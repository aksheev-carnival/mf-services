       COPY CCP00CTW.   
       COPY CCP00SWS.   
       COPY CCP45AAW.   
       COPY CCP01AWS.   
       COPY DPP01CIW.   
       COPY DPP01DTA.   
       COPY DPP01DWS.   
       COPY DPP01ERR.   
       COPY DPP01MCB.   
       COPY DPP01SCO.   
       COPY DPP12SCO.   
       COPY DPP42ERR.   
       COPY DPP03PWS.   
       COPY RSP00DMS.   
       COPY RSP32DMS.   
       COPY CCP10AWS.   
       COPY DPP02Y2K.   
       COPY TDP01SAW.   
PPC470 COPY SMP68EFF.   
       COPY RSP50INP.   
       COPY RSP50OUT.   
       COPY RSP49INP.   
       COPY RSP49OUT.   
       COPY RSP64DMS.   
       COPY RSP77GMD.   
       COPY SSP03GAD.   
       COPY SSP05GCD.   
       COPY RSP90OVW.   
       COPY SSP20GSD.   
       COPY RSP51INP.   
       COPY RSP51OUT.   
       COPY RSP10PON.   
       COPY RSP10PGI.   
       COPY RSP10PGO.   
       COPY RSP54OAV.   
       COPY RSP54OAVCON.
       COPY RSP89SEZ.   
       COPY RSP22CON.   
       COPY RSP22INP.   
       COPY RSP22OUT.   
       COPY CCP76MCW.   
215279 COPY SSP09GCD.   
CCLAUS COPY RSP86GLD.   


       COMMON-STORAGE SECTION.  

       PROCEDURE DIVISION.  
       0000-MAIN-LINE.  
           COPY DPP01INT.   

           PERFORM DPP12-MCB-INIT THRU DPP12-MCB-INIT-EXIT. 

           PERFORM DPP12-BEGIN-THREAD THRU DPP12-BEGIN-THREAD-EXIT. 

           IF DPP01-SQL-ERROR-IND = 'Y' 
              GO TO DPP12-THREAD-ERROR-EXIT 
           END-IF.  

           EXEC SQL USE DEFAULT SCHEMA PSTRDMS END-EXEC.

       0100-INIT-DATABASE.  
           MOVE 01010101               TO DPP01-ERROR-NUMBER.   
           IMPART.  

           OPEN CIF0
                CIF1
                CIF2
                CIF3
                CIF4
                CIF5
                CIF6
                CIF7
                CIF8
                CIF9
                ERROR-DESC  
                AGENT   
                AGENT-PHONE 
                AGNT-PHO-IDX
                AGENT-TERMS 
                AGENT-IDX   
                AGENT-CURR  
                NATIONALITY       USAGE-MODE IS UPDATE  
                NATIONAL-IDX
                GRP1-BOOK   
                AGENCY-ASSOC
                AGENT-COMP  
                AGENCY-RATE 
                AGENT-BUS   
                AGENCY-CONN 
LOYLTY          MMISC-AMT   
LOYLTY          MMISC-AMTX. 

           PERFORM DPP45-OPEN-AVAIL-UPDATE  
              THRU DPP45-AVAIL-EXIT.

       0200-NEXT-MESSAGE.   
       COPY SMP68INT.   
           CALL 'SMO68INT' USING DPP01-COMMON-DATA-FIELDS   
                                 DPP01-COMMON-INFO  
                                 SMP68-INPUT-PARAMS 
                                 SMP68-OUTPUT-PARAMS.   

           IF DPP01-SUB-MSG-CTR > ZERO  
              IF DPP01-SUB-MSG-STATUS (1) > 1   
                 GO TO 9500-RETURN-SUBROUTINE-ERROR.

           COPY CCP00INT.   
           COPY CCP01INT.   
           COPY DPP03INT.   
           COPY SSP01INT.   
           COPY IRP36INT.   
           COPY CCP76MCI.   
           COPY TDP01INT.   

           MOVE LOW-VALUES             TO WS-MISC-VARIABLES-N.  
231005     MOVE LOW-VALUES             TO WS-CONNECT-VARIABLES. 
231005     MOVE ZERO                   TO WS-CONNECT-RESULT-CNT.
231005     PERFORM VARYING WS-CONNECT-RESULT-SUB FROM 1 BY 1
231005       UNTIL WS-CONNECT-RESULT-SUB > 10   
231005        MOVE LOW-VALUES          TO WS-CONNECT-RESULT-ENTRY   
231005                                           (WS-CONNECT-RESULT-SUB)
231005     END-PERFORM. 
231005     MOVE ZERO                   TO WS-CONNECT-RESULT-SUB.
           MOVE SPACES                 TO WS-MISC-VARIABLES-AN. 

           PERFORM DPP12-GET-NEXT-MESSAGE   
              THRU DPP12-GET-NEXT-MESSAGE-EXIT. 

           IF  CCMV-ERROR-SUB > ZERO
               MOVE CCMV-ERROR-SUB     TO MSGHDR-ADVISE-NUM (1) 
               MOVE 'CCP48MCA'         TO MSGHDR-ADVISE-SOURCE (1)  
               PERFORM CCP75-OUTPUT-CCERRMSG
                   THRU CCP75-OUTPUT-CCERRMSG-EXIT  
               GO TO 9000-END-OF-JOB
           END-IF.  

           IF  (CCMH-MSG-SGMT-ID NOT = 'MCAVL') 
               MOVE 1                  TO MSGHDR-ADVISE-NUM (1) 
               MOVE 'CCR48MCA'         TO MSGHDR-ADVISE-SOURCE (1)  
               PERFORM CCP75-OUTPUT-CCERRMSG
                  THRU CCP75-OUTPUT-CCERRMSG-EXIT   
               GO TO 9000-END-OF-JOB
           END-IF.  
           COPY RSP90INT.   

           MOVE SPACES                 TO CCP00-INDV-BOOK-NUM   
                                          CCP00-GROUP-BOOK-NUM. 
           MOVE 1                      TO CCP00-WHOLESALE-ONLY-FLG. 
           MOVE SPACES                 TO CCP00-INPUT-CURRENCY-CODE.
           IF  MCAVL1-CURRENCY-CODE > SPACES
               MOVE MCAVL1-CURRENCY-CODE
                                       TO CCP00-INPUT-CURRENCY-CODE 
           END-IF.  

           PERFORM CCP10-VALIDATE-AGENT 
              THRU CCP10-VALIDATE-AGENT-EXIT.   

           IF  CCM-INQUIRY-SW NOT = 'OFF'   
               ADD 1                   TO CCMV-ADV-SUB  
               MOVE 'CCR48MCA'         TO MSGHDR-ADVISE-SOURCE  
                                          (CCMV-ADV-SUB)
               MOVE 2                  TO MSGHDR-ADVISE-NUM 
                                          (CCMV-ADV-SUB)
           END-IF.  

           IF  MCAVL1-CURRENCY-CODE > SPACES
               IF  MCAVL1-CURRENCY-CODE NOT = RSP50-O-CURRENCY-CODE 
                   ADD 1               TO CCMV-ADV-SUB  
                   MOVE 'CCR48MCA'     TO MSGHDR-ADVISE-SOURCE  
                                          (CCMV-ADV-SUB)
                   MOVE 3              TO MSGHDR-ADVISE-NUM 
                                          (CCMV-ADV-SUB)
                   PERFORM CCP75-OUTPUT-CCERRMSG
                      THRU CCP75-OUTPUT-CCERRMSG-EXIT   
                   GO TO 9000-END-OF-JOB
               END-IF   
           END-IF.  
           MOVE MCACIN-SUB             TO WS-INP-CABIN-COUNT.   

231005*    VALIDATE CONNECTED-CABIN REQUEST INPUT.  
231005     IF MCAVL1-CONNECT-REQ-IND > SPACES AND   
231005        MCAVL1-CONNECT-REQ-IND NOT = 'Y' AND  
231005        MCAVL1-CONNECT-REQ-IND NOT = 'N'  
231005        ADD 1                    TO CCMV-ADV-SUB  
231005        MOVE 'CCR48MCA'          TO MSGHDR-ADVISE-SOURCE  
231005                                      (CCMV-ADV-SUB)  
231005        MOVE 1                   TO MSGHDR-ADVISE-NUM 
231005                                      (CCMV-ADV-SUB)  
231005        PERFORM CCP75-OUTPUT-CCERRMSG 
231005           THRU CCP75-OUTPUT-CCERRMSG-EXIT
231005        GO TO 9000-END-OF-JOB 
231005     END-IF.  
231005     IF MCAVL1-CONNECT-REQ-IND = 'Y' AND  
231005        WS-INP-CABIN-COUNT NOT = 2
231005        ADD 1                    TO CCMV-ADV-SUB  
231005        MOVE 'CCR48MCA'          TO MSGHDR-ADVISE-SOURCE  
231005                                      (CCMV-ADV-SUB)  
231005        MOVE 1                   TO MSGHDR-ADVISE-NUM 
231005                                      (CCMV-ADV-SUB)  
231005        PERFORM CCP75-OUTPUT-CCERRMSG 
231005           THRU CCP75-OUTPUT-CCERRMSG-EXIT
231005        GO TO 9000-END-OF-JOB 
231005     END-IF.  

       0300-CALL-SAILING-AVAIL. 

           COPY RSP51INT.   
           MOVE 'B'                    TO RSP51-I-REQUEST-TYPE. 
           MOVE 'Y'                    TO RSP51-I-ELEC-DIST-IND.
           MOVE MCAVL1-SAIL-DATE       TO RSP51-I-SAIL-DATE.
           MOVE MCAVL1-SHIP-CODE       TO RSP51-I-SHIP-CODE.
           MOVE MCAVL1-DURATION-DAYS   TO RSP51-I-DURATION-DAYS.
           MOVE ZEROES                 TO RSP51-I-NUM-PAX.  
           MOVE 'I'                    TO RSP51-I-BOOK-TYPE.
           MOVE WS-INP-CABIN-COUNT     TO RSP51-I-CABIN-REQUESTS.   
           MOVE 'N'                    TO RSP51-I-PROT-POLICY-PHASE-IND.

           IF    MSGHDR-AGENCY-ID           NOT > SPACES
             AND (   MSGHDR-AGENT-PHONE-NUM NOT > SPACES
                  OR MSGHDR-AGENT-PHONE-NUM NOT > ZEROES)   
             AND (   MSGHDR-AGENT-ARC-NUM   NOT > SPACES
                  OR MSGHDR-AGENT-ARC-NUM   NOT > ZEROES)   
             AND (   MSGHDR-AGENT-CLIA-NUM  NOT > SPACES
                  OR MSGHDR-AGENT-CLIA-NUM  NOT > ZEROES)   

               MOVE 1                  TO RSP51-OVR-AGT-NEW-BOOK-FLG
           END-IF.  

           PERFORM VARYING WS-SUB FROM 1 BY 1   
                   UNTIL WS-SUB > WS-INP-CABIN-COUNT
              IF WS-SUB = 1 
                MOVE MCACIN-NUM-PAX (WS-SUB)
                                       TO WS-MAX-PAX
                                          WS-MIN-PAX
              ELSE  
                IF MCACIN-NUM-PAX (WS-SUB) > WS-MAX-PAX 
                   MOVE MCACIN-NUM-PAX (WS-SUB) 
                                       TO WS-MAX-PAX
                END-IF  
                IF MCACIN-NUM-PAX (WS-SUB) < WS-MIN-PAX 
                   MOVE MCACIN-NUM-PAX (WS-SUB) 
                                       TO WS-MIN-PAX
                END-IF  
              END-IF
           END-PERFORM. 

           INITIALIZE                   DPP01-COMMON-DATA-FIELDS.   
           CALL 'RSO51SAV' USING        DPP01-COMMON-DATA-FIELDS
                                        DPP01-COMMON-INFO   
                                        RSP51-SAILING-AVAIL-INPUT   
                                        RSP51-SAILING-AVAIL-OUTPUT  
                                        RSP50-AGENCY-OUTPUT 
                                        RSP90-OVERRIDE-FLAGS-INFO.  

           IF  DPP01-SUB-MSG-CTR        > ZEROS AND 
               DPP01-SUB-MSG-STATUS (1) > 1 
               ADD 1                   TO CCMV-ADV-SUB  
               MOVE DPP01-SUB-MSG-SOURCE (1)
                                       TO MSGHDR-ADVISE-SOURCE  
                                                (CCMV-ADV-SUB)  
               MOVE DPP01-SUB-MSG-INDEX  (1)
                                       TO MSGHDR-ADVISE-NUM 
                                                (CCMV-ADV-SUB)  
               PERFORM CCP75-OUTPUT-CCERRMSG
                  THRU CCP75-OUTPUT-CCERRMSG-EXIT   
               GO TO 9000-END-OF-JOB
           END-IF.  

           IF WS-MAX-PAX > RSP51-O-SAIL-MAX-GUESTS  
              ADD 1                    TO CCMV-ADV-SUB  
              MOVE 'CCR48MCA'          TO MSGHDR-ADVISE-SOURCE  
                                          (CCMV-ADV-SUB)
              MOVE 4                   TO MSGHDR-ADVISE-NUM 
                                           (CCMV-ADV-SUB)   
              PERFORM CCP75-OUTPUT-CCERRMSG 
                 THRU CCP75-OUTPUT-CCERRMSG-EXIT
              GO TO 9000-END-OF-JOB 
           END-IF.  

       0400-FETCH-PORT-NAME.

           MOVE TDP01-EMBARK-PORT-CODE TO WS-PORT-CODE. 
           MOVE 26061003               TO DPP01-ERROR-NUMBER.   

           EXEC SQL WHENEVER SQLERROR   
              GO TO 9150-RDMS-ERROR 
           END-EXEC.

           EXEC SQL WHENEVER NOT FOUND  
                GO TO 0500-EMBARK-ERROR 
           END-EXEC.

           EXEC SQL 
                SELECT COUNTRY_CODE 
                  INTO :WS-COUNTRY-CODE 
                 FROM PORT  
                WHERE PORT_CODE = :WS-PORT-CODE 
           END-EXEC.

           IF WS-COUNTRY-CODE NOT = 'US' AND 'CA' AND 'PR'  
              MOVE 'I'                 TO WS-INTL-SAIL-IND  
              GO TO 0700-CHECK-FOR-CHANGE   
           END-IF.  

           MOVE TDP01-DEBARK-PORT-CODE TO WS-PORT-CODE. 
           MOVE 26061004               TO DPP01-ERROR-NUMBER.   

           EXEC SQL WHENEVER NOT FOUND  
                GO TO 0600-DEBARK-ERROR 
           END-EXEC.

           EXEC SQL 
                SELECT COUNTRY_CODE 
                  INTO :WS-COUNTRY-CODE 
                 FROM PORT  
                WHERE PORT_CODE = :WS-PORT-CODE 
           END-EXEC.

           IF WS-COUNTRY-CODE NOT = 'US' AND 'CA' AND 'PR'  
              MOVE 'I'                 TO WS-INTL-SAIL-IND  
              GO TO 0700-CHECK-FOR-CHANGE   
           END-IF.  

           GO TO 0800-FETCH-ITINERARY-RECORD.   

       0500-EMBARK-ERROR.   

           DISPLAY 'PERFORMING 0500-EMBARK-ERROR' UPON PRINTER. 
           GO TO 9150-RDMS-ERROR.   


       0600-DEBARK-ERROR.   

           DISPLAY 'PERFORMING 0600-DEBARK-ERROR' UPON PRINTER. 
           GO TO 9150-RDMS-ERROR.   


       0700-CHECK-FOR-CHANGE.   

           MOVE TDP01-SAIL-DATE-YYYYMMDD
                                       TO DPP02-SAIL-DATE.  
           PERFORM DPP10-COMPUTE-DATE-DIFFERENCE.   

           IF  DPP02-DAYS-DIFFERENCE < 61   
               IF  WS-INTL-SAIL-IND = 'I'   
                   MOVE 'I'            TO WS-SAILING-IND
               END-IF   
           END-IF.  

           IF  DPP02-DAYS-DIFFERENCE < 2
               IF  DPP02-SYS-HHMMSS      > 1615 OR  
                   DPP02-DAYS-DIFFERENCE < 1
                   MOVE 'A'            TO WS-SAILING-IND
               END-IF   
           END-IF.  

           IF  WS-SAILING-IND = 'I' 
               ADD 1                   TO CCMV-ADV-SUB  
               MOVE 'CCR48MCA'         TO MSGHDR-ADVISE-SOURCE  
                                          (CCMV-ADV-SUB)
               MOVE 0004               TO MSGHDR-ADVISE-CODE
                                         (CCMV-ADV-SUB) 
           ELSE 
               IF  WS-SAILING-IND = 'A' 
                   ADD 1               TO CCMV-ADV-SUB  
                   MOVE 'CCR48MCA'     TO MSGHDR-ADVISE-SOURCE  
                                          (CCMV-ADV-SUB)
                   MOVE 0005           TO MSGHDR-ADVISE-CODE
                                          (CCMV-ADV-SUB)
               END-IF   
           END-IF.  

       0800-FETCH-ITINERARY-RECORD. 

           EXEC SQL WHENEVER SQLERROR   
              GO TO 9150-RDMS-ERROR 
           END-EXEC.

           EXEC SQL WHENEVER NOT FOUND  
                GO TO 8500-ITINERARY-ERROR  
           END-EXEC.

           EXEC SQL 
                SELECT JONES_ACT_IND
                INTO :WS-JONES-ACT-IND  
                FROM ITINERARY  
                WHERE EMBARK_PORT_CODE = :TDP01-EMBARK-PORT-CODE    AND 
                      DURATION_DAYS    = :MCAVL1-DURATION-DAYS      AND 
                      ITINERARY_CODE   = :TDP01-ITINERARY-CODE  
           END-EXEC.

           IF WS-JONES-ACT-IND = 'Y'
               ADD 1                   TO CCMV-ADV-SUB  
               MOVE 0010               TO MSGHDR-ADVISE-CODE
                                          (CCMV-ADV-SUB)
               MOVE 'CCR48MCA'         TO MSGHDR-ADVISE-SOURCE  
                                          (CCMV-ADV-SUB)
           END-IF.  

           IF TDP01-CUBA-SAIL-IND = 'Y' 
              IF MSGHDR-SYSTEM-ID = 'BCL'   
                 ADD 1                 TO CCMV-ADV-SUB  
                 MOVE 0013             TO   
                                     MSGHDR-ADVISE-CODE   (CCMV-ADV-SUB)
                 MOVE 'CCR48MCA'       TO   
                                     MSGHDR-ADVISE-SOURCE (CCMV-ADV-SUB)
              ELSE  
                 ADD 1                 TO CCMV-ADV-SUB  
                 MOVE 0014             TO   
                                     MSGHDR-ADVISE-CODE   (CCMV-ADV-SUB)
                 MOVE 'CCR48MCA'       TO   
                                     MSGHDR-ADVISE-SOURCE (CCMV-ADV-SUB)
              END-IF
           END-IF.  

           MOVE TDP01-SHIP-CODE        TO TDP01-I-SHIP-CODE.
           MOVE TDP01-DURATION-DAYS    TO TDP01-I-DUR-DAYS. 
           MOVE TDP01-SAIL-DATE-YYYYMMDD
                                       TO TDP01-I-SAIL-DATE-YYYYMMDD.   

           IF  TDP01-JONES-ACT-IND = 'P'
               PERFORM 8200-FETCH-PRIOR-SAILING THRU
                       8200-FETCH-PRIOR-SAILING-EXIT

               IF  WS-PRIOR-DATE < DPP01-SYSTEM-DATE
                   GO TO 0900-FETCH-CURRENT-SAILING 
               END-IF   

               MOVE WS-PRIOR-DATE      TO DPP02-YYYYMMDD-DATE   
               PERFORM DPP10-YYYYMMDD-TO-MMDDYYYY   
               MOVE DPP02-MMDDYYYY-DATE 
                                       TO CCP00-DATE1   
               ADD 1                   TO CCMV-ADV-SUB  
               MOVE 0011               TO MSGHDR-ADVISE-CODE
                                          (CCMV-ADV-SUB)
               MOVE 'CCR48MCA'         TO MSGHDR-ADVISE-SOURCE  
                                          (CCMV-ADV-SUB)
           ELSE 
               IF  TDP01-JONES-ACT-IND = 'A'
                   PERFORM 8400-FETCH-NEXT-SAILING THRU 
                           8400-FETCH-NEXT-SAILING-EXIT 
                   MOVE TDP01-SAIL-DATE-YYYYMMDD
                                       TO DPP02-YYYYMMDD-DATE   
                   PERFORM DPP10-YYYYMMDD-TO-MMDDYYYY   
                   MOVE DPP02-MMDDYYYY-DATE 
                                       TO CCP00-DATE1   
                   ADD 1               TO CCMV-ADV-SUB  
                   MOVE 0011           TO MSGHDR-ADVISE-CODE
                                          (CCMV-ADV-SUB)
                   MOVE 'CCR48MCA'     TO MSGHDR-ADVISE-SOURCE  
                                          (CCMV-ADV-SUB)
               ELSE 
                   IF  TDP01-JONES-ACT-IND = 'B'
                       PERFORM 8200-FETCH-PRIOR-SAILING THRU
                               8200-FETCH-PRIOR-SAILING-EXIT

                       MOVE WS-PRIOR-DATE   
                                       TO DPP02-YYYYMMDD-DATE   
                       PERFORM DPP10-YYYYMMDD-TO-MMDDYYYY   
                       MOVE DPP02-MMDDYYYY-DATE 
                                       TO WS-PRIOR-DATE 
                       MOVE TDP01-SHIP-CODE 
                                       TO WS-PRIOR-SHIP-CODE
                       PERFORM 8400-FETCH-NEXT-SAILING THRU 
                               8400-FETCH-NEXT-SAILING-EXIT 

                       MOVE TDP01-SAIL-DATE-YYYYMMDD
                                       TO DPP02-YYYYMMDD-DATE   
                       PERFORM DPP10-YYYYMMDD-TO-MMDDYYYY   
                       MOVE WS-PRIOR-DATE   
                                       TO CCP00-DATE1   
                       MOVE DPP02-MMDDYYYY-DATE 
                                       TO CCP00-DATE2   
                       ADD 1           TO CCMV-ADV-SUB  
                       MOVE 0012       TO MSGHDR-ADVISE-CODE
                                          (CCMV-ADV-SUB)
                       MOVE 'CCR48MCA' TO MSGHDR-ADVISE-SOURCE  
                                          (CCMV-ADV-SUB)
                   END-IF   
               END-IF   
           END-IF.  

       0900-FETCH-CURRENT-SAILING.  

           PERFORM TDP01-RET-SAIL-DETAILS THRU  
                   TDP01-RET-SAIL-DETAILS-EXIT. 

           IF TDP01-SAIL-SQLERR OR  
              TDP01-SAIL-NOTFND OR  
              TDP01-PROC-ERROR > ZEROES 
              GO TO 8400-SAILING-NOT-FOUND  
           END-IF.  

           IF  TDP01-SCAT-SAIL-ID = TDP01-SAIL-ID AND   
               TDP01-SAIL-CAT-CNT > 1   
               CONTINUE 
           ELSE 
               PERFORM TDP01-RET-ALL-SCAT THRU  
                       TDP01-RET-ALL-SCAT-EXIT  
           END-IF.  

       1000-GET-AVAIL-CATEGORY-REC. 

       COPY SSP20INT.   

           MOVE MCAVL1-SHIP-CODE       TO SSP20-I-SHIP-CODE.

           CALL 'SSC20GSD' USING        DPP01-COMMON-DATA-FIELDS
                                        DPP01-COMMON-INFO   
                                        SSP20-INPUT-PARAMS  
                                        SSP20-OUTPUT-PARAMS.

           IF DPP01-SUB-MSG-CTR > 0 AND DPP01-SUB-MSG-STATUS (1) > 1
              GO TO 9500-RETURN-SUBROUTINE-ERROR
           END-IF.  

           MOVE TDP01-AVAIL-AREA-NAME  TO AVAIL-AREANAME.   
           MOVE TDP01-AVAIL-SLOT-NUM   TO PAGE-NUM   OF AVAIL-AREA-KEY. 
           MOVE ZERO                   TO RECORD-NUM OF AVAIL-AREA-KEY  
                                          WS-CAT-SUB.   
           MOVE LOW-VALUES             TO WS-FIND-CABIN-RECIPE-TABLE.   
           MOVE 'N'                    TO WS-ADD-SP-IND.
           MOVE ZERO                   TO WS-SP-SUB.

       1100-NEXT-SAIL-CATEGORY. 

           IF  WS-ADD-SP-IND = 'Y'  
               PERFORM VARYING WS-SP-SUB FROM 1 BY 1
                       UNTIL   WS-SP-SUB > WS-SP-CNT
                 MOVE WS-SP-ZSUB (WS-SP-SUB)
                                       TO ZSUB  
                 MOVE WS-SP-MSUB (WS-SP-SUB)
                                       TO MSUB  
                 MOVE WS-SP-CATSUB (WS-SP-SUB)  
                                       TO CATSUB
                 ADD 1                 TO WS-ZONE-CABIN-CNT (ZSUB)  
                                          WS-META-CABIN-CNT (ZSUB MSUB) 
                                         WS-CABIN-CNT (ZSUB MSUB CATSUB)
                 MOVE WS-CABIN-CNT (ZSUB MSUB CATSUB)   
                                       TO CABSUB
                 MOVE WS-SP-IS-OS-IND (WS-SP-SUB)   
                                       TO   
                                  WS-IS-OS-IND (ZSUB MSUB CATSUB CABSUB)
                 MOVE WS-SP-NORMAL-CAP (WS-SP-SUB)  
                                       TO   
                                 WS-NORMAL-CAP (ZSUB MSUB CATSUB CABSUB)
                 MOVE WS-SP-MAX-CAP (WS-SP-SUB) 
                                       TO   
                                    WS-MAX-CAP (ZSUB MSUB CATSUB CABSUB)
                 MOVE WS-SP-CONNECT-CAB-NUM (WS-SP-SUB) 
                                       TO   
                            WS-CONNECT-CAB-NUM (ZSUB MSUB CATSUB CABSUB)
                 MOVE WS-SP-PORT-STAR-CODE  (WS-SP-SUB) 
                                       TO   
                             WS-PORT-STAR-CODE (ZSUB MSUB CATSUB CABSUB)
                 MOVE WS-SP-DISPLAY-SEQ (WS-SP-SUB) 
                                       TO   
                                WS-DISPLAY-SEQ (ZSUB MSUB CATSUB CABSUB)
                 MOVE WS-SP-CABIN-NUM (WS-SP-SUB)   
                                       TO   
                                  WS-CABIN-NUM (ZSUB MSUB CATSUB CABSUB)
                 MOVE WS-SP-VIEW-IND (WS-SP-SUB)
                                       TO   
                                   WS-VIEW-IND (ZSUB MSUB CATSUB CABSUB)
                 MOVE WS-SP-SPL-CAT-CODE (WS-SP-SUB)
                                       TO   
                               WS-SPL-CAT-CODE (ZSUB MSUB CATSUB CABSUB)
               END-PERFORM  
               MOVE LOW-VALUES         TO WS-SP-TABLE   
               MOVE 'N'                TO WS-ADD-SP-IND 
               MOVE ZERO               TO WS-SP-CNT 
                                          WS-SP-SUB 
           END-IF.  

           ADD 1                       TO WS-CAT-SUB.   

           IF WS-CAT-SUB > TDP01-SAIL-CAT-CNT   
              GO TO 1600-FIND-RECIPES   
           END-IF.  

           IF TDP01-PHANTOM-CAT-IND (WS-CAT-SUB) = 'Y'  
              GO TO 1100-NEXT-SAIL-CATEGORY 
           END-IF.  

           MOVE SPACES                 TO WS-META-RQSTED.   

           IF MCASCI-SUB > ZERO 
              PERFORM VARYING WS-SUB FROM 1 BY 1
                      UNTIL WS-SUB > MCASCI-SUB 
                IF TDP01-META-CODE (WS-CAT-SUB) =   
                   MCASCI-META-CAT-CODE (WS-SUB) OR 
                   MCAVL1-META-CAT-CODE 
                   MOVE 'Y'            TO WS-META-RQSTED
                   MOVE MCASCI-SUB     TO WS-SUB
                END-IF  
              END-PERFORM   
           ELSE 
              IF TDP01-META-CODE (WS-CAT-SUB) = MCAVL1-META-CAT-CODE
                 MOVE 'Y'              TO WS-META-RQSTED
              END-IF
           END-IF.  

           IF WS-META-RQSTED NOT = 'Y'  
              GO TO 1100-NEXT-SAIL-CATEGORY 
           END-IF.  

           IF TDP01-CABIN-CAT-CODE (WS-CAT-SUB) = 'X' OR 'P'
              GO TO 1100-NEXT-SAIL-CATEGORY 
           END-IF.  

       1200-FETCH-AVAIL-CATEGORY-REC.   

           MOVE WS-CAT-SUB             TO N18-SIGNED.   
           MOVE N18-UNSIGNED           TO RECORD-NUM OF AVAIL-AREA-KEY. 

           IF  WS-CAT-SUB > 1   
               IF  TDP01-SHIP-CODE = AVAIL-SHIP-CODE AND
                   TDP01-SAIL-DATE-YYYYMMDD = AVAIL-SAIL-DATE AND   
                   TDP01-DURATION-DAYS = AVAIL-DURATION-DAYS AND
                   TDP01-CATEGORY-CODE (WS-CAT-SUB) =   
                   AVAIL-CATEGORY-CODE  
                   GO TO 1300-NEXT-AVAIL-CAT-OCC-REC
               END-IF   
           END-IF   

           MOVE 17011016               TO DPP01-ERROR-NUMBER.   
           FETCH AVAIL-CATEGORY-REC RECORD  
                 ON ERROR GO TO 8175-NO-AVAIL-CATEGORY. 

           IF (TDP01-SHIP-CODE NOT = AVAIL-SHIP-CODE) OR
              (TDP01-SAIL-DATE-YYYYMMDD NOT = AVAIL-SAIL-DATE) OR   
              (TDP01-DURATION-DAYS NOT = AVAIL-DURATION-DAYS) OR
              (TDP01-CATEGORY-CODE (WS-CAT-SUB) NOT =   
                                                    AVAIL-CATEGORY-CODE)
              GO TO 1100-NEXT-SAIL-CATEGORY 
           END-IF.  

       1300-NEXT-AVAIL-CAT-OCC-REC. 

           MOVE 17051909               TO DPP01-ERROR-NUMBER.   
           FETCH NEXT AVAIL-CAT-OCC-REC 
             WITHIN AVAIL-CATEGORY-OCC-SET SET  
               AT END GO TO 1100-NEXT-SAIL-CATEGORY.

           IF AVCOR-OPEN-CABINS = ZERO  
              GO TO 1300-NEXT-AVAIL-CAT-OCC-REC 
           END-IF.  

       1400-NEXT-AVAIL-CABIN-REC.   
           MOVE 17011406               TO DPP01-ERROR-NUMBER.   
           FETCH NEXT AVAIL-CABIN-REC   
                  WITHIN AVAIL-OCC-OPEN-CABIN-SET SET   
                  ON ERROR GO TO 1300-NEXT-AVAIL-CAT-OCC-REC.   

           IF  AVL-CAB-WHEELCHAIR-IND = 'Y' OR 'P' OR 'S' OR 'L' OR 'R' 
               GO TO 1400-NEXT-AVAIL-CABIN-REC  
           END-IF.  

           IF AVL-CAB-CABIN-STATUS > SPACES 
              GO TO 1400-NEXT-AVAIL-CABIN-REC   
           END-IF.  

           IF WS-MIN-PAX > AVL-CAB-MAX-CAPACITY 
              GO TO 1400-NEXT-AVAIL-CABIN-REC   
           END-IF.  
           
231005     IF MCAVL1-DECK-CODE > SPACES AND
231005        AVL-CAB-DECK NOT = MCAVL1-DECK-CODE
231005        GO TO 1400-NEXT-AVAIL-CABIN-REC
231005     END-IF.
231005 
231005     IF MCAVL1-LOCATION-CODE > SPACES AND
231005        AVL-CAB-FWD-AFT-IND NOT = MCAVL1-LOCATION-CODE
231005        GO TO 1400-NEXT-AVAIL-CABIN-REC
231005     END-IF.

           MOVE 'N'                    TO WS-CABIN-AVL-FOR-RATE.
           IF AVL-CAB-RATE-CODE > SPACES
              PERFORM VARYING WS-SUB FROM 1 BY 1
                 UNTIL WS-SUB > WS-INP-CABIN-COUNT  
                 IF AVL-CAB-RATE-CODE = WS-OFFER-CODE (WS-SUB)  
                    MOVE 'Y'           TO WS-CABIN-AVL-FOR-RATE 
                    MOVE WS-INP-CABIN-COUNT 
                                       TO WS-SUB
                 END-IF 
              END-PERFORM   
              IF WS-CABIN-AVL-FOR-RATE = 'N'
                 GO TO 1400-NEXT-AVAIL-CABIN-REC
              END-IF
           END-IF.  

           MOVE SPACES                 TO WS-ZONE-EXISTS.   
           PERFORM VARYING WS-SUB FROM 1 BY 1   
                   UNTIL WS-SUB > WS-ZONE-CNT   
               IF WS-DECK-NUM  (WS-SUB) = AVL-CAB-DECK-NUM    AND   
                  WS-DECK-CODE (WS-SUB) = AVL-CAB-DECK        AND   
                  WS-FMA-IND   (WS-SUB) = AVL-CAB-FWD-AFT-IND   
                  MOVE WS-SUB          TO ZSUB  
                  MOVE 'Y'             TO WS-ZONE-EXISTS
                  MOVE WS-ZONE-CNT     TO WS-SUB
               END-IF   
           END-PERFORM. 

           IF WS-ZONE-EXISTS NOT = 'Y'  
              ADD 1                    TO WS-ZONE-CNT   
              MOVE WS-ZONE-CNT         TO ZSUB  
              MOVE AVL-CAB-DECK-NUM    TO WS-DECK-NUM (ZSUB)
              MOVE AVL-CAB-DECK        TO WS-DECK-CODE (ZSUB)   
              MOVE AVL-CAB-FWD-AFT-IND TO WS-FMA-IND  (ZSUB)
           END-IF.  

           MOVE SPACES                 TO WS-META-EXISTS.   
           PERFORM VARYING WS-SUB FROM 1 BY 1   
                   UNTIL WS-SUB > WS-META-CNT (ZSUB)
               IF TDP01-META-CODE (WS-CAT-SUB)  
                   = WS-META-CAT-CODE (ZSUB WS-SUB) 
                  MOVE WS-SUB          TO MSUB  
                  MOVE 'Y'             TO WS-META-EXISTS
                  MOVE WS-META-CNT (ZSUB)   
                                       TO WS-SUB
               END-IF   
           END-PERFORM. 

           IF WS-META-EXISTS NOT = 'Y'  
              ADD 1                    TO WS-META-CNT (ZSUB)
              MOVE WS-META-CNT (ZSUB)  TO MSUB  
              MOVE TDP01-META-CODE (WS-CAT-SUB) 
                                       TO WS-META-CAT-CODE (ZSUB MSUB)  
           END-IF.  

           MOVE SPACES                 TO WS-CAT-EXISTS.

           PERFORM VARYING WS-SUB FROM 1 BY 1   
                   UNTIL WS-SUB > WS-META-CAT-CNT (ZSUB MSUB)   
               IF WS-CAT-CODE (ZSUB MSUB WS-SUB) =  
                  AVL-CAB-CATEGORY-CODE 
                  MOVE WS-SUB          TO CATSUB
                  MOVE 'Y'             TO WS-CAT-EXISTS 
                  MOVE WS-META-CAT-CNT (ZSUB MSUB)  
                                       TO WS-SUB
               END-IF   
           END-PERFORM. 
           IF WS-CAT-EXISTS NOT = 'Y'   
              ADD 1                    TO WS-META-CAT-CNT (ZSUB MSUB)   
              MOVE WS-META-CAT-CNT (ZSUB MSUB)  
                                       TO CATSUB
              MOVE AVL-CAB-CATEGORY-CODE
                                       TO WS-CAT-CODE (ZSUB MSUB CATSUB)
              PERFORM VARYING WS-OCC-SUB FROM 1 BY 1
                   UNTIL WS-OCC-SUB > 5 
              IF TDP01-SCAT-OCC-INDS (WS-CAT-SUB) (WS-OCC-SUB:1) = 'Y'  
                 MOVE WS-OCC-SUB       TO WS-CAT-MAX-PAX
                                                     (ZSUB MSUB CATSUB) 
              END-IF
              END-PERFORM   
              PERFORM VARYING WS-OCC-SUB FROM 1 BY 1
                      UNTIL WS-OCC-SUB > 5  
               IF TDP01-SCAT-OCC-INDS (WS-CAT-SUB) (WS-OCC-SUB:1) = 'Y' 
                  MOVE WS-OCC-SUB      TO WS-CAT-MIN-PAX
                                                     (ZSUB MSUB CATSUB) 
                  MOVE 5               TO WS-OCC-SUB
               END-IF   
              END-PERFORM   
              PERFORM VARYING WS-PAX-SUB FROM 1 BY 1
                   UNTIL WS-PAX-SUB > WS-INP-CABIN-COUNT
PPCPDT*            MOVE MCACIN-NUM-PAX (WS-PAX-SUB) 
PPCPDT*                                TO WS-PAX-COUNT  
PPCPDT             IF WS-PAX-SUB = 1
PPCPDT                MOVE MCACIN-NUM-PAX (WS-PAX-SUB)  
PPCPDT                                 TO WS-MIN-PAX-COUNT  
PPCPDT             END-IF   
PPCPDT             IF MCACIN-NUM-PAX (WS-PAX-SUB) < WS-MIN-PAX-COUNT
PPCPDT                MOVE MCACIN-NUM-PAX (WS-PAX-SUB)  
PPCPDT                                 TO WS-MIN-PAX-COUNT  
PPCPDT             END-IF   
              END-PERFORM   
PPCPDT        MOVE WS-MIN-PAX-COUNT    TO WS-PAX-COUNT  
              EVALUATE WS-PAX-COUNT 
                 WHEN 1 
                    MOVE TDP01-EFF-SPOILAGE-CODE (WS-CAT-SUB)   
                                       TO   
                             WS-CAT-RESTRICT-TYPE (ZSUB MSUB CATSUB 1)  
                 WHEN 2 
                    MOVE TDP01-EFF-SPOILAGE-CODE-DBL (WS-CAT-SUB)   
                                       TO   
                             WS-CAT-RESTRICT-TYPE (ZSUB MSUB CATSUB 2)  
                 WHEN 3 
                    MOVE TDP01-EFF-SPOILAGE-CODE-TRPL (WS-CAT-SUB)  
                                       TO   
                             WS-CAT-RESTRICT-TYPE (ZSUB MSUB CATSUB 3)  
                 WHEN 4 
                    MOVE TDP01-EFF-SPOILAGE-CODE-QUAD (WS-CAT-SUB)  
                                       TO   
                             WS-CAT-RESTRICT-TYPE (ZSUB MSUB CATSUB 4)  
                 WHEN 5 
                    MOVE TDP01-EFF-SPOILAGE-CODE-QUNT (WS-CAT-SUB)  
                                       TO   
                             WS-CAT-RESTRICT-TYPE (ZSUB MSUB CATSUB 5)  
              END-EVALUATE  
              MOVE WS-CAT-RESTRICT-TYPE (ZSUB MSUB CATSUB WS-PAX-COUNT) 
                                       TO WS-CAT-OCC-TYPE   
           END-IF.  

           IF  AVL-CAB-PORT-STAR-CODE = 'P' 
               CONTINUE 
           ELSE 
               PERFORM 1500-MOVE-TO-SP-TABLE
               GO TO 1400-NEXT-AVAIL-CABIN-REC  
           END-IF.  

           ADD 1                       TO WS-ZONE-CABIN-CNT (ZSUB)  
                                          WS-META-CABIN-CNT (ZSUB MSUB) 
                                        WS-CABIN-CNT (ZSUB MSUB CATSUB).
           MOVE WS-CABIN-CNT (ZSUB MSUB CATSUB) 
                                       TO CABSUB.   
           MOVE AVL-CAB-IS-OS-IND      TO   
                                 WS-IS-OS-IND (ZSUB MSUB CATSUB CABSUB).
           MOVE AVL-CAB-NORMAL-CAPACITY 
                                       TO   
                                WS-NORMAL-CAP (ZSUB MSUB CATSUB CABSUB).
           MOVE AVL-CAB-MAX-CAPACITY   TO   
                                   WS-MAX-CAP (ZSUB MSUB CATSUB CABSUB).
           MOVE AVL-CAB-CONNECT-CABIN-NUM   
                                       TO   
                           WS-CONNECT-CAB-NUM (ZSUB MSUB CATSUB CABSUB).
           MOVE AVL-CAB-PORT-STAR-CODE TO   
                            WS-PORT-STAR-CODE (ZSUB MSUB CATSUB CABSUB).
           MOVE AVL-CAB-DISPLAY-SEQ    TO   
                               WS-DISPLAY-SEQ (ZSUB MSUB CATSUB CABSUB).
           MOVE AVL-CAB-CABIN-NUM      TO   
                                 WS-CABIN-NUM (ZSUB MSUB CATSUB CABSUB).
           MOVE AVL-CAB-VIEW-IND       TO   
                                  WS-VIEW-IND (ZSUB MSUB CATSUB CABSUB).
           MOVE 'N'                    TO   
                              WS-SPL-CAT-CODE (ZSUB MSUB CATSUB CABSUB).

           IF  AVL-CAB-SMOKING-FLG = ZERO  AND  
               TDP01-SUBMETA-CODE (WS-CAT-SUB) > SPACES 
               MOVE TDP01-SUBMETA-CODE (WS-CAT-SUB) 
                                       TO WS-SPL-CAT-CODE   
                                          (ZSUB MSUB CATSUB CABSUB) 
           END-IF.  
           GO TO 1400-NEXT-AVAIL-CABIN-REC. 

       1500-MOVE-TO-SP-TABLE.   
           ADD 1                       TO WS-SP-CNT.
           MOVE ZSUB                   TO WS-SP-ZSUB (WS-SP-CNT).   
           MOVE MSUB                   TO WS-SP-MSUB (WS-SP-CNT).   
           MOVE CATSUB                 TO WS-SP-CATSUB (WS-SP-CNT). 
           MOVE AVL-CAB-IS-OS-IND      TO WS-SP-IS-OS-IND   
                                          (WS-SP-CNT).  
           MOVE AVL-CAB-NORMAL-CAPACITY 
                                       TO WS-SP-NORMAL-CAP  
                                             (WS-SP-CNT).   
           MOVE AVL-CAB-MAX-CAPACITY   TO WS-SP-MAX-CAP 
                                             (WS-SP-CNT).   
           MOVE AVL-CAB-CONNECT-CABIN-NUM   
                                       TO WS-SP-CONNECT-CAB-NUM 
                                             (WS-SP-CNT).   
           MOVE AVL-CAB-PORT-STAR-CODE TO WS-SP-PORT-STAR-CODE  
                                          (WS-SP-CNT).  
           MOVE AVL-CAB-DISPLAY-SEQ    TO WS-SP-DISPLAY-SEQ 
                                          (WS-SP-CNT).  
           MOVE AVL-CAB-CABIN-NUM      TO WS-SP-CABIN-NUM   
                                          (WS-SP-CNT).  
           MOVE AVL-CAB-VIEW-IND       TO WS-SP-VIEW-IND
                                          (WS-SP-CNT).  
           MOVE 'N'                    TO WS-SP-SPL-CAT-CODE
                                          (WS-SP-CNT).  

           IF  AVL-CAB-SMOKING-FLG = ZERO  AND  
               TDP01-SUBMETA-CODE (WS-CAT-SUB) > SPACES 
               MOVE TDP01-SUBMETA-CODE (WS-CAT-SUB) 
                                       TO WS-SP-SPL-CAT-CODE
                                          (WS-SP-CNT)   
           END-IF.  
           MOVE 'Y'                    TO WS-ADD-SP-IND.

       1600-FIND-RECIPES.   

           MOVE ZERO                   TO ZSUB MSUB CABSUB URM-ZSUB.
           MOVE LOW-VALUES             TO WS-FIND-URM-RECIPE-TABLE. 

       1700-URM-NEXT-ZONE.  

           ADD 1                       TO ZSUB. 

           IF ZSUB > WS-ZONE-CNT
              GO TO 2100-DONE-URM   
           END-IF.  

           IF WS-ZONE-CABIN-CNT (ZSUB) < WS-INP-CABIN-COUNT 
              GO TO 1700-URM-NEXT-ZONE  
           END-IF.  
           MOVE ZERO                   TO MSUB. 

       1800-URM-NEXT-META.  

           ADD 1                       TO MSUB. 

           IF MSUB > WS-META-CNT (ZSUB) 
              GO TO 1700-URM-NEXT-ZONE  
           END-IF.  

           IF WS-META-CAT-CODE (ZSUB MSUB) NOT = MCAVL1-META-CAT-CODE   
              GO TO 1800-URM-NEXT-META  
           END-IF.  

           IF WS-META-CABIN-CNT (ZSUB MSUB) < WS-INP-CABIN-COUNT
              GO TO 1800-URM-NEXT-META  
           END-IF.  

           ADD 1                       TO URM-ZSUB  
                                          WS-URM-ZONE-META-CNT. 

           MOVE WS-DECK-NUM(ZSUB)      TO  WS-URM-DECK-NUM (URM-ZSUB).  
           MOVE WS-DECK-CODE(ZSUB)     TO  WS-URM-DECK-CODE (URM-ZSUB). 
           MOVE WS-FMA-IND(ZSUB)       TO  WS-URM-FMA-IND (URM-ZSUB).   
           MOVE WS-META-CAT-CODE (ZSUB MSUB)
                                       TO   
                                        WS-URM-META-CAT-CODE (URM-ZSUB).
           MOVE WS-META-CABIN-CNT (ZSUB MSUB)   
                                       TO   
                                  WS-URM-ZONE-META-CABIN-CNT (URM-ZSUB).
           MOVE WS-META-CAT-CNT (ZSUB MSUB) 
                                       TO   
                                        WS-URM-META-CAT-CNT (URM-ZSUB). 

           MOVE ZERO                   TO CATSUB
                                          URM-CATSUB
                                  WS-URM-ZONE-META-CABIN-CNT (URM-ZSUB).

       1900-URM-NEXT-CAT.   

           ADD 1                       TO CATSUB.   

           IF CATSUB > WS-META-CAT-CNT (ZSUB MSUB)  
              GO TO 1800-URM-NEXT-META  
           END-IF.  

           MOVE SPACES                 TO WS-CAT-EXISTS.
           PERFORM VARYING WS-SUB FROM 1 BY 1   
                   UNTIL WS-SUB > WS-URM-META-CAT-CNT (URM-ZSUB)
              IF WS-CAT-CODE (ZSUB MSUB WS-SUB) =   
                 WS-URM-CAT-CODE (URM-ZSUB WS-SUB)  
                 MOVE WS-SUB           TO URM-CATSUB
                 MOVE 'Y'              TO WS-CAT-EXISTS 
                 MOVE WS-META-CAT-CNT (ZSUB MSUB)   
                                       TO WS-SUB
              END-IF
           END-PERFORM. 

           IF WS-CAT-EXISTS NOT = 'Y'   
              ADD 1                    TO WS-URM-META-CAT-CNT (URM-ZSUB)
              MOVE WS-URM-META-CAT-CNT (URM-ZSUB)   
                                       TO URM-CATSUB
              MOVE WS-CAT-CODE (ZSUB MSUB CATSUB)   
                                       TO   
                                   WS-URM-CAT-CODE (URM-ZSUB URM-CATSUB)
              MOVE WS-CAT-MIN-PAX (ZSUB MSUB CATSUB)
                                       TO   
                                WS-URM-CAT-MIN-PAX (URM-ZSUB URM-CATSUB)
              MOVE WS-CAT-MAX-PAX  (ZSUB MSUB CATSUB)   
                                       TO   
                                WS-URM-CAT-MAX-PAX (URM-ZSUB URM-CATSUB)
              PERFORM VARYING WS-SUB FROM 1 BY 1
                      UNTIL WS-SUB > 5  
               MOVE WS-CAT-RESTRICT-TYPE (ZSUB MSUB CATSUB WS-SUB)  
                                       TO   
                WS-URM-CAT-RESTRICT-TYPE (URM-ZSUB URM-CATSUB WS-SUB)   
              END-PERFORM   
           END-IF.  
           MOVE ZERO                   TO CABSUB URM-CABSUB.

       2000-URM-NEXT-CABIN. 

           ADD 1                       TO CABSUB
                                          URM-CABSUB.   

           IF CABSUB > WS-CABIN-CNT (ZSUB MSUB CATSUB)  
              GO TO 1900-URM-NEXT-CAT   
           END-IF.  

           ADD 1                       TO   
                                  WS-URM-ZONE-META-CABIN-CNT (URM-ZSUB).
           ADD 1                       TO   
                                  WS-URM-CABIN-CNT (URM-ZSUB URM-CATSUB)
           MOVE WS-NORMAL-CAP  (ZSUB MSUB CATSUB CABSUB)
                                       TO   
                     WS-URM-NORMAL-CAP (URM-ZSUB URM-CATSUB URM-CABSUB).
           MOVE WS-MAX-CAP (ZSUB MSUB CATSUB CABSUB)
                                       TO   
                       WS-URM-MAX-CAP (URM-ZSUB URM-CATSUB URM-CABSUB). 
           MOVE WS-CONNECT-CAB-NUM (ZSUB MSUB CATSUB CABSUB)
                                       TO   
               WS-URM-CONNECT-CAB-NUM (URM-ZSUB URM-CATSUB URM-CABSUB). 
           MOVE WS-PORT-STAR-CODE (ZSUB MSUB CATSUB CABSUB) 
                                       TO   
                WS-URM-PORT-STAR-CODE (URM-ZSUB URM-CATSUB URM-CABSUB). 
           MOVE WS-DISPLAY-SEQ  (ZSUB MSUB CATSUB CABSUB)   
                                       TO   
                   WS-URM-DISPLAY-SEQ (URM-ZSUB URM-CATSUB URM-CABSUB). 
           MOVE WS-CABIN-NUM  (ZSUB MSUB CATSUB CABSUB) 
                                       TO   
                     WS-URM-CABIN-NUM (URM-ZSUB URM-CATSUB URM-CABSUB). 
           MOVE WS-IS-OS-IND (ZSUB MSUB CATSUB CABSUB)  
                                       TO   
                     WS-URM-IS-OS-IND (URM-ZSUB URM-CATSUB URM-CABSUB). 
           MOVE WS-SPL-CAT-CODE (ZSUB MSUB CATSUB CABSUB)   
                                       TO   
                  WS-URM-SPL-CAT-CODE (URM-ZSUB URM-CATSUB URM-CABSUB). 
           MOVE WS-VIEW-IND(ZSUB MSUB CATSUB CABSUB)
                                       TO   
                      WS-URM-VIEW-IND (URM-ZSUB URM-CATSUB URM-CABSUB). 

           GO TO 2000-URM-NEXT-CABIN.   

       2100-DONE-URM.   

       COPY RSP10PII.   
       COPY RSP54OAVINT.

           MOVE LOW-VALUES             TO   
                                         WS-BEST-FARE-OUTPUT-FOR-RECIPE.
           MOVE ZERO                   TO REQ-CABSUB.   

       2200-CALL-BEST-FARE. 

           ADD 1                       TO REQ-CABSUB.   


           IF REQ-CABSUB > WS-INP-CABIN-COUNT   
              GO TO 2600-BUILD-BEST-URM-RECIPE  
           END-IF.  

           PERFORM VARYING WS-SUB FROM 1 BY 1   
                   UNTIL WS-SUB > MCAGIN-SUB
             IF MCACIN-SEQ-NUM (REQ-CABSUB) = MCAGIN-OWNER-SUB (WS-SUB) 
                MOVE WS-SUB            TO WS-GUEST-SUB  
                MOVE MCAGIN-SUB        TO WS-SUB
             END-IF 
           END-PERFORM. 

           COPY RSP10PII.   
           MOVE 0                    TO WS-PG-CNT.  

           PERFORM VARYING WS-SUB FROM WS-GUEST-SUB BY 1                   
                        UNTIL WS-SUB > (MCAGIN-SUB)                        
               IF MCACIN-SEQ-NUM (REQ-CABSUB) =                            
                  MCAGIN-OWNER-SUB (WS-SUB)                                
                  IF MCAGIN-MILITARY-IND (WS-SUB) = 'Y' 
                     MOVE 'ML'       TO RSP54-I-QUALIFICATION-CODE  
                                        (REQ-CABSUB WS-SUB) 
                  END-IF
                  IF MCAGIN-INTERLINE-IND (WS-SUB) = 'Y'
                     MOVE 'IL'       TO RSP54-I-QUALIFICATION-CODE  
                                        (REQ-CABSUB WS-SUB) 
                  END-IF
                  IF MCACIN-SENIOR-IND (REQ-CABSUB) = 'Y'   
                     MOVE 'SN'       TO RSP54-I-QUALIFICATION-CODE  
                                        (REQ-CABSUB WS-SUB) 
                  END-IF
                  IF  MCAGIN-PAST-GUEST-NUM (WS-SUB) > SPACES   
                      ADD 1          TO WS-PG-CNT   
PPC470*               MOVE MCAGIN-PAST-GUEST-NUM (WS-SUB)   
PPC470*                              TO RSP10-I-LOYALTY-NUM (WS-PG-CNT) 
PPC470                MOVE SPACES           TO WS-OUT-PAST-GUEST-NUM
PPC470                                         WS-INP-PAST-GUEST-NUM
PPC470                MOVE 10               TO WS-NSUB  
PPC470                MOVE MCAGIN-PAST-GUEST-NUM (WS-SUB)   
PPC470                                      TO WS-INP-PAST-GUEST-NUM
PPC470                PERFORM VARYING WS-IN-SUB FROM 10 BY -1   
PPC470                        UNTIL WS-IN-SUB < 1   
PPC470                    IF  WS-NSUB > 0   
PPC470                      IF  WS-INP-PAST-GUEST-DIGIT(WS-IN-SUB) > ' '
PPC470                         MOVE WS-INP-PAST-GUEST-DIGIT (WS-IN-SUB) 
PPC470                           TO WS-OUT-PAST-GUEST-DIGIT (WS-NSUB)   
PPC470                         SUBTRACT 1 FROM WS-NSUB  
PPC470                      END-IF  
PPC470                    END-IF
PPC470                END-PERFORM   
PPC470                INSPECT WS-OUT-PAST-GUEST-NUM 
PPC470                             REPLACING LEADING ' ' BY '0' 
PPC470                MOVE WS-OUT-PAST-GUEST-NUM
PPC470                           TO RSP10-I-LOYALTY-NUM (WS-PG-CNT) 
PPC470  
                      MOVE 'N'       TO RSP10-I-TRUST-ME-IND (WS-PG-CNT)
                      IF  MCAGIN-TIER-CODE  (WS-SUB) > SPACES   
                          MOVE MCAGIN-TIER-CODE  (WS-SUB)   
                                     TO RSP10-I-TIER-CODE (WS-PG-CNT)   
                          MOVE 'Y'   TO RSP10-I-TRUST-ME-IND (WS-PG-CNT)
                      END-IF
                  END-IF

                  IF ((MCACIN-HOME-STATE-CODE (REQ-CABSUB)  > SPACES)   
                  AND  (MCACIN-HOME-STATE-CODE (REQ-CABSUB) NOT = 'XX'))

                     MOVE 'RS'  TO RSP54-I-QUALIFICATION-CODE   
                                                    (REQ-CABSUB WS-SUB) 

                    MOVE MCACIN-HOME-STATE-CODE (REQ-CABSUB)
                                      TO RSP54-I-STATE-CODE (REQ-CABSUB)
                    EXEC SQL
                         SELECT COUNTRY_CODE
                         INTO :RSP54-I-COUNTRY-CODE (REQ-CABSUB)
                               FROM VALID_COUNTRY_STATE 
                         WHERE CCL_STATE_CODE = :MCACIN-HOME-STATE-CODE 
                                                            (REQ-CABSUB)
                        FETCH FIRST 1 ROW ONLY  
                    END-EXEC
                    IF SQLCODE < 0  
                       GO TO 9150-RDMS-ERROR
                    ELSE
                       IF SQLCODE = 100 
                          ADD 1            TO CCMV-ADV-SUB  
                          MOVE 'CCR48MCA'  TO   
                                     MSGHDR-ADVISE-SOURCE (CCMV-ADV-SUB)
                          MOVE 0020        TO   
                                      MSGHDR-ADVISE-CODE(CCMV-ADV-SUB)  
                          PERFORM CCP75-OUTPUT-CCERRMSG 
                             THRU CCP75-OUTPUT-CCERRMSG-EXIT
                          GO TO 9000-END-OF-JOB 
                       END-IF   
                    END-IF  
                  END-IF
               ELSE 
                  MOVE MCAGIN-SUB TO WS-SUB 
               END-IF   
           END-PERFORM. 

           MOVE WS-PG-CNT               TO RSP10-I-LOYALTY-CNT. 
           MOVE TDP01-SHIP-CODE         TO RSP10-I-SHIP-CODE.   
           MOVE TDP01-SAIL-DATE-YYYYMMDD
                                        TO RSP10-I-SAIL-DATE.   
           MOVE TDP01-DURATION-DAYS     TO RSP10-I-DURATION-DAYS.   
           MOVE 'PG'                    TO RSP10-I-IDENTIFER-TYPE.  
           MOVE 'O'                     TO RSP10-I-OFFER-STATUS-CODE.   

           CALL 'RSO10PGI' USING DPP01-COMMON-DATA-FIELDS   
                                 DPP01-COMMON-INFO  
                                 RSP10-INPUT-PARMS  
                                 RSP10-OUTPUT-PARMS.

           IF  DPP01-SUB-MSG-CTR > 0 AND
               DPP01-SUB-MSG-STATUS (1) > 1 
              ADD 1 TO CCMV-ADV-SUB 
              MOVE 'CCR48MCA' TO MSGHDR-ADVISE-SOURCE (CCMV-ADV-SUB)
              MOVE 0015   TO MSGHDR-ADVISE-CODE (CCMV-ADV-SUB)  
              MOVE DPP01-SUB-MSG-SOURCE (1) TO  
                   MSGHDR-ADVISE-SOURCE (CCMV-ADV-SUB)  
              MOVE DPP01-SUB-MSG-INDEX (1)  TO CCP00-ADVISE-CODE
              MOVE CCP00-ADVISE-CODE        TO  
                   MSGHDR-ADVISE-CODE (CCMV-ADV-SUB)
              PERFORM CCP75-OUTPUT-CCERRMSG 
                 THRU CCP75-OUTPUT-CCERRMSG-EXIT
              GO TO 9000-END-OF-JOB 
           END-IF.  

           MOVE LOW-VALUES             TO RSP54-I-OVERRIDE-FLAGS
                                          RSP54-I-SUBSET-SPLIT-FLAGS.   

           MOVE RSP51-O-SAIL-ID        TO RSP54-I-SAIL-ID.  
           MOVE MCACIN-NUM-PAX (REQ-CABSUB) 
                                       TO RSP54-I-OCCUPANCY.
           MOVE MCAVL1-SHIP-CODE       TO RSP54-I-SHIP-CODE.
           MOVE 'B'                    TO RSP54-I-REQUEST-TYPE. 
           MOVE 'I'                    TO RSP54-I-BOOK-TYPE.
           MOVE 'Y'                    TO RSP54-I-NEW-BOOKING-IND.  
           MOVE MCACIN-COUPON-CODE  (REQ-CABSUB)
                                       TO RSP54-I-COUPON-CODE.  
           MOVE MCACIN-OFFER-CODE   (REQ-CABSUB)
                                       TO CCL-CORP-OFFER-CODE   
           PERFORM CCP40-DETERMINE-RATE 
              THRU CCP40-RATE-EXIT. 
           MOVE CCL-CORP-OFFER-CODE    TO WS-OFFER-CODE (REQ-CABSUB)
                                          WS-TGO-AB-CODE (REQ-CABSUB).  
           MOVE WS-OFFER-CODE (REQ-CABSUB)  
                                       TO RSP54-I-OFFER-CODE
                                          CCL-CORP-OFFER-CODE.  
           IF WS-TGO-AB-CODE (REQ-CABSUB) > SPACES  
              MOVE 'ADB'               TO RSP54-I-SUBSET-TGO-ENT-TYPE   
              MOVE WS-TGO-AB-CODE (REQ-CABSUB)  
                                       TO RSP54-I-SUBSET-TGO-ENT-CODE   
           ELSE 
              MOVE 'OFF'               TO RSP54-I-SUBSET-TGO-ENT-TYPE   
              MOVE SPACES              TO RSP54-I-SUBSET-TGO-ENT-CODE   
           END-IF.  
           MOVE 'N'                    TO RSP54-I-INTERNAL-ACCESS-IND.  
           MOVE 1                      TO RSP54-OVERRIDE-SENIOR-FLG 
                                          RSP54-I-SPLIT-QUAL-FLG
                                          RSP54-I-SPLIT-TGO-FLG.
           IF SSP03-O-COUPON-ONLY-FLG = 1   
              MOVE 1                   TO RSP54-I-SPLIT-COUPON-FLG  
              MOVE MCACIN-COUPON-CODE (REQ-CABSUB)  
                                       TO RSP54-I-SUBSET-COUPON-CODE
           ELSE 
              MOVE 0                   TO RSP54-I-SPLIT-COUPON-FLG  
              MOVE SPACES              TO RSP54-I-SUBSET-COUPON-CODE
           END-IF.  
           MOVE SPACES                 TO RSP54-I-SUBSET-KEYS.  
           MOVE RSP51-O-PRC-XCHG-RATE  TO RSP54-I-PRC-XCHG-RATE.
           MOVE 'N'                    TO RSP54-I-PRICE-PROTECT-IND.
           MOVE 'N'                    TO RSP54-I-PRICE-ELIGIBLE-IND.   

           IF SSP03-O-PPC-COMPLAINT-FLG = 0 
              MOVE 1                   TO RSP54-OVERRIDE-MILITARY-FLG   
                                          RSP54-OVERRIDE-INTERLINE-FLG  
           END-IF.  

           CALL 'RSO54OAV' USING DPP01-COMMON-DATA-FIELDS   
                                 DPP01-COMMON-INFO  
                                 RSP54-INPUT-PARMS  
                                 RSP54-OUTPUT-PARMS 
                                 RSP50-AGENCY-OUTPUT
                                 RSP90-OVERRIDE-FLAGS-INFO. 
           IF  DPP01-SUB-MSG-CTR > 0 AND
               DPP01-SUB-MSG-STATUS (1) > 1 
               GO TO 9500-RETURN-SUBROUTINE-ERROR   
           END-IF.  
       2300-BUILD-RATE-CAT-TABLE.   

           MOVE ZERO                   TO R1.   

           ADD 1                       TO WS-RCP-RATE-CNT.  
           MOVE MCACIN-NUM-PAX (REQ-CABSUB) 
                                       TO O1.   
           MOVE O1                     TO WS-RCP-REQ-OCC (REQ-CABSUB).  

           MOVE REQ-CABSUB             TO WS-RCP-REQ-NUM(REQ-CABSUB).   
           MOVE WS-OFFER-CODE (REQ-CABSUB)  
                                       TO WS-RCP-OFFER-CODE(REQ-CABSUB).

       2400-BUILD-RATE-CAT-TABLE.   
           MOVE ZERO                   TO C1
                                       WS-RCP-CATEGORY-CNT (REQ-CABSUB).

       2500-NEXT-CATEGORY.  

           ADD 1                       TO C1 .  

           IF C1 > RSP54-O-CATEGORY-CNT 
              GO TO 2200-CALL-BEST-FARE 
           END-IF.  

           IF (RSP54-OC-CAT-AVAIL-IND (C1 1 ) NOT = 'Y')
              GO TO 2500-NEXT-CATEGORY  
           END-IF.  

           IF RSP54-OC-OCC-INDS (C1 1) (O1:1) = 'N' 
              GO TO 2500-NEXT-CATEGORY  
           END-IF.  

           ADD 1                       TO   
                                       WS-RCP-CATEGORY-CNT (REQ-CABSUB).
           MOVE WS-RCP-CATEGORY-CNT (REQ-CABSUB)
                                       TO REQ-CATSUB.   


           IF WS-22PAY-CALL-FLAG = 'Y'  
              GO TO 2500-CONTINUE   
           END-IF.  

           COPY RSP22INT.   

           MOVE MCAVL1-SHIP-CODE    TO RSP22-I-SHIP-CODE.   
           MOVE RSP51-O-SAIL-ID     TO RSP22-I-SAIL-ID. 
           MOVE RSP54-OC-OFFER-ID (C1 1)
                                    TO RSP22-I-OFFER-ID.
           MOVE MCACIN-NUM-PAX (REQ-CABSUB) 
                                    TO RSP22-I-OCCUPANCY.   
           MOVE 'B'                 TO RSP22-I-REQ-CAB-CODE.
           MOVE RSP50-O-LOCALITY-CODE   
                                    TO RSP22-I-LOCALITY-CODE.   
           MOVE MCAVL1-CURRENCY-CODE
                                    TO RSP22-I-CURRENCY-CODE.   
           MOVE RSP50-O-CUSTOMER-CODE   
                                    TO RSP22-I-CUSTOMER-CODE.   
           MOVE RSP50-O-CONNECTION-CODE 
                                    TO RSP22-I-CONNECTION-CODE. 
           MOVE RSP51-O-PRC-XCHG-RATE   
                                    TO RSP22-I-PRC-XCHG-RATE.   
           MOVE 'I'                 TO RSP22-I-BOOK-TYPE.   
           MOVE RSP50-O-CUSTOMER-NUM TO RSP22-I-CUSTOMER-NUM.   

           CALL 'RSO22PAY' USING     DPP01-COMMON-DATA-FIELDS   
                                     DPP01-COMMON-INFO  
                                     RSP22-INPUT-PARAMS 
                                     RSP22-OUTPUT-PARAMS
                                     RSP90-OVERRIDE-FLAGS-INFO. 

           IF  DPP01-SUB-MSG-CTR > ZERO AND 
               DPP01-SUB-MSG-STATUS (1) > 1 
               GO TO 9500-RETURN-SUBROUTINE-ERROR   
           END-IF.  

           PERFORM VARYING WS-PAY-SUB FROM 1 BY 1   
                   UNTIL WS-PAY-SUB > RSP22-O-TERM-CNT  
                IF RSP22-O-TERM-CODE (WS-PAY-SUB) = 'F' 
                   IF RSP86-O-LOCALITY-CODE <= SPACES   
                      MOVE SPACES                TO RSP86-INPUT-PARAMS  
                      IF SSP03-O-LOCALITY-CODE > SPACES 
                         MOVE SSP03-O-LOCALITY-CODE 
                                               TO RSP86-I-LOCALITY-CODE 
                      ELSE  
                         MOVE RSP50-O-LOCALITY-CODE 
                                               TO RSP86-I-LOCALITY-CODE 
                      END-IF
                      CALL 'RSC86GLD' USING DPP01-COMMON-DATA-FIELDS
                                            DPP01-COMMON-INFO   
                                            RSP86-INPUT-PARAMS  
                                            RSP86-OUTPUT-PARAMS 
                      IF DPP01-SUB-MSG-CTR > 0 AND  
                                        DPP01-SUB-MSG-STATUS (01) > 1   

                         ADD 1  TO CCMV-ADV-SUB 
                         MOVE DPP01-SUB-MSG-SOURCE (01) 
                           TO MSGHDR-ADVISE-SOURCE (CCMV-ADV-SUB)   

                         MOVE DPP01-SUB-MSG-INDEX (01)  
                           TO MSGHDR-ADVISE-NUM  (CCMV-ADV-SUB) 

                         PERFORM CCP75-OUTPUT-CCERRMSG THRU 
                                 CCP75-OUTPUT-CCERRMSG-EXIT 
                         GO TO 9000-END-OF-JOB  
                      END-IF
                   END-IF   
                   IF RSP86-O-TIME-ZONE-CODE = 'AET'
                      PERFORM DPP10-INIT-TMZ-VARS THRU  
                              DPP10-INIT-TMZ-VARS-EXIT  
                      MOVE RSP22-O-PMT-DATE-N (WS-PAY-SUB)  
                                          TO DPP02-TMZ-INP-DATE 
                      MOVE RSP22-O-PMT-TIME-N (WS-PAY-SUB)  
                                          TO DPP02-TMZ-INP-TIME8 (1:4)  
                      MOVE 'USD'          TO DPP02-TMZ-FRM-BASE-CURRENCY
                      MOVE 'AUD'          TO DPP02-TMZ-TO-BASE-CURRENCY 
                      PERFORM DPP10-CHANGE-TIMEZONE THRU
                              DPP10-CHANGE-TIMEZONE-EXIT
                      IF DPP02-TMZ-ERROR-NUM > 0
                         ADD 1            TO CCMV-ADV-SUB   
                         MOVE 'DPP10TMZ'  TO MSGHDR-ADVISE-SOURCE   
                                                          (CCMV-ADV-SUB)
                         MOVE DPP02-TMZ-ERROR-NUM   
                                          TO MSGHDR-ADVISE-NUM  
                                                          (CCMV-ADV-SUB)
                         PERFORM CCP75-OUTPUT-CCERRMSG THRU 
                                 CCP75-OUTPUT-CCERRMSG-EXIT 
                         GO TO 9000-END-OF-JOB  
                      END-IF
                      MOVE DPP02-TMZ-OUT-DATE  TO DPP02-YYYYMMDD-DATE   
                      MOVE DPP02-TMZ-OUT-TIME (1:4) 
                                               TO MCASAV-OPTION-TIME
                   ELSE 
                      MOVE RSP22-O-PMT-DATE-N (WS-PAY-SUB)  
                                               TO DPP02-YYYYMMDD-DATE   
                      MOVE RSP22-O-PMT-TIME-N (WS-PAY-SUB)  
                                               TO MCASAV-OPTION-TIME
                   END-IF   
                   PERFORM DPP10-YYYYMMDD-TO-MMDDYYYY   
                   MOVE DPP02-MMDDYYYY-DATE    TO MCASAV-OPTION-DATE
                   MOVE RSP86-O-TIME-ZONE-CODE TO MCASAV-OPTION-TZONE   
                   IF SSP03-O-GMT-TIME-FLG = 1  
                      MOVE RSP22-O-PMT-DATE-N (WS-PAY-SUB)  
                                    TO DPP02-ET-DATE
                      MOVE RSP22-O-PMT-TIME-N (WS-PAY-SUB)  
                                    TO DPP02-ET-TIME
                      MULTIPLY 10000 BY DPP02-ET-TIME   
                      PERFORM DPP10-GMT 
                      MOVE DPP02-GMT-DATE   
                                    TO DPP02-YYYYMMDD-DATE  
                      PERFORM DPP10-YYYYMMDD-TO-MMDDYYYY
                      MOVE DPP02-MMDDYYYY-DATE  
                                    TO MCASAV-OPTION-DATE   
                      MOVE DPP02-GMT-TIME (1:4) 
                                    TO MCASAV-OPTION-TIME   
                      MOVE 'GMT'    TO MCASAV-OPTION-TZONE  
                   END-IF   
                   MOVE WS-PAY-SUB  TO RSP22-O-TERM-CNT 
                END-IF  
           END-PERFORM. 

           MOVE 'Y'                 TO WS-22PAY-CALL-FLAG.  

       2500-CONTINUE.   

           MOVE RSP54-OC-CATEGORY-CODE (C1) 
                                       TO   
                           WS-RCP-CATEGORY-CODE (REQ-CABSUB REQ-CATSUB).
           MOVE RSP54-OC-CPA-CATEGORY-CODE (C1 1)   
                                       TO   
                            WS-RCP-CPA-CAT-CODE (REQ-CABSUB REQ-CATSUB).
           MOVE WS-CAT-OCC-TYPE        TO   
                            WS-RCP-CAT-OCC-TYPE (REQ-CABSUB REQ-CATSUB).

           PERFORM VARYING WS-OCC-SUB FROM 1 BY 1 UNTIL WS-OCC-SUB > 5  
                 IF RSP54-OC-OCC-INDS (C1 1) (WS-OCC-SUB:1) = 'Y'   
                   MOVE  WS-OCC-SUB    TO   
                             WS-RCP-CAT-MAX-PAX (REQ-CABSUB REQ-CATSUB) 
                 END-IF 
           END-PERFORM. 

           PERFORM VARYING WS-OCC-SUB FROM 1 BY 1 UNTIL WS-OCC-SUB > 5  
                 IF RSP54-OC-OCC-INDS (C1 1) (WS-OCC-SUB:1) = 'Y'   
                   MOVE  WS-OCC-SUB    TO   
                              WS-RCP-CAT-MIN-PAX (REQ-CABSUB REQ-CATSUB)
                   MOVE 5              TO WS-OCC-SUB
                 END-IF 
           END-PERFORM. 

           MOVE 'N'                    TO   
                               WS-RCP-INFO-MSG (REQ-CABSUB REQ-CATSUB). 
           IF  WS-RCP-CAT-MIN-PAX (REQ-CABSUB REQ-CATSUB) > 1   
               MOVE 'Y'                TO   
                                WS-RCP-INFO-MSG (REQ-CABSUB REQ-CATSUB) 
           END-IF.  

           MOVE ZEROES                 TO   
                           WS-RCP-AVG-ADDON-AMT (REQ-CABSUB REQ-CATSUB).

           MOVE ZEROES                 TO WS-FEE-AMT
                                          WS-EXTRA-FEE-AMT. 
           PERFORM VARYING WS-FEE-SUB FROM 1 BY 1   
                   UNTIL WS-FEE-SUB > RSP51-O-FEE-CNT   
CALFEE        IF RSP51-O-INCL-CRS-IND (WS-FEE-SUB) = 0  
                COMPUTE WS-FEE-AMT ROUNDED = WS-FEE-AMT 
                               + (RSP51-O-FEE-AMT(WS-FEE-SUB) * 
                                  RSP51-O-PRC-XCHG-RATE)
                COMPUTE WS-EXTRA-FEE-AMT ROUNDED = WS-EXTRA-FEE-AMT 
                             + (RSP51-O-FEE-EXTRA-AMT (WS-FEE-SUB) *
                                RSP51-O-PRC-XCHG-RATE)  
CALFEE        END-IF
           END-PERFORM. 
           EVALUATE O1  
              WHEN 2
                  COMPUTE WS-FEE-AMT = WS-FEE-AMT * 2   
              WHEN 3
                  COMPUTE WS-FEE-AMT = ( WS-FEE-AMT * 2 )   
                                         + WS-EXTRA-FEE-AMT 
              WHEN 4
                  COMPUTE WS-FEE-AMT = ( WS-FEE-AMT * 2 )   
                                         + (WS-EXTRA-FEE-AMT * 2)   
              WHEN 5
                  COMPUTE WS-FEE-AMT = ( WS-FEE-AMT * 2 )   
                                         + (WS-EXTRA-FEE-AMT * 3)   
           END-EVALUATE.

           MOVE ZEROES                 TO WS-RSP54-CRUISE-AMT   
CALFEE                                    WS-RSP54-INCL-FEE-AMT 
                                          WS-RSP54-NON-COMM-AMT.
           PERFORM VARYING WS-AMT-SUB FROM 1 BY 1   
                   UNTIL WS-AMT-SUB > O1
                  ADD RSP54-OC-CRUISE-AMT (C1 1 WS-AMT-SUB) 
                                       TO WS-RSP54-CRUISE-AMT   
                  ADD RSP54-OC-NON-COMM-AMT (C1 1 WS-AMT-SUB)   
                                       TO WS-RSP54-NON-COMM-AMT 
CALFEE            ADD RSP54-OC-CRS-FARE-FEE-AMT (C1 1 WS-AMT-SUB)   
CALFEE                                 TO WS-RSP54-INCL-FEE-AMT 
           END-PERFORM. 

           COMPUTE WS-RCP-TOT-CRUISE-FARE-AMT (REQ-CABSUB REQ-CATSUB) = 
                   WS-RSP54-CRUISE-AMT   +  
CALFEE             WS-RSP54-INCL-FEE-AMT +  
                   WS-RSP54-NON-COMM-AMT.   

           COMPUTE WS-RCP-AVG-CRUISE-FARE-AMT (REQ-CABSUB REQ-CATSUB) = 
                   (WS-RCP-TOT-CRUISE-FARE-AMT (REQ-CABSUB REQ-CATSUB)  
                    / O1 ). 

           COMPUTE WS-RCP-GROSS-AMT (REQ-CABSUB REQ-CATSUB) =   
                   WS-RSP54-CRUISE-AMT   +  
CALFEE             WS-RSP54-INCL-FEE-AMT +  
                   WS-RSP54-NON-COMM-AMT +  
                   WS-FEE-AMT.  

           COMPUTE WS-RCP-AVG-GROSS-AMT (REQ-CABSUB REQ-CATSUB) =   
                   (WS-RCP-GROSS-AMT (REQ-CABSUB REQ-CATSUB) / O1). 

           GO TO 2500-NEXT-CATEGORY.

       2600-BUILD-BEST-URM-RECIPE.  

231005     MOVE WS-INP-CABIN-COUNT     TO WS-CONNECT-CANDIDATE-LIMIT.   
231005     IF MCAVL1-CONNECT-REQ-IND = 'Y'  
231005        MOVE 125                 TO WS-CONNECT-CANDIDATE-LIMIT
231005     END-IF.  

           MOVE LOW-VALUES             TO WS-FIND-BEST-RECIPE-MATRIX.   
           MOVE ZERO                   TO ZSUB. 
           MOVE WS-URM-ZONE-META-CNT   TO WS-RCP-MTRX-ZONE-CNT. 

       2700-NEXT-ZONE.  

           ADD 1                       TO ZSUB. 

           IF ZSUB > WS-URM-ZONE-META-CNT   
              GO TO 3600-FIND-BEST-URM-RECIPE   
           END-IF.  

           MOVE WS-URM-DECK-NUM (ZSUB) TO WS-RCP-MTRX-DECK-NUM (ZSUB).  
           MOVE WS-URM-DECK-CODE (ZSUB) 
                                       TO WS-RCP-MTRX-DECK-CODE (ZSUB). 
           MOVE WS-URM-FMA-IND (ZSUB)  TO WS-RCP-MTRX-FMA-IND (ZSUB).   
           MOVE WS-URM-META-CAT-CODE (ZSUB) 
                                       TO   
                                      WS-RCP-MTRX-META-CAT-CODE (ZSUB). 
           MOVE WS-URM-BP-CNT          TO   
                                      WS-RCP-MTRX-BEST-PRICE-CNT(ZSUB). 

           MOVE ZERO                   TO CATSUB
                                          MTRX-CABSUB   
                                          WS-RCP-MTRX-CABIN-CNT (ZSUB). 

       2800-NEXT-CATEGORY.  

           ADD 1                       TO CATSUB.   

           IF CATSUB > WS-URM-META-CAT-CNT (ZSUB)   
              GO TO 2700-NEXT-ZONE  
           END-IF.  

           MOVE ZERO                   TO R1
                                          CABSUB
                                          MTRX-RSUB.
           MOVE LOW-VALUES             TO WS-HOLD-MTRX-RATE-INFO.   

       2900-FIND-RATE-OCC.  

           ADD 1                       TO R1.   

           IF R1 > WS-RCP-RATE-CNT  
              GO TO 3100-FIND-NEXT-RATE-CAT 
           END-IF.  

           MOVE ZERO                   TO C1.   

       3000-FIND-NEXT-RATE-CAT. 
           ADD 1                       TO C1.   

           IF C1 > WS-RCP-CATEGORY-CNT (R1) 
              GO TO 2900-FIND-RATE-OCC  
           END-IF.  

           IF WS-RCP-CATEGORY-CODE (R1 C1) NOT =
              WS-URM-CAT-CODE(ZSUB CATSUB)  
              GO TO 3000-FIND-NEXT-RATE-CAT 
           END-IF.  

231005     MOVE WS-RCP-REQ-NUM (R1)    TO WS-CONNECT-REQ-SUB.   
231005     IF WS-CONNECT-REQ-SUB < 1 OR 
231005        WS-CONNECT-REQ-SUB > WS-INP-CABIN-COUNT   
231005        GO TO 2900-FIND-RATE-OCC  
231005     END-IF.  
231005     IF MCAVL1-CONNECT-REQ-IND = 'Y'  
231005        IF MCACIN-CAT-CODE (WS-CONNECT-REQ-SUB) > SPACES  
231005           IF WS-RCP-CATEGORY-CODE (R1 C1) NOT =  
231005              MCACIN-CAT-CODE (WS-CONNECT-REQ-SUB)
231005              GO TO 3000-FIND-NEXT-RATE-CAT   
231005           END-IF 
231005        END-IF
231005     END-IF.  

           IF (WS-RCP-REQ-OCC (R1) >= WS-RCP-CAT-MIN-PAX(R1 C1)) AND
              (WS-RCP-REQ-OCC (R1) <= WS-RCP-CAT-MAX-PAX (R1 C1))   
              CONTINUE  
           ELSE 
              GO TO 2900-FIND-RATE-OCC  
           END-IF.  

           ADD 1                       TO MTRX-RSUB 
                                          WS-HOLD-MTRX-RATE-CNT.
           MOVE WS-RCP-CATEGORY-CODE (R1 C1)
                                       TO   
                                      WS-HOLD-MTRX-CAT-CODE (MTRX-RSUB).
           MOVE WS-RCP-CPA-CAT-CODE (R1 C1) 
                                       TO   
                                  WS-HOLD-MTRX-CPA-CAT-CODE (MTRX-RSUB).
           MOVE WS-RCP-CAT-MIN-PAX(R1 C1)   
                                       TO   
                                   WS-HOLD-MTRX-CAT-MIN-PAX (MTRX-RSUB).
           MOVE WS-RCP-CAT-MAX-PAX(R1 C1)   
                                       TO   
                                   WS-HOLD-MTRX-CAT-MAX-PAX (MTRX-RSUB).
           MOVE WS-RCP-CATEGORY-AMTS (R1 C1)
                                       TO WS-HOLD-MTRX-AMTS (MTRX-RSUB).
           MOVE WS-RCP-OFFER-CODE (R1) TO   
                                     WS-HOLD-MTRX-OFFER-CODE(MTRX-RSUB).
           MOVE WS-RCP-REQ-OCC (R1)    TO   
                                      WS-HOLD-MTRX-REQ-OCC (MTRX-RSUB). 
           MOVE WS-RCP-REQ-NUM (R1)    TO   
                                       WS-HOLD-MTRX-REQ-NUM (MTRX-RSUB).
           MOVE WS-RCP-CAT-OCC-TYPE (R1 C1) 
                                       TO   
                                  WS-HOLD-MTRX-CAT-OCC-TYPE (MTRX-RSUB).
           MOVE WS-RCP-INFO-MSG (R1 C1) 
                                       TO WS-HOLD-INFO-MSG (MTRX-RSUB). 
           GO TO 2900-FIND-RATE-OCC.

       3100-FIND-NEXT-RATE-CAT. 

           ADD 1                       TO CABSUB.   

           IF CABSUB > WS-URM-CABIN-CNT (ZSUB CATSUB)   
              GO TO 2800-NEXT-CATEGORY  
           END-IF.  

           MOVE ZERO                   TO BPSUB.

       3200-NEXT-BEST-PRICE.

           ADD 1                       TO BPSUB.

           IF BPSUB > WS-RCP-MTRX-BEST-PRICE-CNT (ZSUB) 
              GO TO 3100-FIND-NEXT-RATE-CAT 
           END-IF.  

           MOVE BPSUB                  TO   
                                 WS-RCP-MTRX-BEST-PRICE-VAL(ZSUB BPSUB).

           MOVE ZERO                   TO RATE-SUB. 

       3300-ADD-NEXT-RATE-OCC.  

           ADD 1                       TO RATE-SUB. 

           IF RATE-SUB > WS-HOLD-MTRX-RATE-CNT  
              GO TO 3200-NEXT-BEST-PRICE
           END-IF.  

           MOVE SPACES                 TO WS-RATE-EXISTS.   
           PERFORM VARYING WS-SUB FROM 1 BY 1   
             UNTIL WS-SUB > WS-RCP-MTRX-RATE-CNT (ZSUB BPSUB)   
               IF (WS-HOLD-MTRX-OFFER-CODE(RATE-SUB) =  
                   WS-RCP-MTRX-OFFER-CODE (ZSUB BPSUB WS-SUB)) AND  
                  (WS-HOLD-MTRX-REQ-OCC(RATE-SUB) = 
                   WS-RCP-MTRX-REQ-OCC(ZSUB BPSUB WS-SUB)) AND  
                  ( WS-HOLD-MTRX-REQ-NUM (RATE-SUB) =   
                    WS-RCP-MTRX-REQ-NUM (ZSUB BPSUB WS-SUB) )   

                  MOVE WS-SUB          TO RSUB  
                  MOVE 'Y'             TO WS-RATE-EXISTS
                  MOVE WS-RCP-MTRX-RATE-CNT (ZSUB BPSUB)
                                       TO WS-SUB
               END-IF   
           END-PERFORM. 

           IF WS-RATE-EXISTS NOT = 'Y'  
              ADD 1                    TO   
                                      WS-RCP-MTRX-RATE-CNT (ZSUB BPSUB) 
              MOVE WS-RCP-MTRX-RATE-CNT (ZSUB BPSUB)
                                       TO RSUB  
              MOVE WS-HOLD-MTRX-OFFER-CODE (RATE-SUB)   
                                       TO   
                                 WS-RCP-MTRX-OFFER-CODE(ZSUB BPSUB RSUB)
              MOVE WS-HOLD-MTRX-REQ-OCC (RATE-SUB)  
                                       TO   
                                   WS-RCP-MTRX-REQ-OCC (ZSUB BPSUB RSUB)
              MOVE WS-HOLD-MTRX-REQ-NUM (RATE-SUB)  
                                       TO   
                                   WS-RCP-MTRX-REQ-NUM (ZSUB BPSUB RSUB)
              MOVE ZERO                TO MTRX-CABSUB   
                                          WS-RATE-CABIN-CNT(BPSUB RSUB).


       3400-CHECK-CABIN-OCC.

           MOVE WS-URM-NORMAL-CAP (ZSUB CATSUB CABSUB)  
                                       TO WS-OCC.   
           MOVE WS-URM-CAT-RESTRICT-TYPE (ZSUB CATSUB WS-OCC)   
                                       TO   
                                   WS-HOLD-MTRX-CAT-OCC-TYPE (RATE-SUB).
           IF (WS-HOLD-MTRX-REQ-OCC(RATE-SUB) > 
               WS-URM-MAX-CAP (ZSUB CATSUB CABSUB)) AND 
              (TDP01-SPOILAGE-CODE = ' ')   
231005        IF MCAVL1-CONNECT-REQ-IND = 'Y'   
231005           GO TO 3300-ADD-NEXT-RATE-OCC   
231005        ELSE  
                 GO TO 3100-FIND-NEXT-RATE-CAT  
231005        END-IF
           END-IF.  

204924*    IF WS-HOLD-MTRX-CAT-OCC-TYPE (RATE-SUB) NOT > SPACES 
204924     IF WS-HOLD-MTRX-CAT-OCC-TYPE (RATE-SUB) = SPACES 
              IF ((WS-URM-NORMAL-CAP (ZSUB CATSUB CABSUB) >=
                  WS-HOLD-MTRX-CAT-MIN-PAX (RATE-SUB) ) AND 
                  (WS-URM-NORMAL-CAP (ZSUB CATSUB CABSUB) <=
                  WS-HOLD-MTRX-CAT-MAX-PAX (RATE-SUB) )) OR 
                  ((WS-URM-MAX-CAP (ZSUB CATSUB CABSUB) >=  
                  WS-HOLD-MTRX-CAT-MIN-PAX (RATE-SUB) ) AND 
                  (WS-URM-MAX-CAP (ZSUB CATSUB CABSUB) <=   
                  WS-HOLD-MTRX-CAT-MAX-PAX (RATE-SUB) ))
                  GO TO 3500-ADD-CABIN-TO-RATE  
               ELSE 
                 GO TO 3300-ADD-NEXT-RATE-OCC   
               END-IF   
           END-IF.  

           IF WS-HOLD-MTRX-CAT-OCC-TYPE (RATE-SUB) > SPACES 
              IF WS-HOLD-MTRX-CAT-OCC-TYPE (RATE-SUB) = 'M' 
                 IF WS-HOLD-MTRX-REQ-OCC(RATE-SUB) > 1  
                    IF WS-HOLD-MTRX-REQ-OCC(RATE-SUB) NOT = 
                       WS-URM-MAX-CAP (ZSUB CATSUB CABSUB)  
                       GO TO 3300-ADD-NEXT-RATE-OCC 
                    END-IF  
                 ELSE   
                   IF WS-URM-MAX-CAP (ZSUB CATSUB CABSUB) > 2   
                      GO TO 3300-ADD-NEXT-RATE-OCC  
                   END-IF   
                 END-IF 
                 GO TO 3500-ADD-CABIN-TO-RATE   
              END-IF
           END-IF.  

           IF WS-HOLD-MTRX-CAT-OCC-TYPE (RATE-SUB) = 'N'
              IF WS-HOLD-MTRX-REQ-OCC (RATE-SUB) > 1
                 IF ( WS-URM-NORMAL-CAP (ZSUB CATSUB CABSUB) =  
                     ( WS-HOLD-MTRX-REQ-OCC (RATE-SUB) )) OR
                     ( WS-URM-MAX-CAP (ZSUB CATSUB CABSUB) =
                     ( WS-HOLD-MTRX-REQ-OCC (RATE-SUB) ))   
                     GO TO 3500-ADD-CABIN-TO-RATE   
                  ELSE  
                    GO TO 3300-ADD-NEXT-RATE-OCC
                 END-IF 
              ELSE  
                 IF WS-URM-NORMAL-CAP (ZSUB CATSUB CABSUB) = 2  
                    GO TO 3500-ADD-CABIN-TO-RATE
                 ELSE   
                    GO TO 3300-ADD-NEXT-RATE-OCC
                 END-IF 
              END-IF
           END-IF.  

           EVALUATE WS-HOLD-MTRX-CAT-OCC-TYPE (RATE-SUB)
            WHEN '1' MOVE 1            TO WS-SPOIL-CNT  
            WHEN '2' MOVE 2            TO WS-SPOIL-CNT  
            WHEN '3' MOVE 3            TO WS-SPOIL-CNT  
            WHEN OTHER MOVE ZERO       TO WS-SPOIL-CNT  
           END-EVALUATE.

           IF ( WS-URM-MAX-CAP (ZSUB CATSUB CABSUB) >=  
                WS-HOLD-MTRX-REQ-OCC (RATE-SUB)  )      AND 
              ( WS-URM-NORMAL-CAP (ZSUB CATSUB CABSUB) <=   
                ( WS-HOLD-MTRX-REQ-OCC (RATE-SUB)   
                                    + WS-SPOIL-CNT ) )  
              GO TO 3500-ADD-CABIN-TO-RATE  
           ELSE 
              GO TO 3300-ADD-NEXT-RATE-OCC  
           END-IF.  

       3500-ADD-CABIN-TO-RATE.  

231005*    DO NOT USE CONNECTED-MODE MATRIX POSITIONS FOR CABINS
231005*    THAT HAVE NO CONNECTING-CABIN NUMBER.
231005     IF MCAVL1-CONNECT-REQ-IND = 'Y' AND  
231005        WS-URM-CONNECT-CAB-NUM (ZSUB CATSUB CABSUB) NOT > SPACES  
231005        GO TO 3300-ADD-NEXT-RATE-OCC  
231005     END-IF.  

231005     MOVE WS-HOLD-MTRX-REQ-NUM (RATE-SUB)
231005                                 TO WS-CONNECT-REQ-SUB.
231005 
231005     IF WS-CONNECT-REQ-SUB < 1 OR
231005        WS-CONNECT-REQ-SUB > WS-INP-CABIN-COUNT
231005        GO TO 3300-ADD-NEXT-RATE-OCC
231005     END-IF.
231005 
231005     IF MCACIN-CABIN-TYPE (WS-CONNECT-REQ-SUB) > SPACES
231005        MOVE SPACES              TO WS-CANDIDATE-CABIN-TYPE
231005        STRING MCAVL1-SHIP-CODE
231005               WS-URM-META-CAT-CODE (ZSUB)
231005               WS-URM-SPL-CAT-CODE (ZSUB CATSUB CABSUB)
231005               WS-URM-VIEW-IND (ZSUB CATSUB CABSUB)
231005          DELIMITED BY SIZE
231005          INTO WS-CANDIDATE-CABIN-TYPE
231005        IF WS-CANDIDATE-CABIN-TYPE NOT =
231005           MCACIN-CABIN-TYPE (WS-CONNECT-REQ-SUB)
231005           GO TO 3300-ADD-NEXT-RATE-OCC
231005        END-IF
231005     END-IF.

           ADD 1                       TO WS-RATE-CABIN-CNT(BPSUB RSUB).
           MOVE WS-RATE-CABIN-CNT(BPSUB RSUB)   
                                       TO MTRX-CABSUB.  

           MOVE SPACES                 TO WS-MOVE-CABIN 
           PERFORM VARYING WS-SUB FROM 1 BY 1   
             UNTIL WS-SUB > WS-RCP-MTRX-RATE-CABIN-CNT(ZSUB BPSUB RSUB) 

              IF WS-RCP-MTRX-BEST-PRICE-VAL (ZSUB BPSUB) = 1
                 IF WS-HOLD-MTRX-AVG-GROSS-AMT (RATE-SUB) < 
                    WS-RCP-MTRX-AVG-GROSS-AMT   
                    (ZSUB BPSUB RSUB WS-SUB)
                    MOVE WS-SUB        TO MTRX-CABSUB   
                    MOVE 'Y'           TO WS-MOVE-CABIN 
                    MOVE WS-RCP-MTRX-RATE-CABIN-CNT(ZSUB BPSUB RSUB)
                                       TO WS-SUB
                 ELSE   
                  IF WS-HOLD-MTRX-AVG-GROSS-AMT (RATE-SUB) =
                     WS-RCP-MTRX-AVG-GROSS-AMT (ZSUB BPSUB RSUB WS-SUB) 
                     IF WS-URM-NORMAL-CAP (ZSUB CATSUB CABSUB) <
                        WS-RCP-MTRX-NORMAL-CAP (ZSUB BPSUB RSUB WS-SUB) 
                        MOVE WS-SUB    TO MTRX-CABSUB   
                        MOVE 'Y'       TO WS-MOVE-CABIN 
                        MOVE WS-RCP-MTRX-RATE-CABIN-CNT(ZSUB BPSUB RSUB)
                                       TO WS-SUB
                     END-IF 
                  END-IF
                 END-IF 
              ELSE  
                IF WS-RCP-MTRX-BEST-PRICE-VAL (ZSUB BPSUB) = 2  
                 IF WS-HOLD-MTRX-AVG-GROSS-AMT (RATE-SUB) > 
                      WS-RCP-MTRX-AVG-GROSS-AMT 
                      (ZSUB BPSUB RSUB WS-SUB)  
                      MOVE WS-SUB      TO MTRX-CABSUB   
                      MOVE 'Y'         TO WS-MOVE-CABIN 
                      MOVE WS-RCP-MTRX-RATE-CABIN-CNT(ZSUB BPSUB RSUB)  
                                       TO WS-SUB
                 ELSE   
                    IF WS-HOLD-MTRX-AVG-GROSS-AMT (RATE-SUB) =  
                       WS-RCP-MTRX-AVG-GROSS-AMT(ZSUB BPSUB RSUB WS-SUB)
                     IF WS-URM-NORMAL-CAP (ZSUB CATSUB CABSUB) <
                        WS-RCP-MTRX-NORMAL-CAP (ZSUB BPSUB RSUB WS-SUB) 
                        MOVE WS-SUB    TO MTRX-CABSUB   
                        MOVE 'Y'       TO WS-MOVE-CABIN 
                        MOVE WS-RCP-MTRX-RATE-CABIN-CNT(ZSUB BPSUB RSUB)
                                       TO WS-SUB
                     END-IF 
                    END-IF  
                   END-IF   
                END-IF  
              END-IF

           END-PERFORM. 

           IF WS-MOVE-CABIN NOT = 'Y' AND   
231005*       ( WS-RATE-CABIN-CNT(BPSUB RSUB) > WS-INP-CABIN-COUNT )
231005        ( WS-RATE-CABIN-CNT(BPSUB RSUB) > 
231005                                  WS-CONNECT-CANDIDATE-LIMIT )
              GO TO 3300-ADD-NEXT-RATE-OCC  
           END-IF   

231005*    IF WS-RATE-CABIN-CNT(BPSUB RSUB) > WS-INP-CABIN-COUNT
231005*       MOVE WS-INP-CABIN-COUNT  TO   
231005     IF WS-RATE-CABIN-CNT(BPSUB RSUB) > WS-CONNECT-CANDIDATE-LIMIT
231005        MOVE WS-CONNECT-CANDIDATE-LIMIT   
231005                                 TO   
                            WS-RCP-MTRX-RATE-CABIN-CNT(ZSUB BPSUB RSUB) 
           ELSE 
              MOVE WS-RATE-CABIN-CNT(BPSUB RSUB)
                                       TO   
                           WS-RCP-MTRX-RATE-CABIN-CNT(ZSUB BPSUB RSUB)  
           END-IF.  

           IF WS-MOVE-CABIN  = 'Y' AND  
231005*       ( MTRX-CABSUB NOT = WS-INP-CABIN-COUNT )  
231005        ( MTRX-CABSUB NOT = WS-CONNECT-CANDIDATE-LIMIT )  

              MOVE WS-RCP-MTRX-RATE-CABIN-CNT (ZSUB BPSUB RSUB) 
                                       TO WS-SUB2   
              PERFORM VARYING WS-SUB FROM WS-SUB2 BY -1 
                UNTIL WS-SUB <= MTRX-CABSUB 

                COMPUTE WS-SUB3 = WS-SUB - 1

                MOVE WS-RCP-MTRX-CPA-CAT-CODE (ZSUB BPSUB RSUB WS-SUB3) 
                                       TO   
                       WS-RCP-MTRX-CPA-CAT-CODE (ZSUB BPSUB RSUB WS-SUB)

                MOVE WS-RCP-MTRX-AMTS (ZSUB BPSUB RSUB WS-SUB3 )
                                       TO   
                             WS-RCP-MTRX-AMTS (ZSUB BPSUB RSUB WS-SUB ) 
                MOVE WS-RCP-MTRX-NORMAL-CAP (ZSUB BPSUB RSUB WS-SUB3 )  
                                       TO   
                        WS-RCP-MTRX-NORMAL-CAP (ZSUB BPSUB RSUB WS-SUB )
                MOVE WS-RCP-MTRX-MAX-CAP (ZSUB BPSUB RSUB WS-SUB3 ) 
                                       TO   
                           WS-RCP-MTRX-MAX-CAP (ZSUB BPSUB RSUB WS-SUB )
                MOVE WS-RCP-MTRX-CONNECT-CAB-NUM
                     (ZSUB BPSUB RSUB WS-SUB3)  
                                       TO   
                     WS-RCP-MTRX-CONNECT-CAB-NUM(ZSUB BPSUB RSUB WS-SUB)
                MOVE WS-RCP-MTRX-PORT-STAR-CODE(ZSUB BPSUB RSUB WS-SUB3)
                                       TO   
                     WS-RCP-MTRX-PORT-STAR-CODE (ZSUB BPSUB RSUB WS-SUB)
                MOVE WS-RCP-MTRX-DISPLAY-SEQ (ZSUB BPSUB RSUB WS-SUB3)  
                                       TO   
                        WS-RCP-MTRX-DISPLAY-SEQ (ZSUB BPSUB RSUB WS-SUB)
                MOVE WS-RCP-MTRX-CABIN-NUM (ZSUB BPSUB RSUB WS-SUB3)
                                       TO   
                         WS-RCP-MTRX-CABIN-NUM (ZSUB BPSUB RSUB WS-SUB) 
                MOVE WS-RCP-MTRX-IS-OS-IND (ZSUB BPSUB RSUB WS-SUB3)
                                       TO   
                     WS-RCP-MTRX-IS-OS-IND (ZSUB BPSUB RSUB WS-SUB) 
                MOVE WS-RCP-MTRX-CAT-CODE (ZSUB BPSUB RSUB WS-SUB3) 
                                       TO   
                      WS-RCP-MTRX-CAT-CODE (ZSUB BPSUB RSUB WS-SUB) 
                MOVE WS-RCP-MTRX-INFO-MSG (ZSUB BPSUB RSUB WS-SUB3) 
                                       TO   
                        WS-RCP-MTRX-INFO-MSG (ZSUB BPSUB RSUB WS-SUB)   
                MOVE WS-RCP-MTRX-SPL-CAT-CODE (ZSUB BPSUB RSUB WS-SUB3) 
                                       TO   
                       WS-RCP-MTRX-SPL-CAT-CODE (ZSUB BPSUB RSUB WS-SUB)
                MOVE WS-RCP-MTRX-VIEW-IND  (ZSUB BPSUB RSUB WS-SUB3)
                                       TO   
                          WS-RCP-MTRX-VIEW-IND  (ZSUB BPSUB RSUB WS-SUB)
              END-PERFORM   

           END-IF.  

           MOVE WS-HOLD-MTRX-CPA-CAT-CODE (RATE-SUB)
                                       TO   
                 WS-RCP-MTRX-CPA-CAT-CODE (ZSUB BPSUB RSUB MTRX-CABSUB).
           MOVE WS-HOLD-MTRX-AMTS (RATE-SUB)
                                       TO   
                        WS-RCP-MTRX-AMTS (ZSUB BPSUB RSUB MTRX-CABSUB ).
           MOVE WS-HOLD-INFO-MSG (RATE-SUB) 
                                       TO   
                    WS-RCP-MTRX-INFO-MSG (ZSUB BPSUB RSUB MTRX-CABSUB ).
           MOVE WS-URM-NORMAL-CAP (ZSUB CATSUB CABSUB)  
                                       TO   
                  WS-RCP-MTRX-NORMAL-CAP (ZSUB BPSUB RSUB MTRX-CABSUB ).
           MOVE WS-URM-MAX-CAP (ZSUB CATSUB CABSUB) 
                                       TO   
                     WS-RCP-MTRX-MAX-CAP (ZSUB BPSUB RSUB MTRX-CABSUB ).
           MOVE WS-URM-CONNECT-CAB-NUM (ZSUB CATSUB CABSUB) 
                                       TO WS-RCP-MTRX-CONNECT-CAB-NUM   
                                        (ZSUB BPSUB RSUB MTRX-CABSUB ). 
           MOVE WS-URM-PORT-STAR-CODE (ZSUB CATSUB CABSUB)  
                                       TO WS-RCP-MTRX-PORT-STAR-CODE
                                         (ZSUB BPSUB RSUB MTRX-CABSUB ).
           MOVE WS-URM-DISPLAY-SEQ (ZSUB CATSUB CABSUB) 
                                       TO WS-RCP-MTRX-DISPLAY-SEQ   
                                        (ZSUB BPSUB RSUB MTRX-CABSUB ). 
           MOVE WS-URM-CABIN-NUM (ZSUB CATSUB CABSUB)   
                                       TO WS-RCP-MTRX-CABIN-NUM 
                                         (ZSUB BPSUB RSUB MTRX-CABSUB ).
           MOVE WS-URM-IS-OS-IND (ZSUB CATSUB CABSUB)   
                                       TO WS-RCP-MTRX-IS-OS-IND 
                                        (ZSUB BPSUB RSUB MTRX-CABSUB ). 
           MOVE WS-URM-CAT-CODE (ZSUB CATSUB)   
                                       TO WS-RCP-MTRX-CAT-CODE  
                                        (ZSUB BPSUB RSUB MTRX-CABSUB ). 
           MOVE WS-URM-SPL-CAT-CODE  (ZSUB CATSUB CABSUB)   
                                       TO WS-RCP-MTRX-SPL-CAT-CODE  
                                        (ZSUB BPSUB RSUB MTRX-CABSUB).  
           MOVE WS-URM-VIEW-IND (ZSUB CATSUB CABSUB)
                                       TO WS-RCP-MTRX-VIEW-IND  
                                         (ZSUB BPSUB RSUB MTRX-CABSUB ).

           ADD 1                       TO WS-RCP-MTRX-CABIN-CNT(ZSUB).  

           GO TO 3300-ADD-NEXT-RATE-OCC.

       3600-FIND-BEST-URM-RECIPE.   

           MOVE LOW-VALUES             TO HLD-CABIN-TABLE   
                                          WS-ZONE-BP-TABLE. 

           MOVE ZERO                   TO ZSUB WS-BP-CNT
                                          WS-BP-CABIN-TOTAL(1)  
                                          WS-BP-CABIN-TOTAL(2). 

       3700-NEXT-BP-ZONE.   

           ADD 1                       TO ZSUB. 

           IF ZSUB > WS-RCP-MTRX-ZONE-CNT   
              GO TO 4200-DONE-BEST-URM-RECIPE   
           END-IF.  

           MOVE ZERO                   TO BPSUB.

       3800-NEXT-BP-VALUE.  

           ADD  1                      TO BPSUB.

           IF BPSUB > WS-RCP-MTRX-BEST-PRICE-CNT (ZSUB) 
              GO TO 3700-NEXT-BP-ZONE   
           END-IF.  

           IF WS-RCP-MTRX-RATE-CNT(ZSUB BPSUB) NOT = WS-INP-CABIN-COUNT 
              GO TO 3800-NEXT-BP-VALUE  
           END-IF.  

           MOVE SPACES                 TO WS-NO-COMBO.  
           PERFORM VARYING WS-SUB FROM 1 BY 1   
              UNTIL WS-SUB > WS-RCP-MTRX-RATE-CNT(ZSUB BPSUB)   
              IF WS-RCP-MTRX-RATE-CABIN-CNT(ZSUB BPSUB WS-SUB) = ZERO   
                 MOVE 'Y'              TO WS-NO-COMBO   
                 MOVE WS-RCP-MTRX-RATE-CNT(ZSUB BPSUB)  
                                       TO WS-SUB
              END-IF
           END-PERFORM. 

           IF WS-NO-COMBO  = 'Y'
              GO TO 3800-NEXT-BP-VALUE  
           END-IF.  

           MOVE 1                      TO RSUB  
                                          CSUB. 
           MOVE ZERO                   TO HLD-CABIN-CNT.
           MOVE SPACES                 TO WS-HLD-CNT-CHANGED.   


       3900-FIND-NEXT-CABIN.

231005*    PROTECT ALL SUBSCRIPTS BEFORE MATRIX OR HOLD-TABLE ACCESS.   
231005     IF RSUB < 1 OR   
231005        RSUB > WS-RCP-MTRX-RATE-CNT (ZSUB BPSUB)  
231005        GO TO 4100-FIND-NEXT-PATH 
231005     END-IF.  
231005     IF CSUB < 1 OR   
231005        CSUB > WS-RCP-MTRX-RATE-CABIN-CNT 
231005                   (ZSUB BPSUB RSUB)  
231005        GO TO 4100-FIND-NEXT-PATH 
231005     END-IF.  
231005     IF HLD-CABIN-CNT < ZERO OR HLD-CABIN-CNT > 5 
231005        GO TO 3800-NEXT-BP-VALUE  
231005     END-IF.  

           MOVE SPACES                 TO WS-CABIN-EXISTS.  
           PERFORM VARYING WS-SUB FROM 1 BY 1   
             UNTIL WS-SUB > HLD-CABIN-CNT   

             IF WS-RCP-MTRX-CABIN-NUM (ZSUB BPSUB RSUB CSUB) =  
                HLD-CABIN-NUM (WS-SUB)  
                MOVE 'Y'               TO WS-CABIN-EXISTS   
                MOVE HLD-CABIN-CNT     TO WS-SUB
             END-IF 

           END-PERFORM. 

           IF WS-CABIN-EXISTS = 'Y' 

              IF CSUB < WS-RCP-MTRX-RATE-CABIN-CNT(ZSUB BPSUB RSUB) 
                 ADD 1                 TO CSUB  
                 GO TO 3900-FIND-NEXT-CABIN 
              ELSE  
                 GO TO 4100-FIND-NEXT-PATH  
              END-IF
           END-IF.  

231005     IF HLD-CABIN-CNT >= 5
231005        GO TO 4100-FIND-NEXT-PATH 
231005     END-IF.  

           ADD 1                       TO HLD-CABIN-CNT.
           MOVE WS-RCP-MTRX-CABIN-NUM (ZSUB BPSUB RSUB CSUB)
                                       TO HLD-CABIN-NUM(HLD-CABIN-CNT). 
           MOVE WS-RCP-MTRX-CABIN-NUM (ZSUB BPSUB RSUB CSUB)
                                       TO HLD-CABIN-NUM (HLD-CABIN-CNT).
           MOVE RSUB                   TO HLD-RATE-SUB(HLD-CABIN-CNT).  
           MOVE CSUB                   TO HLD-CAB-SUB(HLD-CABIN-CNT).   
           MOVE WS-RCP-MTRX-REQ-NUM (ZSUB BPSUB RSUB)   
                                       TO HLD-REQ-NUM (HLD-CABIN-CNT).  

           IF HLD-CABIN-CNT > 1 
              COMPUTE WS-PRV-CNT = HLD-CABIN-CNT - 1

              COMPUTE HLD-CABIN-TOTAL(HLD-CABIN-CNT) =  
              HLD-CABIN-TOTAL(WS-PRV-CNT) +  WS-RCP-MTRX-AVG-GROSS-AMT  
                                               (ZSUB BPSUB RSUB CSUB)   
              IF HLD-NORMAL-OCC <   
                         WS-RCP-MTRX-NORMAL-CAP (ZSUB BPSUB RSUB CSUB)  
                 MOVE WS-RCP-MTRX-NORMAL-CAP (ZSUB BPSUB RSUB CSUB) 
                                       TO HLD-NORMAL-OCC
              END-IF
           ELSE 
             MOVE WS-RCP-MTRX-NORMAL-CAP (ZSUB BPSUB RSUB CSUB) 
                                       TO HLD-NORMAL-OCC
             MOVE WS-RCP-MTRX-AVG-GROSS-AMT (ZSUB BPSUB RSUB CSUB)  
                                       TO HLD-CABIN-TOTAL(HLD-CABIN-CNT)
           END-IF.  

           IF RSUB < WS-RCP-MTRX-RATE-CNT(ZSUB BPSUB)   
              ADD 1                    TO RSUB  
              MOVE 1                   TO CSUB  
              GO TO 3900-FIND-NEXT-CABIN
           END-IF.  

231005*    FOR CONNECTED MODE, PRICE ONLY COMPLETE RECIPROCAL PAIRS.
231005     IF MCAVL1-CONNECT-REQ-IND = 'Y' AND  
231005        HLD-CABIN-CNT = 2 
231005        PERFORM 3950-VALIDATE-DEFAULT-CON 
231005           THRU 3950-VALIDATE-DEFAULT-CON-EXIT
231005        IF WS-CONNECT-PAIR-VALID-IND NOT = 'Y'
231005           GO TO 4000-CHOOSE-NEXT 
231005        END-IF
231005        PERFORM 3970-COLLECT-DEFAULT-PAIR 
231005           THRU 3970-COLLECT-DEFAULT-PAIR-EXIT
231005        GO TO 4000-CHOOSE-NEXT
231005     END-IF.  

           IF HLD-CABIN-CNT = WS-RCP-MTRX-RATE-CNT(ZSUB BPSUB)  
              IF WS-RCP-MTRX-BEST-PRICE-VAL(ZSUB BPSUB) = 1 
                 IF WS-BP-CABIN-TOTAL(BPSUB) NOT > ZEROES   
                    MOVE HLD-CABIN-TOTAL(HLD-CABIN-CNT) 
                                       TO WS-BP-CABIN-TOTAL(BPSUB)  
                 ELSE   
                   IF HLD-CABIN-TOTAL(HLD-CABIN-CNT) <  
                      WS-BP-CABIN-TOTAL(BPSUB)  
                      MOVE HLD-CABIN-TOTAL(HLD-CABIN-CNT)   
                                       TO WS-BP-CABIN-TOTAL(BPSUB)  
                   ELSE 
                    IF HLD-CABIN-TOTAL(HLD-CABIN-CNT) = 
                        WS-BP-CABIN-TOTAL (BPSUB)   
                     IF HLD-NORMAL-OCC < WS-BP-NORM-OCC (BPSUB) 
                        CONTINUE
                     ELSE   
                        GO TO 4000-CHOOSE-NEXT  
                     END-IF 
                    ELSE
                     GO TO 4000-CHOOSE-NEXT 
                    END-IF  
                   END-IF   
                 END-IF 
              ELSE  
                 IF WS-RCP-MTRX-BEST-PRICE-VAL(ZSUB BPSUB) = 2  
                    IF HLD-CABIN-TOTAL(HLD-CABIN-CNT) > 
                       WS-BP-CABIN-TOTAL(BPSUB) 
                       MOVE HLD-CABIN-TOTAL(HLD-CABIN-CNT)  
                                       TO WS-BP-CABIN-TOTAL(BPSUB)  
                    ELSE
                     IF HLD-CABIN-TOTAL(HLD-CABIN-CNT) =
                         WS-BP-CABIN-TOTAL (BPSUB)  
                      IF HLD-NORMAL-OCC < WS-BP-NORM-OCC (BPSUB)
                         CONTINUE   
                      ELSE  
                         GO TO 4000-CHOOSE-NEXT 
                      END-IF
                     ELSE   
                      GO TO 4000-CHOOSE-NEXT
                     END-IF 
                    END-IF  
                 END-IF 
              END-IF

              MOVE WS-RCP-MTRX-BEST-PRICE-VAL(ZSUB BPSUB)   
                                       TO WS-BP-VALUE (BPSUB)   
              IF WS-BP-CNT NOT > ZEROES 
                 MOVE WS-RCP-MTRX-BEST-PRICE-CNT (ZSUB) 
                                       TO WS-BP-CNT 
              END-IF
              MOVE ZSUB                TO WS-BP-ZONE-SUB(BPSUB) 
              MOVE HLD-CABIN-CNT       TO WS-BP-CABIN-CNT(BPSUB)
              MOVE HLD-NORMAL-OCC      TO WS-BP-NORM-OCC (BPSUB)

              PERFORM VARYING WS-SUB FROM 1 BY 1
                UNTIL WS-SUB > HLD-CABIN-CNT

                MOVE HLD-RATE-SUB(WS-SUB)   
                                       TO WS-BP-RATE-SUB(BPSUB WS-SUB)  
                MOVE HLD-CAB-SUB(WS-SUB)
                                       TO WS-BP-CABIN-SUB(BPSUB WS-SUB) 
                MOVE HLD-REQ-NUM(WS-SUB)
                                       TO WS-BP-REQ-NUM(BPSUB WS-SUB)   
              END-PERFORM   
           END-IF.  

231005     GO TO 4000-CHOOSE-NEXT.  

231005 3950-VALIDATE-DEFAULT-CON.   
231005     MOVE 'N'                    TO WS-CONNECT-PAIR-VALID-IND.
231005     MOVE SPACES                 TO WS-CONNECT-CABIN-1
231005                                    WS-CONNECT-CABIN-2
231005                                    WS-CONNECT-TO-CABIN-1 
231005                                    WS-CONNECT-TO-CABIN-2.
231005  
231005     IF HLD-CABIN-CNT NOT = 2 
231005        GO TO 3950-VALIDATE-DEFAULT-CON-EXIT  
231005     END-IF.  
231005  
231005     MOVE HLD-REQ-NUM (1)        TO WS-CONNECT-REQ-NUM-1. 
231005     MOVE HLD-REQ-NUM (2)        TO WS-CONNECT-REQ-NUM-2. 
231005  
231005*    THE CONNECTED CABINS MUST SATISFY TWO DIFFERENT  
231005*    CABIN REQUEST OCCURRENCES.   
231005     IF WS-CONNECT-REQ-NUM-1 < 1 OR   
231005        WS-CONNECT-REQ-NUM-1 > WS-INP-CABIN-COUNT OR  
231005        WS-CONNECT-REQ-NUM-2 < 1 OR   
231005        WS-CONNECT-REQ-NUM-2 > WS-INP-CABIN-COUNT 
231005        GO TO 3950-VALIDATE-DEFAULT-CON-EXIT  
231005     END-IF.  
231005     IF WS-CONNECT-REQ-NUM-1 = WS-CONNECT-REQ-NUM-2   
231005        GO TO 3950-VALIDATE-DEFAULT-CON-EXIT  
231005     END-IF.  
231005  
231005     MOVE HLD-CABIN-NUM (1)      TO WS-CONNECT-CABIN-1.   
231005     MOVE HLD-CABIN-NUM (2)      TO WS-CONNECT-CABIN-2.   
231005     MOVE HLD-RATE-SUB (1)       TO WS-CONNECT-RATE-SUB-1.
231005     MOVE HLD-RATE-SUB (2)       TO WS-CONNECT-RATE-SUB-2.
231005     MOVE HLD-CAB-SUB (1)        TO WS-CONNECT-CAB-SUB-1. 
231005     MOVE HLD-CAB-SUB (2)        TO WS-CONNECT-CAB-SUB-2. 
231005  
231005     MOVE WS-RCP-MTRX-CONNECT-CAB-NUM 
231005          (ZSUB BPSUB 
231005           WS-CONNECT-RATE-SUB-1  
231005           WS-CONNECT-CAB-SUB-1) TO WS-CONNECT-TO-CABIN-1.
231005  
231005     MOVE WS-RCP-MTRX-CONNECT-CAB-NUM 
231005          (ZSUB BPSUB 
231005           WS-CONNECT-RATE-SUB-2  
231005           WS-CONNECT-CAB-SUB-2) TO WS-CONNECT-TO-CABIN-2.
231005  
231005     IF WS-CONNECT-TO-CABIN-1 = WS-CONNECT-CABIN-2 AND
231005        WS-CONNECT-TO-CABIN-2 = WS-CONNECT-CABIN-1
231005        MOVE 'Y'                 TO WS-CONNECT-PAIR-VALID-IND 
231005     END-IF.  
231005  
231005 3950-VALIDATE-DEFAULT-CON-EXIT.  
231005     EXIT.
231005  
231005 3970-COLLECT-DEFAULT-PAIR.   
231005     IF WS-CONNECT-CABIN-1 < WS-CONNECT-CABIN-2   
231005        MOVE WS-CONNECT-CABIN-1  TO WS-CONNECT-PAIR-LOW   
231005        MOVE WS-CONNECT-CABIN-2  TO WS-CONNECT-PAIR-HIGH  
231005     ELSE 
231005        MOVE WS-CONNECT-CABIN-2  TO WS-CONNECT-PAIR-LOW   
231005        MOVE WS-CONNECT-CABIN-1  TO WS-CONNECT-PAIR-HIGH  
231005     END-IF.  
231005     MOVE 'N'                    TO WS-CONNECT-DUPLICATE-IND. 
231005     PERFORM VARYING WS-CONNECT-RESULT-SUB FROM 1 BY 1
231005       UNTIL WS-CONNECT-RESULT-SUB > WS-CONNECT-RESULT-CNT
231005        IF WS-CONNECT-RESULT-LOW (WS-CONNECT-RESULT-SUB) =
231005              WS-CONNECT-PAIR-LOW AND 
231005           WS-CONNECT-RESULT-HIGH (WS-CONNECT-RESULT-SUB) =   
231005              WS-CONNECT-PAIR-HIGH
231005           MOVE 'Y'              TO WS-CONNECT-DUPLICATE-IND  
231005        END-IF
231005     END-PERFORM. 
231005     IF WS-CONNECT-DUPLICATE-IND = 'Y'
231005        GO TO 3970-COLLECT-DEFAULT-PAIR-EXIT  
231005     END-IF.  
231005     IF WS-CONNECT-RESULT-CNT >= 10   
231005        GO TO 3970-COLLECT-DEFAULT-PAIR-EXIT  
231005     END-IF.  
231005     ADD 1                       TO WS-CONNECT-RESULT-CNT.
231005     MOVE WS-CONNECT-RESULT-CNT  TO WS-CONNECT-RESULT-SUB.
231005     MOVE 'D'                    TO WS-CONNECT-RESULT-SOURCE  
231005                                          (WS-CONNECT-RESULT-SUB).
231005     MOVE WS-CONNECT-PAIR-LOW    TO WS-CONNECT-RESULT-LOW 
231005                                          (WS-CONNECT-RESULT-SUB).
231005     MOVE WS-CONNECT-PAIR-HIGH   TO WS-CONNECT-RESULT-HIGH
231005                                          (WS-CONNECT-RESULT-SUB).
231005     MOVE ZSUB                   TO WS-CONNECT-RESULT-ZONE
231005                                          (WS-CONNECT-RESULT-SUB).
231005     MOVE BPSUB                  TO WS-CONNECT-RESULT-BP  
231005                                          (WS-CONNECT-RESULT-SUB).
231005     MOVE HLD-REQ-NUM (1)        TO WS-CONNECT-RESULT-REQ-1   
231005                                          (WS-CONNECT-RESULT-SUB).
231005     MOVE HLD-RATE-SUB (1)       TO WS-CONNECT-RESULT-RATE-1  
231005                                          (WS-CONNECT-RESULT-SUB).
231005     MOVE HLD-CAB-SUB (1)        TO WS-CONNECT-RESULT-CAB-1   
231005                                          (WS-CONNECT-RESULT-SUB).
231005     MOVE HLD-REQ-NUM (2)        TO WS-CONNECT-RESULT-REQ-2   
231005                                          (WS-CONNECT-RESULT-SUB).
231005     MOVE HLD-RATE-SUB (2)       TO WS-CONNECT-RESULT-RATE-2  
231005                                          (WS-CONNECT-RESULT-SUB).
231005     MOVE HLD-CAB-SUB (2)        TO WS-CONNECT-RESULT-CAB-2   
231005                                          (WS-CONNECT-RESULT-SUB).
231005 3970-COLLECT-DEFAULT-PAIR-EXIT.  
231005     EXIT.

       4000-CHOOSE-NEXT.

231005*    IF HLD-CABIN-CNT = WS-RCP-MTRX-RATE-CNT(ZSUB BPSUB)  
231005*       COMPUTE HLD-CABIN-CNT = HLD-CABIN-CNT - 1 
231005*    END-IF.  

231005*    IF CSUB < WS-RCP-MTRX-RATE-CABIN-CNT(ZSUB BPSUB RSUB)
231005*       ADD 1                    TO CSUB  
231005*       GO TO 3900-FIND-NEXT-CABIN
231005*    END-IF.  

231005*    PROTECT RATE AND CABIN SUBSCRIPTS BEFORE MATRIX ACCESS.  
231005     IF RSUB < 1 OR   
231005        RSUB > WS-RCP-MTRX-RATE-CNT (ZSUB BPSUB)  
231005        GO TO 4100-FIND-NEXT-PATH 
231005     END-IF.  
231005  
231005     IF HLD-CABIN-CNT =   
231005        WS-RCP-MTRX-RATE-CNT (ZSUB BPSUB) 
231005        IF HLD-CABIN-CNT > ZERO   
231005           SUBTRACT 1 FROM HLD-CABIN-CNT  
231005        END-IF
231005     END-IF.  
231005  
231005     IF CSUB >= 1 AND 
231005        CSUB < WS-RCP-MTRX-RATE-CABIN-CNT 
231005                   (ZSUB BPSUB RSUB)  
231005        ADD 1 TO CSUB 
231005        GO TO 3900-FIND-NEXT-CABIN
231005     END-IF.  

       4100-FIND-NEXT-PATH. 

           IF HLD-CABIN-CNT < 1 
              GO TO 3800-NEXT-BP-VALUE  
           END-IF.  

231005*    HLD-CABIN-ENTRY OCCURS 5 TIMES. VALIDATE BEFORE REFERENCE.   
231005     IF HLD-CABIN-CNT > 5 
231005        MOVE 5 TO HLD-CABIN-CNT   
231005     END-IF.  

           MOVE HLD-RATE-SUB(HLD-CABIN-CNT) 
                                       TO RSUB. 
231005*    IF  ( HLD-CAB-SUB(HLD-CABIN-CNT) + 1 ) > 
231005*        WS-RCP-MTRX-RATE-CABIN-CNT(ZSUB BPSUB RSUB)  
231005*        IF RSUB = 1  
231005*           GO TO 3800-NEXT-BP-VALUE  
231005*        END-IF   
231005*        COMPUTE HLD-CABIN-CNT = HLD-CABIN-CNT - 1
231005*        GO TO 4100-FIND-NEXT-PATH
231005*    END-IF.  

231005*    COMPUTE CSUB = HLD-CAB-SUB(HLD-CABIN-CNT) + 1.   
231005*    COMPUTE HLD-CABIN-CNT = HLD-CABIN-CNT - 1

231005     IF RSUB < 1 OR   
231005        RSUB > WS-RCP-MTRX-RATE-CNT (ZSUB BPSUB)  
231005        SUBTRACT 1 FROM HLD-CABIN-CNT 
231005        GO TO 4100-FIND-NEXT-PATH 
231005     END-IF.  
231005  
231005     COMPUTE CSUB = HLD-CAB-SUB(HLD-CABIN-CNT) + 1.   
231005  
231005     IF CSUB < 1 OR   
231005        CSUB > WS-RCP-MTRX-RATE-CABIN-CNT (ZSUB BPSUB RSUB)   
231005        IF RSUB = 1   
231005           GO TO 3800-NEXT-BP-VALUE   
231005        END-IF
231005        SUBTRACT 1 FROM HLD-CABIN-CNT 
231005        GO TO 4100-FIND-NEXT-PATH 
231005     END-IF.  
231005     SUBTRACT 1 FROM HLD-CABIN-CNT.   
           GO TO 3900-FIND-NEXT-CABIN.  

       4200-DONE-BEST-URM-RECIPE.   

           MOVE ZERO                   TO ZSUB  
                                          BPSUB 
                                          RSUB  
                                          CABSUB
                                          TOT-CABSUB
                                          TOT-CABGRP
                                          WS-TOT-PAX .  

           PERFORM VARYING WS-SUB FROM 1 BY 1   
                   UNTIL WS-SUB > MCACIN-SUB
            COMPUTE WS-TOT-PAX = WS-TOT-PAX + MCACIN-NUM-PAX (WS-SUB)   
           END-PERFORM. 

       4300-BUILD-OUTPUT-NEXT-URM-RCP.  
           ADD 1                       TO BPSUB.

           IF BPSUB > WS-BP-CNT 
              GO TO 4600-DONE-BUILD-URM-RCP 
           END-IF.  

           ADD 1                       TO TOT-CABGRP.   

           IF BPSUB > 1 
              MOVE SPACES              TO WS-UNIQUE-TOTAL   
              PERFORM VARYING WS-SUB FROM 1 BY 1
                UNTIL WS-SUB < BPSUB
                IF WS-BP-CABIN-TOTAL (BPSUB) =  
                   WS-BP-CABIN-TOTAL (WS-SUB)   

                   MOVE 'N'            TO WS-UNIQUE-TOTAL   
                END-IF  
              END-PERFORM   
              IF WS-UNIQUE-TOTAL = 'N'  
                 GO TO 4300-BUILD-OUTPUT-NEXT-URM-RCP   
              END-IF
           END-IF.  

       4400-FIND-RATE-CABIN-ZONE.   

           IF  WS-BP-CABIN-CNT (BPSUB) < 1  
               COMPUTE TOT-CABSUB = TOT-CABSUB +  MCACIN-SUB
               GO TO 4300-BUILD-OUTPUT-NEXT-URM-RCP.

           MOVE WS-BP-ZONE-SUB(BPSUB)  TO ZSUB. 

           MOVE WS-RCP-MTRX-DECK-CODE(ZSUB) 
                                       TO MCACAG-DECK-CODE(BPSUB).  
           MOVE WS-RCP-MTRX-FMA-IND (ZSUB)  
                                       TO   
                                        MCACAG-FWD-MID-AFT-CODE(BPSUB). 
           MOVE ZEROES                 TO MCACAG-RCP-SEQ-NUM (BPSUB).   
           MOVE ZERO                   TO CSUB. 

       4500-FIND-RATE-CABINS.   

           ADD 1                       TO CSUB. 
           MOVE 0                      TO WS-ADV-SUB.   

           IF CSUB > WS-BP-CABIN-CNT (BPSUB)
              GO TO 4300-BUILD-OUTPUT-NEXT-URM-RCP. 

           ADD 1 TO TOT-CABSUB. 


           PERFORM VARYING REQ-SUB FROM 1 BY 1  
               UNTIL REQ-SUB > WS-BP-CABIN-CNT (BPSUB)  
             IF WS-BP-REQ-NUM (BPSUB REQ-SUB) = CSUB
               MOVE WS-BP-RATE-SUB(BPSUB REQ-SUB)   
                                       TO RSUB  
               MOVE WS-BP-CABIN-SUB(BPSUB REQ-SUB)  
                                       TO CABSUB
               MOVE WS-BP-CABIN-CNT (BPSUB) 
                                       TO REQ-SUB   
             END-IF 
           END-PERFORM. 

           COMPUTE MCACAG-TOTAVG-CABIN-AMT (BPSUB) =
                   ( MCACAG-TOTAVG-CABIN-AMT (BPSUB)+   
                  WS-RCP-MTRX-TOT-CR-FARE-AMT (ZSUB BPSUB RSUB CABSUB)).

           COMPUTE MCACAG-TOTAVG-ADDON-AMT (BPSUB) =
                   ( MCACAG-TOTAVG-ADDON-AMT (BPSUB) +  
                   WS-RCP-MTRX-AVG-ADDON-AMT (ZSUB BPSUB RSUB CABSUB)). 

           COMPUTE MCACAG-TOTAL-CRUISE-AMT (BPSUB) =
                   ( MCACAG-TOTAL-CRUISE-AMT (BPSUB) +  
                   WS-RCP-MTRX-GROSS-AMT (ZSUB BPSUB RSUB CABSUB)). 

           COMPUTE MCACAG-TOTAVG-CRUISE-AMT (BPSUB) =   
                   ( MCACAG-TOTAVG-CRUISE-AMT (BPSUB) + 
                   WS-RCP-MTRX-TOT-CR-FARE-AMT  
                   (ZSUB BPSUB RSUB CABSUB)).   


           IF CSUB = WS-BP-CABIN-CNT (BPSUB)
              COMPUTE MCACAG-TOTAVG-CABIN-AMT (BPSUB) = 
                      MCACAG-TOTAVG-CABIN-AMT (BPSUB) / WS-TOT-PAX  
              COMPUTE MCACAG-TOTAVG-ADDON-AMT (BPSUB) = 
                      MCACAG-TOTAVG-ADDON-AMT (BPSUB) / CSUB
           END-IF.  

           MOVE BPSUB                  TO MCACAV-OWNER-SUB (TOT-CABSUB).
           MOVE WS-RCP-MTRX-OFFER-CODE (ZSUB BPSUB RSUB )   
                                       TO MCACAV-OFFER-CODE 
                                         (TOT-CABSUB).  
           MOVE WS-RCP-MTRX-CABIN-NUM (ZSUB BPSUB RSUB CABSUB)  
                                       TO MCACAV-CABIN-NUM (TOT-CABSUB).
           MOVE WS-RCP-MTRX-META-CAT-CODE (ZSUB)
                                       TO MCACAV-META-CAT-CODE  
                                         (TOT-CABSUB).  
           MOVE WS-RCP-MTRX-CAT-CODE (ZSUB BPSUB RSUB CABSUB)   
                                       TO MCACAV-CAT-CODE (TOT-CABSUB). 
           IF  MCACAV-CAT-CODE (TOT-CABSUB) NOT =   
               WS-RCP-MTRX-CPA-CAT-CODE (ZSUB BPSUB RSUB CABSUB)
               MOVE WS-RCP-MTRX-CPA-CAT-CODE (ZSUB BPSUB RSUB CABSUB)   
                                       TO MCACAV-UPGRADE-CODE   
                                         (TOT-CABSUB)   
           END-IF   
           MOVE WS-RCP-MTRX-AVG-CR-FARE-AMT (ZSUB BPSUB RSUB CABSUB)
                                       TO MCACAV-AVG-CABIN-AMT  
                                         (TOT-CABSUB).  
           MOVE WS-RCP-MTRX-AVG-ADDON-AMT (ZSUB BPSUB RSUB CABSUB)  
                                       TO MCACAV-AVG-ADDON-AMT  
                                          (TOT-CABSUB). 
           MOVE WS-RCP-MTRX-TOT-CR-FARE-AMT (ZSUB BPSUB RSUB CABSUB)
                                       TO MCACAV-TOT-CABIN-AMT  
                                          (TOT-CABSUB). 
           MOVE WS-RCP-MTRX-GROSS-AMT (ZSUB BPSUB RSUB CABSUB)  
                                       TO MCACAV-TOT-CRUISE-AMT 
                                          (TOT-CABSUB). 
           IF  WS-RCP-MTRX-INFO-MSG (ZSUB BPSUB RSUB CABSUB) = 'Y'  
               ADD 1                   TO WS-ADV-SUB
               MOVE '1230'             TO MCAADV-ADVISORY-CODE  
                                         (TOT-CABSUB WS-ADV-SUB)
               STRING 'The stateroom category selected has an occupancy'
                      ' restriction. Changes in occupancy may result in'
                      ' a change in fare'   
                DELIMITED SIZE INTO MCAADV-ADVISORY-TEXT
                                   (TOT-CABSUB WS-ADV-SUB)  
               MOVE '0026/25211001/CCR48MCA'
                                       TO MCAADV-CONDITION-CODE 
                                         (TOT-CABSUB WS-ADV-SUB)
           END-IF.  

           IF WS-RCP-MTRX-CONNECT-CAB-NUM (ZSUB BPSUB RSUB CABSUB) >
                                            SPACES  
              MOVE WS-RCP-MTRX-CONNECT-CAB-NUM (ZSUB BPSUB RSUB CABSUB) 
                                       TO   
                                   MCACAV-CONNECT-CABIN-NUM (TOT-CABSUB)
           END-IF.  

           MOVE ZEROS                  TO MCACAV-SEQ-NUM(TOT-CABSUB).   

           STRING MCAVL1-SHIP-CODE  
                  MCACAV-META-CAT-CODE (TOT-CABSUB) 
                  WS-RCP-MTRX-SPL-CAT-CODE  (ZSUB BPSUB RSUB CABSUB)
                  WS-RCP-MTRX-VIEW-IND (ZSUB BPSUB RSUB CABSUB) 
                  DELIMITED BY SIZE INTO MCACAV-CABIN-TYPE (TOT-CABSUB).

           IF  WS-RCP-MTRX-SPL-CAT-CODE  (ZSUB BPSUB RSUB CABSUB) = 'Y' 
               ADD 1                   TO WS-ADV-SUB
               MOVE '1200'             TO MCAADV-ADVISORY-CODE  
                                          (TOT-CABSUB WS-ADV-SUB)   
               STRING 'Good call!! That’s not just any stateroom you’ve'
               ' got there — that’s a Cloud 9 Spa stateroom!Enjoy your '
               'complimentary spa access, including Thalassotherapy '   
               'Pool and Thermal Suites. '  
                   DELIMITED SIZE INTO    MCAADV-ADVISORY-TEXT  
                                                (TOT-CABSUB WS-ADV-SUB) 
               MOVE '0027/25211002/CCR48MCA'
                                       TO MCAADV-CONDITION-CODE 
                                                (TOT-CABSUB WS-ADV-SUB) 
           END-IF.  

           IF  (CSUB = WS-BP-CABIN-CNT (BPSUB)) AND (BPSUB = 2) 
              IF (MCACAG-TOTAVG-CABIN-AMT (1) = 
                  MCACAG-TOTAVG-CABIN-AMT (2))  
                  MOVE LOW-VALUES      TO MCACAG-SEGMENT (2)
                  GO TO 4300-BUILD-OUTPUT-NEXT-URM-RCP  
              END-IF
           END-IF.  

           GO TO 4500-FIND-RATE-CABINS. 

       4600-DONE-BUILD-URM-RCP. 

      ************  PRCESSING END FOR DEFAULT RECIPE********************

       4700-LOAD-SAIL-DETAILS.  
           MOVE MCAVL1-SAIL-ID         TO MCASAV-SAIL-ID.   
           MOVE TDP01-SAIL-DATE-YYYYMMDD
                                       TO MCASAV-SAIL-DATE. 
           MOVE TDP01-DURATION-DAYS    TO MCASAV-DURATION-DAYS. 
           MOVE TDP01-SHIP-CODE        TO MCASAV-SHIP-CODE. 
           EVALUATE TDP01-STATUS-CODE   
               WHEN  'O'
                  EVALUATE TDP01-SPECIAL-SAIL-IND   
                     WHEN SPACES
                          IF RSP51-O-INDV-MAX-CABINS <= 0 OR
                             RSP51-O-SAIL-MAX-GUESTS <= 0   
                             MOVE 7    TO MCASAV-STATUS-CODE
                         ELSE   
                             MOVE 1    TO MCASAV-STATUS-CODE
                         END-IF 
                     WHEN 'C'   
                         MOVE 4        TO MCASAV-STATUS-CODE
                     WHEN  OTHER
                         MOVE 2        TO MCASAV-STATUS-CODE
                  END-EVALUATE  
               WHEN  'R'
                  MOVE 4               TO MCASAV-STATUS-CODE
               WHEN  'D'
                  MOVE 21              TO MCASAV-STATUS-CODE
               WHEN  'W'
                  MOVE 21              TO MCASAV-STATUS-CODE
               WHEN  'C'
                  IF  TDP01-SPECIAL-SAIL-IND = 'D'  
                      MOVE 21          TO MCASAV-STATUS-CODE
                  ELSE  
                      MOVE 2           TO MCASAV-STATUS-CODE
                  END-IF
               WHEN  OTHER  
                  MOVE 2               TO MCASAV-STATUS-CODE
           END-EVALUATE.
           MOVE TDP01-ITINERARY-CODE   TO MCASAV-ITINERARY-CODE.
           MOVE RSP51-O-ITINERARY-NBK-DESC  
                                       TO MCASAV-ITINERARY-DESC.
           MOVE TDP01-EMBARK-PORT-CODE TO MCASAV-EMBARK-CODE.   
           MOVE TDP01-DEBARK-PORT-CODE TO MCASAV-DEBARK-CODE.   

       4800-BUILD-INP-RCP-TBL.  

           IF MCARCP-SUB NOT > ZEROES   
231005        IF MCAVL1-CONNECT-REQ-IND = 'Y'   
231005           GO TO 8020-BUILD-CONNECT-OUTPUT
231005        END-IF
              GO TO 8150-SEND-OUTPUT
           END-IF.  

           PERFORM VARYING WS-SUB FROM 1 BY 1   
                   UNTIL WS-SUB > MCARCP-SUB
             MOVE MCARCP-SEQ-NUM(WS-SUB)
                                       TO WS-REQ-RCP-SEQ-NUM (WS-SUB)   
             MOVE ZERO                 TO META-SUB  
             PERFORM VARYING WS-SUB2 FROM 1 BY 1
                     UNTIL WS-SUB2 > MCASCI-SUB 
               IF MCARCP-SEQ-NUM(WS-SUB) = MCASCI-OWNER-SUB(WS-SUB2)
                  ADD 1                TO META-SUB  
                  MOVE MCASCI-META-CAT-CODE (WS-SUB2)   
                                       TO   
                               WS-REQ-RCP-META-CAT-CODE(WS-SUB META-SUB)
                  MOVE MCASCI-NUM-CABINS (WS-SUB2)  
                                       TO   
                                  WS-REQ-RCP-CABIN-CNT (WS-SUB META-SUB)
               END-IF   
             END-PERFORM
             MOVE META-SUB             TO WS-REQ-RCP-META-CNT(WS-SUB)   
           END-PERFORM. 

           MOVE MCARCP-SUB             TO WS-REQ-RCP-CNT.   
           MOVE ZEROES                 TO ZSUB. 
           MOVE LOW-VALUES             TO WS-INP-RECIPE-TABLE.  

       4900-NEXT-ZONE.  
           ADD 1                       TO ZSUB. 
           IF ZSUB > WS-ZONE-CNT
              GO TO 5800-DONE-BUILD-INP-RCP-TBL 
           END-IF.  
           MOVE ZSUB                   TO WS-INP-RCP-ZONE-CNT.  
           MOVE SPACES                 TO   
                                      WS-INP-RCP-ZONE-SELECT-IND(ZSUB). 
           MOVE WS-DECK-NUM(ZSUB)      TO WS-INP-RCP-DECK-NUM (ZSUB).   
           MOVE WS-DECK-CODE(ZSUB)     TO WS-INP-RCP-DECK-CODE (ZSUB).  
           MOVE WS-FMA-IND(ZSUB)       TO WS-INP-RCP-FMA-IND (ZSUB).
           MOVE WS-ZONE-CABIN-CNT (ZSUB)
                                       TO   
                                      WS-INP-RCP-ZONE-CABIN-CNT (ZSUB). 
           MOVE WS-REQ-RCP-CNT         TO WS-INP-RCP-CNT(ZSUB). 
           MOVE ZERO                   TO RCP-SUB.  

       5000-BUILD-NEXT-INP-RCP. 

           ADD 1                       TO RCP-SUB.  
           IF RCP-SUB > WS-INP-RCP-CNT(ZSUB)
              GO TO 5200-FIND-META-CAT  
           END-IF.  

           MOVE WS-REQ-RCP-SEQ-NUM(RCP-SUB) 
                                       TO   
                                       WS-INP-RCP-SEQ-NUM(ZSUB RCP-SUB) 
           MOVE SPACES                 TO   
                                     WS-INP-RCP-SATISFIED(ZSUB RCP-SUB).
           IF WS-REQ-RCP-META-CNT(RCP-SUB)  NOT > ZEROES
              GO TO 5000-BUILD-NEXT-INP-RCP 
           END-IF.  
           MOVE WS-REQ-RCP-META-CNT(RCP-SUB)
                                       TO   
                                      WS-INP-RCP-META-CNT(ZSUB RCP-SUB).
           MOVE ZERO                   TO RCP-MSUB. 

       5100-BUILD-NEXT-META.

           ADD 1                       TO RCP-MSUB. 
           IF RCP-MSUB > WS-INP-RCP-META-CNT(ZSUB RCP-SUB)  
              GO 5000-BUILD-NEXT-INP-RCP
           END-IF.  
           MOVE WS-REQ-RCP-META-CAT-CODE(RCP-SUB RCP-MSUB)  
                                       TO   
                       WS-INP-RCP-META-CAT-CODE(ZSUB RCP-SUB RCP-MSUB). 
           MOVE WS-REQ-RCP-CABIN-CNT(RCP-SUB RCP-MSUB)  
                                       TO   
                       WS-INP-RCP-REQ-CABIN-CNT (ZSUB RCP-SUB RCP-MSUB).
           MOVE SPACES                 TO   
                       WS-INP-RCP-META-SATISFIED(ZSUB RCP-SUB RCP-MSUB).

           GO TO 5100-BUILD-NEXT-META.  

       5200-FIND-META-CAT.  

           MOVE ZERO                   TO RCP-SUB.  

       5300-NEXT-INP-RCP.   

           ADD 1                       TO RCP-SUB.  
           IF RCP-SUB > WS-INP-RCP-CNT(ZSUB)
              PERFORM VARYING WS-SUB FROM 1 BY 1
                      UNTIL WS-SUB > WS-INP-RCP-CNT(ZSUB)   
                 IF WS-INP-RCP-SATISFIED (ZSUB WS-SUB) = 'Y'
                    MOVE 'Y'           TO   
                                       WS-INP-RCP-ZONE-SELECT-IND (ZSUB)
                    MOVE WS-INP-RCP-CNT(ZSUB)   
                                       TO WS-SUB
                 END-IF 
              END-PERFORM   
              GO TO 4900-NEXT-ZONE  
           END-IF.  
           MOVE ZERO                   TO RCP-MSUB. 

       5400-NEXT-INP-RCP-META.  

           ADD 1                       TO RCP-MSUB. 

           IF RCP-MSUB > WS-INP-RCP-META-CNT(ZSUB RCP-SUB)  
              MOVE SPACES              TO WS-META-NOT-SATISFIED 
              PERFORM VARYING WS-SUB FROM 1 BY 1
                      UNTIL WS-SUB > WS-INP-RCP-META-CNT(ZSUB RCP-SUB)  
                 IF WS-INP-RCP-META-SATISFIED (ZSUB RCP-SUB WS-SUB) 
                    NOT > SPACES
                    MOVE 'Y'           TO WS-META-NOT-SATISFIED 
                    MOVE WS-INP-RCP-META-CNT(ZSUB RCP-SUB)  
                                       TO WS-SUB
                 END-IF 
              END-PERFORM   
              IF WS-META-NOT-SATISFIED NOT = 'Y'
                 MOVE 'Y'              TO   
                                     WS-INP-RCP-SATISFIED(ZSUB RCP-SUB) 
              END-IF
              GO TO 5300-NEXT-INP-RCP.  

           MOVE ZERO                   TO MSUB. 

       5500-FIND-META-IN-INVENTORY. 

           ADD 1                       TO MSUB. 

           IF MSUB > WS-META-CNT(ZSUB)  
              GO TO 5400-NEXT-INP-RCP-META  
           END-IF   
           IF WS-META-CAT-CODE (ZSUB MSUB) NOT =
              WS-INP-RCP-META-CAT-CODE(ZSUB RCP-SUB RCP-MSUB)   
              GO TO 5500-FIND-META-IN-INVENTORY 
           END-IF   

           IF WS-META-CABIN-CNT(ZSUB MSUB) <
              WS-INP-RCP-REQ-CABIN-CNT (ZSUB RCP-SUB RCP-MSUB)  
              GO TO 5400-NEXT-INP-RCP-META  
           END-IF.  

           MOVE 'Y'                    TO   
                        WS-INP-RCP-META-SATISFIED(ZSUB RCP-SUB RCP-MSUB)
           MOVE ZERO                   TO CATSUB
                      WS-INP-RCP-META-CABIN-CNT(ZSUB RCP-SUB RCP-MSUB). 
           MOVE ZERO                   TO   
                         WS-INP-RCP-META-CAT-CNT(ZSUB RCP-SUB RCP-MSUB).

       5600-NEXT-CAT.   

           ADD 1                       TO CATSUB.   

           IF CATSUB > WS-META-CAT-CNT(ZSUB MSUB)   
              GO TO 5400-NEXT-INP-RCP-META  
           END-IF.  
           ADD 1                       TO   
                        WS-INP-RCP-META-CAT-CNT(ZSUB RCP-SUB RCP-MSUB). 
           MOVE WS-CAT-CODE (ZSUB MSUB CATSUB)  
                                       TO   
                     WS-INP-RCP-CAT-CODE (ZSUB RCP-SUB RCP-MSUB CATSUB).
           MOVE WS-CAT-MIN-PAX (ZSUB MSUB CATSUB)   
                                       TO   
                  WS-INP-RCP-CAT-MIN-PAX (ZSUB RCP-SUB RCP-MSUB CATSUB).
           MOVE WS-CAT-MAX-PAX  (ZSUB MSUB CATSUB)  
                                       TO   
                  WS-INP-RCP-CAT-MAX-PAX (ZSUB RCP-SUB RCP-MSUB CATSUB).
           PERFORM VARYING WS-SUB FROM 1 BY 1   
                   UNTIL WS-SUB > 5 
                  MOVE WS-CAT-RESTRICT-TYPE (ZSUB MSUB CATSUB WS-SUB)   
                                       TO WS-INP-RCP-CAT-RESTRICT-TYPE  
                                  (ZSUB RCP-SUB RCP-MSUB CATSUB WS-SUB) 
           END-PERFORM. 

           MOVE ZERO                   TO CABSUB
                WS-INP-RCP-CAT-CABIN-CNT (ZSUB RCP-SUB RCP-MSUB CATSUB).

       5700-NEXT-CABIN. 

           ADD 1                       TO CABSUB.   

           IF CABSUB > WS-CABIN-CNT (ZSUB MSUB CATSUB)  
              GO TO 5600-NEXT-CAT   
           END-IF.  

           ADD 1                       TO   
                                       WS-INP-RCP-ZONE-CABIN-CNT (ZSUB).
           ADD 1                       TO WS-INP-RCP-CAT-CABIN-CNT  
                                         (ZSUB RCP-SUB RCP-MSUB CATSUB).
           ADD 1                       TO   
                      WS-INP-RCP-META-CABIN-CNT (ZSUB RCP-SUB RCP-MSUB).
           MOVE WS-NORMAL-CAP  (ZSUB MSUB CATSUB CABSUB)
                                       TO WS-INP-RCP-NORMAL-CAP 
                                  (ZSUB RCP-SUB RCP-MSUB CATSUB CABSUB).
           MOVE WS-MAX-CAP (ZSUB MSUB CATSUB CABSUB)
                                       TO WS-INP-RCP-MAX-CAP
                                  (ZSUB RCP-SUB RCP-MSUB CATSUB CABSUB).
           MOVE WS-CONNECT-CAB-NUM (ZSUB MSUB CATSUB CABSUB)
                                       TO WS-INP-RCP-CONNECT-CAB-NUM
                                  (ZSUB RCP-SUB RCP-MSUB CATSUB CABSUB).
           MOVE WS-PORT-STAR-CODE (ZSUB MSUB CATSUB CABSUB) 
                                       TO WS-INP-RCP-PORT-STAR-CODE 
                                  (ZSUB RCP-SUB RCP-MSUB CATSUB CABSUB).
           MOVE WS-DISPLAY-SEQ  (ZSUB MSUB CATSUB CABSUB)   
                                       TO WS-INP-RCP-DISPLAY-SEQ
                                 (ZSUB RCP-SUB RCP-MSUB CATSUB CABSUB). 
           MOVE WS-CABIN-NUM  (ZSUB MSUB CATSUB CABSUB) 
                                       TO WS-INP-RCP-CABIN-NUM  
                                 (ZSUB RCP-SUB RCP-MSUB CATSUB CABSUB). 
           MOVE WS-IS-OS-IND (ZSUB MSUB CATSUB CABSUB)  
                                       TO WS-INP-RCP-IS-OS-IND  
                                 (ZSUB RCP-SUB RCP-MSUB CATSUB CABSUB). 
           MOVE WS-SPL-CAT-CODE (ZSUB MSUB CATSUB CABSUB)   
                                       TO WS-INP-RCP-SPL-CAT-CODE   
                                  (ZSUB RCP-SUB RCP-MSUB CATSUB CABSUB).
           MOVE WS-VIEW-IND(ZSUB MSUB CATSUB CABSUB)
                                       TO WS-INP-RCP-VIEW-IND   
                                 (ZSUB RCP-SUB RCP-MSUB CATSUB CABSUB). 

           GO TO 5700-NEXT-CABIN.   

       5800-DONE-BUILD-INP-RCP-TBL. 

           MOVE LOW-VALUES             TO  WS-INP-RECIPE-MTRX-TABLE.
           MOVE ZERO                   TO ZSUB MTRX-ZSUB .  

       5900-NEXT-ZONE.  
           ADD 1                       TO ZSUB. 

           IF ZSUB > WS-INP-RCP-ZONE-CNT
              GO TO 7000-FIND-BEST-INP-RECIPE   
           END-IF.  

           IF WS-INP-RCP-ZONE-SELECT-IND(ZSUB) NOT = 'Y'
              GO TO 5900-NEXT-ZONE  
           END-IF.  

           ADD 1                       TO MTRX-ZSUB 
                                          WS-INP-RCP-MTRX-ZONE-CNT. 
           MOVE WS-INP-RCP-DECK-NUM (ZSUB)  
                                       TO   
                                  WS-INP-RCP-MTRX-DECK-NUM (MTRX-ZSUB). 
           MOVE WS-INP-RCP-DECK-CODE (ZSUB) 
                                       TO   
                                  WS-INP-RCP-MTRX-DECK-CODE (MTRX-ZSUB).
           MOVE WS-INP-RCP-FMA-IND (ZSUB)   
                                       TO   
                                    WS-INP-RCP-MTRX-FMA-IND (MTRX-ZSUB).
           MOVE WS-INP-BP-CNT          TO   
                                      WS-INP-RCP-MTRX-BP-CNT(MTRX-ZSUB).

           MOVE ZERO                   TO MTRX-BPSUB.   

       6000-NEXT-BEST-PRICE.

           ADD 1                       TO MTRX-BPSUB.   

           IF MTRX-BPSUB > WS-INP-RCP-MTRX-BP-CNT (MTRX-ZSUB)   
              GO TO 5900-NEXT-ZONE  
           END-IF.  

           MOVE MTRX-BPSUB             TO   
                         WS-INP-RCP-MTRX-BP-VALUE(MTRX-ZSUB MTRX-BPSUB).

           MOVE ZERO                   TO RCP-SUB MTRX-RCP-SUB  
                              WS-INP-RCP-MTRX-CNT(MTRX-ZSUB MTRX-BPSUB).

       6100-NEXT-RCP.   

           ADD 1                       TO RCP-SUB.  
           IF RCP-SUB > WS-INP-RCP-CNT (ZSUB)   
              GO TO 6000-NEXT-BEST-PRICE
           END-IF.  

           ADD 1                       TO MTRX-RCP-SUB  
                              WS-INP-RCP-MTRX-CNT(MTRX-ZSUB MTRX-BPSUB).

           IF WS-INP-RCP-SATISFIED(ZSUB RCP-SUB) NOT = 'Y'  
              GO TO 6100-NEXT-RCP   
           END-IF.  

           MOVE WS-INP-RCP-SEQ-NUM (ZSUB RCP-SUB)   
                                       TO WS-INP-RCP-MTRX-SEQ-NUM   
                                   (MTRX-ZSUB MTRX-BPSUB MTRX-RCP-SUB). 

           MOVE WS-INP-RCP-META-CNT (ZSUB RCP-SUB)  
                                       TO WS-INP-RCP-MTRX-META-CNT  
                                   (MTRX-ZSUB MTRX-BPSUB MTRX-RCP-SUB). 


           MOVE ZERO                   TO MSUB  
                                          MTRX-MSUB.

       6200-NEXT-META.  

           ADD 1                       TO MSUB. 
           IF MSUB > WS-INP-RCP-META-CNT(ZSUB RCP-SUB)  
              GO TO 6100-NEXT-RCP   
           END-IF.  

           ADD 1                       TO MTRX-MSUB.

           MOVE WS-INP-RCP-META-CAT-CODE (ZSUB RCP-SUB MSUB)
                                       TO WS-INP-RCP-MTRX-META-CAT-CODE 
                          (MTRX-ZSUB MTRX-BPSUB MTRX-RCP-SUB MTRX-MSUB).

           MOVE WS-INP-RCP-REQ-CABIN-CNT (ZSUB RCP-SUB MSUB)
                                       TO WS-INP-RCP-MTRX-REQ-CABIN-CNT 
                         (MTRX-ZSUB MTRX-BPSUB MTRX-RCP-SUB MTRX-MSUB). 


           MOVE ZERO                   TO CATSUB.   

       6300-NEXT-CATEGORY.  

           ADD 1                       TO CATSUB.   

           IF CATSUB > WS-INP-RCP-META-CAT-CNT (ZSUB RCP-SUB MSUB)  
              GO TO 6200-NEXT-META  
           END-IF.  

           MOVE ZERO                   TO R1
                                          CABSUB
                                          MTRX-RSUB 
                                          WS-HOLD-MTRX-RATE-CNT.

       6400-FIND-RATE-OCC.  

           ADD 1                       TO R1.   

           IF R1 > WS-RCP-RATE-CNT  
              GO TO 6600-FIND-NEXT-CABIN
           END-IF.  

           MOVE ZERO                   TO C1.   

       6500-FIND-NEXT-RATE-CAT. 

           ADD 1                       TO C1.   

           IF C1 > WS-RCP-CATEGORY-CNT (R1) 
              GO TO 6400-FIND-RATE-OCC  
           END-IF.  

           IF WS-RCP-CATEGORY-CODE (R1 C1) NOT =
              WS-INP-RCP-CAT-CODE(ZSUB RCP-SUB MSUB CATSUB) 
              GO TO 6500-FIND-NEXT-RATE-CAT 
           END-IF.  

           IF (WS-RCP-REQ-OCC (R1) >= WS-RCP-CAT-MIN-PAX(R1 C1)) AND
              (WS-RCP-REQ-OCC (R1) <= WS-RCP-CAT-MAX-PAX (R1 C1))   
              CONTINUE  
           ELSE 
              GO TO 6400-FIND-RATE-OCC  
           END-IF.  
           ADD 1                       TO MTRX-RSUB 
                                          WS-HOLD-MTRX-RATE-CNT.

           MOVE WS-RCP-CATEGORY-CODE (R1 C1)
                                       TO   
                                      WS-HOLD-MTRX-CAT-CODE (MTRX-RSUB).
           MOVE WS-RCP-CPA-CAT-CODE (R1 C1) 
                                       TO   
                                  WS-HOLD-MTRX-CPA-CAT-CODE (MTRX-RSUB).
           MOVE WS-RCP-CAT-MIN-PAX(R1 C1)   
                                       TO   
                                   WS-HOLD-MTRX-CAT-MIN-PAX (MTRX-RSUB).
           MOVE WS-RCP-CAT-MAX-PAX(R1 C1)   
                                       TO   
                                   WS-HOLD-MTRX-CAT-MAX-PAX (MTRX-RSUB).
           MOVE WS-RCP-CATEGORY-AMTS (R1 C1)
                                       TO   
                                        WS-HOLD-MTRX-AMTS (MTRX-RSUB).  
           MOVE WS-RCP-OFFER-CODE (R1) TO   
                                     WS-HOLD-MTRX-OFFER-CODE(MTRX-RSUB).
           MOVE WS-RCP-REQ-OCC (R1)    TO   
                                       WS-HOLD-MTRX-REQ-OCC (MTRX-RSUB).
           MOVE WS-RCP-REQ-NUM (R1)    TO   
                                      WS-HOLD-MTRX-REQ-NUM (MTRX-RSUB). 
           MOVE WS-RCP-CAT-OCC-TYPE (R1 C1) 
                                       TO   
                                 WS-HOLD-MTRX-CAT-OCC-TYPE (MTRX-RSUB). 
           MOVE WS-RCP-INFO-MSG (R1 C1) 
                                       TO WS-HOLD-INFO-MSG (MTRX-RSUB). 

           GO TO 6400-FIND-RATE-OCC.

       6600-FIND-NEXT-CABIN.

           ADD 1                       TO CABSUB.   

           IF CABSUB > WS-INP-RCP-CAT-CABIN-CNT 
                      (ZSUB RCP-SUB MSUB CATSUB)
              GO TO 6300-NEXT-CATEGORY  
           END-IF.  

           MOVE ZERO                   TO RATE-SUB. 

       6700-ADD-NEXT-RATE-OCC.  

           ADD 1                       TO RATE-SUB. 

           IF RATE-SUB > WS-HOLD-MTRX-RATE-CNT  
              GO TO 6600-FIND-NEXT-CABIN
           END-IF.  

           MOVE SPACES                 TO WS-RATE-EXISTS.   
           PERFORM VARYING WS-SUB FROM 1 BY 1   
                   UNTIL WS-SUB > WS-INP-RCP-MTRX-META-RATE-CNT 
                           (MTRX-ZSUB MTRX-BPSUB MTRX-RCP-SUB MTRX-MSUB)
               IF (WS-HOLD-MTRX-OFFER-CODE (RATE-SUB) = 
                   WS-INP-RCP-MTRX-OFFER-CODE   
                   (MTRX-ZSUB MTRX-BPSUB MTRX-RCP-SUB MTRX-MSUB WS-SUB))
                    AND 
                  (WS-HOLD-MTRX-REQ-OCC(RATE-SUB) = 
                   WS-INP-RCP-MTRX-REQ-OCC  
                   (MTRX-ZSUB MTRX-BPSUB MTRX-RCP-SUB MTRX-MSUB WS-SUB))
                    AND 
                  ( WS-HOLD-MTRX-REQ-NUM (RATE-SUB) =   
                    WS-INP-RCP-MTRX-REQ-NUM 
                   (MTRX-ZSUB MTRX-BPSUB MTRX-RCP-SUB MTRX-MSUB WS-SUB))

                  MOVE WS-SUB          TO RSUB  
                  MOVE 'Y'             TO WS-RATE-EXISTS
                  MOVE WS-INP-RCP-MTRX-META-RATE-CNT
                       (MTRX-ZSUB MTRX-BPSUB MTRX-RCP-SUB MTRX-MSUB)
                                       TO WS-SUB

               END-IF   
           END-PERFORM. 

           IF WS-RATE-EXISTS NOT = 'Y'  
              ADD 1                    TO WS-INP-RCP-MTRX-META-RATE-CNT 
                          (MTRX-ZSUB MTRX-BPSUB MTRX-RCP-SUB MTRX-MSUB) 
              MOVE WS-INP-RCP-MTRX-META-RATE-CNT
                  (MTRX-ZSUB MTRX-BPSUB MTRX-RCP-SUB MTRX-MSUB) 
                                       TO RSUB  
              MOVE WS-HOLD-MTRX-OFFER-CODE (RATE-SUB)   
                                       TO WS-INP-RCP-MTRX-OFFER-CODE
                  (MTRX-ZSUB MTRX-BPSUB MTRX-RCP-SUB MTRX-MSUB RSUB)
              MOVE WS-HOLD-MTRX-REQ-OCC (RATE-SUB)  
                                       TO WS-INP-RCP-MTRX-REQ-OCC   
                  (MTRX-ZSUB MTRX-BPSUB MTRX-RCP-SUB MTRX-MSUB RSUB)
              MOVE WS-HOLD-MTRX-REQ-NUM (RATE-SUB)  
                                       TO WS-INP-RCP-MTRX-REQ-NUM   
                  (MTRX-ZSUB MTRX-BPSUB MTRX-RCP-SUB MTRX-MSUB RSUB)
              MOVE ZERO                TO MTRX-CABSUB   
                                       WS-INP-RCP-RATE-CABIN-CNT(RSUB). 

       6800-CHECK-CABIN-OCC.

           MOVE WS-INP-RCP-NORMAL-CAP (ZSUB RCP-SUB MSUB CATSUB CABSUB) 
                                       TO WS-OCC.   
           MOVE WS-INP-RCP-CAT-RESTRICT-TYPE
                                       (ZSUB RCP-SUB MSUB CATSUB WS-OCC)
                                       TO   
                                   WS-HOLD-MTRX-CAT-OCC-TYPE (RATE-SUB).

           IF (WS-HOLD-MTRX-REQ-OCC(RATE-SUB) > 
               WS-INP-RCP-MAX-CAP (ZSUB RCP-SUB MSUB CATSUB CABSUB)) AND
              (TDP01-SPOILAGE-CODE = ' ')   
231005        IF MCAVL1-CONNECT-REQ-IND = 'Y'   
231005           GO TO 6700-ADD-NEXT-RATE-OCC   
231005        ELSE  
                 GO TO 6600-FIND-NEXT-CABIN 
231005        END-IF
           END-IF.  

204924*    IF WS-HOLD-MTRX-CAT-OCC-TYPE (RATE-SUB) NOT > SPACES 
204924     IF WS-HOLD-MTRX-CAT-OCC-TYPE (RATE-SUB) = SPACES 
              IF (( WS-INP-RCP-NORMAL-CAP   
                   (ZSUB RCP-SUB MSUB CATSUB CABSUB) >= 
                  WS-HOLD-MTRX-CAT-MIN-PAX (RATE-SUB) ) AND 
                  ( WS-INP-RCP-NORMAL-CAP   
                   (ZSUB RCP-SUB MSUB CATSUB CABSUB) <= 
                  WS-HOLD-MTRX-CAT-MAX-PAX (RATE-SUB) )) OR 
                  ((WS-INP-RCP-MAX-CAP  
                   (ZSUB RCP-SUB MSUB CATSUB CABSUB) >= 
                  WS-HOLD-MTRX-CAT-MIN-PAX (RATE-SUB) ) AND 
                  (WS-INP-RCP-MAX-CAP   
                   (ZSUB RCP-SUB MSUB CATSUB CABSUB) <= 
                  WS-HOLD-MTRX-CAT-MAX-PAX (RATE-SUB) ))

                  GO TO 6900-ADD-CABIN-TO-RATE  
               ELSE 
                  GO TO 6700-ADD-NEXT-RATE-OCC  
               END-IF   
           END-IF.  

           IF WS-HOLD-MTRX-CAT-OCC-TYPE (RATE-SUB) > SPACES 
              IF WS-HOLD-MTRX-CAT-OCC-TYPE (RATE-SUB) = 'M' 
                 IF WS-HOLD-MTRX-REQ-OCC(RATE-SUB) > 1  
                    IF WS-HOLD-MTRX-REQ-OCC(RATE-SUB) NOT = 
                        ( WS-INP-RCP-MAX-CAP
                       (ZSUB RCP-SUB MSUB CATSUB CABSUB) )  
                       GO TO 6700-ADD-NEXT-RATE-OCC 
                    END-IF  
                 ELSE   
                   IF WS-INP-RCP-MAX-CAP
                      (ZSUB RCP-SUB MSUB CATSUB CABSUB) > 2 
                      GO TO 6700-ADD-NEXT-RATE-OCC  
                   END-IF   
                 END-IF 
                 GO TO 6900-ADD-CABIN-TO-RATE   
              END-IF
           END-IF.  

           IF WS-HOLD-MTRX-CAT-OCC-TYPE (RATE-SUB) = 'N'
              IF WS-HOLD-MTRX-REQ-OCC (RATE-SUB) > 1
                 IF ( WS-INP-RCP-NORMAL-CAP 
                     (ZSUB RCP-SUB MSUB CATSUB CABSUB) =
                     ( WS-HOLD-MTRX-REQ-OCC (RATE-SUB) )) OR
                     ( WS-INP-RCP-MAX-CAP   
                       (ZSUB RCP-SUB MSUB CATSUB CABSUB) =  
                     ( WS-HOLD-MTRX-REQ-OCC (RATE-SUB) ))   
                     GO TO 6900-ADD-CABIN-TO-RATE   
                  ELSE  
                    GO TO 6700-ADD-NEXT-RATE-OCC
                 END-IF 
              ELSE  
                 IF WS-INP-RCP-NORMAL-CAP   
                    (ZSUB RCP-SUB MSUB CATSUB CABSUB) = 2   
                    GO TO 6900-ADD-CABIN-TO-RATE
                 ELSE   
                    GO TO 6700-ADD-NEXT-RATE-OCC
                 END-IF 
              END-IF
           END-IF.  

           EVALUATE WS-HOLD-MTRX-CAT-OCC-TYPE (RATE-SUB)
            WHEN '1' MOVE 1            TO WS-SPOIL-CNT  
            WHEN '2' MOVE 2            TO WS-SPOIL-CNT  
            WHEN '3' MOVE 3            TO WS-SPOIL-CNT  
            WHEN OTHER MOVE ZERO       TO WS-SPOIL-CNT  
           END-EVALUATE.

           IF ( WS-INP-RCP-MAX-CAP (ZSUB RCP-SUB MSUB CATSUB CABSUB) >= 
                WS-HOLD-MTRX-REQ-OCC (RATE-SUB)  )      AND 
              ( WS-INP-RCP-NORMAL-CAP   
                (ZSUB RCP-SUB MSUB CATSUB CABSUB) <=
                ( WS-HOLD-MTRX-REQ-OCC (RATE-SUB)   
                                    + WS-SPOIL-CNT ) )  
              GO TO 6900-ADD-CABIN-TO-RATE  
           ELSE 
              GO TO 6700-ADD-NEXT-RATE-OCC  
           END-IF.  

       6900-ADD-CABIN-TO-RATE.  

231005     MOVE WS-INP-RCP-MTRX-REQ-CABIN-CNT   
231005          (MTRX-ZSUB MTRX-BPSUB MTRX-RCP-SUB MTRX-MSUB)   
231005                                 TO WS-INP-CONNECT-CAND-LIMIT.
231005     IF MCAVL1-CONNECT-REQ-IND = 'Y'  
231005        MOVE 125                 TO WS-INP-CONNECT-CAND-LIMIT 
231005     END-IF.  
231005  
231005*    SAVE THE REQUEST OCCURRENCE IN AN ELEMENTARY FIELD.  
231005     MOVE WS-HOLD-MTRX-REQ-NUM (RATE-SUB) 
231005                                 TO WS-CONNECT-REQ-SUB.   
231005  
231005     IF WS-CONNECT-REQ-SUB < 1 OR 
231005        WS-CONNECT-REQ-SUB > WS-INP-CABIN-COUNT   
231005        GO TO 6700-ADD-NEXT-RATE-OCC  
231005     END-IF.  
231005
231005     IF MCACIN-CABIN-TYPE (WS-CONNECT-REQ-SUB) > SPACES
231005        MOVE SPACES              TO WS-CANDIDATE-CABIN-TYPE
231005        STRING MCAVL1-SHIP-CODE
231005               WS-INP-RCP-META-CAT-CODE
231005                 (ZSUB RCP-SUB MSUB)
231005               WS-INP-RCP-SPL-CAT-CODE
231005                 (ZSUB RCP-SUB MSUB CATSUB CABSUB)
231005               WS-INP-RCP-VIEW-IND
231005                 (ZSUB RCP-SUB MSUB CATSUB CABSUB)
231005          DELIMITED BY SIZE
231005          INTO WS-CANDIDATE-CABIN-TYPE
231005        IF WS-CANDIDATE-CABIN-TYPE NOT =
231005           MCACIN-CABIN-TYPE (WS-CONNECT-REQ-SUB)
231005           GO TO 6700-ADD-NEXT-RATE-OCC
231005        END-IF
231005     END-IF.
231005  
231005*    IN CONNECTED MODE, HONOR THE EXACT CATEGORY REQUESTED
231005*    FOR THE CORRESPONDING CABIN REQUEST. 
231005*    APPLY EXACT CATEGORY FOR THE CABIN REQUEST.  
231005     IF MCAVL1-CONNECT-REQ-IND = 'Y'  
231005        IF MCACIN-CAT-CODE (WS-CONNECT-REQ-SUB) > SPACES  
231005           IF WS-INP-RCP-CAT-CODE(ZSUB RCP-SUB MSUB CATSUB) NOT = 
231005              MCACIN-CAT-CODE (WS-CONNECT-REQ-SUB)
231005              GO TO 6700-ADD-NEXT-RATE-OCC
231005           END-IF 
231005        END-IF
231005     END-IF.  
231005  
231005*    DO NOT INSERT A CABIN WITH NO CONNECTING CABIN.  
231005     IF MCAVL1-CONNECT-REQ-IND = 'Y' AND  
231005        WS-INP-RCP-CONNECT-CAB-NUM
231005        (ZSUB RCP-SUB MSUB CATSUB CABSUB) = SPACES
231005        GO TO 6700-ADD-NEXT-RATE-OCC  
231005     END-IF.  

           ADD 1                       TO   
                                       WS-INP-RCP-RATE-CABIN-CNT(RSUB). 
           MOVE WS-INP-RCP-RATE-CABIN-CNT(RSUB) 
                                       TO MTRX-CABSUB.  

           MOVE SPACES                 TO WS-MOVE-CABIN 
           PERFORM VARYING WS-SUB FROM 1 BY 1   
                   UNTIL WS-SUB > WS-INP-RCP-MTRX-RATE-CABIN-CNT
                      (MTRX-ZSUB MTRX-BPSUB MTRX-RCP-SUB MTRX-MSUB RSUB)

              IF WS-INP-RCP-MTRX-BP-VALUE   
                (MTRX-ZSUB MTRX-BPSUB) = 1  
                 IF WS-HOLD-MTRX-AVG-GROSS-AMT (RATE-SUB) < 
                    WS-INP-RCP-MTRX-AVG-GROSS-AMT   
               (MTRX-ZSUB MTRX-BPSUB MTRX-RCP-SUB MTRX-MSUB RSUB WS-SUB)
                    MOVE WS-SUB        TO MTRX-CABSUB   
                    MOVE 'Y'           TO WS-MOVE-CABIN 
                    MOVE WS-INP-RCP-MTRX-RATE-CABIN-CNT 
                      (MTRX-ZSUB MTRX-BPSUB MTRX-RCP-SUB MTRX-MSUB RSUB)
                                       TO WS-SUB
                 ELSE   
                  IF WS-HOLD-MTRX-AVG-GROSS-AMT (RATE-SUB) =
                      WS-INP-RCP-MTRX-AVG-GROSS-AMT 
               (MTRX-ZSUB MTRX-BPSUB MTRX-RCP-SUB MTRX-MSUB RSUB WS-SUB)
                     IF WS-INP-RCP-NORMAL-CAP   
                        (ZSUB RCP-SUB MSUB CATSUB CABSUB) < 
                        WS-INP-RCP-MTRX-NORMAL-CAP  
             (MTRX-ZSUB MTRX-BPSUB MTRX-RCP-SUB MTRX-MSUB RSUB WS-SUB ) 
                        MOVE WS-SUB    TO MTRX-CABSUB   
                        MOVE 'Y'       TO WS-MOVE-CABIN 
                        MOVE WS-INP-RCP-MTRX-RATE-CABIN-CNT 
                      (MTRX-ZSUB MTRX-BPSUB MTRX-RCP-SUB MTRX-MSUB RSUB)
                                       TO WS-SUB
                     END-IF 
                  END-IF
                 END-IF 
              ELSE  
                IF WS-INP-RCP-MTRX-BP-VALUE 
                  (MTRX-ZSUB MTRX-BPSUB) = 2
                   IF WS-HOLD-MTRX-AVG-GROSS-AMT (RATE-SUB) >   
                      WS-INP-RCP-MTRX-AVG-GROSS-AMT 
               (MTRX-ZSUB MTRX-BPSUB MTRX-RCP-SUB MTRX-MSUB RSUB WS-SUB)
                      MOVE WS-SUB      TO MTRX-CABSUB   
                      MOVE 'Y'         TO WS-MOVE-CABIN 
                      MOVE WS-INP-RCP-MTRX-RATE-CABIN-CNT   
                      (MTRX-ZSUB MTRX-BPSUB MTRX-RCP-SUB MTRX-MSUB RSUB)
                                       TO WS-SUB
                    ELSE
                      IF WS-HOLD-MTRX-AVG-GROSS-AMT (RATE-SUB) =
                         WS-INP-RCP-MTRX-AVG-GROSS-AMT  
               (MTRX-ZSUB MTRX-BPSUB MTRX-RCP-SUB MTRX-MSUB RSUB WS-SUB)
                        IF WS-INP-RCP-NORMAL-CAP
                           (ZSUB RCP-SUB MSUB CATSUB CABSUB) <  
                           WS-INP-RCP-MTRX-NORMAL-CAP   
             (MTRX-ZSUB MTRX-BPSUB MTRX-RCP-SUB MTRX-MSUB RSUB WS-SUB ) 
                             MOVE WS-SUB
                                       TO MTRX-CABSUB   
                             MOVE 'Y'  TO WS-MOVE-CABIN 
                             MOVE WS-INP-RCP-MTRX-RATE-CABIN-CNT
                      (MTRX-ZSUB MTRX-BPSUB MTRX-RCP-SUB MTRX-MSUB RSUB)
                                       TO WS-SUB
                        END-IF  
                      END-IF
                   END-IF   
                END-IF  
              END-IF

           END-PERFORM. 

           IF WS-MOVE-CABIN NOT = 'Y' AND   
              ( WS-INP-RCP-RATE-CABIN-CNT(RSUB) >   
231005*         WS-INP-RCP-MTRX-REQ-CABIN-CNT   
231005*         (MTRX-ZSUB MTRX-BPSUB MTRX-RCP-SUB MTRX-MSUB))  
231005          WS-INP-CONNECT-CAND-LIMIT ) 
              GO TO 6700-ADD-NEXT-RATE-OCC  
           END-IF.  

           IF WS-INP-RCP-RATE-CABIN-CNT(RSUB) > 
231005*       WS-INP-RCP-MTRX-REQ-CABIN-CNT 
231005*      (MTRX-ZSUB MTRX-BPSUB MTRX-RCP-SUB MTRX-MSUB)  
231005        WS-INP-CONNECT-CAND-LIMIT 
231005*       MOVE WS-INP-RCP-MTRX-REQ-CABIN-CNT
231005*           (MTRX-ZSUB MTRX-BPSUB MTRX-RCP-SUB MTRX-MSUB) 
231005        MOVE WS-INP-CONNECT-CAND-LIMIT
                TO WS-INP-RCP-MTRX-RATE-CABIN-CNT   
                   (MTRX-ZSUB MTRX-BPSUB MTRX-RCP-SUB MTRX-MSUB RSUB)   
           ELSE 
              MOVE WS-INP-RCP-RATE-CABIN-CNT(RSUB)  
                TO WS-INP-RCP-MTRX-RATE-CABIN-CNT   
                   (MTRX-ZSUB MTRX-BPSUB MTRX-RCP-SUB MTRX-MSUB RSUB)   
           END-IF.  

           IF WS-MOVE-CABIN  = 'Y' AND  
231005*       ( MTRX-CABSUB NOT = WS-INP-RCP-MTRX-REQ-CABIN-CNT 
231005*                   (MTRX-ZSUB MTRX-BPSUB MTRX-RCP-SUB MTRX-MSUB))
231005        ( MTRX-CABSUB NOT = WS-INP-CONNECT-CAND-LIMIT )   

              MOVE WS-INP-RCP-MTRX-RATE-CABIN-CNT   
                   (MTRX-ZSUB MTRX-BPSUB MTRX-RCP-SUB MTRX-MSUB RSUB)   
                                       TO WS-SUB2   
              PERFORM VARYING WS-SUB FROM WS-SUB2 BY -1 
                UNTIL WS-SUB <= MTRX-CABSUB 

                COMPUTE WS-SUB3 = WS-SUB - 1

                MOVE WS-INP-RCP-MTRX-CPA-CAT-CODE   
              (MTRX-ZSUB MTRX-BPSUB MTRX-RCP-SUB MTRX-MSUB RSUB WS-SUB3)
                                       TO WS-INP-RCP-MTRX-CPA-CAT-CODE  
               (MTRX-ZSUB MTRX-BPSUB MTRX-RCP-SUB MTRX-MSUB RSUB WS-SUB)

                MOVE WS-INP-RCP-MTRX-AMTS   
              (MTRX-ZSUB MTRX-BPSUB MTRX-RCP-SUB MTRX-MSUB RSUB WS-SUB3)
                                       TO WS-INP-RCP-MTRX-AMTS  
              (MTRX-ZSUB MTRX-BPSUB MTRX-RCP-SUB MTRX-MSUB RSUB WS-SUB )

                MOVE WS-INP-RCP-MTRX-NORMAL-CAP 
             (MTRX-ZSUB MTRX-BPSUB MTRX-RCP-SUB MTRX-MSUB RSUB WS-SUB3 )
                                       TO WS-INP-RCP-MTRX-NORMAL-CAP
              (MTRX-ZSUB MTRX-BPSUB MTRX-RCP-SUB MTRX-MSUB RSUB WS-SUB )
                MOVE WS-INP-RCP-MTRX-MAX-CAP
             (MTRX-ZSUB MTRX-BPSUB MTRX-RCP-SUB MTRX-MSUB RSUB WS-SUB3 )
                                       TO WS-INP-RCP-MTRX-MAX-CAP   
              (MTRX-ZSUB MTRX-BPSUB MTRX-RCP-SUB MTRX-MSUB RSUB WS-SUB )
                MOVE WS-INP-RCP-MTRX-CONN-CAB-NUM   
              (MTRX-ZSUB MTRX-BPSUB MTRX-RCP-SUB MTRX-MSUB RSUB WS-SUB3)
                                       TO WS-INP-RCP-MTRX-CONN-CAB-NUM  
               (MTRX-ZSUB MTRX-BPSUB MTRX-RCP-SUB MTRX-MSUB RSUB WS-SUB)
                MOVE WS-INP-RCP-MTRX-PORT-STAR-CODE 
              (MTRX-ZSUB MTRX-BPSUB MTRX-RCP-SUB MTRX-MSUB RSUB WS-SUB3)
                                       TO WS-INP-RCP-MTRX-PORT-STAR-CODE
               (MTRX-ZSUB MTRX-BPSUB MTRX-RCP-SUB MTRX-MSUB RSUB WS-SUB)
                MOVE WS-INP-RCP-MTRX-DISPLAY-SEQ
              (MTRX-ZSUB MTRX-BPSUB MTRX-RCP-SUB MTRX-MSUB RSUB WS-SUB3)
                                       TO WS-INP-RCP-MTRX-DISPLAY-SEQ   
               (MTRX-ZSUB MTRX-BPSUB MTRX-RCP-SUB MTRX-MSUB RSUB WS-SUB)
                MOVE WS-INP-RCP-MTRX-CABIN-NUM  
              (MTRX-ZSUB MTRX-BPSUB MTRX-RCP-SUB MTRX-MSUB RSUB WS-SUB3)
                                       TO WS-INP-RCP-MTRX-CABIN-NUM 
               (MTRX-ZSUB MTRX-BPSUB MTRX-RCP-SUB MTRX-MSUB RSUB WS-SUB)
                MOVE WS-INP-RCP-MTRX-IS-OS-IND  
              (MTRX-ZSUB MTRX-BPSUB MTRX-RCP-SUB MTRX-MSUB RSUB WS-SUB3)
                                       TO WS-INP-RCP-MTRX-IS-OS-IND 
               (MTRX-ZSUB MTRX-BPSUB MTRX-RCP-SUB MTRX-MSUB RSUB WS-SUB)
                MOVE WS-INP-RCP-MTRX-CAT-CODE   
              (MTRX-ZSUB MTRX-BPSUB MTRX-RCP-SUB MTRX-MSUB RSUB WS-SUB3)
                                       TO WS-INP-RCP-MTRX-CAT-CODE  
               (MTRX-ZSUB MTRX-BPSUB MTRX-RCP-SUB MTRX-MSUB RSUB WS-SUB)
                MOVE WS-INP-RCP-MTRX-INFO-MSG   
              (MTRX-ZSUB MTRX-BPSUB MTRX-RCP-SUB MTRX-MSUB RSUB WS-SUB3)
                                       TO WS-INP-RCP-MTRX-INFO-MSG  
               (MTRX-ZSUB MTRX-BPSUB MTRX-RCP-SUB MTRX-MSUB RSUB WS-SUB)
                MOVE WS-INP-RCP-MTRX-SPL-CAT-CODE   
              (MTRX-ZSUB MTRX-BPSUB MTRX-RCP-SUB MTRX-MSUB RSUB WS-SUB3)
                                       TO WS-INP-RCP-MTRX-SPL-CAT-CODE  
               (MTRX-ZSUB MTRX-BPSUB MTRX-RCP-SUB MTRX-MSUB RSUB WS-SUB)
                MOVE WS-INP-RCP-MTRX-VIEW-IND   
              (MTRX-ZSUB MTRX-BPSUB MTRX-RCP-SUB MTRX-MSUB RSUB WS-SUB3)
                                       TO WS-INP-RCP-MTRX-VIEW-IND  
               (MTRX-ZSUB MTRX-BPSUB MTRX-RCP-SUB MTRX-MSUB RSUB WS-SUB)

              END-PERFORM   

           END-IF.  

           MOVE WS-HOLD-MTRX-CPA-CAT-CODE (RATE-SUB)
                                       TO WS-INP-RCP-MTRX-CPA-CAT-CODE  
                (MTRX-ZSUB MTRX-BPSUB MTRX-RCP-SUB MTRX-MSUB RSUB   
                 MTRX-CABSUB).  

           MOVE WS-HOLD-MTRX-AMTS (RATE-SUB)
                                       TO WS-INP-RCP-MTRX-AMTS  
               (MTRX-ZSUB MTRX-BPSUB MTRX-RCP-SUB MTRX-MSUB RSUB
                MTRX-CABSUB ).  
           MOVE WS-HOLD-INFO-MSG (RATE-SUB) 
                                       TO   
                       WS-INP-RCP-MTRX-INFO-MSG (MTRX-ZSUB MTRX-BPSUB   
                             MTRX-RCP-SUB MTRX-MSUB RSUB MTRX-CABSUB).  

           MOVE WS-INP-RCP-NORMAL-CAP (ZSUB RCP-SUB MSUB CATSUB CABSUB) 
                                       TO WS-INP-RCP-MTRX-NORMAL-CAP
                (MTRX-ZSUB MTRX-BPSUB MTRX-RCP-SUB MTRX-MSUB RSUB   
                 MTRX-CABSUB ). 
           MOVE WS-INP-RCP-MAX-CAP (ZSUB RCP-SUB MSUB CATSUB CABSUB)
                                       TO WS-INP-RCP-MTRX-MAX-CAP   
               (MTRX-ZSUB MTRX-BPSUB MTRX-RCP-SUB MTRX-MSUB RSUB
                MTRX-CABSUB ).  
           MOVE WS-INP-RCP-CONNECT-CAB-NUM  
                (ZSUB RCP-SUB MSUB CATSUB CABSUB)   
                                       TO WS-INP-RCP-MTRX-CONN-CAB-NUM  
                (MTRX-ZSUB MTRX-BPSUB MTRX-RCP-SUB MTRX-MSUB RSUB   
                 MTRX-CABSUB ). 
           MOVE WS-INP-RCP-PORT-STAR-CODE   
                (ZSUB RCP-SUB MSUB CATSUB CABSUB)   
                                       TO WS-INP-RCP-MTRX-PORT-STAR-CODE
                (MTRX-ZSUB MTRX-BPSUB MTRX-RCP-SUB MTRX-MSUB RSUB   
                 MTRX-CABSUB ). 
           MOVE WS-INP-RCP-DISPLAY-SEQ (ZSUB RCP-SUB MSUB CATSUB CABSUB)
                                       TO WS-INP-RCP-MTRX-DISPLAY-SEQ   
               (MTRX-ZSUB MTRX-BPSUB MTRX-RCP-SUB MTRX-MSUB RSUB
                MTRX-CABSUB ).  
           MOVE WS-INP-RCP-CABIN-NUM (ZSUB RCP-SUB MSUB CATSUB CABSUB)  
                                       TO WS-INP-RCP-MTRX-CABIN-NUM 
                (MTRX-ZSUB MTRX-BPSUB MTRX-RCP-SUB MTRX-MSUB RSUB   
                 MTRX-CABSUB ). 
           MOVE WS-INP-RCP-IS-OS-IND (ZSUB RCP-SUB MSUB CATSUB CABSUB)  
                                       TO WS-INP-RCP-MTRX-IS-OS-IND 
               (MTRX-ZSUB MTRX-BPSUB MTRX-RCP-SUB MTRX-MSUB RSUB
                MTRX-CABSUB ).  
           MOVE WS-INP-RCP-CAT-CODE (ZSUB RCP-SUB MSUB CATSUB)  
                                      TO WS-INP-RCP-MTRX-CAT-CODE   
               (MTRX-ZSUB MTRX-BPSUB MTRX-RCP-SUB MTRX-MSUB RSUB
                MTRX-CABSUB ).  
           MOVE WS-INP-RCP-SPL-CAT-CODE(ZSUB RCP-SUB MSUB CATSUB CABSUB)
                                       TO WS-INP-RCP-MTRX-SPL-CAT-CODE  
                (MTRX-ZSUB MTRX-BPSUB MTRX-RCP-SUB MTRX-MSUB RSUB   
                 MTRX-CABSUB ). 
           MOVE WS-INP-RCP-VIEW-IND (ZSUB RCP-SUB MSUB CATSUB CABSUB)   
                                       TO WS-INP-RCP-MTRX-VIEW-IND  
                (MTRX-ZSUB MTRX-BPSUB MTRX-RCP-SUB MTRX-MSUB RSUB   
                 MTRX-CABSUB ). 


           ADD 1                       TO   
                             WS-INP-RCP-MTRX-ZONE-CABIN-CNT (MTRX-ZSUB) 
                             WS-INP-RCP-MTRX-META-CABIN-CNT 
                          (MTRX-ZSUB MTRX-BPSUB MTRX-RCP-SUB MTRX-MSUB).

           GO TO 6700-ADD-NEXT-RATE-OCC.

       7000-FIND-BEST-INP-RECIPE.   

231005*    CONNECTED MODE ENUMERATES THE COMPLETE QUALIFIED MATRIX. 
231005     IF MCAVL1-CONNECT-REQ-IND = 'Y'  
231005        GO TO 7010-FIND-ALL-INP-PAIRS 
231005     END-IF.  

           MOVE ZERO                   TO ZSUB. 
           MOVE LOW-VALUES             TO WS-SUBS-TBL   
                                          HLD-INP-CABIN-TABLE   
                                          WS-ZONE-INP-RCP-BP-TABLE. 

231005*    BYPASS OUT-OF-LINE CONNECTED PARAGRAPHS FOR LEGACY MODE. 
231005     GO TO 7100-NEXT-BP-ZONE. 
231005  
231005*    TEMPORARY CONNECTED-MODE DIAGNOSTICS REMAIN ENABLED. 
231005 7010-FIND-ALL-INP-PAIRS. 
231005     MOVE ZERO TO ZSUB.   
231005  
231005 7011-NEXT-INP-ZONE.  
231005  
231005     ADD 1 TO ZSUB.   
231005  
231005     IF ZSUB > WS-INP-RCP-MTRX-ZONE-CNT   
231005        GO TO 8000-DONE-BEST-INP-RECIPE   
231005     END-IF.  
231005  
231005     MOVE ZERO TO BPSUB.  
231005  
231005 7012-NEXT-INP-BP.
231005  
231005     ADD 1 TO BPSUB.  
231005  
231005     IF BPSUB > WS-INP-RCP-MTRX-BP-CNT (ZSUB) 
231005        GO TO 7011-NEXT-INP-ZONE  
231005     END-IF.  
231005  
231005     MOVE ZERO TO RCP-SUB.
231005  
231005 7013-NEXT-INP-RECIPE.
231005  
231005     ADD 1 TO RCP-SUB.
231005  
231005     IF RCP-SUB > WS-INP-RCP-MTRX-CNT (ZSUB BPSUB)
231005        GO TO 7012-NEXT-INP-BP
231005     END-IF.  
231005  
231005     MOVE ZERO TO WS-SOURCE-META-SUB. 
231005  
231005 7014-NEXT-SOURCE-META.   
231005  
231005     ADD 1 TO WS-SOURCE-META-SUB. 
231005  
231005     IF WS-SOURCE-META-SUB >  
231005        WS-INP-RCP-MTRX-META-CNT (ZSUB BPSUB RCP-SUB) 
231005        GO TO 7013-NEXT-INP-RECIPE
231005     END-IF.  
231005  
231005     MOVE ZERO TO WS-SOURCE-RATE-SUB. 
231005  
231005 7015-NEXT-SOURCE-RATE.   
231005  
231005     ADD 1 TO WS-SOURCE-RATE-SUB. 
231005  
231005     IF WS-SOURCE-RATE-SUB >  WS-INP-RCP-MTRX-META-RATE-CNT   
231005                           (ZSUB BPSUB RCP-SUB WS-SOURCE-META-SUB)
231005        GO TO 7014-NEXT-SOURCE-META   
231005     END-IF.  
231005  
231005     MOVE WS-INP-RCP-MTRX-REQ-NUM 
231005                            (ZSUB BPSUB RCP-SUB WS-SOURCE-META-SUB
231005                                               WS-SOURCE-RATE-SUB)
231005                                 TO WS-CONNECT-REQ-NUM-1. 
231005     IF WS-CONNECT-REQ-NUM-1 < 1 OR   
231005        WS-CONNECT-REQ-NUM-1 > WS-INP-CABIN-COUNT 
231005        GO TO 7015-NEXT-SOURCE-RATE   
231005     END-IF.  
231005  
231005     MOVE ZERO TO WS-SOURCE-CAB-SUB.  
231005  
231005 7016-NEXT-SOURCE-CABIN.  
231005  
231005     ADD 1 TO WS-SOURCE-CAB-SUB.  
231005  
231005     IF WS-SOURCE-CAB-SUB > WS-INP-RCP-MTRX-RATE-CABIN-CNT
231005        (ZSUB BPSUB RCP-SUB WS-SOURCE-META-SUB WS-SOURCE-RATE-SUB)
231005        GO TO 7015-NEXT-SOURCE-RATE   
231005     END-IF.  
231005  
231005     MOVE WS-INP-RCP-MTRX-CABIN-NUM   
231005                            (ZSUB BPSUB RCP-SUB WS-SOURCE-META-SUB
231005                             WS-SOURCE-RATE-SUB WS-SOURCE-CAB-SUB)
231005                                 TO WS-CONNECT-CABIN-1.   
231005     MOVE WS-INP-RCP-MTRX-CONN-CAB-NUM
231005                            (ZSUB BPSUB RCP-SUB WS-SOURCE-META-SUB
231005                             WS-SOURCE-RATE-SUB WS-SOURCE-CAB-SUB)
231005                                 TO WS-CONNECT-TO-CABIN-1.
231005  
231005     IF WS-CONNECT-CABIN-1 NOT > SPACES OR
231005        WS-CONNECT-TO-CABIN-1 NOT > SPACES
231005        GO TO 7016-NEXT-SOURCE-CABIN  
231005     END-IF.  
231005  
231005*    SEARCH THE RECIPROCAL PARTNER ACROSS ALL MATRIX ZONES.   
231005     MOVE ZERO TO WS-PARTNER-ZONE-SUB.
231005  
231005 7019-NEXT-PARTNER-ZONE.  
231005  
231005     ADD 1 TO WS-PARTNER-ZONE-SUB.
231005  
231005     IF WS-PARTNER-ZONE-SUB > WS-INP-RCP-MTRX-ZONE-CNT
231005        GO TO 7016-NEXT-SOURCE-CABIN  
231005     END-IF.  
231005  
231005*    ZONE NUMBER AND GROUP LOCATION DO NOT QUALIFY A PAIR.
231005*    QUALIFICATION IS CABIN-LEVEL AND RECIPROCAL. 
231005     MOVE ZERO TO WS-PARTNER-BP-SUB.  
231005  
231005 7020-NEXT-PARTNER-BP.
231005  
231005     ADD 1 TO WS-PARTNER-BP-SUB.  
231005  
231005     IF WS-PARTNER-BP-SUB > WS-INP-RCP-MTRX-BP-CNT
231005                                             (WS-PARTNER-ZONE-SUB)
231005        GO TO 7019-NEXT-PARTNER-ZONE  
231005     END-IF.  
231005  
231005*    BOTH CABINS MUST USE THE SAME PRICE DIRECTION.   
231005     IF WS-INP-RCP-MTRX-BP-VALUE  
231005          (WS-PARTNER-ZONE-SUB WS-PARTNER-BP-SUB) NOT =   
231005        WS-INP-RCP-MTRX-BP-VALUE (ZSUB BPSUB) 
231005        GO TO 7020-NEXT-PARTNER-BP
231005     END-IF.  
231005  
231005     MOVE ZERO TO WS-PARTNER-RCP-SUB. 
231005  
231005 7021-NEXT-PARTNER-RCP.   
231005  
231005     ADD 1 TO WS-PARTNER-RCP-SUB. 
231005  
231005     IF WS-PARTNER-RCP-SUB > WS-INP-RCP-MTRX-CNT  
231005          (WS-PARTNER-ZONE-SUB WS-PARTNER-BP-SUB) 
231005        GO TO 7020-NEXT-PARTNER-BP
231005     END-IF.  
231005  
231005     IF WS-INP-RCP-MTRX-SEQ-NUM   
231005          (WS-PARTNER-ZONE-SUB WS-PARTNER-BP-SUB  
231005           WS-PARTNER-RCP-SUB) NOT =  
231005        WS-INP-RCP-MTRX-SEQ-NUM (ZSUB BPSUB RCP-SUB)  
231005        GO TO 7021-NEXT-PARTNER-RCP   
231005     END-IF.  
231005  
231005     MOVE ZERO TO WS-PARTNER-META-SUB.
231005  
231005 7022-NEXT-PARTNER-META.  
231005     ADD 1 TO WS-PARTNER-META-SUB.
231005     IF WS-PARTNER-META-SUB > WS-INP-RCP-MTRX-META-CNT
231005                            (WS-PARTNER-ZONE-SUB WS-PARTNER-BP-SUB
231005                                               WS-PARTNER-RCP-SUB)
231005        GO TO 7021-NEXT-PARTNER-RCP   
231005     END-IF.  
231005  
231005     MOVE ZERO TO WS-PARTNER-RATE-SUB.
231005  
231005 7023-NEXT-PARTNER-RATE.  
231005  
231005     ADD 1 TO WS-PARTNER-RATE-SUB.
231005  
231005     IF WS-PARTNER-RATE-SUB > WS-INP-RCP-MTRX-META-RATE-CNT   
231005                          (WS-PARTNER-ZONE-SUB WS-PARTNER-BP-SUB  
231005                           WS-PARTNER-RCP-SUB WS-PARTNER-META-SUB)
231005        GO TO 7022-NEXT-PARTNER-META  
231005     END-IF.  
231005  
231005     MOVE WS-INP-RCP-MTRX-REQ-NUM 
231005       (WS-PARTNER-ZONE-SUB WS-PARTNER-BP-SUB 
231005        WS-PARTNER-RCP-SUB WS-PARTNER-META-SUB
231005        WS-PARTNER-RATE-SUB)  
231005                                 TO WS-CONNECT-REQ-NUM-2. 
231005  
231005     IF WS-CONNECT-REQ-NUM-2 < 1 OR   
231005        WS-CONNECT-REQ-NUM-2 > WS-INP-CABIN-COUNT OR  
231005        WS-CONNECT-REQ-NUM-2 = WS-CONNECT-REQ-NUM-1   
231005        GO TO 7023-NEXT-PARTNER-RATE  
231005     END-IF.  
231005  
231005     MOVE ZERO TO WS-PARTNER-CAB-SUB. 
231005  
231005 7024-NEXT-PARTNER-CABIN. 
231005  
231005     ADD 1 TO WS-PARTNER-CAB-SUB. 
231005  
231005     IF WS-PARTNER-CAB-SUB >  
231005        WS-INP-RCP-MTRX-RATE-CABIN-CNT
231005          (WS-PARTNER-ZONE-SUB WS-PARTNER-BP-SUB  
231005           WS-PARTNER-RCP-SUB WS-PARTNER-META-SUB 
231005           WS-PARTNER-RATE-SUB)   
231005        GO TO 7023-NEXT-PARTNER-RATE  
231005     END-IF.  
231005  
231005     IF WS-INP-RCP-MTRX-CABIN-NUM 
231005          (WS-PARTNER-ZONE-SUB WS-PARTNER-BP-SUB  
231005           WS-PARTNER-RCP-SUB WS-PARTNER-META-SUB 
231005           WS-PARTNER-RATE-SUB WS-PARTNER-CAB-SUB)
231005        NOT = WS-CONNECT-TO-CABIN-1   
231005        GO TO 7024-NEXT-PARTNER-CABIN 
231005     END-IF.  
231005  
231005     MOVE WS-INP-RCP-MTRX-CONN-CAB-NUM
231005       (WS-PARTNER-ZONE-SUB WS-PARTNER-BP-SUB 
231005        WS-PARTNER-RCP-SUB WS-PARTNER-META-SUB
231005        WS-PARTNER-RATE-SUB WS-PARTNER-CAB-SUB)   
231005                                 TO WS-CONNECT-TO-CABIN-2.
231005  
231005     IF WS-CONNECT-TO-CABIN-2 NOT = WS-CONNECT-CABIN-1
231005        GO TO 7024-NEXT-PARTNER-CABIN 
231005     END-IF.  
231005  
231005     MOVE WS-CONNECT-TO-CABIN-1  TO WS-CONNECT-CABIN-2.   
231005  
231005     PERFORM 7030-SAVE-DIRECT-INP-PAIR
231005        THRU 7030-SAVE-DIRECT-INP-PAIR-X. 
231005  
231005     IF WS-CONNECT-RESULT-CNT >= 10   
231005        GO TO 8000-DONE-BEST-INP-RECIPE   
231005     END-IF.  
231005  
231005     GO TO 7024-NEXT-PARTNER-CABIN.   
231005  
231005 7030-SAVE-DIRECT-INP-PAIR.   
231005  
231005     IF WS-CONNECT-CABIN-1 < WS-CONNECT-CABIN-2   
231005        MOVE WS-CONNECT-CABIN-1  TO WS-CONNECT-PAIR-LOW   
231005        MOVE WS-CONNECT-CABIN-2  TO WS-CONNECT-PAIR-HIGH  
231005     ELSE 
231005        MOVE WS-CONNECT-CABIN-2  TO WS-CONNECT-PAIR-LOW   
231005        MOVE WS-CONNECT-CABIN-1  TO WS-CONNECT-PAIR-HIGH  
231005     END-IF.  
231005  
231005     MOVE 'N' TO WS-CONNECT-DUPLICATE-IND.
231005  
231005     PERFORM VARYING WS-CONNECT-RESULT-SUB FROM 1 BY 1
231005       UNTIL WS-CONNECT-RESULT-SUB > WS-CONNECT-RESULT-CNT
231005        IF WS-CONNECT-RESULT-LOW  
231005             (WS-CONNECT-RESULT-SUB) = WS-CONNECT-PAIR-LOW AND
231005           WS-CONNECT-RESULT-HIGH 
231005             (WS-CONNECT-RESULT-SUB) = WS-CONNECT-PAIR-HIGH   
231005           MOVE 'Y'              TO WS-CONNECT-DUPLICATE-IND  
231005        END-IF
231005     END-PERFORM. 
231005  
231005     IF WS-CONNECT-DUPLICATE-IND = 'Y' OR 
231005        WS-CONNECT-RESULT-CNT >= 10   
231005        GO TO 7030-SAVE-DIRECT-INP-PAIR-X 
231005     END-IF.  
231005  
231005     ADD 1 TO WS-CONNECT-RESULT-CNT.  
231005  
231005     MOVE WS-CONNECT-RESULT-CNT  TO WS-CONNECT-RESULT-SUB.
231005     MOVE 'I'                    TO WS-CONNECT-RESULT-SOURCE  
231005                                          (WS-CONNECT-RESULT-SUB).
231005     MOVE WS-CONNECT-PAIR-LOW    TO WS-CONNECT-RESULT-LOW 
231005                                          (WS-CONNECT-RESULT-SUB).
231005     MOVE WS-CONNECT-PAIR-HIGH   TO WS-CONNECT-RESULT-HIGH
231005                                          (WS-CONNECT-RESULT-SUB).
231005     MOVE ZSUB                   TO WS-CONNECT-RESULT-ZONE
231005                                          (WS-CONNECT-RESULT-SUB).
231005     MOVE BPSUB                  TO WS-CONNECT-RESULT-BP  
231005                                          (WS-CONNECT-RESULT-SUB).
231005     MOVE RCP-SUB                TO WS-CONNECT-RESULT-RCP 
231005                                          (WS-CONNECT-RESULT-SUB).
231005     MOVE WS-PARTNER-ZONE-SUB    TO WS-CONNECT-RESULT-ZONE-2  
231005                                          (WS-CONNECT-RESULT-SUB).
231005     MOVE WS-PARTNER-BP-SUB      TO WS-CONNECT-RESULT-BP-2
231005                                          (WS-CONNECT-RESULT-SUB).
231005     MOVE WS-PARTNER-RCP-SUB     TO WS-CONNECT-RESULT-RCP-2   
231005                                          (WS-CONNECT-RESULT-SUB).
231005     MOVE WS-INP-RCP-MTRX-SEQ-NUM (ZSUB BPSUB RCP-SUB)
231005                                 TO WS-CONNECT-RESULT-RCP-SEQ 
231005                                          (WS-CONNECT-RESULT-SUB).
231005     MOVE WS-CONNECT-REQ-NUM-1   TO WS-CONNECT-RESULT-REQ-1   
231005                                          (WS-CONNECT-RESULT-SUB).
231005     MOVE WS-SOURCE-META-SUB     TO WS-CONNECT-RESULT-META-1  
231005                                          (WS-CONNECT-RESULT-SUB).
231005     MOVE WS-SOURCE-RATE-SUB     TO WS-CONNECT-RESULT-RATE-1  
231005                                          (WS-CONNECT-RESULT-SUB).
231005     MOVE WS-SOURCE-CAB-SUB      TO WS-CONNECT-RESULT-CAB-1   
231005                                          (WS-CONNECT-RESULT-SUB).
231005     MOVE WS-CONNECT-REQ-NUM-2   TO WS-CONNECT-RESULT-REQ-2   
231005                                          (WS-CONNECT-RESULT-SUB).
231005     MOVE WS-PARTNER-META-SUB    TO WS-CONNECT-RESULT-META-2  
231005                                          (WS-CONNECT-RESULT-SUB).
231005     MOVE WS-PARTNER-RATE-SUB    TO WS-CONNECT-RESULT-RATE-2  
231005                                          (WS-CONNECT-RESULT-SUB).
231005     MOVE WS-PARTNER-CAB-SUB     TO WS-CONNECT-RESULT-CAB-2   
231005                                          (WS-CONNECT-RESULT-SUB).
231005  
231005 7030-SAVE-DIRECT-INP-PAIR-X. 
231005     EXIT.

       7100-NEXT-BP-ZONE.   

           ADD 1                       TO ZSUB. 
           IF ZSUB > WS-INP-RCP-MTRX-ZONE-CNT   
              GO TO 8000-DONE-BEST-INP-RECIPE   
           END-IF.  

           MOVE ZERO                   TO BPSUB.

       7200-NEXT-BEST-PRICE.

           ADD 1                       TO BPSUB.

           IF BPSUB > WS-INP-BP-CNT 
              GO TO 7100-NEXT-BP-ZONE   
           END-IF.  

           MOVE ZERO                   TO RCP-SUB.  

       7300-NEXT-RECIPE.

           ADD 1                       TO RCP-SUB.  
           IF  RCP-SUB > WS-INP-RCP-MTRX-CNT(ZSUB BPSUB )   
               GO TO 7200-NEXT-BEST-PRICE   
           END-IF.  

           IF  WS-INP-RCP-SATISFIED(ZSUB RCP-SUB) NOT = 'Y' 
               GO TO 7300-NEXT-RECIPE   
           END-IF.  

           MOVE ZERO                   TO MSUB  
                                          HLD-INP-CABIN-CNT.

           MOVE SPACES                 TO WS-HLD-CNT-CHANGED.   
           MOVE WS-INP-RCP-MTRX-SEQ-NUM(ZSUB BPSUB RCP-SUB) 
                                       TO HLD-INP-RCP-SEQ-NUM.  

       7400-NEXT-META.  

           ADD 1                       TO MSUB. 

           IF MSUB NOT > WS-INP-RCP-MTRX-META-CNT(ZSUB BPSUB RCP-SUB)   
             IF WS-INP-RCP-MTRX-META-RATE-CNT (ZSUB BPSUB RCP-SUB MSUB) 
              < WS-INP-RCP-MTRX-REQ-CABIN-CNT (ZSUB BPSUB RCP-SUB MSUB) 
                GO TO 7300-NEXT-RECIPE  
             END-IF 
           END-IF.  


           MOVE ZERO                   TO HLD-META-CABIN-CNT(MSUB). 

           IF MSUB > WS-INP-RCP-MTRX-META-CNT(ZSUB BPSUB RCP-SUB)   
              COMPUTE HLD-INP-CABIN-CNT = HLD-INP-CABIN-CNT - 1 
              COMPUTE HLD-META-CABIN-CNT (MSUB) =   
              HLD-META-CABIN-CNT (MSUB) - 1 
              MOVE 'Y'                 TO WS-HLD-CNT-CHANGED
              GO TO 7800-FIND-NEXT-PATH 
           END-IF.  

           MOVE 1                      TO RSUB-META(MSUB)   
                                          CSUB-META(MSUB).  

       7500-FIND-NEXT-CABIN.

231005*    PROTECT INPUT MATRIX SUBSCRIPTS BEFORE TABLE ACCESS. 
231005     IF MSUB < 1 OR   
231005        MSUB > WS-INP-RCP-MTRX-META-CNT   
231005                   (ZSUB BPSUB RCP-SUB)   
231005        GO TO 7800-FIND-NEXT-PATH 
231005     END-IF.  

           MOVE RSUB-META(MSUB)        TO RSUB. 
           MOVE CSUB-META(MSUB)        TO CSUB. 

231005     IF RSUB < 1 OR   
231005        RSUB > WS-INP-RCP-MTRX-META-RATE-CNT  
231005                   (ZSUB BPSUB RCP-SUB MSUB)  
231005        GO TO 7800-FIND-NEXT-PATH 
231005     END-IF.  
231005  
231005     IF CSUB < 1 OR   
231005        CSUB > WS-INP-RCP-MTRX-RATE-CABIN-CNT 
231005                   (ZSUB BPSUB RCP-SUB MSUB RSUB) 
231005        GO TO 7800-FIND-NEXT-PATH 
231005     END-IF.  

           IF WS-INP-RCP-MTRX-RATE-CABIN-CNT
             (ZSUB BPSUB RCP-SUB MSUB RSUB) = ZERO  

              IF RSUB-META(MSUB) <  
                 WS-INP-RCP-MTRX-META-RATE-CNT(ZSUB BPSUB RCP-SUB MSUB )
                 ADD 1                 TO RSUB-META(MSUB)   
                 MOVE 1                TO CSUB-META(MSUB)   
                 GO TO 7500-FIND-NEXT-CABIN 
              ELSE  
                 IF HLD-META-CABIN-CNT(MSUB) =  
                    WS-INP-RCP-MTRX-REQ-CABIN-CNT   
                    (ZSUB BPSUB RCP-SUB MSUB )  
                     AND
                    ( WS-HLD-CNT-CHANGED NOT = 'Y') 
                    GO TO 7400-NEXT-META
                 ELSE   
                    GO TO 7300-NEXT-RECIPE  
                 END-IF 
              END-IF
           END-IF.  

           MOVE SPACES                 TO WS-CABIN-EXISTS   
                                          WS-RATE-EXISTS.   
           PERFORM VARYING WS-SUB FROM 1 BY 1   
                   UNTIL WS-SUB > HLD-INP-CABIN-CNT 

             IF WS-INP-RCP-MTRX-CABIN-NUM   
                (ZSUB BPSUB RCP-SUB MSUB RSUB CSUB) 
              = HLD-INP-CABIN-NUM (WS-SUB)  
                MOVE 'Y'               TO WS-CABIN-EXISTS   
                MOVE HLD-INP-CABIN-CNT TO WS-SUB
             END-IF 

             IF ( WS-INP-RCP-MTRX-REQ-NUM (ZSUB BPSUB RCP-SUB MSUB RSUB)
                  = 
                 HLD-INP-RATE-REQ-NUM(WS-SUB) ) 
                 MOVE 'Y'              TO WS-RATE-EXISTS
                 MOVE HLD-INP-CABIN-CNT 
                                       TO WS-SUB
             END-IF 
           END-PERFORM. 

           IF WS-CABIN-EXISTS = 'Y' 

              IF CSUB-META(MSUB) <  WS-INP-RCP-MTRX-RATE-CABIN-CNT  
                                    (ZSUB BPSUB RCP-SUB MSUB RSUB)  
             AND CSUB-META(MSUB) < WS-INP-RCP-MTRX-REQ-CABIN-CNT
                                   (ZSUB BPSUB RCP-SUB MSUB)
                 ADD 1                 TO CSUB-META (MSUB)  
                 GO TO 7500-FIND-NEXT-CABIN 
              ELSE  
                 IF HLD-INP-CABIN-CNT = 1   
                    IF (RSUB-META(MSUB) =   
                        WS-INP-RCP-MTRX-META-RATE-CNT   
                        (ZSUB BPSUB RCP-SUB MSUB )) 
                         AND (MSUB = 1) 
                       IF CSUB-META(MSUB) = 
                          WS-INP-RCP-MTRX-RATE-CABIN-CNT
                          (ZSUB BPSUB RCP-SUB MSUB RSUB)
                          GO TO 7300-NEXT-RECIPE
                       ELSE 
                          ADD 1        TO CSUB-META(MSUB)   
                          GO TO 7500-FIND-NEXT-CABIN
                       END-IF   
                    ELSE
                       IF MSUB = 1  
                          IF HLD-META-CABIN-CNT(MSUB) = 
                             WS-INP-RCP-MTRX-REQ-CABIN-CNT  
                             (ZSUB BPSUB RCP-SUB MSUB)  
                             ADD 1     TO RSUB-META(MSUB)   
                             MOVE 1    TO CSUB-META(MSUB)   
                             GO TO 7600-MOVE-CABIN  
                          END-IF
                       END-IF   
                    END-IF  
                 END-IF 
                 GO TO 7800-FIND-NEXT-PATH. 

           IF WS-RATE-EXISTS = 'Y'  
              IF RSUB-META(MSUB) <  
                 WS-INP-RCP-MTRX-META-RATE-CNT(ZSUB BPSUB RCP-SUB MSUB) 
                 ADD 1                 TO RSUB-META(MSUB)   
                 MOVE 1                TO CSUB-META(MSUB)   
                 GO TO 7500-FIND-NEXT-CABIN 
              ELSE  
                IF HLD-META-CABIN-CNT(MSUB) =   
                   WS-INP-RCP-MTRX-REQ-CABIN-CNT
                   (ZSUB BPSUB RCP-SUB MSUB)
                   GO TO 7400-NEXT-META 
                ELSE
                   GO TO 7900-PRV-NEXT-RATE 
                END-IF  
              END-IF
           END-IF.  

       7600-MOVE-CABIN. 

           IF WS-HLD-CNT-CHANGED = 'Y'  
              MOVE SPACES              TO WS-HLD-CNT-CHANGED
           END-IF.  

           ADD 1                       TO HLD-INP-CABIN-CNT 
                                          HLD-META-CABIN-CNT(MSUB). 

           MOVE WS-INP-RCP-MTRX-CABIN-NUM   
                (ZSUB BPSUB RCP-SUB MSUB RSUB CSUB) 
                                       TO   
                                   HLD-INP-CABIN-NUM(HLD-INP-CABIN-CNT).

           MOVE RSUB-META(MSUB)        TO   
                                    HLD-INP-RATE-SUB(HLD-INP-CABIN-CNT).
           MOVE CSUB-META(MSUB)        TO   
                                     HLD-INP-CAB-SUB(HLD-INP-CABIN-CNT).
           MOVE WS-INP-RCP-MTRX-REQ-NUM (ZSUB BPSUB RCP-SUB MSUB RSUB)  
                                       TO   
                                HLD-INP-RATE-REQ-NUM(HLD-INP-CABIN-CNT).
           MOVE MSUB                   TO   
                                  HLD-INP-META-SUB(HLD-INP-CABIN-CNT).  

           IF HLD-INP-CABIN-CNT > 1 
              COMPUTE WS-PRV-CNT = HLD-INP-CABIN-CNT - 1

              COMPUTE HLD-INP-CABIN-TOTAL(HLD-INP-CABIN-CNT) =  
              HLD-INP-CABIN-TOTAL(WS-PRV-CNT) + 
              WS-INP-RCP-MTRX-AVG-GROSS-AMT 
              (ZSUB BPSUB RCP-SUB MSUB RSUB CSUB)   
              IF HLD-INP-NORMAL-OCC < WS-INP-RCP-MTRX-NORMAL-CAP
                                    (ZSUB BPSUB RCP-SUB MSUB RSUB CSUB) 
                 MOVE WS-INP-RCP-MTRX-NORMAL-CAP
                                    (ZSUB BPSUB RCP-SUB MSUB RSUB CSUB) 
                                       TO HLD-INP-NORMAL-OCC
              END-IF
           ELSE 
             MOVE WS-INP-RCP-MTRX-NORMAL-CAP
                                    (ZSUB BPSUB RCP-SUB MSUB RSUB CSUB) 
                                       TO HLD-INP-NORMAL-OCC
             MOVE WS-INP-RCP-MTRX-AVG-GROSS-AMT 
                  (ZSUB BPSUB RCP-SUB MSUB RSUB CSUB)   
                                       TO   
                                 HLD-INP-CABIN-TOTAL(HLD-INP-CABIN-CNT) 
           END-IF.  

231005*    VALIDATE AND COLLECT A COMPLETE INPUT PAIR.  
231005     IF MCAVL1-CONNECT-REQ-IND = 'Y' AND  
231005        HLD-INP-CABIN-CNT = 2 
231005        PERFORM 7650-VALIDATE-INPUT-CON   
231005           THRU 7650-VALIDATE-INPUT-CON-EXIT  
231005        IF WS-CONNECT-PAIR-VALID-IND = 'Y'
231005           PERFORM 7670-COLLECT-INPUT-PAIR
231005              THRU 7670-COLLECT-INPUT-PAIR-EXIT   
231005        END-IF
231005        GO TO 7700-CHOOSE-NEXT
231005     END-IF.  

           IF HLD-INP-CABIN-CNT = WS-INP-CABIN-COUNT
              IF BPSUB = 1  
                IF WS-INP-RCP-BP-CABIN-TOTAL(BPSUB RCP-SUB) NOT > ZEROES
                   MOVE HLD-INP-CABIN-TOTAL(HLD-INP-CABIN-CNT)  
                                       TO   
                                WS-INP-RCP-BP-CABIN-TOTAL(BPSUB RCP-SUB)
                ELSE
                  IF HLD-INP-CABIN-TOTAL(HLD-INP-CABIN-CNT) <   
                     WS-INP-RCP-BP-CABIN-TOTAL(BPSUB RCP-SUB)   
                     MOVE HLD-INP-CABIN-TOTAL(HLD-INP-CABIN-CNT)
                                       TO   
                         WS-INP-RCP-BP-CABIN-TOTAL(BPSUB RCP-SUB)   
                  ELSE  
                    IF HLD-INP-CABIN-TOTAL(HLD-INP-CABIN-CNT) = 
                     WS-INP-RCP-BP-CABIN-TOTAL(BPSUB RCP-SUB)   
                     IF HLD-INP-NORMAL-OCC <
                        WS-INP-RCP-BP-NORM-OCC (BPSUB RCP-SUB)  
                        CONTINUE
                     ELSE   
                        GO TO 7700-CHOOSE-NEXT  
                     END-IF 
                    ELSE
                     GO TO 7700-CHOOSE-NEXT 
                    END-IF  
                  END-IF
                END-IF  
              ELSE  
                 IF BPSUB = 2   
                    IF HLD-INP-CABIN-TOTAL(HLD-INP-CABIN-CNT) > 
                       WS-INP-RCP-BP-CABIN-TOTAL(BPSUB RCP-SUB) 
                       MOVE HLD-INP-CABIN-TOTAL(HLD-INP-CABIN-CNT)  
                                       TO   
                          WS-INP-RCP-BP-CABIN-TOTAL(BPSUB RCP-SUB)  
                    ELSE
                     IF HLD-INP-CABIN-TOTAL(HLD-INP-CABIN-CNT) =
                      WS-INP-RCP-BP-CABIN-TOTAL(BPSUB RCP-SUB)  
                      IF HLD-INP-NORMAL-OCC <   
                         WS-INP-RCP-BP-NORM-OCC (BPSUB RCP-SUB) 
                         CONTINUE   
                      ELSE  
                         GO TO 7700-CHOOSE-NEXT 
                      END-IF
                     ELSE   
                      GO TO 7700-CHOOSE-NEXT
                     END-IF 
                    END-IF  
                 END-IF 
              END-IF

              MOVE BPSUB               TO WS-INP-RCP-BP-VALUE (BPSUB)   

              IF WS-INP-RCP-BP-CNT NOT > ZEROES 
                 MOVE WS-INP-RCP-MTRX-BP-CNT (ZSUB) 
                   TO WS-INP-RCP-BP-CNT 
              END-IF

              MOVE ZSUB                TO   
                                 WS-INP-RCP-BP-ZONE-SUB(BPSUB RCP-SUB)  
              MOVE WS-INP-RCP-MTRX-SEQ-NUM(ZSUB BPSUB RCP-SUB)  
                                       TO   
                 WS-INP-RCP-BP-RCP-SEQ-NUM (BPSUB RCP-SUB)  
              MOVE HLD-INP-CABIN-CNT   TO   
                  WS-INP-RCP-BP-CABIN-CNT(BPSUB RCP-SUB)
              MOVE HLD-INP-NORMAL-OCC  TO   
                  WS-INP-RCP-BP-NORM-OCC (BPSUB RCP-SUB)
              IF WS-INP-RCP-BP-RCP-CNT(BPSUB) NOT > ZEROES  
                 ADD 1                 TO WS-INP-RCP-BP-RCP-CNT(BPSUB)  
              ELSE  
                 MOVE SPACES           TO WS-RECIPE-FOUND   
                 PERFORM VARYING WS-SUB FROM 1 BY 1 
                         UNTIL WS-SUB > WS-INP-RCP-BP-RCP-CNT(BPSUB)
                    IF WS-INP-RCP-BP-RCP-SEQ-NUM(BPSUB WS-SUB)  
                     = WS-INP-RCP-BP-RCP-SEQ-NUM (BPSUB RCP-SUB)

                       MOVE 'Y'        TO WS-RECIPE-FOUND   
                       MOVE WS-INP-RCP-BP-RCP-CNT(BPSUB)
                                       TO WS-SUB
                    END-IF  
                 END-PERFORM
                 IF WS-RECIPE-FOUND NOT = 'Y'   
                    ADD 1              TO WS-INP-RCP-BP-RCP-CNT(BPSUB)  
                 END-IF 
              END-IF

              PERFORM VARYING WS-SUB FROM 1 BY 1
                      UNTIL WS-SUB > HLD-INP-CABIN-CNT  
                MOVE HLD-INP-RATE-SUB(WS-SUB)   
                                       TO   
                   WS-INP-RCP-BP-RATE-SUB(BPSUB RCP-SUB WS-SUB) 
                MOVE HLD-INP-CAB-SUB(WS-SUB)
                                       TO   
                    WS-INP-RCP-BP-CABIN-SUB(BPSUB RCP-SUB WS-SUB)   
                MOVE HLD-INP-META-SUB(WS-SUB)   
                                       TO   
                    WS-INP-RCP-BP-META-SUB(BPSUB RCP-SUB WS-SUB)
                MOVE HLD-INP-RATE-REQ-NUM(WS-SUB)   
                                       TO   
                    WS-INP-RCP-BP-REQ-NUM(BPSUB RCP-SUB WS-SUB) 
              END-PERFORM   
           END-IF.  

           IF HLD-INP-CABIN-CNT = WS-INP-CABIN-COUNT
              GO TO 7700-CHOOSE-NEXT
           END-IF.  

           IF HLD-META-CABIN-CNT(MSUB) =  WS-INP-RCP-MTRX-REQ-CABIN-CNT 
                                           (ZSUB BPSUB RCP-SUB MSUB)
               GO TO 7400-NEXT-META 
           END-IF.  


           IF RSUB-META(MSUB) < WS-INP-RCP-MTRX-META-RATE-CNT   
                                (ZSUB BPSUB RCP-SUB MSUB)   
              ADD 1                    TO RSUB-META(MSUB)   
              MOVE 1                   TO CSUB-META(MSUB)   
              GO TO 7500-FIND-NEXT-CABIN
           END-IF.  

231005     GO TO 7700-CHOOSE-NEXT.  
231005  
231005 7650-VALIDATE-INPUT-CON. 
231005     MOVE 'N'                    TO WS-CONNECT-PAIR-VALID-IND.
231005     MOVE SPACES                 TO WS-CONNECT-CABIN-1
231005                                    WS-CONNECT-CABIN-2
231005                                    WS-CONNECT-TO-CABIN-1 
231005                                    WS-CONNECT-TO-CABIN-2.
231005  
231005     IF HLD-INP-CABIN-CNT NOT = 2 
231005        GO TO 7650-VALIDATE-INPUT-CON-EXIT
231005     END-IF.  
231005  
231005     MOVE HLD-INP-RATE-REQ-NUM (1)
231005                                 TO WS-CONNECT-REQ-NUM-1. 
231005     MOVE HLD-INP-RATE-REQ-NUM (2)
231005                                 TO WS-CONNECT-REQ-NUM-2. 
231005  
231005*    THE CONNECTED CABINS MUST SATISFY TWO DIFFERENT  
231005*    CABIN REQUEST OCCURRENCES.   
231005     IF WS-CONNECT-REQ-NUM-1 < 1 OR   
231005        WS-CONNECT-REQ-NUM-1 > WS-INP-CABIN-COUNT OR  
231005        WS-CONNECT-REQ-NUM-2 < 1 OR   
231005        WS-CONNECT-REQ-NUM-2 > WS-INP-CABIN-COUNT 
231005        GO TO 7650-VALIDATE-INPUT-CON-EXIT
231005     END-IF.  
231005  
231005     IF WS-CONNECT-REQ-NUM-1 = WS-CONNECT-REQ-NUM-2   
231005        GO TO 7650-VALIDATE-INPUT-CON-EXIT
231005     END-IF.  
231005  
231005     MOVE HLD-INP-CABIN-NUM (1)  TO WS-CONNECT-CABIN-1.   
231005     MOVE HLD-INP-CABIN-NUM (2)  TO WS-CONNECT-CABIN-2.   
231005  
231005     MOVE HLD-INP-META-SUB (1)   TO WS-CONNECT-META-SUB-1.
231005     MOVE HLD-INP-META-SUB (2)   TO WS-CONNECT-META-SUB-2.
231005     MOVE HLD-INP-RATE-SUB (1)   TO WS-CONNECT-RATE-SUB-1.
231005     MOVE HLD-INP-RATE-SUB (2)   TO WS-CONNECT-RATE-SUB-2.
231005     MOVE HLD-INP-CAB-SUB (1)    TO WS-CONNECT-CAB-SUB-1. 
231005     MOVE HLD-INP-CAB-SUB (2)    TO WS-CONNECT-CAB-SUB-2. 
231005  
231005     MOVE WS-INP-RCP-MTRX-CONN-CAB-NUM
231005                         (ZSUB BPSUB RCP-SUB WS-CONNECT-META-SUB-1
231005                       WS-CONNECT-RATE-SUB-1 WS-CONNECT-CAB-SUB-1)
231005                                 TO WS-CONNECT-TO-CABIN-1.
231005  
231005     MOVE WS-INP-RCP-MTRX-CONN-CAB-NUM
231005                         (ZSUB BPSUB RCP-SUB WS-CONNECT-META-SUB-2
231005                       WS-CONNECT-RATE-SUB-2 WS-CONNECT-CAB-SUB-2)
231005                                 TO WS-CONNECT-TO-CABIN-2.
231005  
231005     IF WS-CONNECT-TO-CABIN-1 = WS-CONNECT-CABIN-2 AND
231005        WS-CONNECT-TO-CABIN-2 = WS-CONNECT-CABIN-1
231005        MOVE 'Y'                 TO WS-CONNECT-PAIR-VALID-IND 
231005     END-IF.  
231005  
231005 7650-VALIDATE-INPUT-CON-EXIT.
231005     EXIT.
231005  
231005 7670-COLLECT-INPUT-PAIR. 
231005  
231005     IF WS-CONNECT-CABIN-1 < WS-CONNECT-CABIN-2   
231005        MOVE WS-CONNECT-CABIN-1  TO WS-CONNECT-PAIR-LOW   
231005        MOVE WS-CONNECT-CABIN-2  TO WS-CONNECT-PAIR-HIGH  
231005     ELSE 
231005        MOVE WS-CONNECT-CABIN-2  TO WS-CONNECT-PAIR-LOW   
231005        MOVE WS-CONNECT-CABIN-1  TO WS-CONNECT-PAIR-HIGH  
231005     END-IF.  
231005  
231005     MOVE 'N'                    TO WS-CONNECT-DUPLICATE-IND. 
231005     PERFORM VARYING WS-CONNECT-RESULT-SUB FROM 1 BY 1
231005       UNTIL WS-CONNECT-RESULT-SUB > WS-CONNECT-RESULT-CNT
231005        IF WS-CONNECT-RESULT-LOW (WS-CONNECT-RESULT-SUB) =
231005              WS-CONNECT-PAIR-LOW AND 
231005           WS-CONNECT-RESULT-HIGH (WS-CONNECT-RESULT-SUB) =   
231005              WS-CONNECT-PAIR-HIGH
231005           MOVE 'Y'              TO WS-CONNECT-DUPLICATE-IND  
231005        END-IF
231005     END-PERFORM. 
231005  
231005     IF WS-CONNECT-DUPLICATE-IND = 'Y'
231005        GO TO 7670-COLLECT-INPUT-PAIR-EXIT
231005     END-IF.  
231005     IF WS-CONNECT-RESULT-CNT >= 10   
231005        GO TO 7670-COLLECT-INPUT-PAIR-EXIT
231005     END-IF.  
231005  
231005     ADD 1                       TO WS-CONNECT-RESULT-CNT.
231005     MOVE WS-CONNECT-RESULT-CNT  TO WS-CONNECT-RESULT-SUB.
231005  
231005     MOVE 'I'                    TO WS-CONNECT-RESULT-SOURCE  
231005                                          (WS-CONNECT-RESULT-SUB).
231005     MOVE WS-CONNECT-PAIR-LOW    TO WS-CONNECT-RESULT-LOW 
231005                                          (WS-CONNECT-RESULT-SUB).
231005     MOVE WS-CONNECT-PAIR-HIGH   TO WS-CONNECT-RESULT-HIGH
231005                                          (WS-CONNECT-RESULT-SUB).
231005     MOVE ZSUB                   TO WS-CONNECT-RESULT-ZONE
231005                                          (WS-CONNECT-RESULT-SUB).
231005     MOVE BPSUB                  TO WS-CONNECT-RESULT-BP  
231005                                          (WS-CONNECT-RESULT-SUB).
231005     MOVE RCP-SUB                TO WS-CONNECT-RESULT-RCP 
231005                                          (WS-CONNECT-RESULT-SUB).
231005     MOVE ZSUB                   TO WS-CONNECT-RESULT-ZONE-2  
231005                                          (WS-CONNECT-RESULT-SUB).
231005     MOVE BPSUB                  TO WS-CONNECT-RESULT-BP-2
231005                                          (WS-CONNECT-RESULT-SUB).
231005     MOVE RCP-SUB                TO WS-CONNECT-RESULT-RCP-2   
231005                                          (WS-CONNECT-RESULT-SUB).
231005     MOVE HLD-INP-RCP-SEQ-NUM    TO WS-CONNECT-RESULT-RCP-SEQ 
231005                                          (WS-CONNECT-RESULT-SUB).
231005     MOVE HLD-INP-RATE-REQ-NUM (1)
231005                                 TO WS-CONNECT-RESULT-REQ-1   
231005                                          (WS-CONNECT-RESULT-SUB).
231005     MOVE HLD-INP-META-SUB (1)   TO WS-CONNECT-RESULT-META-1  
231005                                          (WS-CONNECT-RESULT-SUB).
231005     MOVE HLD-INP-RATE-SUB (1)   TO WS-CONNECT-RESULT-RATE-1  
231005                                          (WS-CONNECT-RESULT-SUB).
231005     MOVE HLD-INP-CAB-SUB (1)    TO WS-CONNECT-RESULT-CAB-1   
231005                                          (WS-CONNECT-RESULT-SUB).
231005     MOVE HLD-INP-RATE-REQ-NUM (2)
231005                                 TO WS-CONNECT-RESULT-REQ-2   
231005                                          (WS-CONNECT-RESULT-SUB).
231005     MOVE HLD-INP-META-SUB (2)   TO WS-CONNECT-RESULT-META-2  
231005                                          (WS-CONNECT-RESULT-SUB).
231005     MOVE HLD-INP-RATE-SUB (2)   TO WS-CONNECT-RESULT-RATE-2  
231005                                          (WS-CONNECT-RESULT-SUB).
231005     MOVE HLD-INP-CAB-SUB (2)    TO WS-CONNECT-RESULT-CAB-2   
231005                                          (WS-CONNECT-RESULT-SUB).
231005  
231005 7670-COLLECT-INPUT-PAIR-EXIT.
231005     EXIT.

       7700-CHOOSE-NEXT.

           IF HLD-INP-CABIN-CNT = WS-INP-CABIN-COUNT
              COMPUTE HLD-INP-CABIN-CNT = HLD-INP-CABIN-CNT - 1 
              COMPUTE HLD-META-CABIN-CNT(MSUB) =
                 HLD-META-CABIN-CNT(MSUB)  - 1  
              MOVE 'Y'                 TO WS-HLD-CNT-CHANGED
           END-IF.  

           IF CSUB-META (MSUB) < WS-INP-RCP-MTRX-RATE-CABIN-CNT 
                                 (ZSUB BPSUB RCP-SUB MSUB RSUB) 
              ADD 1                    TO CSUB-META (MSUB)  
              GO TO 7500-FIND-NEXT-CABIN
           END-IF.  

       7800-FIND-NEXT-PATH. 

           IF  HLD-INP-CABIN-CNT = 0
               GO TO 7300-NEXT-RECIPE   
           END-IF.  

           MOVE HLD-INP-META-SUB(HLD-INP-CABIN-CNT) 
                                       TO MSUB. 
           MOVE HLD-INP-RATE-SUB(HLD-INP-CABIN-CNT) 
                                       TO RSUB-META(MSUB)   
                                          RSUB. 

           IF  ( HLD-INP-CAB-SUB(HLD-INP-CABIN-CNT) + 1 ) > 
               WS-INP-RCP-MTRX-RATE-CABIN-CNT   
               (ZSUB BPSUB RCP-SUB  MSUB RSUB)  
               IF MSUB = 1 AND  
                 ( RSUB-META(MSUB)  = WS-INP-RCP-MTRX-META-RATE-CNT 
                                    (ZSUB BPSUB RCP-SUB MSUB )) 
                  GO TO 7300-NEXT-RECIPE
               END-IF   
               COMPUTE HLD-INP-CABIN-CNT = HLD-INP-CABIN-CNT - 1
               COMPUTE HLD-META-CABIN-CNT(MSUB) =   
                       HLD-META-CABIN-CNT(MSUB)  - 1
               MOVE 'Y'                TO WS-HLD-CNT-CHANGED
               GO TO 7800-FIND-NEXT-PATH.   

           COMPUTE CSUB-META(MSUB) =
                   HLD-INP-CAB-SUB(HLD-INP-CABIN-CNT) + 1.  
           COMPUTE HLD-INP-CABIN-CNT = HLD-INP-CABIN-CNT - 1
           COMPUTE HLD-META-CABIN-CNT(MSUB) =   
                   HLD-META-CABIN-CNT(MSUB)  - 1
           MOVE 'Y'                    TO WS-HLD-CNT-CHANGED
           GO TO 7500-FIND-NEXT-CABIN.  


       7900-PRV-NEXT-RATE.  
           IF HLD-INP-CABIN-CNT = 1 
              GO TO 7800-FIND-NEXT-PATH 
           END-IF.  

           COMPUTE HLD-INP-CABIN-CNT = HLD-INP-CABIN-CNT - 1.   
           COMPUTE HLD-META-CABIN-CNT(MSUB) =   
                 HLD-META-CABIN-CNT(MSUB)  - 1. 
           MOVE 'Y'                    TO WS-HLD-CNT-CHANGED.   

           IF HLD-INP-META-SUB(HLD-INP-CABIN-CNT) > 1   
              IF MSUB = HLD-INP-META-SUB(HLD-INP-CABIN-CNT) 
                 GO TO 7900-PRV-NEXT-RATE   
              ELSE  
                 IF RSUB-META(MSUB) < WS-INP-RCP-MTRX-META-RATE-CNT 
                                      (ZSUB BPSUB RCP-SUB MSUB )
                    ADD 1              TO RSUB-META(MSUB)   
                    MOVE 1             TO CSUB-META(MSUB)   
                    MOVE HLD-INP-META-SUB(HLD-INP-CABIN-CNT)
                                       TO  MSUB 
                    GO TO 7500-FIND-NEXT-CABIN  
                 ELSE   
                    GO TO 7900-PRV-NEXT-RATE
                 END-IF 
              END-IF
           ELSE 
      ***** AN ANOMOLY WHICH SHOULD NOT EXIST.  
              IF RSUB-META(MSUB) < WS-INP-RCP-MTRX-META-RATE-CNT
                                   (ZSUB BPSUB RCP-SUB MSUB )   
                 ADD 1                 TO RSUB-META(MSUB)   
                 MOVE 1                TO CSUB-META(MSUB)   
                 MOVE HLD-INP-META-SUB(HLD-INP-CABIN-CNT)   
                                       TO  MSUB 
                 GO TO 7500-FIND-NEXT-CABIN 
              ELSE  
                 GO TO 7300-NEXT-RECIPE 
              END-IF
           END-IF.  

       8000-DONE-BEST-INP-RECIPE.   

231005     IF MCAVL1-CONNECT-REQ-IND = 'Y'  
231005        GO TO 8020-BUILD-CONNECT-OUTPUT   
231005     END-IF.  

           MOVE ZERO                   TO ZSUB  
                                          BPSUB 
                                          RSUB  
                                          CABSUB.   

231005*    BYPASS CONNECTED OUTPUT FOR BLANK OR N REQUESTS. 
231005     GO TO 8050-BUILD-OUTPUT-NEXT-INP-RCP.
231005  
231005 8020-BUILD-CONNECT-OUTPUT.   
231005  
231005     MOVE ZERO                   TO TOT-CABGRP TOT-CABSUB 
231005                                    WS-CONNECT-RESULT-SUB 
231005                                    WS-TOT-PAX.   
231005  
231005     PERFORM VARYING WS-SUB FROM 1 BY 1   
231005       UNTIL WS-SUB > MCACIN-SUB  
231005        COMPUTE WS-TOT-PAX = WS-TOT-PAX + MCACIN-NUM-PAX (WS-SUB) 
231005     END-PERFORM. 
231005  
231005 8025-NEXT-CONNECT-PAIR.  
231005  
231005     ADD 1 TO WS-CONNECT-RESULT-SUB.  
231005  
231005     IF WS-CONNECT-RESULT-SUB > WS-CONNECT-RESULT-CNT 
231005        GO TO 8150-SEND-OUTPUT
231005     END-IF.  
231005  
231005     IF TOT-CABGRP >= 10 OR TOT-CABSUB + 2 > 50   
231005        GO TO 8150-SEND-OUTPUT
231005     END-IF.  
231005  
231005*    VALIDATE BOTH SAVED CABINS BEFORE ANY MATRIX ACCESS. 
231005     MOVE 1 TO CSUB.  
231005  
231005     PERFORM 8040-LOAD-CONNECT-COORDINATES
231005        THRU 8040-LOAD-CON-COORD-EXIT.
231005  
231005     IF WS-CONNECT-PAIR-VALID-IND NOT = 'Y'   
231005        GO TO 8025-NEXT-CONNECT-PAIR  
231005     END-IF.  
231005  
231005     MOVE 2 TO CSUB.  
231005  
231005     PERFORM 8040-LOAD-CONNECT-COORDINATES
231005        THRU 8040-LOAD-CON-COORD-EXIT.
231005  
231005     IF WS-CONNECT-PAIR-VALID-IND NOT = 'Y'   
231005        GO TO 8025-NEXT-CONNECT-PAIR  
231005     END-IF.  
231005  
231005     MOVE TOT-CABSUB TO WS-CONNECT-PAIR-CAB-START.
231005  
231005     ADD 1                       TO TOT-CABGRP.   
231005  
231005     MOVE ZERO                   TO MCACAG-TOTAVG-CABIN-AMT   
231005                                                      (TOT-CABGRP)
231005                                    MCACAG-TOTAVG-ADDON-AMT   
231005                                                      (TOT-CABGRP)
231005                                    MCACAG-TOTAVG-CRUISE-AMT  
231005                                                      (TOT-CABGRP)
231005                                    MCACAG-TOTAL-CRUISE-AMT   
231005                                                     (TOT-CABGRP).
231005  
231005     MOVE WS-CONNECT-RESULT-ZONE (WS-CONNECT-RESULT-SUB)  
231005                                 TO ZSUB. 
231005     MOVE WS-CONNECT-RESULT-BP (WS-CONNECT-RESULT-SUB)
231005                                 TO BPSUB.
231005  
231005     IF WS-CONNECT-RESULT-SOURCE (WS-CONNECT-RESULT-SUB) = 'D'
231005        MOVE WS-RCP-MTRX-DECK-CODE (ZSUB) 
231005                                 TO MCACAG-DECK-CODE  (TOT-CABGRP)
231005        MOVE WS-RCP-MTRX-FMA-IND (ZSUB)   
231005                                 TO MCACAG-FWD-MID-AFT-CODE   
231005                                                      (TOT-CABGRP)
231005        MOVE ZERO                TO MCACAG-RCP-SEQ-NUM
231005                                                      (TOT-CABGRP)
231005     ELSE 
231005        IF WS-CONNECT-RESULT-ZONE-2 (WS-CONNECT-RESULT-SUB) < 1 OR
231005           WS-CONNECT-RESULT-ZONE-2 (WS-CONNECT-RESULT-SUB) > 
231005           WS-INP-RCP-MTRX-ZONE-CNT   
231005           MOVE LOW-VALUES       TO MCACAG-SEGMENT (TOT-CABGRP)   
231005           SUBTRACT 1 FROM TOT-CABGRP 
231005           GO TO 8025-NEXT-CONNECT-PAIR   
231005        END-IF
231005  
231005*       USE REQUEST 1 LOCATION FOR THE CABIN GROUP HEADER.
231005*       EACH CABIN STILL USES ITS OWN COMPLETE COORDINATES.   
231005        MOVE WS-INP-RCP-MTRX-DECK-CODE (ZSUB) 
231005                                 TO MCACAG-DECK-CODE  (TOT-CABGRP)
231005        MOVE WS-INP-RCP-MTRX-FMA-IND (ZSUB)   
231005                                 TO MCACAG-FWD-MID-AFT-CODE   
231005                                                      (TOT-CABGRP)
231005        MOVE WS-CONNECT-RESULT-RCP-SEQ (WS-CONNECT-RESULT-SUB)
231005                                 TO MCACAG-RCP-SEQ-NUM
231005                                                      (TOT-CABGRP)
231005     END-IF.  
231005  
231005     MOVE ZERO TO CSUB.   
231005  
231005 8030-NEXT-CONNECT-CABIN. 
231005  
231005     ADD 1 TO CSUB.   
231005  
231005     IF CSUB > 2  
231005        COMPUTE MCACAG-TOTAVG-CABIN-AMT (TOT-CABGRP) =
231005          MCACAG-TOTAVG-CABIN-AMT (TOT-CABGRP) / WS-TOT-PAX   
231005        COMPUTE MCACAG-TOTAVG-ADDON-AMT (TOT-CABGRP) =
231005          MCACAG-TOTAVG-ADDON-AMT (TOT-CABGRP) / 2
231005        GO TO 8025-NEXT-CONNECT-PAIR  
231005     END-IF.  
231005  
231005     PERFORM 8040-LOAD-CONNECT-COORDINATES
231005        THRU 8040-LOAD-CON-COORD-EXIT.
231005  
231005     IF WS-CONNECT-PAIR-VALID-IND NOT = 'Y'   
231005        MOVE WS-CONNECT-PAIR-CAB-START TO TOT-CABSUB  
231005        MOVE LOW-VALUES          TO MCACAG-SEGMENT (TOT-CABGRP)   
231005        SUBTRACT 1 FROM TOT-CABGRP
231005        GO TO 8025-NEXT-CONNECT-PAIR  
231005     END-IF.  
231005  
231005     ADD 1                       TO TOT-CABSUB.   
231005     MOVE ZERO                   TO WS-ADV-SUB.   
231005     MOVE TOT-CABGRP             TO MCACAV-OWNER-SUB (TOT-CABSUB).
231005     MOVE CSUB                   TO MCACAV-SEQ-NUM (TOT-CABSUB).  
231005  
231005     IF WS-CONNECT-RESULT-SOURCE (WS-CONNECT-RESULT-SUB) = 'D'
231005        PERFORM 8045-OUT-DFLT-CON-CAB 
231005           THRU 8045-OUT-DFLT-CON-CAB-EXIT
231005     ELSE 
231005        PERFORM 8055-OUT-INP-CON-CAB  
231005           THRU 8055-OUT-INP-CON-CAB-EXIT 
231005     END-IF.  
231005     GO TO 8030-NEXT-CONNECT-CABIN.   
231005  
231005 8040-LOAD-CONNECT-COORDINATES.   
231005  
231005     MOVE 'N' TO WS-CONNECT-PAIR-VALID-IND.   
231005  
231005     IF WS-CONNECT-RESULT-SUB < 1 OR  
231005        WS-CONNECT-RESULT-SUB > WS-CONNECT-RESULT-CNT OR  
231005        WS-CONNECT-RESULT-SUB > 10
231005        GO TO 8040-LOAD-CON-COORD-EXIT
231005     END-IF.  
231005  
231005*    VALIDATE THE SAVED CONNECTED-RESULT IDENTITY.
231005     IF WS-CONNECT-RESULT-SOURCE  
231005          (WS-CONNECT-RESULT-SUB) NOT = 'D' AND   
231005        WS-CONNECT-RESULT-SOURCE  
231005          (WS-CONNECT-RESULT-SUB) NOT = 'I'   
231005        GO TO 8040-LOAD-CON-COORD-EXIT
231005     END-IF.  
231005  
231005     IF WS-CONNECT-RESULT-REQ-1 (WS-CONNECT-RESULT-SUB) < 1 OR
231005        WS-CONNECT-RESULT-REQ-1 (WS-CONNECT-RESULT-SUB) > 
231005        WS-INP-CABIN-COUNT OR 
231005        WS-CONNECT-RESULT-REQ-2 (WS-CONNECT-RESULT-SUB) < 1 OR
231005        WS-CONNECT-RESULT-REQ-2 (WS-CONNECT-RESULT-SUB) > 
231005        WS-INP-CABIN-COUNT OR 
231005        WS-CONNECT-RESULT-REQ-1 (WS-CONNECT-RESULT-SUB) = 
231005        WS-CONNECT-RESULT-REQ-2 (WS-CONNECT-RESULT-SUB)   
231005        GO TO 8040-LOAD-CON-COORD-EXIT
231005     END-IF.  
231005  
231005*    SELECT ONLY AN EXPLICIT REQUEST 1 OR REQUEST 2 MATCH.
231005     EVALUATE CSUB
231005        WHEN WS-CONNECT-RESULT-REQ-1       (WS-CONNECT-RESULT-SUB)
231005           MOVE WS-CONNECT-RESULT-META-1   (WS-CONNECT-RESULT-SUB)
231005                                 TO MSUB  
231005           MOVE WS-CONNECT-RESULT-RATE-1   (WS-CONNECT-RESULT-SUB)
231005                                 TO RSUB  
231005           MOVE WS-CONNECT-RESULT-CAB-1    (WS-CONNECT-RESULT-SUB)
231005                                 TO CABSUB
231005           MOVE WS-CONNECT-RESULT-ZONE     (WS-CONNECT-RESULT-SUB)
231005                                 TO  ZSUB 
231005           MOVE WS-CONNECT-RESULT-BP       (WS-CONNECT-RESULT-SUB)
231005                                 TO  BPSUB
231005           MOVE WS-CONNECT-RESULT-RCP      (WS-CONNECT-RESULT-SUB)
231005                                 TO  RCP-SUB  
231005        WHEN WS-CONNECT-RESULT-REQ-2       (WS-CONNECT-RESULT-SUB)
231005           MOVE WS-CONNECT-RESULT-META-2   (WS-CONNECT-RESULT-SUB)
231005                                 TO MSUB  
231005           MOVE WS-CONNECT-RESULT-RATE-2   (WS-CONNECT-RESULT-SUB)
231005                                 TO RSUB  
231005           MOVE WS-CONNECT-RESULT-CAB-2    (WS-CONNECT-RESULT-SUB)
231005                                 TO CABSUB
231005           IF WS-CONNECT-RESULT-SOURCE
231005                (WS-CONNECT-RESULT-SUB) = 'D' 
231005              MOVE WS-CONNECT-RESULT-ZONE  (WS-CONNECT-RESULT-SUB)
231005                                 TO ZSUB  
231005              MOVE WS-CONNECT-RESULT-BP    (WS-CONNECT-RESULT-SUB)
231005                                 TO BPSUB 
231005              MOVE WS-CONNECT-RESULT-RCP   (WS-CONNECT-RESULT-SUB)
231005                                 TO RCP-SUB   
231005           ELSE   
231005              MOVE WS-CONNECT-RESULT-ZONE-2(WS-CONNECT-RESULT-SUB)
231005                                 TO ZSUB  
231005              MOVE WS-CONNECT-RESULT-BP-2  (WS-CONNECT-RESULT-SUB)
231005                                 TO BPSUB 
231005              MOVE WS-CONNECT-RESULT-RCP-2 (WS-CONNECT-RESULT-SUB)
231005                                 TO RCP-SUB   
231005           END-IF 
231005        WHEN OTHER
231005           GO TO 8040-LOAD-CON-COORD-EXIT 
231005     END-EVALUATE.
231005  
231005     IF WS-CONNECT-RESULT-SOURCE (WS-CONNECT-RESULT-SUB) = 'D'
231005        IF ZSUB < 1 OR ZSUB > WS-RCP-MTRX-ZONE-CNT
231005           GO TO 8040-LOAD-CON-COORD-EXIT 
231005        END-IF
231005        IF BPSUB < 1 OR BPSUB > WS-RCP-MTRX-BEST-PRICE-CNT (ZSUB) 
231005           GO TO 8040-LOAD-CON-COORD-EXIT 
231005        END-IF
231005        IF RSUB < 1 OR RSUB > WS-RCP-MTRX-RATE-CNT (ZSUB BPSUB)   
231005           GO TO 8040-LOAD-CON-COORD-EXIT 
231005        END-IF
231005        IF CABSUB < 1 OR CABSUB > 
231005           WS-RCP-MTRX-RATE-CABIN-CNT (ZSUB BPSUB RSUB)   
231005           GO TO 8040-LOAD-CON-COORD-EXIT 
231005        END-IF
231005     ELSE 
231005        IF ZSUB < 1 OR ZSUB > WS-INP-RCP-MTRX-ZONE-CNT
231005           GO TO 8040-LOAD-CON-COORD-EXIT 
231005        END-IF
231005        IF BPSUB < 1 OR BPSUB > WS-INP-RCP-MTRX-BP-CNT (ZSUB) 
231005           GO TO 8040-LOAD-CON-COORD-EXIT 
231005        END-IF
231005        IF RCP-SUB < 1 OR RCP-SUB >   
231005           WS-INP-RCP-MTRX-CNT (ZSUB BPSUB)   
231005           GO TO 8040-LOAD-CON-COORD-EXIT 
231005        END-IF
231005        IF MSUB < 1 OR MSUB > 
231005           WS-INP-RCP-MTRX-META-CNT (ZSUB BPSUB RCP-SUB)  
231005           GO TO 8040-LOAD-CON-COORD-EXIT 
231005        END-IF
231005        IF RSUB < 1 OR RSUB > WS-INP-RCP-MTRX-META-RATE-CNT   
231005           (ZSUB BPSUB RCP-SUB MSUB)  
231005           GO TO 8040-LOAD-CON-COORD-EXIT 
231005        END-IF
231005        IF CABSUB < 1 OR CABSUB > WS-INP-RCP-MTRX-RATE-CABIN-CNT  
231005           (ZSUB BPSUB RCP-SUB MSUB RSUB) 
231005           GO TO 8040-LOAD-CON-COORD-EXIT 
231005        END-IF
231005     END-IF.  
231005  
231005     MOVE 'Y' TO WS-CONNECT-PAIR-VALID-IND.   
231005  
231005 8040-LOAD-CON-COORD-EXIT.
231005     EXIT.
231005  
231005 8045-OUT-DFLT-CON-CAB.   
231005  
231005     COMPUTE MCACAG-TOTAVG-CABIN-AMT (TOT-CABGRP) =   
231005       MCACAG-TOTAVG-CABIN-AMT (TOT-CABGRP) + 
231005       WS-RCP-MTRX-TOT-CR-FARE-AMT (ZSUB BPSUB RSUB CABSUB).  
231005  
231005     COMPUTE MCACAG-TOTAVG-ADDON-AMT (TOT-CABGRP) =   
231005       MCACAG-TOTAVG-ADDON-AMT (TOT-CABGRP) + 
231005       WS-RCP-MTRX-AVG-ADDON-AMT (ZSUB BPSUB RSUB CABSUB).
231005  
231005     COMPUTE MCACAG-TOTAVG-CRUISE-AMT (TOT-CABGRP) =  
231005       MCACAG-TOTAVG-CRUISE-AMT (TOT-CABGRP) +
231005       WS-RCP-MTRX-TOT-CR-FARE-AMT (ZSUB BPSUB RSUB CABSUB).  
231005  
231005     COMPUTE MCACAG-TOTAL-CRUISE-AMT (TOT-CABGRP) =   
231005       MCACAG-TOTAL-CRUISE-AMT (TOT-CABGRP) + 
231005       WS-RCP-MTRX-GROSS-AMT (ZSUB BPSUB RSUB CABSUB).
231005  
231005     MOVE WS-RCP-MTRX-OFFER-CODE (ZSUB BPSUB RSUB)
231005       TO MCACAV-OFFER-CODE (TOT-CABSUB). 
231005  
231005     MOVE WS-RCP-MTRX-CABIN-NUM (ZSUB BPSUB RSUB CABSUB)  
231005       TO MCACAV-CABIN-NUM (TOT-CABSUB).  
231005  
231005     MOVE WS-RCP-MTRX-META-CAT-CODE (ZSUB)
231005       TO MCACAV-META-CAT-CODE (TOT-CABSUB).  
231005  
231005     MOVE WS-RCP-MTRX-CAT-CODE (ZSUB BPSUB RSUB CABSUB)   
231005       TO MCACAV-CAT-CODE (TOT-CABSUB).   
231005  
231005*    RETAIN LEGACY UPGRADE CODE MAPPING.  
231005     IF MCACAV-CAT-CODE (TOT-CABSUB) NOT =
231005        WS-RCP-MTRX-CPA-CAT-CODE (ZSUB BPSUB RSUB CABSUB) 
231005        MOVE WS-RCP-MTRX-CPA-CAT-CODE (ZSUB BPSUB RSUB CABSUB)
231005                                 TO MCACAV-UPGRADE-CODE   
231005                                                      (TOT-CABSUB)
231005     END-IF.  
231005  
231005     MOVE WS-RCP-MTRX-AVG-CR-FARE-AMT (ZSUB BPSUB RSUB CABSUB)
231005                                 TO MCACAV-AVG-CABIN-AMT  
231005                                                     (TOT-CABSUB).
231005     MOVE WS-RCP-MTRX-AVG-ADDON-AMT (ZSUB BPSUB RSUB CABSUB)  
231005                                 TO MCACAV-AVG-ADDON-AMT  
231005                                                     (TOT-CABSUB).
231005     MOVE WS-RCP-MTRX-TOT-CR-FARE-AMT (ZSUB BPSUB RSUB CABSUB)
231005                                 TO MCACAV-TOT-CABIN-AMT  
231005                                                     (TOT-CABSUB).
231005     MOVE WS-RCP-MTRX-GROSS-AMT (ZSUB BPSUB RSUB CABSUB)  
231005                                 TO MCACAV-TOT-CRUISE-AMT 
231005                                                     (TOT-CABSUB).
231005     MOVE WS-RCP-MTRX-CONNECT-CAB-NUM (ZSUB BPSUB RSUB CABSUB)
231005                                 TO MCACAV-CONNECT-CABIN-NUM  
231005                                                     (TOT-CABSUB).
231005  
231005*    RETAIN LEGACY OCCUPANCY ADVISORY.
231005     IF WS-RCP-MTRX-INFO-MSG (ZSUB BPSUB RSUB CABSUB) = 'Y'   
231005        ADD 1 TO WS-ADV-SUB   
231005        MOVE '1230'              TO MCAADV-ADVISORY-CODE  
231005                                           (TOT-CABSUB WS-ADV-SUB)
231005        STRING
231005          'The stateroom category selected has an occupancy'  
231005          ' restriction. Changes in occupancy may result in'  
231005          ' a change in fare' 
231005          DELIMITED BY SIZE INTO MCAADV-ADVISORY-TEXT 
231005             (TOT-CABSUB WS-ADV-SUB)  
231005        MOVE '0026/25211001/CCR48MCA' 
231005                                 TO MCAADV-CONDITION-CODE 
231005                                           (TOT-CABSUB WS-ADV-SUB)
231005     END-IF.  
231005  
231005*    RETAIN LEGACY CLOUD 9 SPA ADVISORY.  
231005     IF WS-RCP-MTRX-SPL-CAT-CODE  
231005          (ZSUB BPSUB RSUB CABSUB) = 'Y'  
231005        ADD 1 TO WS-ADV-SUB   
231005        MOVE '1200' TO MCAADV-ADVISORY-CODE   
231005             (TOT-CABSUB WS-ADV-SUB)  
231005        STRING
231005          'Good call!! That’s not just any stateroom you’ve'  
231005          ' got there — that’s a Cloud 9 Spa stateroom!'  
231005          'Enjoy your complimentary spa access, including '   
231005          'Thalassotherapy Pool and Thermal Suites. ' 
231005          DELIMITED BY SIZE INTO MCAADV-ADVISORY-TEXT 
231005             (TOT-CABSUB WS-ADV-SUB)  
231005        MOVE '0027/25211002/CCR48MCA' 
231005                                 TO MCAADV-CONDITION-CODE 
231005                                           (TOT-CABSUB WS-ADV-SUB)
231005     END-IF.  
231005  
231005     STRING MCAVL1-SHIP-CODE MCACAV-META-CAT-CODE (TOT-CABSUB)
231005            WS-RCP-MTRX-SPL-CAT-CODE (ZSUB BPSUB RSUB CABSUB) 
231005            WS-RCP-MTRX-VIEW-IND (ZSUB BPSUB RSUB CABSUB) 
231005       DELIMITED BY SIZE INTO MCACAV-CABIN-TYPE (TOT-CABSUB). 
231005  
231005 8045-OUT-DFLT-CON-CAB-EXIT.  
231005     EXIT.
231005  
231005 8055-OUT-INP-CON-CAB.
231005  
231005     COMPUTE MCACAG-TOTAVG-CABIN-AMT (TOT-CABGRP) =   
231005       MCACAG-TOTAVG-CABIN-AMT (TOT-CABGRP) + 
231005       WS-INP-RCP-MTRX-TOT-CR-FR-AMT  
231005       (ZSUB BPSUB RCP-SUB MSUB RSUB CABSUB). 
231005  
231005     COMPUTE MCACAG-TOTAVG-ADDON-AMT (TOT-CABGRP) =   
231005       MCACAG-TOTAVG-ADDON-AMT (TOT-CABGRP) + 
231005       WS-INP-RCP-MTRX-AVG-ADDON-AMT  
231005       (ZSUB BPSUB RCP-SUB MSUB RSUB CABSUB). 
231005  
231005     COMPUTE MCACAG-TOTAVG-CRUISE-AMT (TOT-CABGRP) =  
231005       MCACAG-TOTAVG-CRUISE-AMT (TOT-CABGRP) +
231005       WS-INP-RCP-MTRX-TOT-CR-FR-AMT  
231005       (ZSUB BPSUB RCP-SUB MSUB RSUB CABSUB). 
231005  
231005     COMPUTE MCACAG-TOTAL-CRUISE-AMT (TOT-CABGRP) =   
231005       MCACAG-TOTAL-CRUISE-AMT (TOT-CABGRP) + 
231005       WS-INP-RCP-MTRX-GROSS-AMT  
231005       (ZSUB BPSUB RCP-SUB MSUB RSUB CABSUB). 
231005  
231005     MOVE WS-INP-RCP-MTRX-OFFER-CODE  
231005       (ZSUB BPSUB RCP-SUB MSUB RSUB) 
231005                                 TO MCACAV-OFFER-CODE(TOT-CABSUB).
231005     MOVE WS-INP-RCP-MTRX-CABIN-NUM   
231005       (ZSUB BPSUB RCP-SUB MSUB RSUB CABSUB)  
231005                                 TO MCACAV-CABIN-NUM (TOT-CABSUB).
231005     MOVE WS-INP-RCP-MTRX-META-CAT-CODE   
231005       (ZSUB BPSUB RCP-SUB MSUB)  
231005                                 TO MCACAV-META-CAT-CODE  
231005                                                     (TOT-CABSUB).
231005     MOVE WS-INP-RCP-MTRX-CAT-CODE
231005       (ZSUB BPSUB RCP-SUB MSUB RSUB CABSUB)  
231005                                 TO MCACAV-CAT-CODE  (TOT-CABSUB).
231005  
231005*    RETAIN LEGACY UPGRADE CODE MAPPING.  
231005     IF MCACAV-CAT-CODE (TOT-CABSUB) NOT =
231005        WS-INP-RCP-MTRX-CPA-CAT-CODE  
231005                             (ZSUB BPSUB RCP-SUB MSUB RSUB CABSUB)
231005        MOVE WS-INP-RCP-MTRX-CPA-CAT-CODE 
231005                             (ZSUB BPSUB RCP-SUB MSUB RSUB CABSUB)
231005                                 TO MCACAV-UPGRADE-CODE   
231005                                                      (TOT-CABSUB)
231005     END-IF.  
231005  
231005     MOVE WS-INP-RCP-MTRX-AVG-CR-FR-AMT   
231005       (ZSUB BPSUB RCP-SUB MSUB RSUB CABSUB)  
231005                                 TO MCACAV-AVG-CABIN-AMT  
231005                                                     (TOT-CABSUB).
231005     MOVE WS-INP-RCP-MTRX-AVG-ADDON-AMT   
231005       (ZSUB BPSUB RCP-SUB MSUB RSUB CABSUB)  
231005                                 TO MCACAV-AVG-ADDON-AMT  
231005                                                     (TOT-CABSUB).
231005     MOVE WS-INP-RCP-MTRX-TOT-CR-FR-AMT   
231005       (ZSUB BPSUB RCP-SUB MSUB RSUB CABSUB)  
231005                                 TO MCACAV-TOT-CABIN-AMT  
231005                                                     (TOT-CABSUB).
231005     MOVE WS-INP-RCP-MTRX-GROSS-AMT   
231005       (ZSUB BPSUB RCP-SUB MSUB RSUB CABSUB)  
231005                                 TO MCACAV-TOT-CRUISE-AMT 
231005                                                     (TOT-CABSUB).
231005     MOVE WS-INP-RCP-MTRX-CONN-CAB-NUM
231005       (ZSUB BPSUB RCP-SUB MSUB RSUB CABSUB)  
231005                                 TO MCACAV-CONNECT-CABIN-NUM  
231005                                                     (TOT-CABSUB).
231005  
231005*    RETAIN LEGACY OCCUPANCY ADVISORY.
231005     IF WS-INP-RCP-MTRX-INFO-MSG  
231005          (ZSUB BPSUB RCP-SUB MSUB RSUB CABSUB) = 'Y' 
231005        ADD 1 TO WS-ADV-SUB   
231005        MOVE '1230' TO MCAADV-ADVISORY-CODE   
231005             (TOT-CABSUB WS-ADV-SUB)  
231005        STRING
231005          'The stateroom category selected has an occupancy'  
231005          ' restriction. Changes in occupancy may result in'  
231005          ' a change in fare' 
231005          DELIMITED BY SIZE INTO MCAADV-ADVISORY-TEXT 
231005             (TOT-CABSUB WS-ADV-SUB)  
231005        MOVE '0026/25211001/CCR48MCA' 
231005          TO MCAADV-CONDITION-CODE
231005             (TOT-CABSUB WS-ADV-SUB)  
231005     END-IF.  
231005  
231005*    RETAIN LEGACY CLOUD 9 SPA ADVISORY.  
231005     IF WS-INP-RCP-MTRX-SPL-CAT-CODE  
231005          (ZSUB BPSUB RCP-SUB MSUB RSUB CABSUB) = 'Y' 
231005        ADD 1 TO WS-ADV-SUB   
231005        MOVE '1200' TO MCAADV-ADVISORY-CODE   
231005             (TOT-CABSUB WS-ADV-SUB)  
231005        STRING
231005          'Good call!! That’s not just any stateroom you’ve'  
231005          ' got there — that’s a Cloud 9 Spa stateroom!'  
231005          'Enjoy your complimentary spa access, including '   
231005          'Thalassotherapy Pool and Thermal Suites. ' 
231005          DELIMITED BY SIZE INTO MCAADV-ADVISORY-TEXT 
231005             (TOT-CABSUB WS-ADV-SUB)  
231005        MOVE '0027/25211002/CCR48MCA' 
231005          TO MCAADV-CONDITION-CODE
231005             (TOT-CABSUB WS-ADV-SUB)  
231005     END-IF.  
231005  
231005     STRING MCAVL1-SHIP-CODE MCACAV-META-CAT-CODE (TOT-CABSUB)
231005            WS-INP-RCP-MTRX-SPL-CAT-CODE  
231005            (ZSUB BPSUB RCP-SUB MSUB RSUB CABSUB) 
231005            WS-INP-RCP-MTRX-VIEW-IND  
231005            (ZSUB BPSUB RCP-SUB MSUB RSUB CABSUB) 
231005       DELIMITED BY SIZE INTO MCACAV-CABIN-TYPE (TOT-CABSUB). 
231005  
231005 8055-OUT-INP-CON-CAB-EXIT.   
231005     EXIT.

       8050-BUILD-OUTPUT-NEXT-INP-RCP.  

           ADD 1                       TO BPSUB.

           IF BPSUB > WS-INP-RCP-BP-CNT 
              GO TO 8150-SEND-OUTPUT
           END-IF.  

           MOVE ZERO                   TO RCP-SUB.  
       8075-NEXT-RECIPE.

           ADD 1                       TO RCP-SUB.  

           IF RCP-SUB > MCARCP-SUB  
              GO TO 8050-BUILD-OUTPUT-NEXT-INP-RCP  
           END-IF.  

           ADD 1                       TO TOT-CABGRP.   

       8100-FIND-RATE-CABIN-ZONE.   

           IF  WS-INP-RCP-BP-CABIN-CNT (BPSUB RCP-SUB) < 1  
              COMPUTE TOT-CABSUB = TOT-CABSUB +  MCACIN-SUB 
              GO TO 8075-NEXT-RECIPE
           END-IF.  

           MOVE WS-INP-RCP-BP-ZONE-SUB(BPSUB RCP-SUB )  
                                       TO ZSUB. 
           MOVE WS-INP-RCP-MTRX-DECK-CODE(ZSUB) 
                                       TO MCACAG-DECK-CODE(TOT-CABGRP). 
           MOVE WS-RCP-MTRX-FMA-IND (ZSUB)  
                                       TO   
                                    MCACAG-FWD-MID-AFT-CODE(TOT-CABGRP).
           MOVE WS-INP-RCP-BP-RCP-SEQ-NUM (BPSUB RCP-SUB)   
                                       TO   
                                        MCACAG-RCP-SEQ-NUM (TOT-CABGRP).

           MOVE ZERO                   TO CSUB. 

       8125-FIND-RATE-CABINS.   
           ADD 1                       TO CSUB. 
           MOVE 0                      TO WS-ADV-SUB.   

           IF CSUB > WS-INP-RCP-BP-CABIN-CNT (BPSUB RCP-SUB)
              GO TO 8075-NEXT-RECIPE
           END-IF.  

           ADD 1                       TO TOT-CABSUB.   


           PERFORM VARYING REQ-SUB FROM 1 BY 1  
                  UNTIL REQ-SUB > WS-INP-RCP-BP-CABIN-CNT(BPSUB RCP-SUB)
              IF WS-INP-RCP-BP-REQ-NUM(BPSUB RCP-SUB REQ-SUB) = CSUB
                 MOVE WS-INP-RCP-BP-RATE-SUB(BPSUB RCP-SUB REQ-SUB) 
                                       TO RSUB  
                 MOVE WS-INP-RCP-BP-CABIN-SUB(BPSUB RCP-SUB REQ-SUB)
                                       TO CABSUB
                 MOVE WS-INP-RCP-BP-META-SUB(BPSUB RCP-SUB REQ-SUB) 
                                       TO MSUB  
                 MOVE WS-INP-RCP-BP-CABIN-CNT(BPSUB RCP-SUB)
                                       TO REQ-SUB   
              END-IF
           END-PERFORM. 

           COMPUTE MCACAG-TOTAVG-CABIN-AMT (TOT-CABGRP) =   
                   ( MCACAG-TOTAVG-CABIN-AMT (TOT-CABGRP)+  
                   WS-INP-RCP-MTRX-TOT-CR-FR-AMT
                   (ZSUB BPSUB RCP-SUB MSUB RSUB CABSUB)).  

           COMPUTE MCACAG-TOTAVG-ADDON-AMT (TOT-CABGRP) =   
                   ( MCACAG-TOTAVG-ADDON-AMT (TOT-CABGRP) + 
                   WS-INP-RCP-MTRX-AVG-ADDON-AMT
                   (ZSUB BPSUB RCP-SUB MSUB RSUB CABSUB)).  


           COMPUTE MCACAG-TOTAVG-CRUISE-AMT (TOT-CABGRP) =  
                   ( MCACAG-TOTAVG-CRUISE-AMT (TOT-CABGRP) +
                   WS-INP-RCP-MTRX-TOT-CR-FR-AMT
                   (ZSUB BPSUB RCP-SUB MSUB RSUB CABSUB)).  

           COMPUTE MCACAG-TOTAL-CRUISE-AMT (TOT-CABGRP) =   
                   ( MCACAG-TOTAL-CRUISE-AMT (TOT-CABGRP) + 
                   WS-INP-RCP-MTRX-GROSS-AMT
                   (ZSUB BPSUB RCP-SUB MSUB RSUB CABSUB)).  

           IF CSUB = WS-INP-RCP-BP-CABIN-CNT (BPSUB RCP-SUB)
              COMPUTE MCACAG-TOTAVG-CABIN-AMT (TOT-CABGRP) =
                      MCACAG-TOTAVG-CABIN-AMT (TOT-CABGRP) / WS-TOT-PAX 
              COMPUTE MCACAG-TOTAVG-ADDON-AMT (TOT-CABGRP) =
                      MCACAG-TOTAVG-ADDON-AMT (TOT-CABGRP) / CSUB   
           END-IF.  

           MOVE TOT-CABGRP             TO MCACAV-OWNER-SUB (TOT-CABSUB).
           MOVE WS-INP-RCP-MTRX-OFFER-CODE(ZSUB BPSUB RCP-SUB MSUB RSUB)
                                      TO MCACAV-OFFER-CODE (TOT-CABSUB).
           MOVE WS-INP-RCP-MTRX-CABIN-NUM   
                (ZSUB BPSUB RCP-SUB MSUB RSUB CABSUB)   
                                       TO MCACAV-CABIN-NUM (TOT-CABSUB).
           MOVE WS-INP-RCP-MTRX-META-CAT-CODE (ZSUB BPSUB RCP-SUB MSUB) 
                                       TO   
                                    MCACAV-META-CAT-CODE (TOT-CABSUB).  
           MOVE WS-INP-RCP-MTRX-CAT-CODE
                (ZSUB BPSUB RCP-SUB MSUB RSUB CABSUB)   
                                       TO MCACAV-CAT-CODE (TOT-CABSUB). 
           IF  MCACAV-CAT-CODE (TOT-CABSUB) NOT =   
              WS-INP-RCP-MTRX-CPA-CAT-CODE  
              (ZSUB BPSUB RCP-SUB MSUB RSUB CABSUB) 
              MOVE WS-INP-RCP-MTRX-CPA-CAT-CODE 
                   (ZSUB BPSUB RCP-SUB MSUB RSUB CABSUB)
                                       TO   
                                        MCACAV-UPGRADE-CODE (TOT-CABSUB)
           END-IF.  
           MOVE WS-INP-RCP-MTRX-AVG-CR-FR-AMT   
                (ZSUB BPSUB RCP-SUB MSUB RSUB CABSUB)   
                                       TO   
                                      MCACAV-AVG-CABIN-AMT (TOT-CABSUB).
           MOVE WS-INP-RCP-MTRX-AVG-ADDON-AMT   
                (ZSUB BPSUB RCP-SUB MSUB RSUB CABSUB)   
                                       TO   
                                      MCACAV-AVG-ADDON-AMT (TOT-CABSUB).
           MOVE WS-INP-RCP-MTRX-TOT-CR-FR-AMT   
                (ZSUB BPSUB RCP-SUB MSUB RSUB CABSUB)   
                                       TO   
                                      MCACAV-TOT-CABIN-AMT (TOT-CABSUB).
           MOVE WS-INP-RCP-MTRX-GROSS-AMT   
                (ZSUB BPSUB RCP-SUB MSUB RSUB CABSUB)   
                                       TO   
                                     MCACAV-TOT-CRUISE-AMT (TOT-CABSUB).

           IF  WS-INP-RCP-MTRX-INFO-MSG 
               (ZSUB BPSUB RCP-SUB MSUB RSUB CABSUB) = 'Y'  
               ADD 1                   TO WS-ADV-SUB
               MOVE '1230'             TO   
                          MCAADV-ADVISORY-CODE (TOT-CABSUB WS-ADV-SUB)  
               STRING 'The stateroom category selected has an occupancy'
                      'restriction. Changes in occupancy may result in' 
                      ' a change in fare'   
               DELIMITED SIZE INTO MCAADV-ADVISORY-TEXT 
                                  (TOT-CABSUB WS-ADV-SUB)   
               MOVE '0026/25211001/CCR48MCA'
                                       TO   
                  MCAADV-CONDITION-CODE (TOT-CABSUB WS-ADV-SUB) 
           END-IF.  

           IF WS-INP-RCP-MTRX-CONN-CAB-NUM  
              (ZSUB BPSUB RCP-SUB MSUB RSUB CABSUB) > SPACES
              MOVE WS-INP-RCP-MTRX-CONN-CAB-NUM 
                   (ZSUB BPSUB RCP-SUB MSUB RSUB CABSUB)
                                       TO   
                                   MCACAV-CONNECT-CABIN-NUM (TOT-CABSUB)
           END-IF.  

           MOVE WS-INP-RCP-BP-RCP-SEQ-NUM (BPSUB RCP-SUB)   
                                       TO MCACAV-SEQ-NUM(TOT-CABSUB).   

           IF  WS-INP-RCP-MTRX-SPL-CAT-CODE (ZSUB BPSUB RCP-SUB MSUB
               RSUB CABSUB) = 'Y'   
               ADD 1                   TO WS-ADV-SUB
               MOVE '1200'             TO MCAADV-ADVISORY-CODE  
                                                (TOT-CABSUB WS-ADV-SUB) 
               STRING 'Good call!! That’s not just any stateroom you’ve'
               ' got there — that’s a Cloud 9 Spa stateroom!Enjoy your '
               'complimentary spa access, including Thalassotherapy '   
               'Pool and Thermal Suites. '  
                DELIMITED SIZE INTO             MCAADV-ADVISORY-TEXT
                                                (TOT-CABSUB WS-ADV-SUB) 
               MOVE '0027/25211002/CCR48MCA'
                                       TO MCAADV-CONDITION-CODE 
                                                (TOT-CABSUB WS-ADV-SUB) 
           END-IF.  

           STRING MCAVL1-SHIP-CODE  
                  MCACAV-META-CAT-CODE (TOT-CABSUB) 
                  WS-INP-RCP-MTRX-SPL-CAT-CODE  
                  (ZSUB BPSUB RCP-SUB MSUB RSUB CABSUB) 
                  WS-INP-RCP-MTRX-VIEW-IND  
                  (ZSUB BPSUB RCP-SUB MSUB RSUB CABSUB) 
                  DELIMITED BY SIZE INTO MCACAV-CABIN-TYPE (TOT-CABSUB).

            MOVE ZERO                  TO  TOT-NEWGRP.  
            IF CSUB = WS-INP-RCP-BP-CABIN-CNT (BPSUB RCP-SUB) AND   
               (BPSUB = 2)  
               COMPUTE TOT-NEWGRP = TOT-CABGRP - MCARCP-SUB 
               IF (MCACAG-TOTAVG-CABIN-AMT (TOT-NEWGRP) =   
                  MCACAG-TOTAVG-CABIN-AMT (TOT-CABGRP)) 
                  MOVE LOW-VALUES      TO MCACAG-SEGMENT (TOT-CABGRP)   
                  GO TO 8075-NEXT-RECIPE
               END-IF   
            END-IF  

           GO TO 8125-FIND-RATE-CABINS. 

       8150-SEND-OUTPUT.

           PERFORM CCP76-OUTPUT-CCMCAVL2
           THRU CCP76-OUTPUT-CCMCAVL2-EXIT. 
           GO TO 9000-END-OF-JOB.   

       8175-NO-AVAIL-CATEGORY.  

           DISPLAY 'AVAIL-CAT-FETCH-ERROR:' UPON PRINTER.   
           DISPLAY 'STATUS      '      ERROR-STATUS UPON PRINTER.   
           DISPLAY 'ERROR NUM   '      ERROR-NUM UPON PRINTER.  
           DISPLAY 'ERROR AREA  '      ERROR-AREA UPON PRINTER. 
           DISPLAY 'ERROR RECORD '     ERROR-RECORD UPON PRINTER.   
           DISPLAY 'DPP-ERR-NUM ' DPP01-ERROR-NUMBER UPON PRINTER.  

           GO TO 1100-NEXT-SAIL-CATEGORY.   

       8200-FETCH-PRIOR-SAILING.

           EXEC SQL 
                DECLARE PRE_SAILING CURSOR  
                SELECT CONVERT(SAIL_DATE,112),  
                       STATUS_CODE  
                 FROM  SAILING  
                WHERE  SHIP_CODE = :TDP01-I-SHIP-CODE   
                  AND  SAIL_DATE <= DATE
                                (STRPTIME(:TDP01-I-SAIL-DATE-YYYYMMDD-X,
                                                              '%Y%m%d'))
                ORDER  BY SAIL_DATE DESCENDING  
           END-EXEC.

           EXEC SQL OPEN PRE_SAILING END-EXEC.  

           EXEC SQL WHENEVER SQLERROR   
              GO TO 8400-SAILING-NOT-FOUND  
           END-EXEC.

           EXEC SQL WHENEVER NOT FOUND  
              GO TO 8400-SAILING-NOT-FOUND  
           END-EXEC.

       8300-FETCH-PRIOR-SAIL-CONT.  

           EXEC SQL 
                FETCH NEXT PRE_SAILING  
                   INTO :WS-PRIOR-DATE, 
                        :WS-SAIL-STATUS-CODE
           END-EXEC.

           IF  WS-PRIOR-DATE < DPP01-SYSTEM-DATE
               GO TO 8200-FETCH-PRIOR-SAILING-EXIT  
           END-IF.  

           IF  WS-SAIL-STATUS-CODE NOT = 'O'
               GO TO 8300-FETCH-PRIOR-SAIL-CONT 
           END-IF.  

       8200-FETCH-PRIOR-SAILING-EXIT.   
           EXEC SQL 
                CLOSE PRE_SAILING   
           END-EXEC.
           EXIT.

       8400-FETCH-NEXT-SAILING. 

           PERFORM TDP01-FETCH-NEXT-SAIL THRU   
                   TDP01-FETCH-SAIL-EXIT.   

           IF  TDP01-SAIL-SQLERR OR 
               TDP01-SAIL-NOTFND
               GO TO 8400-SAILING-NOT-FOUND 
           END-IF.  

           IF  (TDP01-SHIP-CODE NOT = TDP01-I-SHIP-CODE) OR 
               (TDP01-STATUS-CODE NOT = 'O')
               GO TO 8400-FETCH-NEXT-SAILING
           END-IF.  

       8400-FETCH-NEXT-SAILING-EXIT.
           EXIT.

       8400-SAILING-NOT-FOUND.  
           MOVE 'NO SAILING FOUND'     TO DPP42-HOLD-MSG-DESC.  
           GO TO 9200-EDIT-ERROR-MSG.   

       8500-ITINERARY-ERROR.
           DISPLAY 'NO ITINERARY FOUND ' UPON PRINTER.  
           GO TO 9150-RDMS-ERROR.   

       9000-END-OF-JOB. 
           GO TO DPP12-END-OF-JOB.  

       9100-DATABASE-ERROR. 
           MOVE 6                      TO MSGHDR-ADVISE-CODE (1).   

           PERFORM CCP75-OUTPUT-CCERRMSG
              THRU CCP75-OUTPUT-CCERRMSG-EXIT.  
           GO TO DPP12-DATABASE-ERROR.  

       9150-RDMS-ERROR. 
           MOVE 7                      TO MSGHDR-ADVISE-CODE (1).   

           PERFORM CCP75-OUTPUT-CCERRMSG
              THRU CCP75-OUTPUT-CCERRMSG-EXIT.  
           GO TO DPP12-RDMS-ERROR.  

       9200-EDIT-ERROR-MSG. 
           PERFORM DPP12-EDIT-ERROR-MSG 
              THRU DPP12-EDIT-ERROR-MSG-EXIT.   

           GO TO 9000-END-OF-JOB.   

       9210-EDIT-CONTINUE-MSG.  
           PERFORM DPP12-EDIT-ERROR-MSG 
              THRU DPP12-EDIT-ERROR-MSG-EXIT.   

       9300-SEVERE-ERROR-MSG.   
           GO TO DPP12-SEVERE-ERROR-MSG.

       9400-INFO-MSG.   
           PERFORM DPP12-INFO-MSG   
              THRU DPP12-INFO-MSG-EXIT. 

       9500-RETURN-SUBROUTINE-ERROR.
           GO TO DPP12-RETURN-SUBROUTINE-ERROR. 

       9600-SAVE-SUBROUTINE-ERRORS. 
           PERFORM DPP12-SAVE-SUBROUTINE-MSGS   
              THRU DPP12-SAVE-SUBROUTINE-MSGS-X.

       COPY CCP10CCC.   
       COPY CCP10CCS.   
       COPY CCP50P02.   
       COPY CCP51MCA.   
       COPY CCP75P02.   
       COPY CCP76MCA.   
       COPY DPP10Y2K.   
       COPY DPP12API.   
       COPY DPP12AMI.   
       COPY DPP12ERR.   
       COPY DPP12WDB.   
       COPY RSP50INT.   
       COPY RSP49INT.   
       COPY DPP45AOP.   
       COPY TDP01SAP.   
PPC470 COPY TDP01SCP.   
       COPY CCP40IAT.   
       COPY DPP10TMZ.   
