       0280-CHECK-GTEE-CAT. 
           IF WS-REACTIVATE-FLAG = 'Y' OR WS-CHG-SAILING-FLAG = 'Y' 
              GO TO 0300-CHECK-LANGUAGE.

           IF (RSP06-IBR-GTEE-CATEGORY-CODE OF RSP06-NEW =  
                 RSP06-IBR-GTEE-CATEGORY-CODE OF RSP06-OLD) 
              GO TO 0300-CHECK-LANGUAGE.

           MOVE SPACES     TO WS-HISTORY-AN-PARAMS. 
           MOVE LOW-VALUES TO WS-HISTORY-N-PARAMS.  
           MOVE 'GTC'      TO WS-HIST-ACTIVITY-TYPE.

           STRING 'GUARANTEE: ' 
                  RSP06-IBR-GTEE-CATEGORY-CODE OF RSP06-OLD 
                  DELIMITED BY SIZE INTO WS-HIST-COMMENT.   

126290     MOVE WS-HIST-COMMENT TO WS-HIST-TRF-COMMENT2.
126290     MOVE 'Y'             TO WS-HIST-TRF-IND. 

           PERFORM 8000-WRITE-HISTORY THRU 8099-EXIT.   

      *-----------------------------------------------------------------

       0300-CHECK-LANGUAGE. 
           IF (RSP06-IBR-LANGUAGE-CODE OF RSP06-NEW =   
                 RSP06-IBR-LANGUAGE-CODE OF RSP06-OLD)  
              GO TO 0320-CHECK-ROLLAWAYS.   

           MOVE SPACES     TO WS-HISTORY-AN-PARAMS. 
           MOVE LOW-VALUES TO WS-HISTORY-N-PARAMS.  
           MOVE 'CLI'      TO WS-HIST-ACTIVITY-TYPE.

           STRING 'LANGUAGE CODE: ' 
                  RSP06-IBR-LANGUAGE-CODE OF RSP06-OLD  
                  DELIMITED BY SIZE INTO WS-HIST-COMMENT.   

           PERFORM 8000-WRITE-HISTORY THRU 8099-EXIT.   

      *-----------------------------------------------------------------

       0320-CHECK-ROLLAWAYS.
           IF (RSP06-IBR-NUM-ROLLAWAYS OF RSP06-NEW =   
                 RSP06-IBR-NUM-ROLLAWAYS OF RSP06-OLD)  
              GO TO 0340-CHECK-CRIBS.   

           MOVE SPACES     TO WS-HISTORY-AN-PARAMS. 
           MOVE LOW-VALUES TO WS-HISTORY-N-PARAMS.  
           MOVE 'CGO'      TO WS-HIST-ACTIVITY-TYPE.

           STRING 'RABS: ' RSP06-IBR-NUM-ROLLAWAYS OF RSP06-OLD 
                  DELIMITED BY SIZE INTO WS-HIST-COMMENT.   

           MOVE WS-HIST-COMMENT TO WS-HIST-TRF-COMMENT2.
           MOVE 'Y'             TO WS-HIST-TRF-IND. 

           PERFORM 8000-WRITE-HISTORY THRU 8099-EXIT.   

      *-----------------------------------------------------------------

       0340-CHECK-CRIBS.
           IF (RSP06-IBR-NUM-CRIBS OF RSP06-NEW =   
                 RSP06-IBR-NUM-CRIBS OF RSP06-OLD)  
              GO TO 0360-CHECK-CURRENCY.

           MOVE SPACES     TO WS-HISTORY-AN-PARAMS. 
           MOVE LOW-VALUES TO WS-HISTORY-N-PARAMS.  
           MOVE 'CGO'      TO WS-HIST-ACTIVITY-TYPE.

           STRING 'CRIB: ' RSP06-IBR-NUM-CRIBS OF RSP06-OLD 
                  DELIMITED BY SIZE INTO WS-HIST-COMMENT.   

           MOVE WS-HIST-COMMENT TO WS-HIST-TRF-COMMENT2.
           MOVE 'Y'             TO WS-HIST-TRF-IND. 

           PERFORM 8000-WRITE-HISTORY THRU 8099-EXIT.   

      *-----------------------------------------------------------------

       0360-CHECK-CURRENCY. 
           IF (RSP06-IBR-CURRENCY-CODE OF RSP06-NEW =   
                 RSP06-IBR-CURRENCY-CODE OF RSP06-OLD)  
              GO TO 0380-CHECK-REFUND-IND.  

           MOVE SPACES     TO WS-HISTORY-AN-PARAMS. 
           MOVE LOW-VALUES TO WS-HISTORY-N-PARAMS.  
           MOVE 'CGO'      TO WS-HIST-ACTIVITY-TYPE.

           STRING 'CURRENCY: ' RSP06-IBR-CURRENCY-CODE OF RSP06-OLD 
                  DELIMITED BY SIZE INTO WS-HIST-COMMENT.   

           MOVE WS-HIST-COMMENT TO WS-HIST-TRF-COMMENT2.
           MOVE 'Y'             TO WS-HIST-TRF-IND. 

           PERFORM 8000-WRITE-HISTORY THRU 8099-EXIT.   

      *-----------------------------------------------------------------

       0380-CHECK-REFUND-IND.   
           IF (RSP06-IBR-REFUND-IND OF RSP06-NEW =  
                 RSP06-IBR-REFUND-IND OF RSP06-OLD) 
              GO TO 0400-CHECK-ALLOW-REF-IND.   

           MOVE SPACES     TO WS-HISTORY-AN-PARAMS. 
           MOVE LOW-VALUES TO WS-HISTORY-N-PARAMS.  
128764     MOVE 'CGR'      TO WS-HIST-ACTIVITY-TYPE.

           STRING 'REFUND IND: ' RSP06-IBR-REFUND-IND OF RSP06-OLD  
                  DELIMITED BY SIZE INTO WS-HIST-COMMENT.   

           MOVE WS-HIST-COMMENT TO WS-HIST-TRF-COMMENT2 
           MOVE 'Y'             TO WS-HIST-TRF-IND. 

           PERFORM 8000-WRITE-HISTORY THRU 8099-EXIT.   

      *-----------------------------------------------------------------

       0400-CHECK-ALLOW-REF-IND.
           IF (RSP06-IBR-ALLOW-REFUND-IND OF RSP06-NEW =
                 RSP06-IBR-ALLOW-REFUND-IND OF RSP06-OLD)   
LOYLTY*        GO TO 0420-CHECK-DEPOSIT-TYPE1.  
LOYLTY         GO TO 0410-ELIGIBLE-AMOUNT.  

           MOVE SPACES     TO WS-HISTORY-AN-PARAMS. 
           MOVE LOW-VALUES TO WS-HISTORY-N-PARAMS.  
           MOVE 'CREF'     TO WS-HIST-ACTIVITY-TYPE.

           STRING 'ALLOW REFUND IND CHANGED FROM '  
                  RSP06-IBR-ALLOW-REFUND-IND OF RSP06-OLD ' TO '
                  RSP06-IBR-ALLOW-REFUND-IND OF RSP06-NEW   
                  DELIMITED BY SIZE INTO WS-HIST-COMMENT

           PERFORM 8000-WRITE-HISTORY THRU 8099-EXIT.   

LOYLTY 0410-ELIGIBLE-AMOUNT.
LOYLTY     IF (RSP06-IBR-CMH-ELIGIBLE-AMT OF RSP06-NEW =
LOYLTY           RSP06-IBR-CMH-ELIGIBLE-AMT OF RSP06-OLD)   
LOYLTY        GO TO 0420-CHECK-DEPOSIT-TYPE1.   
LOYLTY  
LOYLTY     MOVE SPACES     TO WS-HISTORY-AN-PARAMS. 
LOYLTY     MOVE LOW-VALUES TO WS-HISTORY-N-PARAMS.  
LOYLTY     MOVE 'CEL'      TO WS-HIST-ACTIVITY-TYPE.

LOYLTY     MOVE RSP06-IBR-CMH-ELIGIBLE-AMT OF RSP06-OLD TO WS-DSPAMT8-1.
LOYLTY     MOVE RSP06-IBR-CMH-ELIGIBLE-AMT OF RSP06-NEW TO WS-DSPAMT8-2.
LOYLTY     MOVE SPACES TO WS-HIST-COMMENT   
LOYLTY     STRING 'EL AMT FR:'  WS-DSPAMT8-1
LOYLTY           DELIMITED BY SIZE INTO WS-HIST-COMMENT 
LOYLTY     PERFORM 8000-WRITE-HISTORY THRU 8099-EXIT
LOYLTY     MOVE SPACES TO WS-HIST-COMMENT   
LOYLTY     STRING 'EL AMT TO:'  WS-DSPAMT8-2
LOYLTY           DELIMITED BY SIZE INTO WS-HIST-COMMENT 
LOYLTY     MOVE 'Y'             TO WS-HIST-TRF-IND  
LOYLTY     PERFORM 8000-WRITE-HISTORY THRU 8099-EXIT
LOYLTY     MOVE SPACES TO WS-HIST-COMMENT.  
LOYLTY  
      *-----------------------------------------------------------------

       0420-CHECK-DEPOSIT-TYPE1.
           IF (RSP06-IBR-DEPOSIT-TYPE-1 OF RSP06-NEW =  
                 RSP06-IBR-DEPOSIT-TYPE-1 OF RSP06-OLD) AND 
                 (RSP06-IBR-DEPOSIT-NUM-1 OF RSP06-NEW =
                 RSP06-IBR-DEPOSIT-NUM-1 OF RSP06-OLD)  
              GO TO 0440-CHECK-DEPOSIT-TYPE2.   

           MOVE SPACES     TO WS-HISTORY-AN-PARAMS. 
           MOVE LOW-VALUES TO WS-HISTORY-N-PARAMS.  
           MOVE 'CGP'      TO WS-HIST-ACTIVITY-TYPE 

           IF (RSP06-IBR-DEPOSIT-TYPE-1 OF RSP06-OLD > SPACE) OR
                 (RSP06-IBR-DEPOSIT-NUM-1 OF RSP06-OLD > SPACES)
              STRING RSP06-IBR-DEPOSIT-TYPE-1 OF RSP06-OLD  
                      ' ' RSP06-IBR-DEPOSIT-NUM-1 OF RSP06-OLD  
                     DELIMITED BY SIZE INTO WS-HIST-COMMENT 
           ELSE 
CCL-UK        MOVE 'DEP COMMENT V/C/F/A/W'   TO WS-HIST-COMMENT 
CCL-UK     END-IF.  
CCL-UK*       MOVE 'DEPOSIT COMMENT V/C/F/A' TO WS-HIST-COMMENT.


126688     MOVE WS-HIST-COMMENT TO WS-HIST-TRF-COMMENT2.
126688     MOVE 'Y'             TO WS-HIST-TRF-IND. 

           PERFORM 8000-WRITE-HISTORY THRU 8099-EXIT.   

      *-----------------------------------------------------------------

       0440-CHECK-DEPOSIT-TYPE2.
           IF (RSP06-IBR-DEPOSIT-TYPE-2 OF RSP06-NEW =  
                 RSP06-IBR-DEPOSIT-TYPE-2 OF RSP06-OLD) AND 
                 (RSP06-IBR-DEPOSIT-NUM-2 OF RSP06-NEW =
                 RSP06-IBR-DEPOSIT-NUM-2 OF RSP06-OLD)  
              GO TO 0460-CHECK-FINAL-DATE.  

           MOVE SPACES     TO WS-HISTORY-AN-PARAMS. 
           MOVE LOW-VALUES TO WS-HISTORY-N-PARAMS.  
           MOVE 'CGP'      TO WS-HIST-ACTIVITY-TYPE 

           IF (RSP06-IBR-DEPOSIT-TYPE-2 OF RSP06-OLD > SPACE) OR
                 (RSP06-IBR-DEPOSIT-NUM-2 OF RSP06-OLD > SPACES)
              STRING RSP06-IBR-DEPOSIT-TYPE-2 OF RSP06-OLD  
                      ' ' RSP06-IBR-DEPOSIT-NUM-2 OF RSP06-OLD  
                     DELIMITED BY SIZE INTO WS-HIST-COMMENT 
           ELSE 
CCL-UK        MOVE 'DEP COMMENT V/C/F/A/W'   TO WS-HIST-COMMENT 
CCL-UK     END-IF.  
CCL-UK*       MOVE 'DEPOSIT COMMENT V/C/F/A' TO WS-HIST-COMMENT.


126688     MOVE WS-HIST-COMMENT TO WS-HIST-TRF-COMMENT2.
126688     MOVE 'Y'             TO WS-HIST-TRF-IND. 

           PERFORM 8000-WRITE-HISTORY THRU 8099-EXIT.   

      *=================================================================

       0460-CHECK-FINAL-DATE.   
           IF WS-REACTIVATE-FLAG = 'Y' OR WS-CHG-SAILING-FLAG = 'Y' 
              GO TO 0520-CHECK-CPA-CAT. 

           IF (RSP06-IBR-FINAL-DATE OF RSP06-NEW =  
                 RSP06-IBR-FINAL-DATE OF RSP06-OLD) 
              GO TO 0480-CHECK-OPTION-DATE. 

           MOVE SPACES     TO WS-HISTORY-AN-PARAMS. 
           MOVE LOW-VALUES TO WS-HISTORY-N-PARAMS.  
           MOVE 'CGO'      TO WS-HIST-ACTIVITY-TYPE.

           STRING 'FPD: ' RSP06-IBR-FINAL-DATE OF RSP06-OLD 
                  DELIMITED BY SIZE INTO WS-HIST-COMMENT.   

           MOVE WS-HIST-COMMENT TO WS-HIST-TRF-COMMENT2.
           MOVE 'Y'             TO WS-HIST-TRF-IND. 

           PERFORM 8000-WRITE-HISTORY THRU 8099-EXIT.   

      *-----------------------------------------------------------------

       0480-CHECK-OPTION-DATE.  
           IF (RSP06-IBR-OPTION-DATE OF RSP06-NEW = 
                 RSP06-IBR-OPTION-DATE OF RSP06-OLD)
              GO TO 0500-CHECK-OPTION-TIME. 

           MOVE SPACES     TO WS-HISTORY-AN-PARAMS. 
           MOVE LOW-VALUES TO WS-HISTORY-N-PARAMS.  
           MOVE 'CGO'      TO WS-HIST-ACTIVITY-TYPE.

           STRING 'OPD: ' RSP06-IBR-OPTION-DATE OF RSP06-OLD
                  DELIMITED BY SIZE INTO WS-HIST-COMMENT.   

           MOVE WS-HIST-COMMENT TO WS-HIST-TRF-COMMENT2.
           MOVE 'Y'             TO WS-HIST-TRF-IND. 

           PERFORM 8000-WRITE-HISTORY THRU 8099-EXIT.   

      *-----------------------------------------------------------------

       0500-CHECK-OPTION-TIME.  
           IF (RSP06-IBR-OPTION-TIME OF RSP06-NEW = 
                 RSP06-IBR-OPTION-TIME OF RSP06-OLD)
              GO TO 0520-CHECK-CPA-CAT. 

           MOVE SPACES     TO WS-HISTORY-AN-PARAMS. 
           MOVE LOW-VALUES TO WS-HISTORY-N-PARAMS.  
           MOVE 'CGO'      TO WS-HIST-ACTIVITY-TYPE.

           STRING 'OPT-TIME: ' RSP06-IBR-OPTION-TIME OF RSP06-OLD   
                  DELIMITED BY SIZE INTO WS-HIST-COMMENT.   

           PERFORM 8000-WRITE-HISTORY THRU 8099-EXIT.   

      *=================================================================

       0520-CHECK-CPA-CAT.  
           IF (RSP06-IBR-CPA-CATEGORY-CODE OF RSP06-NEW =   
                 RSP06-IBR-CPA-CATEGORY-CODE OF RSP06-OLD) AND  
                 (RSP06-IBR-CPA-APPROVAL-USERID OF RSP06-NEW =  
                 RSP06-IBR-CPA-APPROVAL-USERID OF RSP06-OLD)
              GO TO 0540-CHECK-AGENT-CONTACT.   

           MOVE SPACES     TO WS-HISTORY-AN-PARAMS. 
           MOVE LOW-VALUES TO WS-HISTORY-N-PARAMS.  
           MOVE 'CGO'      TO WS-HIST-ACTIVITY-TYPE.

           STRING 'UPG/DISC: ' RSP06-IBR-CPA-CATEGORY-CODE OF RSP06-OLD 
                  ' APPRVL: ' RSP06-IBR-CPA-APPROVAL-USERID OF RSP06-OLD
                  DELIMITED BY SIZE INTO WS-HIST-COMMENT.   

           MOVE WS-HIST-COMMENT  TO WS-HIST-TRF-COMMENT2.   

           IF RSP06-IBR-CATEGORY-CODE OF RSP06-NEW =
                 RSP06-IBR-CATEGORY-CODE OF RSP06-OLD AND   
                 RSP06-IBR-CABIN-NUM OF RSP06-NEW = 
                    RSP06-IBR-CABIN-NUM OF RSP06-OLD
              MOVE 'Y'              TO WS-HIST-TRF-IND. 

           COMPUTE WS-HIST-AMT =  RSP06-IBR-CRUISE-AMT OF RSP06-NEW 
                               + RSP06-IBR-INS-PREMIUM-AMT OF RSP06-NEW 
                               + RSP06-IBR-TOTAL-FEES-AMT OF RSP06-NEW  
                               - RSP06-IBR-CRUISE-AMT OF RSP06-OLD  
                               - RSP06-IBR-INS-PREMIUM-AMT OF RSP06-OLD 
                               - RSP06-IBR-TOTAL-FEES-AMT OF RSP06-OLD. 

           PERFORM 8000-WRITE-HISTORY THRU 8099-EXIT.   

      *-----------------------------------------------------------------

       0540-CHECK-AGENT-CONTACT.
           IF (RSP06-IBR-AGENT-CONTACT OF RSP06-NEW =   
                 RSP06-IBR-AGENT-CONTACT OF RSP06-OLD)  
              GO TO 0560-CHECK-AGENCY-CONN. 

           MOVE SPACES     TO WS-HISTORY-AN-PARAMS. 
           MOVE LOW-VALUES TO WS-HISTORY-N-PARAMS.  
           MOVE 'CCT'      TO WS-HIST-ACTIVITY-TYPE.
           MOVE RSP06-IBR-AGENT-CONTACT OF RSP06-OLD TO WS-HIST-COMMENT.

           COMPUTE WS-HIST-TRF-AMT =
                               RSP06-IB-PAX-GROSS-FARE-AMT OF RSP06-NEW 
                             - WS-STEPPED-GROSS-AMT.

           PERFORM 8000-WRITE-HISTORY THRU 8099-EXIT.   

      *-----------------------------------------------------------------

       0560-CHECK-AGENCY-CONN.  
           IF (RSP06-IBR-AGENCY-CONN-CODE OF RSP06-NEW =
                 RSP06-IBR-AGENCY-CONN-CODE OF RSP06-OLD)   
144517*       GO TO 0580-CHECK-USERID.  
144517        GO TO 0570-CHECK-LOCATION-CODE
144517     END-IF.  

           MOVE SPACES     TO WS-HISTORY-AN-PARAMS. 
           MOVE LOW-VALUES TO WS-HISTORY-N-PARAMS.  
           MOVE 'CAC'              TO WS-HIST-ACTIVITY-TYPE.

           STRING 'AGENCY-CONN-CODE = ' 
                  RSP06-IBR-AGENCY-CONN-CODE OF RSP06-OLD   
                 DELIMITED BY SIZE INTO WS-HIST-COMMENT.

           PERFORM 8000-WRITE-HISTORY THRU 8099-EXIT.   

      *-----------------------------------------------------------------

144517 0570-CHECK-LOCATION-CODE.
144517     IF (RSP06-IBR-LOCATION-CODE OF RSP06-NEW =   
144517         RSP06-IBR-LOCATION-CODE OF RSP06-OLD)
144517         GO TO 0580-CHECK-USERID  
144517     END-IF.  

144517     MOVE SPACES     TO WS-HISTORY-AN-PARAMS. 
144517     MOVE LOW-VALUES TO WS-HISTORY-N-PARAMS.  
144517     MOVE 'CAC'      TO WS-HIST-ACTIVITY-TYPE.

144517     STRING 'LOCATION-CODE = '
144517             RSP06-IBR-LOCATION-CODE OF RSP06-OLD 
144517             DELIMITED BY SIZE INTO WS-HIST-COMMENT.  
144517     PERFORM 8000-WRITE-HISTORY THRU 8099-EXIT.   

      *-----------------------------------------------------------------

       0580-CHECK-USERID.   
           IF (RSP06-IBR-USERID OF RSP06-NEW =  
                 RSP06-IBR-USERID OF RSP06-OLD) 
123463        GO TO 0590-CHECK-USERID2. 

           MOVE SPACES     TO WS-HISTORY-AN-PARAMS. 
           MOVE LOW-VALUES TO WS-HISTORY-N-PARAMS.  
           MOVE 'CGI'      TO WS-HIST-ACTIVITY-TYPE.

           STRING 'OPERATOR INITIALS: ' 
                  RSP06-IBR-USERID OF RSP06-OLD 
                  DELIMITED BY SIZE INTO WS-HIST-COMMENT.   

           MOVE WS-HIST-COMMENT TO WS-HIST-TRF-COMMENT2.
           MOVE 'Y'             TO WS-HIST-TRF-IND. 

           PERFORM 8000-WRITE-HISTORY THRU 8099-EXIT.   

      *-----------------------------------------------------------------

123463 0590-CHECK-USERID2.  
123463     IF (RSP06-IBR-USERID-2 OF RSP06-NEW =
123463           RSP06-IBR-USERID-2 OF RSP06-OLD)   
123463        GO TO 0600-CHECK-TRAVEL-WITH. 
123463  
123463     MOVE SPACES     TO WS-HISTORY-AN-PARAMS. 
123463     MOVE LOW-VALUES TO WS-HISTORY-N-PARAMS.  
123463     MOVE 'CGI'      TO WS-HIST-ACTIVITY-TYPE.
123463  
123463     STRING '2nd USER INITAILS: ' 
123463            RSP06-IBR-USERID-2 OF RSP06-OLD   
123463            DELIMITED BY SIZE INTO WS-HIST-COMMENT.   
123463  
123463     MOVE WS-HIST-COMMENT TO WS-HIST-TRF-COMMENT2.
123463     MOVE 'Y'             TO WS-HIST-TRF-IND. 
123463  
123463     PERFORM 8000-WRITE-HISTORY THRU 8099-EXIT.   

      *-----------------------------------------------------------------

       0600-CHECK-TRAVEL-WITH.  
           MOVE RSP06-IBR-TRVL-WITH-NUM OF RSP06-OLD TO WS-DOLLAR-VALUE.

           IF (WS-DOLLAR-VALUE IS NOT NUMERIC) OR   
                 WS-DOLLAR-VALUE <= ZERO
              MOVE ZERO TO RSP06-IBR-TRVL-WITH-NUM OF RSP06-OLD.

           IF (RSP06-IBR-TRVL-WITH-NUM OF RSP06-NEW =   
                 RSP06-IBR-TRVL-WITH-NUM OF RSP06-OLD)  
              GO TO 0620-CHECK-BKG-CMT1.

124575     IF RSP06-IBR-TRVL-WITH-NUM OF RSP06-OLD <= ZERO  
124575        IF RSP06-IBR-TRVL-WITH-NUM OF RSP06-NEW <= ZERO   
124575           GO TO 0620-CHECK-BKG-CMT1. 

           MOVE SPACES     TO WS-HISTORY-AN-PARAMS. 
           MOVE LOW-VALUES TO WS-HISTORY-N-PARAMS.  
           MOVE 'CTW'      TO WS-HIST-ACTIVITY-TYPE.
           MOVE SPACES     TO WS-TRVL-WITH-REM. 

           IF RSP06-IBR-TRVL-WITH-NUM OF RSP06-OLD > ZERO AND   
                 RSP06-IBR-TRVL-WITH-NUM OF RSP06-NEW > ZERO
              STRING 'TRVL-WITH CHANGED:'   
                     RSP06-IBR-TRVL-WITH-NUM OF RSP06-OLD   
                     DELIMITED BY SIZE INTO WS-HIST-COMMENT 
           ELSE 
              IF RSP06-IBR-TRVL-WITH-NUM OF RSP06-OLD NOT > ZERO AND
                    RSP06-IBR-TRVL-WITH-NUM OF RSP06-NEW > ZERO 
                 STRING 'TRVL-WITH ADDED:'  
                        RSP06-IBR-TRVL-WITH-NUM OF RSP06-OLD
                        DELIMITED BY SIZE INTO WS-HIST-COMMENT  
              ELSE  
                 IF RSP06-IBR-TRVL-WITH-NUM OF RSP06-OLD > ZERO AND 
                       RSP06-IBR-TRVL-WITH-NUM OF RSP06-NEW NOT > ZERO  
                    MOVE 'Y' TO WS-TRVL-WITH-REM
                    STRING 'TRVL-WITH REMOVED:' 
                           RSP06-IBR-TRVL-WITH-NUM OF RSP06-OLD 
127218                     DELIMITED BY SIZE INTO WS-HIST-COMMENT   
127218           ELSE   
127218              GO TO 0620-CHECK-BKG-CMT1.  

           MOVE WS-HIST-COMMENT TO WS-HIST-TRF-COMMENT2.
           MOVE 'Y'             TO WS-HIST-TRF-IND. 

           PERFORM 8000-WRITE-HISTORY THRU 8099-EXIT.   

           IF WS-TRVL-WITH-REM NOT = 'Y'
              GO TO 0620-CHECK-BKG-CMT1.

           MOVE SPACES TO WS-TVL-COMMENT1   
                          WS-TVL-COMMENT2.  
           MOVE RSP06-IBR-TRVL-WITH-NUM OF RSP06-OLD TO 
                TWR-TRVL-WITH-NUM.  
           MOVE RSP06-IBR-SHIP-CODE OF RSP06-OLD TO TWR-SHIP-CODE.  
           MOVE RSP06-IBR-SAIL-DATE OF RSP06-OLD TO TWR-SAIL-DATE.  
           MOVE RSP06-IBR-DURATION-DAYS OF RSP06-OLD TO 
                TWR-DURATION-DAYS.  

           FETCH TRAVEL-WITH-REC RECORD 
                 ON ERROR GO TO 0620-CHECK-BKG-CMT1.

           PERFORM 8700-LOAD-TVL-WITH-BKGS THRU 8720-EXIT.  

           MOVE SPACES          TO WS-HIST-COMMENT  
                                   WS-HIST-TRF-COMMENT2.

           IF RSP06-IBR-BOOK-TYPE OF RSP06-NEW = 'G'
              IF WS-TVL-COMMENT1 > SPACES   
                 MOVE WS-TVL-COMMENT1 TO WS-HIST-COMMENT
                                         WS-HIST-TRF-COMMENT2   
                 PERFORM 8000-WRITE-HISTORY THRU 8099-EXIT  
                 IF WS-TVL-COMMENT2 > SPACES
                    MOVE WS-TVL-COMMENT2 TO WS-HIST-COMMENT 
                                            WS-HIST-TRF-COMMENT2
                    PERFORM 8000-WRITE-HISTORY THRU 8099-EXIT   
                 END-IF 
                 GO TO 0620-CHECK-BKG-CMT1. 

           IF WS-TVL-CMT-1A > SPACES
              MOVE WS-TVL-CMT-1A TO WS-HIST-COMMENT 
                                    WS-HIST-TRF-COMMENT2
              PERFORM 8000-WRITE-HISTORY THRU 8099-EXIT.

           IF WS-TVL-CMT-1B > SPACES
              MOVE WS-TVL-CMT-1B TO WS-HIST-COMMENT 
                                    WS-HIST-TRF-COMMENT2
              PERFORM 8000-WRITE-HISTORY THRU 8099-EXIT.

           IF WS-TVL-CMT-2A > SPACES
              MOVE WS-TVL-CMT-2A TO WS-HIST-COMMENT 
                                    WS-HIST-TRF-COMMENT2
              PERFORM 8000-WRITE-HISTORY THRU 8099-EXIT.

           IF WS-TVL-CMT-2B > SPACES
              MOVE WS-TVL-CMT-2B TO WS-HIST-COMMENT 
                                    WS-HIST-TRF-COMMENT2
              PERFORM 8000-WRITE-HISTORY THRU 8099-EXIT.

      *-----------------------------------------------------------------

       0620-CHECK-BKG-CMT1. 
           IF (RSP06-IBR-BKG-COMMENT1 OF RSP06-NEW =
                 RSP06-IBR-BKG-COMMENT1 OF RSP06-OLD)   
              GO TO 0640-CHECK-BKG-CMT2.

           MOVE SPACES     TO WS-HISTORY-AN-PARAMS. 
           MOVE LOW-VALUES TO WS-HISTORY-N-PARAMS.  
           MOVE 'CGB'      TO WS-HIST-ACTIVITY-TYPE.

           IF (RSP06-IBR-BKG-COMMENT1 OF RSP06-OLD <= SPACES)   
               MOVE 'BOOKING COMMENT (1)' TO WS-HIST-COMMENT
126688         MOVE WS-HIST-COMMENT TO WS-HIST-TRF-COMMENT2 
126688         MOVE 'Y'             TO WS-HIST-TRF-IND  
               PERFORM 8000-WRITE-HISTORY THRU 8099-EXIT
               GO TO 0640-CHECK-BKG-CMT2.   

           MOVE RSP06-IBR-BKG-COMMENT1 OF RSP06-OLD (1:23) TO   
                WS-HIST-COMMENT.

126688     MOVE WS-HIST-COMMENT TO WS-HIST-TRF-COMMENT2.
126688     MOVE 'Y'             TO WS-HIST-TRF-IND. 

           PERFORM 8000-WRITE-HISTORY THRU 8099-EXIT.   

           IF RSP06-IBR-BKG-COMMENT1 OF RSP06-OLD (24:22) > SPACES  
              MOVE RSP06-IBR-BKG-COMMENT1 OF RSP06-OLD (24:22) TO   
                   WS-HIST-COMMENT  
126688        MOVE WS-HIST-COMMENT TO WS-HIST-TRF-COMMENT2  
126688        MOVE 'Y'             TO WS-HIST-TRF-IND   
              PERFORM 8000-WRITE-HISTORY THRU 8099-EXIT.

      *-----------------------------------------------------------------

       0640-CHECK-BKG-CMT2. 
           IF (RSP06-IBR-BKG-COMMENT2 OF RSP06-NEW =
                 RSP06-IBR-BKG-COMMENT2 OF RSP06-OLD)   
              GO TO 0660-CHECK-PAY-COMMENT. 

           MOVE SPACES     TO WS-HISTORY-AN-PARAMS. 
           MOVE LOW-VALUES TO WS-HISTORY-N-PARAMS.  
           MOVE 'CGB'      TO WS-HIST-ACTIVITY-TYPE.

           IF (RSP06-IBR-BKG-COMMENT2 OF RSP06-OLD <= SPACES)   
               MOVE 'BOOKING COMMENT (2)' TO WS-HIST-COMMENT
126688         MOVE WS-HIST-COMMENT TO WS-HIST-TRF-COMMENT2 
126688         MOVE 'Y'             TO WS-HIST-TRF-IND  
               PERFORM 8000-WRITE-HISTORY THRU 8099-EXIT
               GO TO 0660-CHECK-PAY-COMMENT.

           MOVE RSP06-IBR-BKG-COMMENT2 OF RSP06-OLD (1:23) TO   
                WS-HIST-COMMENT.
126688     MOVE WS-HIST-COMMENT TO WS-HIST-TRF-COMMENT2.
126688     MOVE 'Y'             TO WS-HIST-TRF-IND. 

           PERFORM 8000-WRITE-HISTORY THRU 8099-EXIT.   

           IF RSP06-IBR-BKG-COMMENT2 OF RSP06-OLD (24:22) > SPACES  
              MOVE RSP06-IBR-BKG-COMMENT2 OF RSP06-OLD (24:22) TO   
                   WS-HIST-COMMENT  
126688        MOVE WS-HIST-COMMENT TO WS-HIST-TRF-COMMENT2  
126688        MOVE 'Y'             TO WS-HIST-TRF-IND   
              PERFORM 8000-WRITE-HISTORY THRU 8099-EXIT.

      *-----------------------------------------------------------------

       0660-CHECK-PAY-COMMENT.  
           IF (RSP06-IBR-PAY-COMMENT OF RSP06-NEW = 
                 RSP06-IBR-PAY-COMMENT OF RSP06-OLD)
              GO TO 0680-CHECK-PGM-FEE-WAIVE.   

           MOVE SPACES     TO WS-HISTORY-AN-PARAMS. 
           MOVE LOW-VALUES TO WS-HISTORY-N-PARAMS.  
           MOVE 'CGP'      TO WS-HIST-ACTIVITY-TYPE 

           IF (RSP06-IBR-PAY-COMMENT OF RSP06-OLD <= SPACE) 
               MOVE 'PAYMENT COMMENT' TO WS-HIST-COMMENT
126688         MOVE WS-HIST-COMMENT TO WS-HIST-TRF-COMMENT2 
126688         MOVE 'Y'             TO WS-HIST-TRF-IND  
               PERFORM 8000-WRITE-HISTORY THRU 8099-EXIT
               GO TO 0680-CHECK-PGM-FEE-WAIVE.  

           MOVE RSP06-IBR-PAY-COMMENT OF RSP06-OLD (1:23) TO
                WS-HIST-COMMENT.
126688     MOVE WS-HIST-COMMENT TO WS-HIST-TRF-COMMENT2.
126688     MOVE 'Y'             TO WS-HIST-TRF-IND. 

           PERFORM 8000-WRITE-HISTORY THRU 8099-EXIT.   

           IF RSP06-IBR-PAY-COMMENT OF RSP06-OLD (24:22) > SPACES   
              MOVE RSP06-IBR-PAY-COMMENT OF RSP06-OLD (24:22) TO
                   WS-HIST-COMMENT  
126688        MOVE WS-HIST-COMMENT TO WS-HIST-TRF-COMMENT2  
126688        MOVE 'Y'             TO WS-HIST-TRF-IND   
              PERFORM 8000-WRITE-HISTORY THRU 8099-EXIT.

      *=================================================================

       0680-CHECK-PGM-FEE-WAIVE.
           IF (RSP06-IBR-WAIVE-PROG-FEE-IND OF RSP06-NEW =  
                 RSP06-IBR-WAIVE-PROG-FEE-IND OF RSP06-OLD) 
              GO TO 0700-CHECK-PGM-FEE-AMT. 

           IF (RSP06-IBR-WAIVE-PROG-FEE-IND OF RSP06-NEW = 'Y') 
              IF (RSP06-IBR-WAIVE-PROG-FEE-IND OF RSP06-OLD = 'y')  
                 GO TO 0700-CHECK-PGM-FEE-AMT.  

           IF (RSP06-IBR-WAIVE-PROG-FEE-IND OF RSP06-NEW = 'N') 
              IF NOT (RSP06-IBR-WAIVE-PROG-FEE-IND OF RSP06-OLD = 'y'   
                     OR 'Y')
                 GO TO 0700-CHECK-PGM-FEE-AMT.  

           MOVE SPACES     TO WS-HISTORY-AN-PARAMS. 
           MOVE LOW-VALUES TO WS-HISTORY-N-PARAMS.  
           MOVE 'WPGF'     TO WS-HIST-ACTIVITY-TYPE.

           STRING 'WAIVE PROGRAM FEE: ' 
                  RSP06-IBR-WAIVE-PROG-FEE-IND OF RSP06-OLD 
                  DELIMITED BY SIZE INTO WS-HIST-COMMENT.   

           MOVE WS-HIST-COMMENT TO WS-HIST-TRF-COMMENT2.
           MOVE 'Y'             TO WS-HIST-TRF-IND. 

           PERFORM 8000-WRITE-HISTORY THRU 8099-EXIT.   

      *-----------------------------------------------------------------

       0700-CHECK-PGM-FEE-AMT.  
           IF (RSP06-IBR-PROGRAM-FEE-AMT OF RSP06-NEW = 
                  RSP06-IBR-PROGRAM-FEE-AMT OF RSP06-OLD)   
              GO TO 0720-CHECK-ALT-PHONE.   

           IF WS-SKIP-HISTORY-IND = 'Y' 
              GO TO 0720-CHECK-ALT-PHONE.   

           MOVE SPACES     TO WS-HISTORY-AN-PARAMS. 
           MOVE LOW-VALUES TO WS-HISTORY-N-PARAMS.  
           MOVE 'PGFA'     TO WS-HIST-ACTIVITY-TYPE.
           MOVE RSP06-IBR-PROGRAM-FEE-AMT OF RSP06-OLD TO WS-DSPAMT8-1. 

           STRING 'PROGRAM FEE AMOUNT: ' WS-DSPAMT8-1   
                  DELIMITED BY SIZE INTO WS-HIST-COMMENT.   

           MOVE WS-HIST-COMMENT TO WS-HIST-TRF-COMMENT2.
           MOVE 'Y'             TO WS-HIST-TRF-IND. 

           COMPUTE WS-HIST-AMT = RSP06-IBR-PROGRAM-FEE-AMT OF RSP06-NEW 
                               - RSP06-IBR-PROGRAM-FEE-AMT OF RSP06-OLD 

           PERFORM 8000-WRITE-HISTORY THRU 8099-EXIT.   

      *=================================================================

       0720-CHECK-ALT-PHONE.
           IF (RSP06-IBR-ALT-FAX-PHONE-NUM OF RSP06-OLD <= SPACES) OR   
                 RSP06-IBR-ALT-FAX-PHONE-NUM OF RSP06-OLD = ZERO
              MOVE SPACES TO
                   RSP06-IBR-ALT-FAX-PHONE-NUM OF RSP06-OLD.

           IF (RSP06-IBR-ALT-FAX-PHONE-NUM OF RSP06-NEW <= SPACES) OR   
                 RSP06-IBR-ALT-FAX-PHONE-NUM OF RSP06-NEW = ZERO
              MOVE SPACES TO
                   RSP06-IBR-ALT-FAX-PHONE-NUM OF RSP06-NEW.

           IF RSP06-IBR-ALT-FAX-PHONE-NUM OF RSP06-NEW =
                 RSP06-IBR-ALT-FAX-PHONE-NUM OF RSP06-OLD   
              GO TO 0740-CHECK-CUST-NUM.

           MOVE SPACES     TO WS-HISTORY-AN-PARAMS. 
           MOVE LOW-VALUES TO WS-HISTORY-N-PARAMS.  
           MOVE 'IBFA'     TO WS-HIST-ACTIVITY-TYPE.

           STRING 'IBR FAX# SET TO '
                  RSP06-IBR-ALT-FAX-PHONE-NUM OF RSP06-NEW  
                  ' FM ' RSP06-IBR-ALT-FAX-PHONE-NUM OF RSP06-OLD   
                  DELIMITED BY SIZE INTO WS-HIST-COMMENT.   

           PERFORM 8000-WRITE-HISTORY THRU 8099-EXIT.   

