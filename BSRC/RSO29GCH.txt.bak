       0860-CHECK-PIER-HIST.
           IF (RSP06-I-PIER-READ-IND OF RSP06-NEW = 'N') AND
                 (RSP06-I-PIER-READ-IND OF RSP06-OLD  = 'N')
168921*       GO TO 0880-CHECK-I-ANAR-HIST. 
168921         GO TO 0900-CHECK-BTB 
168921     END-IF.  

           IF (RSP06-I-PIER-EXIST-IND OF RSP06-NEW = 'N') AND   
                 (RSP06-I-PIER-EXIST-IND OF RSP06-OLD  = 'N')   
168921*       GO TO 0880-CHECK-I-ANAR-HIST. 
168921         GO TO 0900-CHECK-BTB 
168921     END-IF.  

           IF (RSP06-I-PIER-EXIST-IND OF RSP06-NEW =
                 RSP06-I-PIER-EXIST-IND OF RSP06-OLD)   
              IF RSP06-I-EMAIL-INFO OF RSP06-NEW =  
                    RSP06-I-PIER-EMAIL-ADDR OF RSP06-OLD
168921*          GO TO 0880-CHECK-I-ANAR-HIST.  
168921           GO TO 0900-CHECK-BTB   
168921        END-IF
168921     END-IF.  

           MOVE SPACES     TO WS-HISTORY-AN-PARAMS. 
           MOVE LOW-VALUES TO WS-HISTORY-N-PARAMS.  
           MOVE 'DOC'      TO WS-HIST-ACTIVITY-TYPE.

           IF RSP06-I-PIER-EXIST-IND OF RSP06-OLD = 'N' 
              MOVE 'Cabin email addr added' TO WS-HIST-COMMENT  
              PERFORM 8000-WRITE-HISTORY THRU 8099-EXIT 
              MOVE RSP06-I-PIER-EMAIL-ADDR OF RSP06-NEW TO  
                   WS-HIST-COMMENT  
           ELSE 
              IF RSP06-I-PIER-EXIST-IND OF RSP06-OLD = 'N'  
                 MOVE 'Cabin email addr removed' TO WS-HIST-COMMENT 
                 PERFORM 8000-WRITE-HISTORY THRU 8099-EXIT  
                 MOVE RSP06-I-PIER-EMAIL-ADDR OF RSP06-OLD TO   
                      WS-HIST-COMMENT   
              ELSE  
                 MOVE 'Cabin email addr change from' TO 
                      WS-HIST-COMMENT   
                 PERFORM 8000-WRITE-HISTORY THRU 8099-EXIT  
                 MOVE RSP06-I-PIER-EMAIL-ADDR OF RSP06-OLD TO   
                      WS-HIST-COMMENT.  

202476     MOVE 'Y'        TO WS-HIST-TRF-IND.  
           PERFORM 8000-WRITE-HISTORY THRU 8099-EXIT.   

      *-----------------------------------------------------------------

168921*0880-CHECK-I-ANAR-HIST.  
168921*    IF (RSP06-I-ANAR-READ-IND OF RSP06-NEW = 'N' AND 
168921*          RSP06-I-ANAR-READ-IND OF RSP06-OLD = 'N')  
