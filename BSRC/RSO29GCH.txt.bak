189672        MOVE RSP06-PAX-SEQ-NUM OF RSP06-NEW (NSUB)
189672                          TO WS-HIST-PAX-SEQ-NUM  
189672        MOVE ZEROES       TO WS-HIST-TRF-AMT  
189672        STRING ' AIR ADDED TO BOOKING TODAY ' 
189672               DELIMITED BY SIZE INTO WS-HIST-TRF-COMMENT1
189672        PERFORM 8100-WRITE-TRF THRU 8199-EXIT 
189672     END-IF.  
189672  
189672     IF (RSP06-PAX-CITY-CODE OF RSP06-NEW (NSUB) NOT =
189672         RSP06-PAX-CITY-CODE OF RSP06-OLD (OSUB)) 
189672        MOVE SPACES       TO WS-HISTORY-AN-PARAMS 
189672        MOVE LOW-VALUES   TO WS-HISTORY-N-PARAMS  
189672        MOVE 'CCY'        TO WS-HIST-TRF-ACTIVITY-TYPE
189672        MOVE RSP06-PAX-SEQ-NUM OF RSP06-NEW (NSUB)
189672                          TO WS-HIST-PAX-SEQ-NUM  
189672        MOVE ZEROES       TO WS-HIST-TRF-AMT  
189672        STRING 'FROM: '   
189672               RSP06-PAX-CITY-CODE OF RSP06-OLD (OSUB)
189672               '  TO: '   
189672               RSP06-PAX-CITY-CODE OF RSP06-NEW (NSUB)
189672               DELIMITED BY SIZE INTO WS-HIST-TRF-COMMENT1
189672        PERFORM 8100-WRITE-TRF THRU 8199-EXIT 
189672     END-IF.  
189672  
189672     IF (RSP06-PAX-FARE-TYPE OF RSP06-NEW (NSUB) NOT =
189672           RSP06-PAX-FARE-TYPE OF RSP06-OLD (OSUB)) AND   
189672        (RSP06-PAX-FARE-TYPE OF RSP06-OLD (OSUB) = 'F' AND
189672         RSP06-PAX-FARE-TYPE OF RSP06-NEW (NSUB) = 'C')   
189672        MOVE SPACES       TO WS-HISTORY-AN-PARAMS 
189672        MOVE LOW-VALUES   TO WS-HISTORY-N-PARAMS  
189672        MOVE 'DCY'        TO WS-HIST-TRF-ACTIVITY-TYPE
189672        MOVE RSP06-PAX-SEQ-NUM OF RSP06-NEW (NSUB)
189672                          TO WS-HIST-PAX-SEQ-NUM  
189672        MOVE ZEROES       TO WS-HIST-TRF-AMT  
189672        STRING ' AIR REMOVED FROM BOOKING TODAY ' 
189672               DELIMITED BY SIZE INTO WS-HIST-TRF-COMMENT1
189672        PERFORM 8100-WRITE-TRF THRU 8199-EXIT 
189672     END-IF.  

      *-----------------------------------------------------------------

       2940-CHECK-INS-HISTORY.  
115785     IF  WS-REACTIVATE-FLAG = 'N' AND WS-CHG-SAILING-FLAG = 'N'   
              IF (RSP06-PAX-INSURANCE-IND OF RSP06-NEW (NSUB) = 
                    RSP06-PAX-INSURANCE-IND OF RSP06-OLD (OSUB))
104170           GO TO 2945-CHECK-UPG-CHG.  

115785     IF  RSP06-PAX-INSURANCE-IND OF RSP06-OLD (OSUB) = 'N'
115785         IF  RSP06-PAX-INSURANCE-IND OF RSP06-NEW (NSUB) = 'N'
104170             GO TO 2945-CHECK-UPG-CHG.

           MOVE SPACES     TO WS-HISTORY-AN-PARAMS. 
           MOVE LOW-VALUES TO WS-HISTORY-N-PARAMS.  
           MOVE NSUB       TO WS-HIST-PAX-NUM.  
           MOVE 'VPP'      TO WS-HIST-ACTIVITY-TYPE.
           MOVE RSP06-PAX-SEQ-NUM OF RSP06-NEW (NSUB) TO
                WS-HIST-PAX-SEQ-NUM.
           MOVE RSP06-PAX-CITY-CODE OF RSP06-NEW (NSUB) TO  
                WS-HIST-CITY-CODE.  
PPC470*    MOVE RSP06-PAX-FARE-CODE OF RSP06-NEW (NSUB) TO  
PPC470*         WS-HIST-FARE-CODE.  
PPC470     MOVE RSP06-PAX-OFFER-CODE OF RSP06-NEW (NSUB) TO 
PPC470          WS-HIST-OFFER-CODE. 
PPC470     MOVE RSP06-PAX-FARE-TYPE OF RSP06-NEW (NSUB) TO  
PPC470          WS-HIST-FARE-TYPE.  

           IF (RSP06-TIR-READ-IND OF RSP06-NEW (NSUB) NOT = 'Y')
              MOVE 10 TO DPP42-HOLD-MSG-INDEX   
              GO TO 9200-EDIT-ERROR-MSG.

           IF RSP06-PAX-INSURANCE-IND OF RSP06-NEW (NSUB) = 'Y' OR 'S'  
                 OR 'G' 
              IF RSP06-TIR-EXIST-IND OF RSP06-NEW (NSUB) NOT = 'Y'  
                 MOVE 11 TO DPP42-HOLD-MSG-INDEX
                 GO TO 9200-EDIT-ERROR-MSG. 

           IF RSP06-PAX-INSURANCE-IND OF RSP06-OLD (OSUB) = 'Y' OR 'S'  
                 OR 'G' 
              IF RSP06-TIR-EXIST-IND OF RSP06-OLD (OSUB) NOT = 'Y'  
                 MOVE 12 TO DPP42-HOLD-MSG-INDEX
                 GO TO 9200-EDIT-ERROR-MSG. 

           IF RSP06-PAX-INSURANCE-IND OF RSP06-OLD (OSUB) = 'Y' OR 'S'  
                 OR 'G' 
              IF RSP06-PAX-INSURANCE-IND OF RSP06-NEW (NSUB) = 'Y' OR   
                    'S' OR 'G'  
                COMPUTE WS-HIST-AMT =   
                        RSP06-TIR-PREMIUM-AMT OF RSP06-NEW (NSUB) - 
                        RSP06-TIR-PREMIUM-AMT OF RSP06-OLD (OSUB)   
              ELSE  
                COMPUTE WS-HIST-AMT =   
                        RSP06-TIR-PREMIUM-AMT OF RSP06-OLD (OSUB) * -1  
           ELSE 
              IF RSP06-PAX-INSURANCE-IND OF RSP06-NEW (NSUB) = 'Y' OR   
                    'S' OR 'G'  
                MOVE RSP06-TIR-PREMIUM-AMT OF RSP06-new (nSUB) TO   
                     WS-HIST-AMT.   

           IF (RSP06-PAX-INSURANCE-IND OF RSP06-NEW (NSUB)  
                      = 'Y' OR 'S' OR 'G')  
115785        IF  WS-REACTIVATE-FLAG = 'Y' OR   
115785            WS-HIST-ACTIVITY-TYPE = 'VPA' 
115785            MOVE 'INSURANCE REQUESTED '     TO WS-HIST-COMMENT
115785        ELSE  
115785            IF  WS-CHG-SAILING-FLAG = 'Y' AND 
115785                WS-HIST-ACTIVITY-TYPE = 'VPP' 
115785                MOVE 'VPP CHG DUE TO SAIL'  TO WS-HIST-COMMENT
115785           ELSE   
                    STRING 'CHG PREM TYPE FROM: '   
                           RSP06-PAX-INSURANCE-IND OF RSP06-OLD (OSUB)  
                           ' TO '   
                           RSP06-PAX-INSURANCE-IND OF RSP06-NEW (NSUB)  
                           DELIMITED BY SIZE INTO WS-HIST-COMMENT   
115785           END-IF 
115785        END-IF
           ELSE 
              IF (RSP06-PAX-INSURANCE-IND OF RSP06-NEW (NSUB)  = 'U') OR
                    (RSP06-PAX-INSURANCE-IND OF RSP06-NEW (NSUB) = 'C') 
                 MOVE 'INSURANCE REFUSED' TO WS-HIST-COMMENT
              ELSE  
                 MOVE 'INSURANCE CANCELLED' TO WS-HIST-COMMENT. 

           MOVE WS-HIST-COMMENT TO WS-HIST-TRF-COMMENT2.
           MOVE 'Y'             TO WS-HIST-TRF-IND. 

           PERFORM 8000-WRITE-HISTORY THRU 8099-EXIT.   

115785     MOVE ZEROES          TO WS-HIST-TRF-AMT  
115785                             WS-HIST-OLD-AMT  
115785                             WS-HIST-TRF-OLD-AMT  
115785                             WS-HIST-AMT. 

115785     IF  RSP06-PAX-INSURANCE-IND OF RSP06-OLD (OSUB) = 'S' OR 'G' 
115785        IF  RSP06-PAX-INSURANCE-IND OF RSP06-NEW (NSUB) = 
115785              'U' OR 'W' OR 'C' OR 'N'
115785            MOVE 'VPC' TO WS-HIST-ACTIVITY-TYPE   
115785                          WS-HIST-TRF-ACTIVITY-TYPE   
115785        ELSE  
104170            GO TO 2945-CHECK-UPG-CHG  
115785        END-IF
115785     ELSE 
115785        IF  RSP06-PAX-INSURANCE-IND OF RSP06-NEW (NSUB) = 
115785                                                       'S' OR 'G' 
115785            MOVE 'VPA' TO WS-HIST-ACTIVITY-TYPE   
115785                          WS-HIST-TRF-ACTIVITY-TYPE   
              ELSE  
104170           GO TO 2945-CHECK-UPG-CHG   
115785        END-IF
115785     END-IF.  

115785     PERFORM 8000-WRITE-HISTORY THRU 8099-EXIT.   

      *=================================================================

104170 2945-CHECK-UPG-CHG.  
119064*    Write UAM TRF if upgrade amount changed at guest position.   
119064*    This will be used by data warehouse to track revenue dilution
119064*    and to build CURE fact table.
119064  
213133**** FIRST CHECK THE UPGRADE FLG WHICH HELPS DETECT 0 UPGRADE AMT 
213133****   UPGRADES (FREE).  IF = 1, UPGRADE APPLIED TO ALL PAX   
213133****   AND THIS FLAG WILL SUPERCEDE ALL SUBSEQUENT CHECKS because 
213133****   IT TELLS US WE DEFINITELY NEED A 'UAM' TRF.
213133     IF     WS-UAM-TRF-FLG = 0
119064      IF      (NSUB > RSP06-PAX-CNT OF RSP06-OLD) 
119064          OR  (  RSP06-PAX-UPGRADE-AMT OF RSP06-OLD (NSUB)
119064               = RSP06-PAX-UPGRADE-AMT OF RSP06-NEW (NSUB))   
104170*       No change by position.  However its still possible
104170*       that upgrade amount could have changed for specific   
104170*       guest who shifted position due to CXP.
119064        GO TO 2955-CHECK-UPG-ADJ  
119064      END-IF  
119064  
119064      IF      (  RSP06-PAX-UPGRADE-AMT OF RSP06-OLD (OSUB)
119064               = RSP06-PAX-UPGRADE-AMT OF RSP06-NEW (NSUB))   
104170*       The amount for the guest is the same as it was
104170*       before at prior position. This fact also implies shifting 
104170*       due to CXP.  This situation could have been caused by 
104170*       a CXP to single where a manual upgrade amount was already 
104170*       fully on the remaining guest.  Regardless, the EDW won't  
104170*       need TRF for revenue dilution or CURE fact table  
104170*       adjustments.  
119064        GO TO 2960-CHECK-PAST-GUEST-OVER  
119064      END-IF  
119064     END-IF.  

104170     IF RSP29-PBS-FLAG = 0 OR 
104170           RSP29-NEW-PAX-PROMO-UPG-AMT (NSUB) = 0 
104170         GO TO 2950-CHECK-MANUAL-UPG-CHG. 

104170*    The code below is only for upgrades due to a PI based offer  
104170*    redemption.  Manual upgrades and upgrade amount adjustments  
104170*    are handled in paragraph 2950-CHECK-MANUAL-UPG-CHG.  

104170     MOVE SPACES     TO WS-HISTORY-AN-PARAMS. 
104170     MOVE LOW-VALUES TO WS-HISTORY-N-PARAMS.  
104170     MOVE 'UAM'      TO WS-HIST-TRF-ACTIVITY-TYPE.

119064     COMPUTE WS-HIST-TRF-AMT  
119064         =   RSP06-PAX-UPGRADE-AMT OF RSP06-NEW (NSUB)
119064           - RSP06-PAX-UPGRADE-AMT OF RSP06-OLD (OSUB)
119064  
PBS-ME     MOVE WS-HIST-TRF-AMT TO  
104170          WS-DSPAMT8-1.   
104170     MOVE RSP06-PAX-SEQ-NUM OF RSP06-NEW (NSUB) TO
104170          WS-HIST-PAX-SEQ-NUM.

104170     STRING 'UPGRADE AMT: ' WS-DSPAMT8-1  
104170            DELIMITED BY SIZE INTO WS-HIST-TRF-COMMENT1.  
104170  
PPC470     EXEC SQL 
PPC470         SELECT ADD_BENEFIT_CODE  
PPC470               ,ADD_BENEFIT_TYPE  
PPC470               ,PHASE_NUM 
PPC470           INTO :WS-IBPIR-AB-CODE 
PPC470               ,:WS-IBPIR-AB-TYPE 
PPC470               ,:WS-IBPIR-AB-PHASE-NUM
PPC470           FROM ADD_BENEFIT_MASTER
PPC470          WHERE PRP_OWNER_CODE ='ADB' 
PPC470            AND PRP_OWNER_ID   = :RSP06-IBPIR-AB-OWNER-ID 
PPC470                                    OF RSP06-NEW (RSP29-PBS-SUB)  
PPC470       FETCH FIRST 1 ROWS ONLY
PPC470     END-EXEC.
PPC470     IF SQLCODE < 0   
PPC470        GO TO 9150-RDMS-ERROR 
PPC470     ELSE 
PPC470        IF SQLCODE = 100  
PPC470           MOVE 99 TO DPP42-HOLD-MSG-INDEX
PPC470           GO TO 9200-EDIT-ERROR-MSG  
PPC470        END-IF
PPC470     END-IF.  

PPC470*    MOVE RSP06-IBPIR-PI-PHASE-NUM OF RSP06-NEW (RSP29-PBS-SUB)   
PPC470*                              TO WS-DSPNUM5-1
104170     STRING RSP06-IBPIR-OFFER-ID OF RSP06-NEW (RSP29-PBS-SUB) 
PPC470           ' ' WS-IBPIR-AB-TYPE   
PPC470           ' ' WS-IBPIR-AB-CODE   
PPC470           ' ' WS-IBPIR-AB-PHASE-NUM  
PPC470*          ' ' RSP06-IBPIR-PI-TYPE OF RSP06-NEW (RSP29-PBS-SUB)   
PPC470*          ' ' RSP06-IBPIR-PI-CODE OF RSP06-NEW (RSP29-PBS-SUB)   
PPC470*          ' ' WS-DSPNUM5-1   
104170           DELIMITED BY SIZE INTO WS-HIST-TRF-COMMENT2

104170     PERFORM 8100-WRITE-TRF THRU 8199-EXIT.   

104170     IF ((RSP06-PAX-UPGRADE-AMT OF RSP06-NEW (NSUB) - 
104170           RSP06-PAX-UPGRADE-AMT OF RSP06-OLD (OSUB)) =   
104170           RSP29-NEW-PAX-PROMO-UPG-AMT (NSUB))
104170        GO TO 2960-CHECK-PAST-GUEST-OVER. 

104170     MOVE SPACES     TO WS-HISTORY-AN-PARAMS. 
104170     MOVE LOW-VALUES TO WS-HISTORY-N-PARAMS.  
104170     MOVE 'UAS'      TO WS-HIST-TRF-ACTIVITY-TYPE.
104170     MOVE RSP06-PAX-SEQ-NUM OF RSP06-NEW (NSUB) TO
104170          WS-HIST-PAX-SEQ-NUM.

104170     COMPUTE WS-HIST-TRF-AMT =
104170             RSP06-PAX-UPGRADE-AMT OF RSP06-NEW (NSUB) -  
104170             RSP06-PAX-UPGRADE-AMT OF RSP06-OLD (OSUB) -  
104170             RSP29-NEW-PAX-PROMO-UPG-AMT (NSUB).  

PBS-ME     MOVE WS-HIST-TRF-AMT TO WS-DSPAMT8-1.
PBS-ME     STRING 'UPGRADE SUPPLMENT: ' WS-DSPAMT8-1
104170            DELIMITED BY SIZE INTO WS-HIST-TRF-COMMENT1.  

PPC470     EXEC SQL 
PPC470         SELECT ADD_BENEFIT_CODE  
PPC470               ,ADD_BENEFIT_TYPE  
PPC470               ,PHASE_NUM 
PPC470           INTO :WS-IBPIR-AB-CODE 
PPC470               ,:WS-IBPIR-AB-TYPE 
PPC470               ,:WS-IBPIR-AB-PHASE-NUM
PPC470           FROM ADD_BENEFIT_MASTER
PPC470          WHERE PRP_OWNER_CODE ='ADB' 
PPC470            AND PRP_OWNER_ID   = :RSP06-IBPIR-AB-OWNER-ID 
PPC470                                    OF RSP06-NEW (RSP29-PBS-SUB)  
PPC470       FETCH FIRST 1 ROWS ONLY
PPC470     END-EXEC.

PPC470     IF SQLCODE < 0   
PPC470        GO TO 9150-RDMS-ERROR 
PPC470     ELSE 
PPC470        IF SQLCODE = 100  
PPC470           MOVE 99 TO DPP42-HOLD-MSG-INDEX
PPC470           GO TO 9200-EDIT-ERROR-MSG  
PPC470        END-IF
PPC470     END-IF.  

PPC470*    MOVE RSP06-IBPIR-PI-PHASE-NUM OF RSP06-NEW (RSP29-PBS-SUB)   
PPC470*                              TO WS-DSPNUM5-1
104170     STRING RSP06-IBPIR-OFFER-ID OF RSP06-NEW (RSP29-PBS-SUB) 
PPC470           ' ' WS-IBPIR-AB-TYPE   
PPC470           ' ' WS-IBPIR-AB-CODE   
PPC470           ' ' WS-IBPIR-AB-PHASE-NUM  
PPC470*          ' ' RSP06-IBPIR-PI-TYPE OF RSP06-NEW (RSP29-PBS-SUB)   
PPC470*          ' ' RSP06-IBPIR-PI-CODE OF RSP06-NEW (RSP29-PBS-SUB)   
PPC470*          ' ' WS-DSPNUM5-1   
104170           DELIMITED BY SIZE INTO WS-HIST-TRF-COMMENT2

104170      PERFORM 8100-WRITE-TRF THRU 8199-EXIT.  
104170  
104170      GO TO 2960-CHECK-PAST-GUEST-OVER.   

      *-----------------------------------------------------------------

104170 2950-CHECK-MANUAL-UPG-CHG.   
104170*    We are here because upgrade amount is not the same   
104170*    at given guest position and PI based offer redemption is 
104170*    not taking place.  The change is likely a manual one.
104170  
119064     MOVE SPACES     TO WS-HISTORY-AN-PARAMS. 
119064     MOVE LOW-VALUES TO WS-HISTORY-N-PARAMS.  
119064     MOVE 'UAM'      TO WS-HIST-TRF-ACTIVITY-TYPE.
119064  
119064     MOVE RSP06-PAX-UPGRADE-AMT OF RSP06-OLD (OSUB)   
119064         TO WS-DSPAMT8-1  
119064     STRING 'UPGRADE AMT: ' WS-DSPAMT8-1  
119064            DELIMITED BY SIZE INTO WS-HIST-TRF-COMMENT1.  
119064  
119064     COMPUTE WS-HIST-TRF-AMT  
119064         =   RSP06-PAX-UPGRADE-AMT OF RSP06-NEW (NSUB)
119064           - RSP06-PAX-UPGRADE-AMT OF RSP06-OLD (OSUB)
119064  
119064*    In future world of CNAV or API where currently impossible
119064*    situations, such as upgrade amounts changing within  
119064*    position in the same transaction as CXP, using the amounts   
119064*    above should still work. 
119064  
119064     MOVE RSP06-PAX-SEQ-NUM OF RSP06-NEW (NSUB) TO
119064          WS-HIST-PAX-SEQ-NUM.

119064     PERFORM 8100-WRITE-TRF THRU 8199-EXIT.   
119064  
119064     GO TO 2960-CHECK-PAST-GUEST-OVER.
119064  
      *-----------------------------------------------------------------

119064 2955-CHECK-UPG-ADJ.  
119064*    Write UAA TRF if upgrade amount changed for guest who moved  
119064*    due to CXP.  This is used only to build CURE fact table on   
119064*    on the warehouse.  It is not to be used to account for   
119064*    overall revenue change.  
119064  
119064     IF (RSP06-PAX-UPGRADE-AMT OF RSP06-OLD (OSUB) =  
119064           RSP06-PAX-UPGRADE-AMT OF RSP06-NEW (NSUB)) 
119064        GO TO 2960-CHECK-PAST-GUEST-OVER. 

119064     MOVE SPACES     TO WS-HISTORY-AN-PARAMS. 
119064     MOVE LOW-VALUES TO WS-HISTORY-N-PARAMS.  
119064     MOVE 'UAA'      TO WS-HIST-TRF-ACTIVITY-TYPE.
119064  
119064     MOVE RSP06-PAX-UPGRADE-AMT OF RSP06-OLD (OSUB)   
119064         TO WS-DSPAMT8-1  
119064     STRING 'UPGRADE AMT: ' WS-DSPAMT8-1  
119064            DELIMITED BY SIZE INTO WS-HIST-TRF-COMMENT1.  
119064  
119064     COMPUTE WS-HIST-TRF-AMT  
119064         =   RSP06-PAX-UPGRADE-AMT OF RSP06-NEW (NSUB)
119064           - RSP06-PAX-UPGRADE-AMT OF RSP06-OLD (OSUB)
119064  
119064     MOVE RSP06-PAX-SEQ-NUM OF RSP06-NEW (NSUB) TO
119064          WS-HIST-PAX-SEQ-NUM.
119064     PERFORM 8100-WRITE-TRF THRU 8199-EXIT.   

      *=================================================================

       2960-CHECK-PAST-GUEST-OVER.  
           IF (RSP29-PAX-OVR-PAST-GUEST-FLAG (NSUB) = ZERO) 
              GO TO 2980-CHECK-RESIDENT-ST. 

           MOVE SPACES     TO WS-HISTORY-AN-PARAMS. 
           MOVE LOW-VALUES TO WS-HISTORY-N-PARAMS.  
           MOVE 'PGO'      TO WS-HIST-ACTIVITY-TYPE.
           MOVE NSUB       TO WS-HIST-PAX-NUM.  
           MOVE RSP06-PAX-SEQ-NUM OF RSP06-NEW (NSUB) TO
                WS-HIST-PAX-SEQ-NUM.
           MOVE RSP06-PAX-CITY-CODE OF RSP06-NEW (NSUB) TO  
                WS-HIST-CITY-CODE.  
PPC470*    MOVE RSP06-PAX-FARE-CODE OF RSP06-NEW (NSUB) TO  
PPC470*         WS-HIST-FARE-CODE.  
PPC470     MOVE RSP06-PAX-OFFER-CODE OF RSP06-NEW (NSUB) TO 
PPC470          WS-HIST-OFFER-CODE. 
PPC470     MOVE RSP06-PAX-FARE-TYPE OF RSP06-NEW (NSUB) TO  
PPC470          WS-HIST-FARE-TYPE.  

           STRING 'PAST GUEST MISMATCH' 
                 DELIMITED BY SIZE INTO WS-HIST-COMMENT.

           MOVE 'Y'             TO WS-HIST-TRF-OVERRIDE-IND.
           MOVE WS-HIST-COMMENT TO WS-HIST-TRF-COMMENT1.
           MOVE 'Y'             TO WS-HIST-TRF-IND. 

           PERFORM 8000-WRITE-HISTORY THRU 8099-EXIT.   

      *-----------------------------------------------------------------

       2980-CHECK-RESIDENT-ST.  
           IF (RSP29-PAX-OVR-RESIDENT-ST-FLAG (NSUB) = ZERO)
              GO TO 3000-CHECK-RPU-CHANGE.  

           MOVE SPACES     TO WS-HISTORY-AN-PARAMS. 
           MOVE LOW-VALUES TO WS-HISTORY-N-PARAMS.  
           MOVE 'PSO'      TO WS-HIST-ACTIVITY-TYPE.
           MOVE NSUB       TO WS-HIST-PAX-NUM.  
           MOVE RSP06-PAX-SEQ-NUM OF RSP06-NEW (NSUB) TO
                WS-HIST-PAX-SEQ-NUM.
           MOVE RSP06-PAX-CITY-CODE OF RSP06-NEW (NSUB) TO  
                WS-HIST-CITY-CODE.  
PPC470*    MOVE RSP06-PAX-FARE-CODE OF RSP06-NEW (NSUB) TO  
PPC470*         WS-HIST-FARE-CODE.  
PPC470     MOVE RSP06-PAX-OFFER-CODE OF RSP06-NEW (NSUB) TO 
PPC470          WS-HIST-OFFER-CODE. 
PPC470     MOVE RSP06-PAX-FARE-TYPE OF RSP06-NEW (NSUB) TO  
PPC470          WS-HIST-FARE-TYPE.  

           STRING 'PAX RESIDENT STATE OVERRIDE' 
                  DELIMITED BY SIZE INTO WS-HIST-COMMENT.   

           MOVE 'Y'             TO WS-HIST-TRF-OVERRIDE-IND.
           MOVE WS-HIST-COMMENT TO WS-HIST-TRF-COMMENT1.
           MOVE 'Y'             TO WS-HIST-TRF-IND. 

           PERFORM 8000-WRITE-HISTORY THRU 8099-EXIT.   

      *=================================================================

PPC470 3000-CHECK-RPU-CHANGE.   

PPC470     IF WS-REACTIVATE-FLAG = 'Y' OR WS-CHG-SAILING-FLAG = 'Y' OR  
PPC470        WS-CHG-OFFER-FLAG = 'Y'   
PPC470        GO TO 3160-CHECK-PTFR-CHANGE. 

PPC470     IF RSP06-PAX-CRUISE-AMT OF RSP06-OLD (OSUB) =
PPC470        RSP06-PAX-CRUISE-AMT OF RSP06-NEW (NSUB) AND  
PPC470        RSP06-PAX-PTCHG-AMT  OF RSP06-OLD (OSUB) =
PPC470        RSP06-PAX-PTCHG-AMT  OF RSP06-NEW (NSUB)  
PPC470        GO TO 3160-CHECK-PTFR-CHANGE  
PPC470     END-IF.  

PPC470     MOVE 'N' TO WS-RPU-TRF-IND.  

PPC470     IF RSP06-PAX-CRUISE-AMT OF RSP06-OLD (OSUB) =
PPC470        RSP06-PAX-CRUISE-AMT OF RSP06-NEW (NSUB)  
PPC470        GO TO 3010-CHECK-NCF-AMOUNT   
PPC470     END-IF.  

PPC470     MOVE 'Y'        TO WS-RPU-TRF-IND.   
PPC470     MOVE SPACES     TO WS-HISTORY-AN-PARAMS. 
PPC470     MOVE LOW-VALUES TO WS-HISTORY-N-PARAMS.  
PPC470     MOVE NSUB       TO WS-HIST-PAX-NUM.  
PPC470     MOVE 'RPU'      TO WS-HIST-ACTIVITY-TYPE.
PPC470     MOVE RSP06-PAX-SEQ-NUM OF RSP06-NEW (NSUB)   
PPC470                     TO WS-HIST-PAX-SEQ-NUM.  
PPC470     MOVE RSP06-PAX-OFFER-CODE OF RSP06-NEW (NSUB)
PPC470                     TO WS-HIST-OFFER-CODE.   
PPC470     MOVE RSP06-PAX-FARE-TYPE OF RSP06-NEW (NSUB) 
PPC470                     TO WS-HIST-FARE-TYPE.

PPC470     MOVE RSP06-PAX-CRUISE-AMT OF RSP06-OLD (OSUB)
PPC470                     TO WS-DSPAMT8-1  
PPC470     STRING 'Cruise Fr: ' WS-DSPAMT8-1
PPC470            DELIMITED BY SIZE INTO WS-HIST-COMMENT.   
PPC470     PERFORM 8000-WRITE-HISTORY THRU 8099-EXIT.   
