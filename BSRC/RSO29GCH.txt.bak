161361          RSP06-POBC-ENTRY-CNT OF RSP06-OLD (OSUB)
161361         IF RSP06-POBC-SAILING-AMT
161361                 OF RSP06-NEW (NSUB WS-OBC-SUB) NOT = 
161361            RSP06-POBC-SAILING-AMT
161361                 OF RSP06-OLD (OSUB WS-OBC-SUB)   
161361  
161361          MOVE 'OBM'                TO WS-HIST-ACTIVITY-TYPE  
161361          MOVE NSUB                 TO WS-HIST-PAX-NUM
161361          MOVE RSP06-PAX-SEQ-NUM OF RSP06-NEW (NSUB)  
161361                                    TO WS-HIST-PAX-SEQ-NUM
161361          MOVE RSP06-PAX-CITY-CODE OF RSP06-NEW (NSUB)
161361                                    TO WS-HIST-CITY-CODE  
PPC470*         MOVE RSP06-PAX-FARE-CODE OF RSP06-NEW (NSUB)
PPC470*                                   TO WS-HIST-FARE-CODE  
PPC470          MOVE RSP06-PAX-OFFER-CODE OF RSP06-NEW (NSUB)   
PPC470                                    TO WS-HIST-OFFER-CODE 
PPC470          MOVE RSP06-PAX-FARE-TYPE OF RSP06-NEW (NSUB)
PPC470                                    TO WS-HIST-FARE-TYPE  
161361**SAIL BASED CURRENCY AMOUNTS - DIFFERENT AMOUNTS 
161361          SUBTRACT RSP06-POBC-SAILING-AMT 
161361                 OF RSP06-OLD (OSUB WS-OBC-SUB)   
161361          FROM RSP06-POBC-SAILING-AMT 
161361                  OF RSP06-NEW (NSUB WS-OBC-SUB)  
161361                        GIVING      WS-HIST-AMT   
161361          MOVE SPACES TO WS-HIST-COMMENT  
161361          STRING RSP06-POBC-OBC-CODE OF RSP06-NEW 
161361                                  (NSUB WS-OBC-SUB) ' CHANGED'
161361             DELIMITED BY SIZE INTO WS-HIST-COMMENT   
161361  
161361          MOVE WS-HIST-COMMENT      TO WS-HIST-TRF-COMMENT2   
161361*         IF  RSP06-POBC-CHARGE-AMT   
161361*                 OF RSP06-OLD (OSUB WS-OBC-SUB) NOT =
161361*             RSP06-POBC-CHARGE-AMT   
161361*                 OF RSP06-NEW (NSUB WS-OBC-SUB)  
161361          MOVE 'Y'                  TO WS-HIST-TRF-IND
161361*         END-IF  
161361  
161361          PERFORM 8000-WRITE-HISTORY THRU 8099-EXIT   
161361       END-IF 
161361      END-PERFORM 
161361      IF RSP06-POBC-ENTRY-CNT OF RSP06-NEW(NSUB) >
161361          RSP06-POBC-ENTRY-CNT OF RSP06-OLD (OSUB)
161361        ADD 1 TO RSP06-POBC-ENTRY-CNT OF RSP06-OLD (OSUB) 
161361                       GIVING WS-OBC-SUB-1
161361        PERFORM VARYING WS-OBC-SUB FROM   
161361          WS-OBC-SUB-1 BY 1   
161361                UNTIL WS-OBC-SUB >
161361          RSP06-POBC-ENTRY-CNT OF RSP06-NEW (NSUB)
161361  
161361         IF  RSP06-POBC-OBC-CODE OF RSP06-NEW 
161361             (NSUB WS-OBC-SUB) NOT = 'TRUP'   
161361             MOVE 'OBA'                TO WS-HIST-ACTIVITY-TYPE   
161361             MOVE NSUB                 TO WS-HIST-PAX-NUM 
161361             MOVE RSP06-PAX-SEQ-NUM OF RSP06-NEW (NSUB)   
161361                                       TO WS-HIST-PAX-SEQ-NUM 
161361             MOVE RSP06-PAX-CITY-CODE OF RSP06-NEW (NSUB) 
161361                                       TO WS-HIST-CITY-CODE   
PPC470*            MOVE RSP06-PAX-FARE-CODE OF RSP06-NEW (NSUB) 
PPC470*                                      TO WS-HIST-FARE-CODE   
PPC470             MOVE RSP06-PAX-OFFER-CODE OF RSP06-NEW (NSUB)
PPC470                                       TO WS-HIST-OFFER-CODE  
PPC470             MOVE RSP06-PAX-FARE-TYPE OF RSP06-NEW (NSUB) 
PPC470                                       TO WS-HIST-FARE-TYPE   
161361**SAIL BASED CURRENCY AMOUNTS 
161361             MOVE RSP06-POBC-SAILING-AMT  
161361                     OF RSP06-NEW (NSUB WS-OBC-SUB)   
161361                                TO     WS-HIST-AMT
161361             MOVE SPACES TO WS-HIST-COMMENT   
161361             STRING RSP06-POBC-OBC-CODE OF RSP06-NEW  
161361                                        (NSUB WS-OBC-SUB) ' ADDED'
161361                 DELIMITED BY SIZE INTO WS-HIST-COMMENT   
161361  
161361             MOVE WS-HIST-COMMENT      TO WS-HIST-TRF-COMMENT2
161361*            IF   RSP06-POBC-CHARGE-AMT   
161361*                    OF RSP06-NEW (NSUB WS-OBC-SUB) > 0   
161361             MOVE 'Y'                  TO WS-HIST-TRF-IND 
161361*            END-IF   
161361  
