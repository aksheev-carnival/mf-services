148695                                             DELIMITED BY SIZE
148695                   INTO WS-HISTORY-COMMENT
148695              PERFORM 7100-WRITE-PPHOR-HIST   
148695                 THRU 7100-WRITE-PPHOR-HIST-EXIT  
148695           END-IF 
148695  
148695           IF (RSP06-PPHOR-SEND-TXT-PREF-IND OF RSP06-NEW 
148695              (NSUB WS-PPHOR-NEW-PHN-SUB) = 'Y' OR 'I' OR 'N') AND
148695              (RSP06-PPHOR-PHONE-TYPE OF RSP06-NEW
148695                     (NSUB WS-PPHOR-NEW-PHN-SUB) NOT = 'H')   
148695              MOVE SPACES                 TO WS-HISTORY-COMMENT   
148695              MOVE 'STP'                  TO WS-HIST-ACTIVITY-TYPE
148695              STRING 'PREF IND: '            DELIMITED BY SIZE
148695                     ' '                     DELIMITED BY SIZE
148695                     ' TO '                  DELIMITED BY SIZE
148695                     RSP06-PPHOR-SEND-TXT-PREF-IND OF RSP06-NEW   
148695                     (NSUB WS-PPHOR-NEW-PHN-SUB)  
148695                                             DELIMITED BY SIZE
148695                   INTO WS-HISTORY-COMMENT
148695              PERFORM 7100-WRITE-PPHOR-HIST   
148695                 THRU 7100-WRITE-PPHOR-HIST-EXIT  
148695           END-IF 
148695  
148695           IF (RSP06-PPHOR-SAIL-TXT-OPT-FLG OF RSP06-NEW  
148695                  (NSUB WS-PPHOR-NEW-PHN-SUB) = 1) AND
148695              (RSP06-PPHOR-PHONE-TYPE OF RSP06-NEW
148695                     (NSUB WS-PPHOR-NEW-PHN-SUB) NOT = 'H')   
148695              MOVE SPACES                 TO WS-HISTORY-COMMENT   
148695              MOVE 'STO'                  TO WS-HIST-ACTIVITY-TYPE
148695              STRING 'SAIL OPT: '            DELIMITED BY SIZE
148695                     ' '                     DELIMITED BY SIZE
148695                     ' TO '                  DELIMITED BY SIZE
148695                     'Y'                     DELIMITED BY SIZE
148695                   INTO WS-HISTORY-COMMENT
148695              PERFORM 7100-WRITE-PPHOR-HIST   
148695                 THRU 7100-WRITE-PPHOR-HIST-EXIT  
148695           END-IF 
148695  
148695           IF (RSP06-PPHOR-PAYM-TXT-OPT-FLG OF RSP06-NEW  
148695                  (NSUB WS-PPHOR-NEW-PHN-SUB) = 1) AND
148695              (RSP06-PPHOR-PHONE-TYPE OF RSP06-NEW
148695                     (NSUB WS-PPHOR-NEW-PHN-SUB) NOT = 'H')   
148695              MOVE SPACES                 TO WS-HISTORY-COMMENT   
148695              MOVE 'PTO'                  TO WS-HIST-ACTIVITY-TYPE
148695              STRING 'PAYM OPT: '            DELIMITED BY SIZE
148695                     ' '                     DELIMITED BY SIZE
148695                     ' TO '                  DELIMITED BY SIZE
148695                     'Y'                     DELIMITED BY SIZE
148695                   INTO WS-HISTORY-COMMENT
148695              PERFORM 7100-WRITE-PPHOR-HIST   
148695                 THRU 7100-WRITE-PPHOR-HIST-EXIT  
148695           END-IF 
148695        END-IF
148695     END-PERFORM. 

148695 7000-CHK-PPHOR-PHN-NUM-EXIT. 
148695     EXIT.

      *-----------------------------------------------------------------

148695 7100-WRITE-PPHOR-HIST.   

148695     MOVE NSUB                    TO WS-HIST-PAX-NUM. 
148695     MOVE RSP06-PAX-SEQ-NUM OF RSP06-NEW (NSUB)   
148695                                  TO WS-HIST-PAX-SEQ-NUM. 
148695     MOVE RSP06-PAX-CITY-CODE OF RSP06-NEW (NSUB) 
148695                                  TO WS-HIST-CITY-CODE.   
PPC470*    MOVE RSP06-PAX-FARE-CODE OF RSP06-NEW (NSUB) TO  
PPC470*         WS-HIST-FARE-CODE.  
PPC470     MOVE RSP06-PAX-OFFER-CODE OF RSP06-NEW (NSUB) TO 
PPC470          WS-HIST-OFFER-CODE. 
PPC470     MOVE RSP06-PAX-FARE-TYPE OF RSP06-NEW (NSUB) TO  
PPC470          WS-HIST-FARE-TYPE.  
148695     MOVE WS-HISTORY-COMMENT      TO WS-HIST-COMMENT. 
148695     MOVE WS-HIST-COMMENT         TO WS-HIST-TRF-COMMENT2.
148695     MOVE 'Y'                     TO WS-HIST-TRF-IND. 
148695     PERFORM 8000-WRITE-HISTORY THRU 8099-EXIT.   

148695 7100-WRITE-PPHOR-HIST-EXIT.  
148695     EXIT.

      *=================================================================
      *=================================================================

       8000-WRITE-HISTORY.  
           PERFORM VARYING SUB FROM 1 BY 1 UNTIL SUB > 40   
              IF WS-HIST-CMT-ASCII (SUB) > 126 OR   
                    WS-HIST-CMT-ASCII (SUB) < 32
                 MOVE SPACE TO WS-HIST-COMMENT (SUB:1)  
              END-IF
           END-PERFORM. 

           PERFORM VARYING SUB FROM 1 BY 1 UNTIL SUB > 15   
              IF WS-HIST-CNTCT-ASCII (SUB) > 126 OR 
                    WS-HIST-CNTCT-ASCII (SUB) < 32  
                 MOVE SPACE TO WS-HIST-CONTACT (SUB:1)  
              END-IF
           END-PERFORM. 

           IF RSP06-IBR-BOOK-TYPE OF RSP06-NEW = 'G'
              GO TO 8050-WRITE-GRP-HISTORY. 

           IF WS-HIST-CURRENT-FLAG = 'N'
              MOVE LOW-VALUES TO INDV-BOOK-HISTORY-REC  
              FETCH LAST INDV-BOOK-HISTORY-REC  
                    WITHIN INDV-BOOKING-HIST-SET SET
                    ON ERROR GO TO 8010-INIT-NEW-INDV-HIST  
              MOVE 'Y'                  TO WS-HIST-CURRENT-FLAG 
              MOVE CURRENT-DBKEY        TO WS-HIST-DBKEY
              MOVE IBHR-RECORD-SEQ-NUM  TO WS-HIST-SEQ-NUM. 

           GO TO 8020-ADD-NEW-ENTRY.

      *-----------------------------------------------------------------

       8010-INIT-NEW-INDV-HIST. 
           MOVE SPACES           TO IBHR-HISTORY-TABLE  
                                    IBHR-CALC-KEY.  
           MOVE DPP02-SYS-HHMMSS TO IBHR-STORE-TIME.
           MOVE RSP06-IBR-BOOK-NUM OF RSP06-NEW TO IBHR-BOOK-NUM.   
           MOVE ZERO             TO IBHR-ENTRY-CTR. 
144449*    MOVE 'INDV-HIST-'     TO INDV-HISTORY-CALCAREA.  
144449     MOVE RSP06-IBR-BOOK-NUM OF RSP06-NEW (5:1) TO
                INDV-HISTORY-CALCAREA (11:1).   

CCLAUS*    IF  RSP06-IBR-BOOK-NUM OF RSP06-NEW   (6:1) < '5'
CCLAUS*        MOVE '1' TO INDV-HISTORY-CALCAREA (12:1) 
CCLAUS*    ELSE 
CCLAUS*        MOVE '2' TO INDV-HISTORY-CALCAREA (12:1) 
CCLAUS*    END-IF.  
CCLAUS     MOVE FUNCTION ORD (RSP06-IBR-BOOK-NUM OF RSP06-NEW (6:1))
CCLAUS                                        TO WS-AREA-NUM-VALUE. 
CCLAUS     IF ( WS-AREA-NUM-VALUE >= 49 AND 
CCLAUS          WS-AREA-NUM-VALUE <= 53) OR 
CCLAUS        ( WS-AREA-NUM-VALUE >= 67 AND 
CCLAUS          WS-AREA-NUM-VALUE <= 78)
CCLAUS        MOVE '1' TO INDV-HISTORY-CALCAREA (12:1)  
CCLAUS     ELSE 
CCLAUS        MOVE '2' TO INDV-HISTORY-CALCAREA (12:1)  
CCLAUS     END-IF.  


           ADD 1 TO IBHR-RECORD-SEQ-NUM.

           STORE INDV-BOOK-HISTORY-REC  
                 ON ERROR GO TO 10200-STORE-IBHR-ERROR. 

           MOVE 'Y'                  TO WS-HIST-CURRENT-FLAG.   
           MOVE CURRENT-DBKEY        TO WS-HIST-DBKEY.  
           MOVE IBHR-RECORD-SEQ-NUM  TO WS-HIST-SEQ-NUM.

      *-----------------------------------------------------------------

       8020-ADD-NEW-ENTRY.  
           IF IBHR-ENTRY-CTR NOT < WS-IBHR-ENTRY-MAX
              GO TO 8010-INIT-NEW-INDV-HIST.
           ADD 1 TO IBHR-ENTRY-CTR. 
           MOVE IBHR-ENTRY-CTR        TO WS-HIST-ENTRY-SUB. 

           MOVE WS-3CHAR-USERID       TO
               IBHR-OPER-INITIALS (IBHR-ENTRY-CTR). 

176338     IF  WS-HIST-ACTIVITY-TYPE  = 'OBA'   
176338         IF  WS-HIST-USER-ID = 'SYS' OR   
181859             ( NSUB > 0 AND   
181859                NSUB < 6 AND  
176338             RSP06-POBC-USERID OF RSP06-NEW (NSUB WS-OBC-SUB) 
181859             = 'SYS' )
176338             MOVE 'SYS'         TO IBHR-OPER-INITIALS 
176338                                   (IBHR-ENTRY-CTR)   
176338         END-IF   
176338     END-IF.  

           MOVE WS-HIST-ACTIVITY-TYPE      TO   
                IBHR-ACTIVITY-CODE (IBHR-ENTRY-CTR).
           MOVE WS-HIST-COMMENT            TO   
                IBHR-COMMENT (IBHR-ENTRY-CTR).  
           MOVE WS-HIST-AMT           TO
                IBHR-HISTORY-AMT (IBHR-ENTRY-CTR).  
           MOVE WS-HIST-PAX-NUM       TO
                IBHR-PAX-NUM (IBHR-ENTRY-CTR).  
           MOVE WS-HIST-PAX-SEQ-NUM   TO
                IBHR-PAX-SEQ-NUM (IBHR-ENTRY-CTR).  
           MOVE WS-HIST-TYPE          TO
                IBHR-HISTORY-TYPE (IBHR-ENTRY-CTR). 
           MOVE RSP29-I-LOCATION-CODE TO
                IBHR-AGENCY-CONN-CODE (IBHR-ENTRY-CTR). 
           MOVE RSP06-IBR-REMOTE-AGENCY-ID OF RSP06-NEW TO  
                IBHR-PSEUDO-CITY-CODE (IBHR-ENTRY-CTR). 
           MOVE WS-HIST-SYSTEM-CC     TO
                IBHR-CC-DATE-FILLER (IBHR-ENTRY-CTR).   
           MOVE WS-HIST-SYSTEM-DATE   TO
                IBHR-DATE (IBHR-ENTRY-CTR). 
           MOVE DPP02-SYS-HHMMSS      TO
                IBHR-TIME (IBHR-ENTRY-CTR). 

           IF (WS-HIST-CONTACT > SPACE) 
              MOVE WS-HIST-CONTACT  TO  
                   IBHR-AGENCY-CONTACT  (IBHR-ENTRY-CTR)
           ELSE 
              MOVE RSP29-I-UPDATE-CONTACT TO
                   IBHR-AGENCY-CONTACT (IBHR-ENTRY-CTR).

           IF (CURRENT-DBKEY NOT = WS-HIST-DBKEY)   
              FIND CURRENT INDV-BOOK-HISTORY-REC RECORD 
                   ON ERROR GO TO 12600-FIND-IBHR-ERROR.

           MODIFY INDV-BOOK-HISTORY-REC RECORD  
                  ON ERROR GO TO 10300-MODIFY-IBHR-ERROR.   
           PERFORM 8200-CREATE-ASTRF-REC THRU 8299-EXIT.

           PERFORM 8300-CREATE-ACHR-REC THRU 8399-EXIT. 

           IF WS-HIST-TRF-IND NOT = 'Y' 
              GO TO 8099-EXIT.  

           IF WS-HIST-TRF-AMT = ZERO AND (WS-HIST-AMT NOT = ZERO)   
              MOVE WS-HIST-AMT TO WS-HIST-TRF-AMT.  

           IF WS-HIST-TRF-OLD-AMT = ZERO AND
                 (WS-HIST-OLD-AMT NOT = ZERO)   
              MOVE WS-HIST-OLD-AMT TO WS-HIST-TRF-OLD-AMT.  

           IF WS-HIST-TRF-ACTIVITY-TYPE <= SPACES   
              MOVE WS-HIST-ACTIVITY-TYPE TO WS-HIST-TRF-ACTIVITY-TYPE.  

116157     PERFORM 8100-WRITE-TRF THRU 8199-EXIT.   

           GO TO 8099-EXIT. 

      *-----------------------------------------------------------------

       8050-WRITE-GRP-HISTORY.  
           IF WS-HIST-CURRENT-FLAG = 'N'
              MOVE LOW-VALUES TO GRP1-BOOK-HISTORY-REC  
              FETCH LAST GRP1-BOOK-HISTORY-REC  
                    WITHIN GRP1-BOOK-HISTORY-SET SET
                    ON ERROR GO TO 8060-INIT-NEW-GRP-HIST   
              MOVE 'Y'                  TO WS-HIST-CURRENT-FLAG 
              MOVE CURRENT-DBKEY        TO WS-HIST-DBKEY
              MOVE GBHR1-REC-SEQ-NUM    TO WS-HIST-SEQ-NUM. 

           GO TO 8070-ADD-NEW-ENTRY.

      *-----------------------------------------------------------------

       8060-INIT-NEW-GRP-HIST.  
           MOVE ZERO             TO GBHR1-ENTRY-CNT.
           MOVE 'GRP1-HIST-'     TO GRP1-HIST-AREA-NAME.
           MOVE RSP06-IBR-GROUP-BOOK-NUM OF RSP06-NEW (6:1) TO  
                GRP1-HIST-AREA-NAME (11:1). 

           MOVE 2 TO FETCH-WITH-LOCK.   

           FIND GRP1-HISTORY-HDR-REC RECORD 
                ON ERROR GO TO 10700-GRP-HIST-HDR-ERROR.

           MOVE 0 TO FETCH-WITH-LOCK.   

           ADD 1 TO GBHR1-REC-SEQ-NUM.  

           STORE GRP1-BOOK-HISTORY-REC  
                 ON ERROR GO TO 10400-STORE-GBHR1-ERROR.

           MOVE 'Y'                  TO WS-HIST-CURRENT-FLAG.   
           MOVE CURRENT-DBKEY        TO WS-HIST-DBKEY.  
           MOVE GBHR1-REC-SEQ-NUM    TO WS-HIST-SEQ-NUM.

      *-----------------------------------------------------------------

       8070-ADD-NEW-ENTRY.  
           IF GBHR1-ENTRY-CNT NOT < WS-GBHR-ENTRY-MAX   
              GO TO 8060-INIT-NEW-GRP-HIST. 

           ADD 1 TO GBHR1-ENTRY-CNT.

           MOVE GBHR1-ENTRY-CNT TO WS-HIST-ENTRY-SUB.   

           MOVE WS-USERID TO
                GBHR1-USER-ID (GBHR1-ENTRY-CNT).

