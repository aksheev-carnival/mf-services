      *-----------------------------------------------------------------

       0900-CHECK-BTB.  
           IF (RSP06-IBR-BTB-BOOK-NUM OF RSP06-NEW =
                 RSP06-IBR-BTB-BOOK-NUM OF RSP06-OLD)   
              GO TO 0920-CHECK-PIN. 

           MOVE SPACES     TO WS-HISTORY-AN-PARAMS. 
           MOVE LOW-VALUES TO WS-HISTORY-N-PARAMS.  
           MOVE 'BTB'      TO WS-HIST-ACTIVITY-TYPE.

           STRING 'CHG BTB: '   
                  RSP06-IBR-BTB-BOOK-NUM OF RSP06-OLD   
                  DELIMITED BY SIZE INTO WS-HIST-COMMENT.   

126688     MOVE WS-HIST-COMMENT TO WS-HIST-TRF-COMMENT2.
126688     MOVE 'Y'             TO WS-HIST-TRF-IND. 

           PERFORM 8000-WRITE-HISTORY THRU 8099-EXIT.   

      *-----------------------------------------------------------------

       0920-CHECK-PIN.  
           IF (RSP06-IBR-PIN-NUM OF RSP06-NEW = 
                 RSP06-IBR-PIN-NUM OF RSP06-OLD)
              GO TO 0940-CHECK-WAITLIST.

           MOVE SPACES     TO WS-HISTORY-AN-PARAMS. 
           MOVE LOW-VALUES TO WS-HISTORY-N-PARAMS.  
           MOVE 'CPN'      TO WS-HIST-ACTIVITY-TYPE.

           STRING 'CHG PIN NUM: '   
                  RSP06-IBR-PIN-NUM OF RSP06-OLD
                  DELIMITED BY SIZE INTO WS-HIST-COMMENT.   

           PERFORM 8000-WRITE-HISTORY THRU 8099-EXIT.   

      *=================================================================

       0940-CHECK-WAITLIST. 
           IF RSP06-WAIT-READ-IND OF RSP06-NEW = 'N'
              GO TO 1000-PROCESS-GUEST-HISTORY. 

           IF RSP06-WAIT-EXIST-IND OF RSP06-NEW = 'N'   
              IF RSP06-WAIT-EXIST-IND OF RSP06-OLD = 'N'
                 GO TO 1000-PROCESS-GUEST-HISTORY   
              ELSE  
                 GO TO 0960-DELETE-WAITLIST-INFO
           ELSE 
              IF RSP06-WAIT-EXIST-IND OF RSP06-OLD = 'Y'
                 IF RSP06-WAITLIST-REC OF RSP06-OLD =   
                       RSP06-WAITLIST-REC OF RSP06-NEW  
                    GO TO 1000-PROCESS-GUEST-HISTORY.   

           MOVE SPACES     TO WS-HISTORY-AN-PARAMS. 
           MOVE LOW-VALUES TO WS-HISTORY-N-PARAMS.  


           IF RSP06-WAIT-EXIST-IND OF RSP06-OLD = 'N'   
              MOVE 'WLA'      TO WS-HIST-ACTIVITY-TYPE  
           ELSE 
              MOVE 'WLC'      TO WS-HIST-ACTIVITY-TYPE. 

           MOVE RSP06-WAIT-COMMENT OF RSP06-NEW TO WS-HIST-COMMENT. 
           MOVE 'Y'                             TO WS-HIST-TRF-IND. 

           PERFORM 8000-WRITE-HISTORY THRU 8099-EXIT.   

           GO TO 1000-PROCESS-GUEST-HISTORY.

       0960-DELETE-WAITLIST-INFO.   
           MOVE SPACES     TO WS-HISTORY-AN-PARAMS. 
           MOVE LOW-VALUES TO WS-HISTORY-N-PARAMS.  
           MOVE 'WLD'      TO WS-HIST-ACTIVITY-TYPE.
           MOVE RSP06-WAIT-COMMENT OF RSP06-NEW TO WS-HIST-COMMENT. 
           MOVE 'Y'        TO WS-HIST-TRF-IND.  

           PERFORM 8000-WRITE-HISTORY THRU 8099-EXIT.   

      *=================================================================
      *=================================================================

       1000-PROCESS-GUEST-HISTORY.  
           MOVE ZERO TO OSUB.   

       1020-CHECK-NEXT-OLD-PAX. 
           ADD 1 TO OSUB.   

           IF OSUB > RSP06-PAX-CNT OF RSP06-OLD 
              GO TO 2000-CHECK-ACTIVE-PAX.  

           MOVE ZERO TO NSUB.   

           PERFORM VARYING SUB FROM 1 BY 1  
                   UNTIL SUB > RSP06-PAX-CNT OF RSP06-NEW   
              IF RSP06-PAX-SEQ-NUM OF RSP06-OLD (OSUB) =
                    RSP06-PAX-SEQ-NUM OF RSP06-NEW (SUB)
                 MOVE SUB                        TO NSUB
                 MOVE RSP06-PAX-CNT OF RSP06-NEW TO SUB 
              END-IF
           END-PERFORM. 

           IF NSUB > ZERO   
              GO TO 1020-CHECK-NEXT-OLD-PAX.

           PERFORM VARYING SUB FROM 1 BY 1  
                   UNTIL SUB > RSP06-CXP-PAX-CNT OF RSP06-NEW   
              IF RSP06-PAX-SEQ-NUM OF RSP06-OLD (OSUB) =
                    RSP06-PCX-SEQ-NUM OF RSP06-NEW (SUB)
                 MOVE SUB                            TO NSUB
                 MOVE RSP06-CXP-PAX-CNT OF RSP06-NEW TO SUB 
              END-IF
           END-PERFORM. 

           IF NSUB = ZERO   
              MOVE 5                    TO DPP42-HOLD-MSG-INDEX 
              MOVE 'PAX-SEQ-NUM missing in CXP-TABLE' TO
                   DPP42-HOLD-MSG-DESC  
              GO TO 9200-EDIT-ERROR-MSG.

           IF (RSP06-PAX-INSURANCE-IND OF RSP06-OLD (OSUB) = 'N')   
PPC470*       GO TO 1040-CHECK-CXP-PTFRS.   
PPC470        GO TO 1022-CHECK-PPG-INCULDED 
PPC470     END-IF.  

           IF (RSP06-PCX-INSURANCE-IND OF RSP06-NEW (NSUB) = 'S' OR 'G')
PPC470*       GO TO 1040-CHECK-CXP-PTFRS.   
PPC470        GO TO 1022-CHECK-PPG-INCULDED 
PPC470     END-IF.  

           MOVE SPACES     TO WS-HISTORY-AN-PARAMS. 
           MOVE LOW-VALUES TO WS-HISTORY-N-PARAMS.  
           MOVE 'VPP'      TO WS-HIST-ACTIVITY-TYPE.
           MOVE OSUB       TO WS-HIST-PAX-NUM.  
           MOVE RSP06-PAX-SEQ-NUM OF RSP06-OLD (OSUB) TO
                WS-HIST-PAX-SEQ-NUM.
           MOVE RSP06-PAX-CITY-CODE OF RSP06-OLD (OSUB) TO  
                WS-HIST-CITY-CODE.  
PPC470*    MOVE RSP06-PAX-FARE-CODE OF RSP06-OLD (OSUB) TO  
PPC470*         WS-HIST-FARE-CODE.  
PPC470     MOVE RSP06-PAX-OFFER-CODE OF RSP06-OLD (OSUB) TO 
PPC470          WS-HIST-OFFER-CODE. 
PPC470     MOVE RSP06-PAX-FARE-TYPE OF RSP06-OLD (OSUB) TO  
PPC470          WS-HIST-FARE-TYPE.  
115785*    MOVE 'CANCEL PAX'       TO WS-HIST-CONTACT   
115785     MOVE RSP06-IBR-AGENT-CONTACT OF RSP06-NEW
115785                             TO WS-HIST-CONTACT.  

           IF (RSP06-TIR-READ-IND OF RSP06-OLD (OSUB) NOT = 'Y')
              MOVE 6 TO DPP42-HOLD-MSG-INDEX
              GO TO 9200-EDIT-ERROR-MSG.

           IF (RSP06-TIR-EXIST-IND OF RSP06-OLD (OSUB) = 'Y')   
              COMPUTE WS-HIST-AMT = 
                      RSP06-TIR-PREMIUM-AMT OF RSP06-OLD (OSUB) * -1.   

           IF (RSP06-PCX-INSURANCE-IND OF RSP06-NEW (NSUB) = 'N' OR 'C')
              MOVE 'INSURANCE CANCELLED' TO WS-HIST-COMMENT 
           ELSE 
              IF RSP06-PCX-INSURANCE-IND OF RSP06-NEW (NSUB) = 'W'  
                 MOVE 'INSURANCE WAIVED   ' TO WS-HIST-COMMENT. 

           MOVE WS-HIST-COMMENT       TO WS-HIST-TRF-COMMENT1   
           MOVE 'Y'    TO WS-HIST-TRF-IND.  

           PERFORM 8000-WRITE-HISTORY THRU 8099-EXIT.   

115785     MOVE 'VPC'  TO WS-HIST-ACTIVITY-TYPE 
115785                    WS-HIST-TRF-ACTIVITY-TYPE.
115785     MOVE ZEROES TO WS-HIST-TRF-AMT   
115785                    WS-HIST-OLD-AMT   
115785                    WS-HIST-TRF-OLD-AMT   
115785                    WS-HIST-AMT.  
115785     PERFORM 8000-WRITE-HISTORY THRU 8099-EXIT.   

