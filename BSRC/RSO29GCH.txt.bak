PPC470*-----------------------------------------------------------------

       3140-CREATE-RPU-TRF. 
           IF WS-RPU-TRF-IND = 'N'  
              GO TO 3160-CHECK-PTFR-CHANGE. 

           MOVE SPACES     TO WS-HISTORY-AN-PARAMS. 
           MOVE LOW-VALUES TO WS-HISTORY-N-PARAMS.  


           COMPUTE WS-HIST-AMT = RSP06-IBR-GROSS-FARE-AMT OF RSP06-NEW  
                               - RSP06-IBR-GROSS-FARE-AMT OF RSP06-OLD. 

           IF WS-HIST-AMT = ZEROES  
              GO TO 3160-CHECK-PTFR-CHANGE. 

           MOVE 'RPU'      TO WS-HIST-TRF-ACTIVITY-TYPE.
           MOVE NSUB       TO WS-HIST-PAX-NUM   
           MOVE RSP06-PAX-SEQ-NUM OF RSP06-NEW (NSUB) TO
                WS-HIST-PAX-SEQ-NUM.
           MOVE RSP06-PAX-CITY-CODE OF RSP06-NEW (NSUB) TO  
                WS-HIST-CITY-CODE.  
PPC470*    MOVE RSP06-PAX-FARE-CODE OF RSP06-NEW (NSUB) TO  
PPC470*         WS-HIST-FARE-CODE.  
PPC470     MOVE RSP06-PAX-OFFER-CODE OF RSP06-NEW (NSUB) TO 
PPC470          WS-HIST-OFFER-CODE. 
PPC470     MOVE RSP06-PAX-FARE-TYPE OF RSP06-NEW (NSUB) TO  
PPC470          WS-HIST-FARE-TYPE.  

           MOVE WS-HIST-AMT TO WS-HIST-TRF-AMT. 

           PERFORM 8100-WRITE-TRF THRU 8199-EXIT.   

      *=================================================================

       3160-CHECK-PTFR-CHANGE.  
           IF (RSP06-PTFR-READ-IND OF RSP06-NEW (NSUB) = 'N') AND   
                 (RSP06-PTFR-READ-IND OF RSP06-OLD (OSUB) = 'N')
              GO TO 3280-CHECK-PAX-PACKAGE-CHG  
           ELSE 
              IF (RSP06-PTFR-READ-IND OF RSP06-NEW (NSUB) NOT = 
                    RSP06-PTFR-READ-IND OF RSP06-OLD (OSUB))
                 MOVE 13 TO DPP42-HOLD-MSG-INDEX
                 GO TO 9200-EDIT-ERROR-MSG. 

           IF (RSP06-PTFR-EXIST-IND OF RSP06-OLD (OSUB) = 'N')  
              GO TO 3220-CHECK-NEW-PTFRS.   

           MOVE ZERO TO OPTFR-SUB.  

       3180-NEXT-OLD-PTFR.  
           ADD 1 TO OPTFR-SUB.  

           IF OPTFR-SUB > RSP06-PTFR-TRANSFER-CNT OF RSP06-OLD (OSUB)   
              GO TO 3220-CHECK-NEW-PTFRS.   

           IF (RSP06-PTFR-EXIST-IND OF RSP06-NEW (NSUB) = 'N')  
              GO TO 3200-REMOVE-PTFR-HISTORY.   

146816     IF  RSP06-PTFR-CANCEL-DATE OF RSP06-OLD (OSUB OPTFR-SUB) > 0 
146816         GO TO 3180-NEXT-OLD-PTFR 
146816     END-IF.  

           MOVE ZERO TO PTFR-SUB.   

           PERFORM VARYING SUB FROM 1 BY 1  
                 UNTIL SUB > RSP06-PTFR-TRANSFER-CNT OF RSP06-NEW (NSUB)
              IF RSP06-PTFR-PRE-POST-IND OF RSP06-OLD (OSUB OPTFR-SUB) =
                    RSP06-PTFR-PRE-POST-IND OF RSP06-NEW (NSUB SUB) 
                 MOVE SUB TO PTFR-SUB   
                 MOVE RSP06-PTFR-TRANSFER-CNT OF RSP06-NEW (NSUB) TO SUB
              END-IF
           END-PERFORM. 

           IF PTFR-SUB = ZERO   
              GO TO 3200-REMOVE-PTFR-HISTORY.   

146816     IF  ( RSP06-PTFR-CANCEL-DATE OF RSP06-OLD (OSUB OPTFR-SUB)   
146816           <= ZEROES ) AND
146816         ( RSP06-PTFR-CANCEL-DATE OF RSP06-NEW (NSUB PTFR-SUB) >  
146816           ZEROES )   
146816         GO TO 3200-REMOVE-PTFR-HISTORY   
146816     END-IF.  

           IF (RSP06-PTFR-DETAIL OF RSP06-NEW (NSUB PTFR-SUB) = 
                 RSP06-PTFR-DETAIL OF RSP06-OLD (OSUB OPTFR-SUB))   
              GO TO 3180-NEXT-OLD-PTFR. 

           MOVE SPACES     TO WS-HISTORY-AN-PARAMS. 
           MOVE LOW-VALUES TO WS-HISTORY-N-PARAMS.  
           MOVE NSUB       TO WS-HIST-PAX-NUM.  
           MOVE 'CTM'      TO WS-HIST-ACTIVITY-TYPE.
           MOVE RSP06-PAX-SEQ-NUM OF RSP06-NEW (NSUB) TO
                WS-HIST-PAX-SEQ-NUM.
PPC470*    MOVE RSP06-PAX-FARE-CODE OF RSP06-NEW (NSUB) TO  
PPC470*         WS-HIST-FARE-CODE.  
PPC470     MOVE RSP06-PAX-OFFER-CODE OF RSP06-NEW (NSUB) TO 
PPC470          WS-HIST-OFFER-CODE. 
PPC470     MOVE RSP06-PAX-FARE-TYPE OF RSP06-NEW (NSUB) TO  
PPC470          WS-HIST-FARE-TYPE.  

           MOVE RSP06-PTFR-AMT OF RSP06-OLD (OSUB OPTFR-SUB) TO 
                WS-DSPAMT4-1.   

           EVALUATE RSP06-PTFR-PRE-POST-IND OF RSP06-NEW (NSUB PTFR-SUB)
              WHEN 'I'  
                 STRING 'PRE-XFR OLD: ' 
                     RSP06-PTFR-LOC-CODE OF RSP06-OLD (OSUB OPTFR-SUB)  
                     ' TO: '
                     RSP06-PTFR-LOC-CODE OF RSP06-NEW (NSUB PTFR-SUB)   
                     DELIMITED BY SIZE INTO WS-HIST-COMMENT 
              WHEN 'O'  
                 STRING 'POST-XFR OLD: '
                     RSP06-PTFR-LOC-CODE OF RSP06-OLD (OSUB OPTFR-SUB)  
                     ' TO: '
                     RSP06-PTFR-LOC-CODE OF RSP06-NEW (NSUB PTFR-SUB)   
                     DELIMITED BY SIZE INTO WS-HIST-COMMENT 
           END-EVALUATE.

           PERFORM 8000-WRITE-HISTORY THRU 8099-EXIT.   

           COMPUTE WS-HIST-TRF-AMT =
                       RSP06-PTFR-AMT OF RSP06-NEW (NSUB PTFR-SUB) -
                       RSP06-PTFR-AMT OF RSP06-OLD (OSUB OPTFR-SUB).

           MOVE WS-HIST-ACTIVITY-TYPE TO WS-HIST-TRF-ACTIVITY-TYPE. 
           MOVE WS-HIST-COMMENT       TO WS-HIST-TRF-COMMENT1.  

           PERFORM 8100-WRITE-TRF THRU 8199-EXIT.   

PPC470*    IF (RSP06-PAX-FARE-TYPE OF RSP06-NEW (NSUB) = 'C')   
PPC470*       GO TO 3180-NEXT-OLD-PTFR. 
PPC470* 
PPC470*    IF (RSP06-PAX-FARE-TYPE OF RSP06-NEW (NSUB) = 'C')   
PPC470*       GO TO 3180-NEXT-OLD-PTFR. 
PPC470* 
PPC470*    IF (RSP06-PAX-BOOK-TYPE OF RSP06-NEW (NSUB) NOT = 'G')   
PPC470*       GO TO 3180-NEXT-OLD-PTFR. 
PPC470* 
PPC470*    IF (RSP06-PTFR-AMT OF RSP06-NEW (NSUB PTFR-SUB) > 0) OR  
PPC470*          (RSP06-PTFR-PHASE-NUM OF RSP06-NEW (NSUB PTFR-SUB) =   
PPC470*          99999 OR 1)
PPC470*       GO TO 3180-NEXT-OLD-PTFR. 
PPC470* 
PPC470*    PERFORM 8600-GET-GRP-CITY THRU 8699-EXIT.
PPC470* 
PPC470*    IF (GCC1-INCLUSIVE-XFR-IND NOT = 'Y')
PPC470*       GO TO 3180-NEXT-OLD-PTFR. 
PPC470* 
PPC470*    MOVE SPACES     TO WS-HISTORY-AN-PARAMS. 
PPC470*    MOVE LOW-VALUES TO WS-HISTORY-N-PARAMS.  
PPC470*    MOVE NSUB       TO WS-HIST-PAX-NUM.  
PPC470*    MOVE 'XFRO'     TO WS-HIST-ACTIVITY-TYPE.
PPC470*    MOVE RSP06-PAX-SEQ-NUM OF RSP06-NEW (NSUB) TO
PPC470*         WS-HIST-PAX-SEQ-NUM.
PPC470*    MOVE RSP06-PAX-CITY-CODE OF RSP06-NEW (NSUB) TO  
PPC470*         WS-HIST-CITY-CODE.  
PPC470*    MOVE RSP06-PAX-OFFER-CODE OF RSP06-NEW (NSUB) TO 
PPC470*         WS-HIST-OFFER-CODE. 
PPC470*    MOVE RSP06-PAX-FARE-TYPE OF RSP06-NEW (NSUB) TO  
PPC470*         WS-HIST-FARE-TYPE.  
PPC470* 
PPC470*    MOVE 'FLY-AWEIGH XFER OVERRIDE' TO WS-HIST-COMMENT.  
PPC470*    MOVE WS-HIST-COMMENT TO WS-HIST-TRF-COMMENT1.
PPC470*    MOVE 'Y'             TO WS-HIST-TRF-IND. 
PPC470* 
PPC470*    PERFORM 8000-WRITE-HISTORY THRU 8099-EXIT.   

           GO TO 3180-NEXT-OLD-PTFR.

      *-----------------------------------------------------------------

       3200-REMOVE-PTFR-HISTORY.
           MOVE SPACES     TO WS-HISTORY-AN-PARAMS. 
           MOVE LOW-VALUES TO WS-HISTORY-N-PARAMS.  
           MOVE NSUB       TO WS-HIST-PAX-NUM.  
           MOVE 'CTX'      TO WS-HIST-ACTIVITY-TYPE.
           MOVE RSP06-PAX-SEQ-NUM OF RSP06-NEW (NSUB) TO
                WS-HIST-PAX-SEQ-NUM.
           MOVE RSP06-PAX-CITY-CODE OF RSP06-NEW (NSUB) TO  
                WS-HIST-CITY-CODE.  
PPC470*    MOVE RSP06-PAX-FARE-CODE OF RSP06-NEW (NSUB) TO  
PPC470*         WS-HIST-FARE-CODE.  
PPC470     MOVE RSP06-PAX-OFFER-CODE OF RSP06-NEW (NSUB) TO 
PPC470          WS-HIST-OFFER-CODE. 
PPC470     MOVE RSP06-PAX-FARE-TYPE OF RSP06-NEW (NSUB) TO  
PPC470          WS-HIST-FARE-TYPE.  

           MOVE RSP06-PTFR-AMT OF RSP06-OLD (OSUB OPTFR-SUB) TO 
                WS-DSPAMT4-1.   

           IF RSP06-PTFR-PURCHASE-SRC OF RSP06-OLD (OSUB OPTFR-SUB) 
                 NOT = 'S'  
              COMPUTE WS-HIST-AMT = 
                      RSP06-PTFR-AMT OF RSP06-OLD (OSUB OPTFR-SUB) * -1.

           EVALUATE RSP06-PTFR-PRE-POST-IND 
                                          OF RSP06-OLD (OSUB OPTFR-SUB) 
              WHEN 'I'  
                 IF RSP06-PTFR-LOC-CODE OF RSP06-OLD (OSUB OPTFR-SUB) > 
                       SPACES   
                    STRING 'DELETED XFER '  
                           RSP06-PTFR-LOC-CODE  
                                        OF RSP06-OLD (OSUB OPTFR-SUB)   
                          ' TO PIER '   
                          DELIMITED BY SIZE INTO WS-HIST-COMMENT
                ELSE
                   MOVE 'DELETED XFER FFF TO PIER ' TO WS-HIST-COMMENT  
                END-IF  
              WHEN 'O'  
                 IF RSP06-PTFR-LOC-CODE OF RSP06-OLD (OSUB OPTFR-SUB) > 
                       SPACES   
                    STRING 'DELETED XFER PIER TO '  
                           RSP06-PTFR-LOC-CODE  
                                          OF RSP06-OLD (OSUB OPTFR-SUB) 

                           DELIMITED BY SIZE INTO WS-HIST-COMMENT   
                 ELSE   
                    MOVE 'DELETED XFER PIER TO FFF' TO WS-HIST-COMMENT  
                 END-IF 
           END-EVALUATE.

           MOVE WS-HIST-COMMENT       TO WS-HIST-TRF-COMMENT1   
           MOVE 'Y'    TO WS-HIST-TRF-IND.  

           PERFORM 8000-WRITE-HISTORY THRU 8099-EXIT.   

           IF RSP06-PTFR-AMT OF RSP06-OLD (OSUB OPTFR-SUB) > ZERO   
              GO TO 3180-NEXT-OLD-PTFR. 

           IF (RSP06-PAX-BOOK-TYPE OF RSP06-OLD (OSUB) NOT = 'G')   
              GO TO 3180-NEXT-OLD-PTFR. 

           IF (RSP06-PAX-FARE-TYPE OF RSP06-OLD (OSUB) = 'C')   
              GO TO 3180-NEXT-OLD-PTFR. 

PPC470*    PERFORM 8600-GET-GRP-CITY THRU 8699-EXIT.
PPC470* 
PPC470*    IF (GCC1-INCLUSIVE-XFR-IND NOT = 'Y')
PPC470*       GO TO 3180-NEXT-OLD-PTFR. 

           MOVE 'COV' TO WS-HIST-ACTIVITY-TYPE. 

           PERFORM 8000-WRITE-HISTORY THRU 8099-EXIT.   

           GO TO 3180-NEXT-OLD-PTFR.

      *-----------------------------------------------------------------

       3220-CHECK-NEW-PTFRS.
           IF (RSP06-PTFR-EXIST-IND OF RSP06-NEW (NSUB) = 'N')  
              GO TO 3280-CHECK-PAX-PACKAGE-CHG. 

           MOVE ZERO TO PTFR-SUB.   

       3240-NEXT-NEW-PTFR.  
           ADD 1 TO PTFR-SUB.   

           IF PTFR-SUB > RSP06-PTFR-TRANSFER-CNT OF RSP06-NEW (NSUB)
              GO TO 3280-CHECK-PAX-PACKAGE-CHG. 

           IF (RSP06-PTFR-EXIST-IND OF RSP06-OLD (OSUB) = 'N')  
              GO TO 3260-ADD-PTFR-HISTORY.  

146816     IF  RSP06-PTFR-CANCEL-DATE OF RSP06-NEW (NSUB PTFR-SUB) > 0  
146816         GO TO 3240-NEXT-NEW-PTFR 
146816     END-IF.  

           MOVE ZERO TO OPTFR-SUB.  

           PERFORM VARYING SUB FROM 1 BY 1  
                 UNTIL SUB > RSP06-PTFR-TRANSFER-CNT OF RSP06-OLD (OSUB)
146816*       IF RSP06-PTFR-PRE-POST-IND OF RSP06-OLD (OSUB SUB) =  
146816*             RSP06-PTFR-PRE-POST-IND OF RSP06-NEW (NSUB PTFR-SUB)
146816        IF ( RSP06-PTFR-PRE-POST-IND OF RSP06-OLD (OSUB SUB) =
146816             RSP06-PTFR-PRE-POST-IND OF RSP06-NEW (NSUB PTFR-SUB))
146816           AND
146816           ( RSP06-PTFR-CANCEL-DATE OF RSP06-NEW (NSUB PTFR-SUB)  
146816           = RSP06-PTFR-CANCEL-DATE OF RSP06-OLD (OSUB SUB))  
                 MOVE SUB TO OPTFR-SUB  
                 MOVE RSP06-PTFR-TRANSFER-CNT OF RSP06-OLD (OSUB) TO SUB
              END-IF
           END-PERFORM. 

           IF OPTFR-SUB > ZERO  
              GO TO 3240-NEXT-NEW-PTFR. 

      *-----------------------------------------------------------------

       3260-ADD-PTFR-HISTORY.   
           MOVE SPACES     TO WS-HISTORY-AN-PARAMS. 
           MOVE LOW-VALUES TO WS-HISTORY-N-PARAMS.  
           MOVE NSUB       TO WS-HIST-PAX-NUM.  
           MOVE 'CTA'      TO WS-HIST-ACTIVITY-TYPE.
           MOVE RSP06-PAX-SEQ-NUM OF RSP06-NEW (NSUB) TO
                WS-HIST-PAX-SEQ-NUM.
           MOVE RSP06-PAX-CITY-CODE OF RSP06-NEW (NSUB) TO  
                WS-HIST-CITY-CODE.  
PPC470*    MOVE RSP06-PAX-FARE-CODE OF RSP06-NEW (NSUB) TO  
PPC470*         WS-HIST-FARE-CODE.  
PPC470     MOVE RSP06-PAX-OFFER-CODE OF RSP06-NEW (NSUB) TO 
PPC470          WS-HIST-OFFER-CODE. 
PPC470     MOVE RSP06-PAX-FARE-TYPE OF RSP06-NEW (NSUB) TO  
PPC470          WS-HIST-FARE-TYPE.  
           MOVE RSP06-PTFR-AMT OF RSP06-NEW (NSUB PTFR-SUB) TO  
                WS-DSPAMT4-1
                WS-HIST-AMT.

           EVALUATE RSP06-PTFR-PRE-POST-IND OF RSP06-NEW (NSUB PTFR-SUB)
              WHEN 'I'  
                 IF RSP06-PTFR-LOC-CODE OF RSP06-NEW (NSUB PTFR-SUB) >  
                       SPACES   
                    STRING 'ADDED XFER - '  
                           RSP06-PTFR-LOC-CODE  
                                            OF RSP06-NEW (NSUB PTFR-SUB)
                         ' TO PIER '
                         DELIMITED BY SIZE  INTO WS-HIST-COMMENT
                 ELSE   
                    MOVE 'ADDED XFER - FFF TO PIER' TO WS-HIST-COMMENT  
                 END-IF 
              WHEN 'O'  
                 IF RSP06-PTFR-LOC-CODE OF RSP06-NEW (NSUB PTFR-SUB) >  
                       SPACES   
                    STRING 'ADDED XFER - PIER TO '  
                           RSP06-PTFR-LOC-CODE  
                                          OF RSP06-NEW (NSUB PTFR-SUB)  
                           DELIMITED BY SIZE
                                     INTO WS-HIST-COMMENT   
                 ELSE   
                    MOVE 'ADDED XFER - PIER TO FFF' TO WS-HIST-COMMENT  
                 END-IF 
           END-EVALUATE.

           MOVE WS-HIST-COMMENT       TO WS-HIST-TRF-COMMENT1   
           MOVE 'Y'    TO WS-HIST-TRF-IND.  

           PERFORM 8000-WRITE-HISTORY THRU 8099-EXIT.   

196210     IF  RSP29-CALL-CENTER-FLAG = 1                           AND 
196210         RSP06-PAX-FARE-TYPE  OF RSP06-NEW (NSUB) = 'F'       AND 
196210         RSP06-PICF-EXIST-IND OF RSP06-NEW (NSUB) = 'Y'   
196210         MOVE RSP06-IBR-SAIL-DATE OF RSP06-NEW
196210                                TO DPP02-YYYYMMDD-DATE
196210         MOVE RSP06-IBR-DURATION-DAYS OF RSP06-NEW
196210                                TO DPP02-NUMBER-DAYS  
196210         PERFORM DPP10-ADVANCE-YYYYMMDD-DATE  
196210         MOVE DPP02-YYYYMMDD-DATE 
196210                                TO WS-SAIL-END-DATE   
196210         MOVE SPACES            TO WS-PICF-ARRIVAL-CITY   
196210                                   WS-PICF-DEPART-CITY
196210  
196210         PERFORM VARYING WS-PCF-SUB FROM RSP06-PICF-CNT OF
196210                 RSP06-NEW (NSUB) BY -1 UNTIL WS-PCF-SUB < 1  
196210            EVALUATE RSP06-PICF-ARRIVE-DATE OF RSP06-NEW  
196210                                                 (NSUB WS-PCF-SUB)
196210                WHEN RSP06-IBR-SAIL-DATE OF RSP06-NEW 
196210                     MOVE RSP06-PICF-TO-CITY OF RSP06-NEW 
196210                                                 (NSUB WS-PCF-SUB)
196210                                TO WS-PICF-ARRIVAL-CITY   
196210                     MOVE 1     TO WS-PCF-SUB 
196210            END-EVALUATE  
196210         END-PERFORM  
196210  
196210         PERFORM VARYING WS-PCF-SUB FROM 1 BY 1   
196210                 UNTIL WS-PCF-SUB > RSP06-PICF-CNT OF RSP06-NEW   
196210                                                            (NSUB)
196210            EVALUATE RSP06-PICF-DEPART-DATE OF RSP06-NEW  
196210                                                 (NSUB WS-PCF-SUB)
196210                WHEN WS-SAIL-END-DATE 
196210                     MOVE RSP06-PICF-FROM-CITY OF RSP06-NEW   
196210                                                 (NSUB WS-PCF-SUB)
196210                                TO WS-PICF-DEPART-CITY
196210                     MOVE RSP06-PICF-CNT OF RSP06-NEW (NSUB)  
196210                                TO WS-PCF-SUB 
196210            END-EVALUATE  
196210         END-PERFORM  
196210  
196210         IF  ((WS-PICF-ARRIVAL-CITY     > SPACES)             AND 
196210              (WS-PICF-ARRIVAL-CITY NOT = 
196210               RSP06-PTFR-LOC-CODE OF RSP06-NEW (NSUB PTFR-SUB))  
196210             )                                                OR  
196210             ((WS-PICF-DEPART-CITY      > SPACES)             AND 
196210              (WS-PICF-DEPART-CITY  NOT = 
196210               RSP06-PTFR-LOC-CODE OF RSP06-NEW (NSUB PTFR-SUB))  
196210             )
196210             MOVE SPACES        TO WS-HISTORY-AN-PARAMS   
196210             MOVE LOW-VALUES    TO WS-HISTORY-N-PARAMS
196210             MOVE NSUB          TO WS-HIST-PAX-NUM
196210             MOVE 'XFM'         TO WS-HIST-ACTIVITY-TYPE  
196210             MOVE RSP06-PAX-SEQ-NUM OF RSP06-NEW (NSUB)   
196210                                TO WS-HIST-PAX-SEQ-NUM
196210             MOVE RSP06-PAX-CITY-CODE OF RSP06-NEW (NSUB) 
196210                                TO WS-HIST-CITY-CODE  
PPC470*            MOVE RSP06-PAX-FARE-CODE OF RSP06-NEW (NSUB) 
PPC470*                               TO WS-HIST-FARE-CODE  
PPC470             MOVE RSP06-PAX-OFFER-CODE OF RSP06-NEW (NSUB)
PPC470                                TO WS-HIST-OFFER-CODE 
PPC470             MOVE RSP06-PAX-FARE-TYPE OF RSP06-NEW (NSUB) 
PPC470                                TO WS-HIST-FARE-TYPE  
196210  
196210             EVALUATE RSP06-PTFR-PRE-POST-IND OF RSP06-NEW
196210                                                   (NSUB PTFR-SUB)
196210                 WHEN 'I' 
196210                      MOVE 'Pre XFR mismatch arr cty '
196210                                TO WS-HIST-COMMENT
196210                 WHEN 'O' 
196210                      MOVE 'Pst XFR mismatch dep cty '
196210                                TO WS-HIST-COMMENT
196210             END-EVALUATE 
196210  
196210             MOVE WS-HIST-ACTIVITY-TYPE   
196210                                TO WS-HIST-TRF-ACTIVITY-TYPE  
196210             MOVE WS-HIST-COMMENT 
196210                                TO WS-HIST-TRF-COMMENT1   
196210             MOVE 'Y'           TO WS-HIST-TRF-IND
196210             PERFORM 8000-WRITE-HISTORY THRU 8099-EXIT
196210         END-IF   
196210     END-IF.  

PPC470*    IF (RSP06-PAX-BOOK-TYPE OF RSP06-NEW (NSUB) NOT = 'G')   
PPC470*       GO TO 3240-NEXT-NEW-PTFR. 
PPC470* 
PPC470*    IF (RSP06-PAX-FARE-TYPE OF RSP06-NEW (NSUB) = 'C')   
PPC470*       GO TO 3240-NEXT-NEW-PTFR. 
PPC470* 
PPC470*    IF (RSP06-PTFR-AMT OF RSP06-NEW (NSUB PTFR-SUB) > ZERO)  
PPC470*       GO TO 3240-NEXT-NEW-PTFR. 
PPC470* 
PPC470*    IF (RSP06-PTFR-PHASE-NUM OF RSP06-NEW (NSUB PTFR-SUB) =  
PPC470*          99999 OR 1)
PPC470*       GO TO 3240-NEXT-NEW-PTFR. 
PPC470* 
PPC470*    PERFORM 8600-GET-GRP-CITY THRU 8699-EXIT.
PPC470* 
PPC470*    IF (GCC1-INCLUSIVE-XFR-IND NOT = 'Y')
PPC470*       GO TO 3240-NEXT-NEW-PTFR. 
PPC470* 
PPC470*    MOVE 'XFRO'   TO WS-HIST-ACTIVITY-TYPE.  
PPC470*    MOVE RSP06-PTFR-AMT OF RSP06-NEW (NSUB PTFR-SUB) TO  
PPC470*         WS-DSPAMT4-1.   
PPC470*    MOVE 'FLY-AWEIGH XFER OVERRIDE' TO WS-HIST-COMMENT   
PPC470*                                       WS-HIST-TRF-COMMENT1. 
PPC470*    MOVE 'Y'                        TO WS-HIST-TRF-IND.  
PPC470* 
PPC470*    PERFORM 8000-WRITE-HISTORY THRU 8099-EXIT.   

           GO TO 3240-NEXT-NEW-PTFR.

      *=================================================================

       3280-CHECK-PAX-PACKAGE-CHG.  
           IF (RSP06-PPR-READ-IND OF RSP06-NEW (NSUB) = 'N') AND
                 (RSP06-PPR-READ-IND OF RSP06-OLD (OSUB) = 'N') 
              GO TO 3400-CHECK-PIAR-CHG.

           IF (RSP06-PPR-READ-IND OF RSP06-NEW (NSUB) NOT = 
                 RSP06-PPR-READ-IND OF RSP06-OLD (OSUB))
              MOVE 14 TO DPP42-HOLD-MSG-INDEX   
              GO TO 9200-EDIT-ERROR-MSG.

           IF RSP06-PPR-EXIST-IND OF RSP06-OLD (OSUB) = 'N' 
              GO TO 3340-CHECK-NEW-PPRS.

           MOVE ZERO TO OPPR-SUB.   

       3300-NEXT-OLD-PPR.   
           ADD 1 TO OPPR-SUB.   

           IF OPPR-SUB > RSP06-PPR-CNT OF RSP06-OLD (OSUB)  
              GO TO 3340-CHECK-NEW-PPRS.

           IF RSP06-PPR-EXIST-IND OF RSP06-NEW (NSUB) = 'N' 
              GO TO 3320-REMOVE-PPR-HISTORY.

146816     IF  RSP06-PPR-CANCEL-DATE OF RSP06-OLD (OSUB OPPR-SUB) > 0   
146816         GO TO 3300-NEXT-OLD-PPR  
146816     END-IF.  

           MOVE ZERO TO PPR-SUB.

           PERFORM VARYING SUB FROM 1 BY 1  
                   UNTIL SUB > RSP06-PPR-CNT OF RSP06-NEW (NSUB)
              IF (RSP06-PPR-PKG-NUM OF RSP06-OLD (OSUB OPPR-SUB) =  
                    RSP06-PPR-PKG-NUM OF RSP06-NEW (NSUB SUB)) AND  
                    (RSP06-PPR-PKG-CODE OF RSP06-OLD (OSUB OPPR-SUB) =  
                    RSP06-PPR-PKG-CODE OF RSP06-NEW (NSUB SUB)) AND 
                    (RSP06-PPR-PKG-TYPE OF RSP06-OLD (OSUB OPPR-SUB) =  
                    RSP06-PPR-PKG-TYPE OF RSP06-NEW (NSUB SUB)) 
                 MOVE SUB TO PPR-SUB
                 MOVE RSP06-PPR-CNT OF RSP06-NEW (NSUB) TO SUB  
              END-IF
           END-PERFORM. 

146816*    IF PPR-SUB = ZERO
146816     IF PPR-SUB = ZERO AND
146816        RSP06-PPR-CANCEL-DATE OF RSP06-OLD (OSUB OPPR-SUB)
146816        <= ZEROES 
              GO TO 3320-REMOVE-PPR-HISTORY.

146816     IF  RSP06-PPR-PKG-CAR-IND OF RSP06-NEW (NSUB PPR-SUB) NOT =  
146816         RSP06-PPR-PKG-CAR-IND OF RSP06-OLD (OSUB OPPR-SUB)   
146816         IF  ( RSP06-PPR-PKG-CAR-IND OF RSP06-OLD (OSUB OPPR-SUB) 
146816               = 'T' ) AND
146816             ( RSP06-PPR-PKG-CAR-IND OF RSP06-NEW (NSUB PPR-SUB)  
146816               NOT = 'T' )
146816             MOVE SPACES             TO WS-HISTORY-AN-PARAMS  
146816             MOVE LOW-VALUES         TO WS-HISTORY-N-PARAMS   
146816             IF  RSP06-PPR-PKG-TYPE   
146816                 OF RSP06-OLD (OSUB OPPR-SUB) = 'B'   
146816             MOVE 'PTR'              TO WS-HIST-TRF-ACTIVITY-TYPE 
146816             ELSE 
146816                 MOVE 'PTX'          TO WS-HIST-TRF-ACTIVITY-TYPE 
146816             END-IF   
146816             MOVE 'PACKAGE TRANSFER REMOVED ' 
146816                                     TO WS-HIST-TRF-COMMENT1  
146816             MOVE RSP06-PAX-SEQ-NUM OF RSP06-OLD (OSUB)   
146816                                     TO  WS-HIST-PAX-SEQ-NUM  
146816           PERFORM 8100-WRITE-TRF THRU 8199-EXIT  
146816        END-IF
146816     END-IF.  


           IF RSP06-PPR-REC OF RSP06-NEW (NSUB PPR-SUB) =   
                 RSP06-PPR-REC OF RSP06-OLD (OSUB OPPR-SUB) 
              GO TO 3300-NEXT-OLD-PPR.  

114988     IF  RSP06-PPR-HOTEL-CODE-1 OF RSP06-NEW (NSUB PPR-SUB) = 
114988         RSP06-PPR-HOTEL-CODE-1 OF RSP06-OLD (OSUB OPPR-SUB) AND  
114988         RSP06-PPR-HOTEL-CODE-2 OF RSP06-NEW (NSUB PPR-SUB) = 
114988         RSP06-PPR-HOTEL-CODE-2 OF RSP06-OLD (OSUB OPPR-SUB) AND  
114988         RSP06-PPR-HOTEL-CODE-3 OF RSP06-NEW (NSUB PPR-SUB) = 
114988         RSP06-PPR-HOTEL-CODE-3 OF RSP06-OLD (OSUB OPPR-SUB) AND  
114988         RSP06-PPR-HOTEL-CODE-4 OF RSP06-NEW (NSUB PPR-SUB) = 
114988         RSP06-PPR-HOTEL-CODE-4 OF RSP06-OLD (OSUB OPPR-SUB) AND  
114988         RSP06-PPR-HOTEL-CODE-5 OF RSP06-NEW (NSUB PPR-SUB) = 
114988         RSP06-PPR-HOTEL-CODE-5 OF RSP06-OLD (OSUB OPPR-SUB)  
114988         NEXT SENTENCE
114988     ELSE 
114988         GO TO 3300-NEXT-OLD-PPR. 

           MOVE SPACES     TO WS-HISTORY-AN-PARAMS. 
           MOVE LOW-VALUES TO WS-HISTORY-N-PARAMS.  
           MOVE NSUB       TO WS-HIST-PAX-NUM.  
           MOVE 'CPK'      TO WS-HIST-ACTIVITY-TYPE.
           MOVE RSP06-PAX-SEQ-NUM OF RSP06-NEW (NSUB) TO
                WS-HIST-PAX-SEQ-NUM.
           MOVE RSP06-PAX-CITY-CODE OF RSP06-NEW (NSUB) TO  
                WS-HIST-CITY-CODE.  
PPC470*    MOVE RSP06-PAX-FARE-CODE OF RSP06-NEW (NSUB) TO  
PPC470*         WS-HIST-FARE-CODE.  
PPC470     MOVE RSP06-PAX-OFFER-CODE OF RSP06-NEW (NSUB) TO 
PPC470          WS-HIST-OFFER-CODE. 
PPC470     MOVE RSP06-PAX-FARE-TYPE OF RSP06-NEW (NSUB) TO  
PPC470          WS-HIST-FARE-TYPE.  

           COMPUTE WS-HIST-AMT =
                         RSP06-PPR-PKG-AMT OF RSP06-NEW (NSUB PPR-SUB)  
                       - RSP06-PPR-PKG-AMT OF RSP06-OLD (OSUB OPPR-SUB).

           STRING RSP06-PPR-PKG-NUM OF RSP06-OLD (OSUB OPPR-SUB) '/'
                  RSP06-PPR-PKG-CODE OF RSP06-OLD (OSUB OPPR-SUB) '/'   
                  RSP06-PPR-PKG-TYPE OF RSP06-OLD (OSUB OPPR-SUB) ' '   
                  RSP06-PAX-LAST-NAME OF RSP06-OLD (OSUB) ','   
                  RSP06-PAX-FIRST-NAME OF RSP06-OLD (OSUB)  
                  DELIMITED BY SIZE INTO WS-HIST-COMMENT.   

           MOVE WS-HIST-COMMENT TO WS-HIST-TRF-COMMENT1.
           MOVE 'Y'             TO WS-HIST-TRF-IND. 

           PERFORM 8000-WRITE-HISTORY THRU 8099-EXIT.   

           GO TO 3300-NEXT-OLD-PPR. 

      *-----------------------------------------------------------------

       3320-REMOVE-PPR-HISTORY. 

146816     IF  RSP06-PPR-PKG-CAR-IND OF RSP06-OLD (OSUB OPPR-SUB) = 
146816         'T'  
146816         MOVE SPACES             TO WS-HISTORY-AN-PARAMS  
146816         MOVE LOW-VALUES         TO WS-HISTORY-N-PARAMS   
146816         IF  RSP06-PPR-PKG-TYPE   
146816             OF RSP06-OLD (OSUB OPPR-SUB) = 'B'   
146816         MOVE 'PTR'              TO WS-HIST-TRF-ACTIVITY-TYPE 
146816         ELSE 
146816             MOVE 'PTX'          TO WS-HIST-TRF-ACTIVITY-TYPE 
146816         END-IF   
146816         MOVE 'PACKAGE TRANSFER REMOVED ' 
146816                                 TO WS-HIST-TRF-COMMENT1  
146816         MOVE RSP06-PAX-SEQ-NUM OF RSP06-OLD (OSUB)   
146816                                 TO  WS-HIST-PAX-SEQ-NUM  
146816         PERFORM 8100-WRITE-TRF THRU 8199-EXIT
146816     END-IF.  

           MOVE SPACES     TO WS-HISTORY-AN-PARAMS. 
           MOVE LOW-VALUES TO WS-HISTORY-N-PARAMS.  
           MOVE NSUB       TO WS-HIST-PAX-NUM.  
           MOVE 'DPK'      TO WS-HIST-ACTIVITY-TYPE.
           MOVE RSP06-PAX-SEQ-NUM OF RSP06-NEW (NSUB) TO
                WS-HIST-PAX-SEQ-NUM.
           MOVE RSP06-PAX-CITY-CODE OF RSP06-NEW (NSUB) TO  
                WS-HIST-CITY-CODE.  
PPC470*    MOVE RSP06-PAX-FARE-CODE OF RSP06-NEW (NSUB) TO  
PPC470*         WS-HIST-FARE-CODE.  
PPC470     MOVE RSP06-PAX-OFFER-CODE OF RSP06-NEW (NSUB) TO 
PPC470          WS-HIST-OFFER-CODE. 
PPC470     MOVE RSP06-PAX-FARE-TYPE OF RSP06-NEW (NSUB) TO  
PPC470          WS-HIST-FARE-TYPE.  

           COMPUTE WS-HIST-AMT =
                   RSP06-PPR-PKG-AMT OF RSP06-OLD (OSUB OPPR-SUB) * -1. 

           STRING RSP06-PPR-PKG-NUM OF RSP06-OLD (OSUB OPPR-SUB) '/'
                  RSP06-PPR-PKG-CODE OF RSP06-OLD (OSUB OPPR-SUB) '/'   
                  RSP06-PPR-PKG-TYPE OF RSP06-OLD (OSUB OPPR-SUB) ' '   
                  RSP06-PAX-LAST-NAME OF RSP06-OLD (OSUB) ','   
                  RSP06-PAX-FIRST-NAME OF RSP06-OLD (OSUB)  
                  DELIMITED BY SIZE INTO WS-HIST-COMMENT.   

           MOVE WS-HIST-COMMENT TO WS-HIST-TRF-COMMENT1.
           MOVE 'Y'             TO WS-HIST-TRF-IND. 

           PERFORM 8000-WRITE-HISTORY THRU 8099-EXIT.   

           GO TO 3300-NEXT-OLD-PPR. 

      *-----------------------------------------------------------------

       3340-CHECK-NEW-PPRS. 
           IF RSP06-PPR-EXIST-IND OF RSP06-NEW (NSUB) = 'N' 
              GO TO 3400-CHECK-PIAR-CHG.

           MOVE ZERO TO PPR-SUB.

       3360-NEXT-NEW-PPR.   
           ADD 1 TO PPR-SUB.

           IF PPR-SUB > RSP06-PPR-CNT OF RSP06-NEW (NSUB)   
              GO TO 3400-CHECK-PIAR-CHG.

           IF RSP06-PPR-EXIST-IND OF RSP06-OLD (OSUB) = 'N' 
