144449 COPY SSP06UGT.   
165711 COPY RSP90OVO.   
PPC470 COPY TDP01SAW.   
PPC470 COPY SMP68EFF.   

       COMMON-STORAGE SECTION.  

       LINKAGE SECTION. 
       COPY DPP01SCO.   
       COPY DPP01CIW.   
       COPY RSP06GCI REPLACING RSP06-GUEST-CABIN-INFO BY RSP06-OLD. 
       COPY RSP06GCI REPLACING RSP06-GUEST-CABIN-INFO BY RSP06-NEW. 
       COPY RSP29GCH.   
165711 COPY RSP90OVW.   
165711 COPY RSP89SEZ.   

       PROCEDURE DIVISION USING DPP01-COMMON-DATA-FIELDS
                                DPP01-COMMON-INFO   
                                RSP06-OLD   
                                RSP06-NEW   
                                RSP29-AUXILIARY-INPUT   
165711                          RSP90-OVERRIDE-FLAGS-INFO   
165711                          RSP89-SEC-RULE-TBL. 

       0000-RSO29GCH-MAINLINE.  
       COPY DPP42INT.   
C90569*     For automated email confirmation
C90569 COPY IRP48INT.   
       COPY SMP68INT.   
PPC470     EXEC SQL USE DEFAULT SCHEMA PRDRDMS END-EXEC.
           MOVE FUNCTION CURRENT-DATE  TO DPP02-SYSTEM-DATE-TIME.   
           MOVE DPP02-SYSTEM-REDEF     TO WS-SYSTEM-DATE.   
           MOVE DPP02-SYS-HHMMSS-REDEF TO WS-SYSTEM-TIME.   
           MOVE 'RSO29GCH'             TO DPP42-HOLD-MSG-SOURCE 
           MOVE 'N'                    TO WS-HIST-CURRENT-FLAG  
                                          WS-REACTIVATE-FLAG
218337                                    WS-O-IBR-ADV-SPOILAGE-POL-IND 
218337                                    WS-N-IBR-ADV-SPOILAGE-POL-IND 
126142                                    WS-CHG-SAILING-FLAG   
PPC470                                    WS-CHG-OFFER-FLAG 
126142                                    WS-CBC-HIST   
126142                                    WS-UBC-HIST.  

165711     MOVE ZEROES                 TO WS-OVERRIDE-COUNT 
213133                                    WS-UAM-TRF-FLG.   

           MOVE RSP06-IB-PAX-GROSS-FARE-AMT OF RSP06-OLD TO 
                WS-STEPPED-GROSS-AMT.   

           IF RSP06-IBR-BOOK-NUM OF RSP06-OLD > SPACES  
              MOVE 'N' TO WS-NEW-BKG-FLAG   
           ELSE 
              MOVE 'Y' TO WS-NEW-BKG-FLAG.  

           IF RSP06-PAX-CNT OF RSP06-NEW > RSP06-PAX-TABLE-MAX  
              MOVE 1 TO DPP42-HOLD-MSG-INDEX
              MOVE 'PAX cnt of old IBR out of range' TO 
                   DPP42-HOLD-MSG-DESC  
              GO TO 9200-EDIT-ERROR-MSG.

           IF (RSP06-IBR-BOOK-NUM OF RSP06-NEW NOT = IBR-BOOK-NUM)  
              MOVE RSP06-IBR-BOOK-NUM OF RSP06-NEW TO IBR-BOOK-NUM  
              MOVE 'INDV-BK-' TO INDV-BOOKING-CALCAREA  
CCLAUS*       MOVE RSP06-IBR-BOOK-NUM OF RSP06-NEW (6:1) TO 
CCLAUS*            INDV-BOOKING-CALCAREA (9:1)  
CCLAUS        EVALUATE RSP06-IBR-BOOK-NUM OF RSP06-NEW (6:1)
CCLAUS           WHEN 'B' WHEN 'C' WHEN '0' 
CCLAUS                 MOVE '0'  TO INDV-BOOKING-CALCAREA (9:1) 
CCLAUS           WHEN 'D' WHEN 'F' WHEN '1' 
CCLAUS                 MOVE '1'  TO INDV-BOOKING-CALCAREA (9:1) 
CCLAUS           WHEN 'G' WHEN 'H' WHEN '2' 
CCLAUS                 MOVE '2'  TO INDV-BOOKING-CALCAREA (9:1) 
CCLAUS           WHEN 'J' WHEN 'K' WHEN '3' 
CCLAUS                 MOVE '3'  TO INDV-BOOKING-CALCAREA (9:1) 
CCLAUS           WHEN 'L' WHEN 'M' WHEN '4' 
CCLAUS                 MOVE '4'  TO INDV-BOOKING-CALCAREA (9:1) 
CCLAUS           WHEN 'N' WHEN 'P' WHEN '5' 
CCLAUS                 MOVE '5'  TO INDV-BOOKING-CALCAREA (9:1) 
CCLAUS           WHEN 'Q' WHEN 'R' WHEN '6' 
CCLAUS                 MOVE '6'  TO INDV-BOOKING-CALCAREA (9:1) 
CCLAUS           WHEN 'S' WHEN 'T' WHEN '7' 
CCLAUS                 MOVE '7'  TO INDV-BOOKING-CALCAREA (9:1) 
CCLAUS           WHEN 'V' WHEN 'W' WHEN '8' 
CCLAUS                 MOVE '8'  TO INDV-BOOKING-CALCAREA (9:1) 
CCLAUS           WHEN 'X' WHEN 'Z' WHEN '9' 
CCLAUS                 MOVE '9'  TO INDV-BOOKING-CALCAREA (9:1) 
CCLAUS        END-EVALUATE  

              FETCH INDV-BOOKING-REC RECORD 
                    ON ERROR GO TO 10000-IBR-ERROR. 

           IF RSP06-IBR-BOOK-TYPE OF RSP06-NEW = 'G'
              IF (RSP06-IBR-GROUP-BOOK-NUM OF RSP06-NEW NOT =   
                    GBR1-BOOK-NUM)  
                  MOVE RSP06-IBR-GROUP-BOOK-NUM OF RSP06-NEW TO 
                       GBR1-BOOK-NUM
                  FETCH GRP1-BOOKING-REC RECORD 
                        ON ERROR GO TO 10100-GBR1-ERROR.

           IF RSP29-CALL-CENTER-FLAG = ZERO 
              MOVE '@'                   TO WS-3CHAR-USERID 
              MOVE RSP29-I-LOCATION-CODE TO WS-3CHAR-USERID (2:2)   
              MOVE WS-3CHAR-USERID       TO WS-USERID   
           ELSE 
              MOVE DPP01-3CHAR-USERID    TO WS-3CHAR-USERID 
              MOVE DPP01-USERID          TO WS-USERID.  

           IF RSP06-IBR-BOOK-TYPE OF RSP06-NEW = 'I'
              IF WS-3CHAR-USERID (2:2) NOT > SPACES 
                 MOVE 2 TO DPP42-HOLD-MSG-INDEX 
                 GO TO 9200-EDIT-ERROR-MSG  
              END-IF
           ELSE 
              IF WS-USERID (2:2) NOT > SPACES   
                 MOVE 3 TO DPP42-HOLD-MSG-INDEX 
                 GO TO 9200-EDIT-ERROR-MSG. 

           IF VCR-MISC-COMMENT-ENTRY-CTR NOT > ZERO 
              FETCH VALID-CODES-REC RECORD  
                    ON ERROR GO TO 12100-FETCH-VCR-ERROR.   

           IF WS-NEW-BKG-FLAG = 'N' 
              GO TO 0060-CHECK-CANCEL-DATE. 

           MOVE SPACES     TO WS-HISTORY-AN-PARAMS. 
           MOVE LOW-VALUES TO WS-HISTORY-N-PARAMS.  

           IF RSP06-IBR-BOOK-TYPE OF RSP06-NEW = 'I'
              MOVE 'NBK' TO WS-HIST-ACTIVITY-TYPE   
           ELSE 
              IF RSP06-IBR-CABIN-SOURCE-CODE OF RSP06-NEW > SPACES  
                 MOVE 'PNI' TO WS-HIST-ACTIVITY-TYPE
              ELSE  
                 MOVE 'PNA' TO WS-HIST-ACTIVITY-TYPE.   

           MOVE 'Y'  TO WS-HIST-TRF-IND 
                        WS-HIST-TRF-MAIL-IND.   
           MOVE ZERO TO PSUB.   
           MOVE 1    TO WS-PTR. 

       0020-NEXT-NBK-PAX.   
           ADD 1 TO PSUB.   

           IF PSUB > RSP06-PAX-CNT OF RSP06-NEW 
              GO 0040-FINISH-NBK-HISORY.

           IF RSP06-IBR-BOOK-TYPE OF RSP06-NEW = 'G'
              MOVE PSUB   TO WS-HIST-PAX-NUM
              MOVE SPACES TO WS-HIST-COMMENT
              MOVE RSP06-PAX-SEQ-NUM OF RSP06-NEW (PSUB) TO 
                   WS-HIST-PAX-SEQ-NUM  
              MOVE RSP06-PAX-CITY-CODE OF RSP06-NEW (PSUB) TO   
                   WS-HIST-CITY-CODE
PPC470*       MOVE RSP06-PAX-FARE-CODE OF RSP06-NEW (PSUB) TO   
PPC470*            WS-HIST-FARE-CODE
PPC470        MOVE RSP06-PAX-OFFER-CODE OF RSP06-NEW (PSUB) TO  
PPC470             WS-HIST-OFFER-CODE   
PPC470        MOVE RSP06-PAX-FARE-TYPE OF RSP06-NEW (PSUB) TO   
PPC470             WS-HIST-FARE-TYPE
C85443*       MOVE RSP06-PAX-REQ-RATE-VER-NUM OF RSP06-NEW (PSUB) TO
C85443        MOVE RSP06-IBR-REQ-RATE-VERSION OF RSP06-NEW TO   
                   WS-HIST-RATE-VER-NUM 
              MOVE RSP06-PDI-PAX-GROSS-FARE-AMT OF RSP06-NEW (PSUB) TO  
                   WS-HIST-AMT  
138474             WS-HIST-TRF-AMT  
              STRING RSP06-PAX-TITLE OF RSP06-NEW (PSUB) ' '
                     RSP06-PAX-INITIAL OF RSP06-NEW (PSUB) ' '  
                     RSP06-PAX-LAST-NAME OF RSP06-NEW (PSUB) ' '
                     DELIMITED BY SIZE INTO WS-HIST-COMMENT 
              PERFORM 8000-WRITE-HISTORY THRU 8099-EXIT 
           ELSE 
119666        MOVE PSUB TO WS-HIST-PAX-NUM  
PPC470*       STRING RSP06-PAX-FARE-CODE OF RSP06-NEW (PSUB) (1:4) '/'  
PPC470        STRING RSP06-PAX-OFFER-CODE OF RSP06-NEW (PSUB) '/'   
                     DELIMITED BY SIZE INTO WS-HIST-COMMENT 
                     WITH POINTER WS-PTR.   

           GO TO 0020-NEXT-NBK-PAX. 

       0040-FINISH-NBK-HISORY.  
           IF RSP06-IBR-BOOK-TYPE OF RSP06-NEW = 'I'
              IF (RSP06-IBR-DIRECT-IND OF RSP06-NEW = 'Y')  
                 MOVE 'DIR' TO WS-HIST-TRF-COMMENT2 
              END-IF
              MOVE RSP06-IB-PAX-GROSS-FARE-AMT OF RSP06-NEW TO  
                   WS-HIST-AMT  
              PERFORM 8000-WRITE-HISTORY THRU 8099-EXIT.

           GO TO 2000-CHECK-ACTIVE-PAX. 

      *=================================================================

       0060-CHECK-CANCEL-DATE.  
           IF RSP06-IBR-CANCEL-DATE OF RSP06-OLD =  
                 RSP06-IBR-CANCEL-DATE OF RSP06-NEW 
              GO TO 0120-CHECK-SAILING. 

           IF (RSP06-IBR-CANCEL-DATE OF RSP06-OLD > 0) AND  
                 (RSP06-IBR-CANCEL-DATE OF RSP06-NEW = 0)   
              MOVE 'Y' TO WS-REACTIVATE-FLAG
              GO TO 0100-REACTIVATE-HISTORY.

           IF (RSP06-IBR-CANCEL-DATE OF RSP06-OLD = 0) AND  
                 (RSP06-IBR-CANCEL-DATE OF RSP06-NEW > 0)   
              GO TO 0080-CANCEL-HISTORY.

           MOVE 4 TO DPP42-HOLD-MSG-INDEX.  

           GO TO 9200-EDIT-ERROR-MSG.   

       0080-CANCEL-HISTORY. 
           GO TO 2000-CHECK-ACTIVE-PAX. 

      *=================================================================

       0100-REACTIVATE-HISTORY. 
           MOVE SPACES     TO WS-HISTORY-AN-PARAMS. 
           MOVE LOW-VALUES TO WS-HISTORY-N-PARAMS.  
126243     MOVE 'ACB'      TO WS-HIST-ACTIVITY-TYPE 
126243                        WS-HIST-TRF-ACTIVITY-TYPE.

           COMPUTE WS-HIST-AMT = RSP06-IBR-GROSS-FARE-AMT OF RSP06-NEW  
                               - RSP06-IBR-GROSS-FARE-AMT OF RSP06-OLD. 

           STRING RSP06-IBR-CABIN-NUM OF RSP06-OLD  
                  RSP06-IBR-SHIP-CODE OF RSP06-OLD  
                  RSP06-IBR-SAIL-DATE OF RSP06-OLD  
                  RSP06-IBR-CATEGORY-CODE OF RSP06-OLD  
                 DELIMITED BY SIZE INTO WS-HIST-COMMENT.

           MOVE WS-HIST-COMMENT TO WS-HIST-TRF-COMMENT1.
           MOVE 'ACB'           TO WS-HIST-TRF-COMMENT2.
           MOVE 'Y'             TO WS-HIST-TRF-IND. 

           PERFORM 8000-WRITE-HISTORY THRU 8099-EXIT.   

868336     MOVE SPACES     TO WS-HIST-COMMENT.  
868336     MOVE 'ACP'      TO WS-HIST-ACTIVITY-TYPE.
868336  
868336     STRING 'Cancelled On '   
868336            RSP06-IBR-CANCEL-DATE OF RSP06-OLD
868336            DELIMITED BY SIZE INTO WS-HIST-COMMENT.   

868336     MOVE WS-HIST-COMMENT TO WS-HIST-TRF-COMMENT1.
868336     MOVE 'ACP'           TO WS-HIST-TRF-COMMENT2 
868336                             WS-HIST-TRF-ACTIVITY-TYPE.   
868336     MOVE 'Y'             TO WS-HIST-TRF-IND. 
868336  
868336     PERFORM 8000-WRITE-HISTORY THRU 8099-EXIT.   

124506     GO TO 0230-CHECK-IBR-UPG-HISTORY.

       0120-CHECK-SAILING.  
           IF (RSP06-IBR-SAIL-DATE OF RSP06-OLD =   
                 RSP06-IBR-SAIL-DATE OF RSP06-NEW) AND  
                 (RSP06-IBR-SHIP-CODE OF RSP06-OLD =
                 RSP06-IBR-SHIP-CODE OF RSP06-NEW) AND  
                 (RSP06-IBR-DURATION-DAYS OF RSP06-OLD =
                 RSP06-IBR-DURATION-DAYS OF RSP06-NEW)  
              GO TO 0140-CHECK-CABIN-CHANGE.

           IF WS-REACTIVATE-FLAG = 'N'  
              MOVE 'Y' TO WS-CHG-SAILING-FLAG.  

           MOVE SPACES     TO WS-HISTORY-AN-PARAMS. 
           MOVE LOW-VALUES TO WS-HISTORY-N-PARAMS.  
           MOVE 'CDT'      TO WS-HIST-ACTIVITY-TYPE.

125293*    COMPUTE WS-HIST-AMT = RSP06-IBR-GROSS-FARE-AMT OF RSP06-NEW  
125293*                        - RSP06-IBR-GROSS-FARE-AMT OF RSP06-OLD. 

           STRING RSP06-IBR-CABIN-NUM OF RSP06-OLD  
                  RSP06-IBR-SHIP-CODE OF RSP06-OLD  
                  RSP06-IBR-SAIL-DATE OF RSP06-OLD  
                  RSP06-IBR-CATEGORY-CODE OF RSP06-OLD  
                  RSP06-IBR-DURATION-DAYS OF RSP06-OLD  
               DELIMITED BY SIZE INTO WS-HIST-COMMENT.  

           MOVE WS-HIST-COMMENT TO WS-HIST-TRF-COMMENT1.
           MOVE 'Y'             TO WS-HIST-TRF-IND. 

           PERFORM 8000-WRITE-HISTORY THRU 8099-EXIT.   

           GO TO 0200-IBR-FIELD-HISTORY.

      *=================================================================

       0140-CHECK-CABIN-CHANGE. 
           IF (RSP06-IBR-CABIN-NUM OF RSP06-OLD =   
                 RSP06-IBR-CABIN-NUM OF RSP06-NEW)  
              GO TO 0180-CHECK-CABIN-CATEGORY.  

           MOVE SPACES     TO WS-HISTORY-AN-PARAMS. 
           MOVE LOW-VALUES TO WS-HISTORY-N-PARAMS.  
126142     IF WS-CBC-HIST = 'N' 
126142        MOVE 'CBC'   TO WS-HIST-ACTIVITY-TYPE 
126142     ELSE 
126142        MOVE 'UBC'   TO WS-HIST-ACTIVITY-TYPE.

126142     IF RSP29-PBS-FLAG NOT = 1
126142        COMPUTE WS-HIST-AMT = 
126142                            RSP06-IBR-GROSS-FARE-AMT OF RSP06-NEW 
126142                          - RSP06-IBR-GROSS-FARE-AMT OF RSP06-OLD.

           STRING 'FR:' RSP06-IBR-CABIN-NUM OF RSP06-OLD
                  ' ' RSP06-IBR-CATEGORY-CODE OF RSP06-OLD  
                  ' ' RSP06-IBR-SHIP-CODE OF RSP06-OLD  
                  ' ' RSP06-IBR-SAIL-DATE OF RSP06-OLD  
                  ' ' RSP06-IBR-DURATION-DAYS OF RSP06-OLD  
                  DELIMITED BY SIZE INTO WS-HIST-COMMENT.   

           MOVE WS-HIST-COMMENT TO WS-HIST-TRF-COMMENT1.

125978*    IF (RSP06-PAX-PRICE-TYPE OF RSP06-NEW (1) =  
125978*        RSP06-PAX-PRICE-TYPE OF RSP06-OLD (1)) AND   
125978*       (RSP06-PAX-PRICE-CODE OF RSP06-NEW (1) =  
125978*        RSP06-PAX-PRICE-CODE OF RSP06-OLD (1))   
125978     MOVE 'Y'             TO WS-HIST-TRF-IND. 

           IF RSP06-IBR-CPA-CATEGORY-CODE OF RSP06-NEW <= SPACES
              GO TO 0160-WRITE-FIRST-CBC-HIST.  

           IF (RSP06-IBR-CABIN-NUM OF RSP06-NEW (1:1) = 'C' OR 'T' OR   
                                                        'W')
              GO TO 0160-WRITE-FIRST-CBC-HIST.  

           IF RSP06-IBR-CATEGORY-CODE OF RSP06-NEW =
                 RSP06-IBR-CPA-CATEGORY-CODE OF RSP06-NEW   
              GO TO 0160-WRITE-FIRST-CBC-HIST.  

           MOVE SPACES TO WS-LEAD-CAT-CODE  
                          WS-LEAD-CPA-CODE. 
           MOVE ZERO   TO WS-LEAD-CAT-SUB.  
PPC470     IF TDP01-SCAT-SAIL-ID = TDP01-SAIL-ID AND
PPC470        TDP01-SAIL-CAT-CNT > 1
PPC470        CONTINUE  
PPC470     ELSE 
PPC470        PERFORM TDP01-RET-ALL-SCAT THRU   
PPC470                TDP01-RET-ALL-SCAT-EXIT   
PPC470     END-IF.  

PPC470*    PERFORM VARYING SUB FROM 1 BY 1  
PPC470*            UNTIL SUB > SAIL1-CATEGORY-CNT   
PPC470*       IF (RSP06-IBR-CATEGORY-CODE OF RSP06-NEW  =   
PPC470*                SAIL1-CATEGORY-CODE (SUB))   
PPC470*          MOVE SAIL1-LEAD-CATEGORY-CODE (SUB) TO WS-LEAD-CAT-CODE
PPC470*          MOVE SUB                TO WS-LEAD-CAT-SUB 
PPC470*          MOVE SAIL1-CATEGORY-CNT TO SUB 
PPC470*       END-IF
PPC470*    END-PERFORM. 
PPC470     PERFORM VARYING SUB FROM 1 BY 1  
PPC470             UNTIL SUB > TDP01-SAIL-CAT-CNT   
PPC470        IF (RSP06-IBR-CATEGORY-CODE OF RSP06-NEW  =   
PPC470                 TDP01-CATEGORY-CODE (SUB))   
PPC470           MOVE TDP01-META-CODE (SUB) TO WS-LEAD-CAT-CODE 
PPC470           MOVE SUB                TO WS-LEAD-CAT-SUB 
PPC470           MOVE TDP01-SAIL-CAT-CNT TO SUB 
PPC470        END-IF
PPC470     END-PERFORM. 

PPC470*    PERFORM VARYING SUB FROM 1 BY 1  
PPC470*            UNTIL SUB > SAIL1-CATEGORY-CNT   
PPC470*       IF (RSP06-IBR-CPA-CATEGORY-CODE OF RSP06-NEW =
PPC470*                SAIL1-CATEGORY-CODE (SUB))   
PPC470*          MOVE SAIL1-LEAD-CATEGORY-CODE (SUB) TO WS-LEAD-CPA-CODE
PPC470*          MOVE SAIL1-CATEGORY-CNT TO SUB 
PPC470*       END-IF
PPC470*    END-PERFORM. 
PPC470     PERFORM VARYING SUB FROM 1 BY 1  
PPC470             UNTIL SUB > TDP01-SAIL-CAT-CNT   
PPC470        IF (RSP06-IBR-CPA-CATEGORY-CODE OF RSP06-NEW =
PPC470                 TDP01-CATEGORY-CODE (SUB))   
PPC470           MOVE TDP01-META-CODE (SUB) TO WS-LEAD-CPA-CODE 
PPC470           MOVE TDP01-SAIL-CAT-CNT TO SUB 
PPC470        END-IF
PPC470     END-PERFORM. 


           IF (WS-LEAD-CAT-CODE NOT = WS-LEAD-CPA-CODE) OR  
PPC470*           (SAIL1-ALLOW-UPG-INTO-FLAG (WS-LEAD-CAT-SUB) = ZERO)  
PPC470            (TDP01-ALLOW-UPG-INTO-IND (WS-LEAD-CAT-SUB) = 'N')
              MOVE 'Y' TO WS-HIST-TRF-OVERRIDE-IND  
              MOVE 'POSSIBLE EXCESSIVE UPGRADE' TO  
                   WS-HIST-TRF-COMMENT2.

       0160-WRITE-FIRST-CBC-HIST.   
           PERFORM 8000-WRITE-HISTORY THRU 8099-EXIT.   

           MOVE SPACES     TO WS-HISTORY-AN-PARAMS. 
           MOVE LOW-VALUES TO WS-HISTORY-N-PARAMS.  
126142     IF WS-CBC-HIST = 'N' 
126142        MOVE 'CBC'   TO WS-HIST-ACTIVITY-TYPE 
126142        MOVE 'Y'     TO WS-CBC-HIST   
126142     ELSE 
126142        MOVE 'UBC'   TO WS-HIST-ACTIVITY-TYPE 
126142        MOVE 'Y'     TO WS-UBC-HIST.  


           STRING 'TO:' RSP06-IBR-CABIN-NUM OF RSP06-NEW
                  ' ' RSP06-IBR-CATEGORY-CODE OF RSP06-NEW  
                  ' ' RSP06-IBR-SHIP-CODE OF RSP06-NEW  
                  ' ' RSP06-IBR-SAIL-DATE OF RSP06-NEW  
                  ' ' RSP06-IBR-DURATION-DAYS OF RSP06-NEW  
                  DELIMITED BY SIZE INTO WS-HIST-COMMENT.   

           MOVE RSP06-IBR-CABIN-NUM OF RSP06-OLD TO 
                WS-HIST-CABIN-NUM.  

126314     MOVE WS-HIST-COMMENT TO WS-HIST-TRF-COMMENT1.
126314     MOVE 'Y'             TO WS-HIST-TRF-IND. 

           PERFORM 8000-WRITE-HISTORY THRU 8099-EXIT.   

126142     IF RSP29-PBS-FLAG  = 1 AND WS-UBC-HIST = 'N' 
126142        GO TO 0140-CHECK-CABIN-CHANGE.

           GO TO 0200-IBR-FIELD-HISTORY.

       0180-CHECK-CABIN-CATEGORY.   
           IF (RSP06-IBR-CATEGORY-CODE OF RSP06-OLD =   
                 RSP06-IBR-CATEGORY-CODE OF RSP06-NEW)  
              GO TO 0200-IBR-FIELD-HISTORY. 

           MOVE SPACES     TO WS-HISTORY-AN-PARAMS. 
           MOVE LOW-VALUES TO WS-HISTORY-N-PARAMS.  
126142     IF WS-CBC-HIST = 'N' 
126142        MOVE 'CBC'   TO WS-HIST-ACTIVITY-TYPE 
126142        MOVE 'Y'     TO WS-CBC-HIST   
126142     ELSE 
126142        MOVE 'UBC'   TO WS-HIST-ACTIVITY-TYPE 
126142        MOVE 'Y'     TO WS-UBC-HIST.  

126142     IF RSP29-PBS-FLAG NOT = 1
126142        COMPUTE WS-HIST-AMT = 
126142                             RSP06-IBR-GROSS-FARE-AMT OF RSP06-NEW
126142                           - WS-STEPPED-GROSS-AMT.

           STRING RSP06-IBR-CABIN-NUM OF RSP06-OLD  
                  RSP06-IBR-SHIP-CODE OF RSP06-OLD  
                  RSP06-IBR-SAIL-DATE OF RSP06-OLD  
                  RSP06-IBR-CATEGORY-CODE OF RSP06-OLD  
                  RSP06-IBR-DURATION-DAYS OF RSP06-OLD  
               DELIMITED BY SIZE INTO WS-HIST-COMMENT.  

           MOVE WS-HIST-COMMENT TO WS-HIST-TRF-COMMENT1.
           MOVE 'Y'             TO WS-HIST-TRF-IND. 

           PERFORM 8000-WRITE-HISTORY THRU 8099-EXIT.   

126142     IF RSP29-PBS-FLAG  = 1 AND WS-UBC-HIST = 'N' 
126142        GO TO 0180-CHECK-CABIN-CATEGORY.  

      *=================================================================
      *=================================================================

       0200-IBR-FIELD-HISTORY.  
           IF RSP29-REPRICE-FLAG = 1 AND
PPC470*          DPP02-SYSTEM-DATE > SAIL1-SAIL-DATE AND
PPC470*          SAIL1-STATUS-CODE = 'T'
PPC470           DPP02-SYSTEM-DATE > TDP01-SAIL-DATE-YYYYMMDD AND   
PPC470           TDP01-STATUS-CODE = 'T'
              MOVE 'Y' TO WS-SKIP-HISTORY-IND   
           ELSE 
              MOVE 'N' TO WS-SKIP-HISTORY-IND.  

      *-----------------------------------------------------------------

124490 0210-CHECK-BEDDING-HISTORY.  
124490     IF (RSP06-IBR-CNV-KING-CODE OF RSP06-NEW NOT =   
124490         RSP06-IBR-CNV-KING-CODE OF RSP06-OLD) AND
124490         WS-NEW-BKG-FLAG = 'N'
124490            MOVE SPACES          TO WS-HISTORY-AN-PARAMS  
124490            MOVE LOW-VALUES      TO WS-HISTORY-N-PARAMS   
124490            MOVE 'RBC'           TO WS-HIST-ACTIVITY-TYPE 
124490            STRING 'OLD CNV-KING-FLG: '   
137688                   RSP06-IBR-CNV-KING-CODE OF RSP06-OLD   
124490                   DELIMITED BY SIZE  INTO WS-HIST-COMMENT
124490            MOVE WS-HIST-COMMENT TO WS-HIST-TRF-COMMENT2  
124490            MOVE 'Y'             TO WS-HIST-TRF-IND   
124490            PERFORM 8000-WRITE-HISTORY THRU 8099-EXIT 
124490     END-IF.  

      *-----------------------------------------------------------------

181973 0215-CHECK-BOOK-STATUS-HISTORY.  

181973     IF  (WS-NEW-BKG-FLAG = 'N' AND WS-REACTIVATE-FLAG = 'N' AND  
181973           WS-CHG-SAILING-FLAG = 'N') 
181973         IF  (RSP06-IBR-BOOK-STATUS OF RSP06-NEW NOT =
181973                          RSP06-IBR-BOOK-STATUS OF RSP06-OLD) 
181973             MOVE SPACES         TO WS-HISTORY-AN-PARAMS  
181973             MOVE LOW-VALUES     TO WS-HISTORY-N-PARAMS   
181973             MOVE 'CBS'          TO WS-HIST-ACTIVITY-TYPE 
181973             STRING 'Old Bkg Status : '   
181973                  RSP06-IBR-BOOK-STATUS OF RSP06-OLD  
181973                  DELIMITED BY SIZE INTO WS-HIST-COMMENT  
181973             MOVE WS-HIST-COMMENT 
181973                                 TO WS-HIST-TRF-COMMENT2  
181973             MOVE 'Y'            TO WS-HIST-TRF-IND   
181973             PERFORM 8000-WRITE-HISTORY THRU 8099-EXIT
181973         END-IF   
181973     END-IF.  

       0220-CHECK-DEPOSIT-HISTORY.  
124575     MOVE RSP06-IBR-DEPOSIT-AMT OF RSP06-OLD TO WS-DOLLAR-VALUE.  

124575     IF (WS-DOLLAR-VALUE IS NOT NUMERIC) OR   
124575           WS-DOLLAR-VALUE = ZERO 
124575        MOVE ZERO TO RSP06-IBR-DEPOSIT-AMT OF RSP06-OLD.  

124575     MOVE RSP06-IBR-INS-PREMIUM-AMT OF RSP06-OLD TO   
124575          WS-DOLLAR-VALUE.

124575     IF (WS-DOLLAR-VALUE IS NOT NUMERIC) OR   
124575           WS-DOLLAR-VALUE = ZERO 
124575        MOVE ZERO TO RSP06-IBR-INS-PREMIUM-AMT OF RSP06-OLD.  

           IF ((RSP06-IBR-DEPOSIT-AMT OF RSP06-NEW =
                 RSP06-IBR-DEPOSIT-AMT OF RSP06-OLD) AND
                 (RSP06-IBR-INS-PREMIUM-AMT OF RSP06-NEW =  
                 RSP06-IBR-INS-PREMIUM-AMT OF RSP06-OLD)) OR
                 WS-SKIP-HISTORY-IND = 'Y'  
124506        GO TO 0230-CHECK-IBR-UPG-HISTORY. 

             MOVE SPACES     TO WS-HISTORY-AN-PARAMS.   
             MOVE LOW-VALUES TO WS-HISTORY-N-PARAMS.
             MOVE 'CDA'      TO WS-HIST-ACTIVITY-TYPE.  

             ADD RSP06-IBR-DEPOSIT-AMT OF RSP06-OLD 
                 RSP06-IBR-INS-PREMIUM-AMT OF RSP06-OLD 
                 GIVING WS-DSPAMT8-1

             STRING 'DEPOSIT: ' WS-DSPAMT8-1
                    DELIMITED BY SIZE INTO WS-HIST-COMMENT. 

             MOVE WS-HIST-COMMENT TO WS-HIST-TRF-COMMENT2.  
             MOVE 'Y'             TO WS-HIST-TRF-IND.   

             COMPUTE WS-HIST-AMT = RSP06-IBR-DEPOSIT-AMT OF RSP06-NEW   
                               + RSP06-IBR-INS-PREMIUM-AMT OF RSP06-NEW 
                               - RSP06-IBR-DEPOSIT-AMT OF RSP06-OLD 
                               - RSP06-IBR-INS-PREMIUM-AMT OF RSP06-OLD.

             PERFORM 8000-WRITE-HISTORY THRU 8099-EXIT. 

      *-----------------------------------------------------------------

PBS-P1 0230-CHECK-IBR-UPG-HISTORY.  
119064* 
119064*    We will write IBR level UAM history only if upgrade  
119064*    amounts have changed at active guest positions, excluding
119064*    lost (CXP) or added (APX) positions. 
119064* 
119064*    We don't write pax level history because it will be  
119064*    considered excessive.  We don't look at IBR-UPGRADE-AMT  
119064*    because it may change due to CXP or may be just have been
110064*    rebalanced.  
119064* 
119064*    TRF will be written later at the guest level.  This is   
119064*    because the data warehouse has processes (CURE Fact table)   
119064*    that work with guest level upgrade amounts.  Also booking
119064*    gross fare changes (revenue dilution) are best determined
119064*    at guest level.  
119064  
119064     PERFORM  
119064         VARYING  SUB 
119064             FROM 1 BY 1  
119064         UNTIL   (SUB > RSP06-PAX-CNT OF RSP06-OLD)   
119064             OR  (SUB > RSP06-PAX-CNT OF RSP06-NEW)   
119064             OR  (      RSP06-PAX-UPGRADE-AMT 
119064                            OF RSP06-NEW (SUB)
119064                  NOT = RSP06-PAX-UPGRADE-AMT 
119064                            OF RSP06-OLD (SUB))   
148678             OR  (      RSP06-IBR-PBS-UPG-CTR 
148678                            OF RSP06-NEW  
148678                  NOT = RSP06-IBR-PBS-UPG-CTR 
148678                            OF RSP06-OLD )
119064         CONTINUE 
119064     END-PERFORM  
119064  
119064     IF      (   (SUB > RSP06-PAX-CNT OF RSP06-OLD)   
119064             OR  (SUB > RSP06-PAX-CNT OF RSP06-NEW))  
CCL-UK*           GO TO 0240-CHECK-DEV-ADMIN-FEE
CCLAUS*           GO TO 0235-CHECK-IBR-B-PLUS-HISTORY   
CCLAUS            GO TO 0231-CHECK-IBR-GST-AMT  
119064     END-IF   

PBS-P1     MOVE SPACES     TO WS-HISTORY-AN-PARAMS. 
PBS-P1     MOVE LOW-VALUES TO WS-HISTORY-N-PARAMS.  
PBS-P1     MOVE 'UAM'      TO WS-HIST-ACTIVITY-TYPE.
213133***Most UAM activity will not need this flag.  0 upgrades need it.
213133     MOVE 1 TO WS-UAM-TRF-FLG.


PBS-P1     MOVE RSP06-IBR-UPGRADE-AMT OF RSP06-OLD  
PBS-P1         TO WS-DSPAMT8-1  

PBS-P1     STRING 'UPGRADE AMT: ' WS-DSPAMT8-1  
PBS-P1            DELIMITED BY SIZE INTO WS-HIST-COMMENT.   

119064     MOVE 'N'             TO WS-HIST-TRF-IND. 
PBS-P1  
PBS-P1     COMPUTE WS-HIST-AMT = RSP06-IBR-UPGRADE-AMT OF RSP06-NEW 
PBS-P1                         - RSP06-IBR-UPGRADE-AMT OF RSP06-OLD.

PBS-P1     PERFORM 8000-WRITE-HISTORY THRU 8099-EXIT.   

PBS-ME     IF      (RSP29-PBS-FLAG = 0) 
PBS-ME         OR  (RSP29-NEW-PAX-PROMO-UPG-AMT (1) = 0)
PBS-ME*      If pax promo based upgrade amounts are zer0 (first guest   
PBS-ME*      position is enough to detect this) then amount is  
PBS-ME*      completely manual for which no UAS should be written.  
PBS-ME*      If PBS-FLAG is not set, then any change in upgrade would   
PBS-ME*      be due to adding or cancelling a guest.
PBS-ME       CONTINUE   
PBS-ME     ELSE 
PBS-ME*      To show booking level supplemental amount on UAS, we   
PBS-ME*      need to subtract total of promotional based upgrade for
PBS-ME*      for each guest.
PBS-ME  
PBS-ME       PERFORM
PBS-ME           VARYING  SUB   
PBS-ME               FROM 1 BY 1
PBS-ME           UNTIL   (SUB > RSP06-PAX-CNT OF RSP06-NEW) 
PBS-ME         SUBTRACT RSP29-NEW-PAX-PROMO-UPG-AMT (SUB)   
PBS-ME             FROM WS-HIST-AMT 
PBS-ME       END-PERFORM
PBS-ME  
PBS-ME       IF  (WS-HIST-AMT NOT = 0)  
PBS-ME*        If supplemental amount is somehow negative, I want to see
PBS-ME*        in history so it can be detected and debugged if need be.
PBS-ME  
PBS-ME         MOVE 'UAS'            TO WS-HIST-ACTIVITY-TYPE   
PBS-ME         MOVE 'N'              TO WS-HIST-TRF-IND 
PBS-ME         MOVE 'UPGRADE SUPPLEMENT' TO WS-HIST-COMMENT 
PBS-ME         PERFORM 8000-WRITE-HISTORY THRU 8099-EXIT
PBS-ME       END-IF 
PBS-ME     END-IF.  

CCLAUS 0231-CHECK-IBR-GST-AMT.  

CCLAUS     IF RSP06-IBR-TOTAL-GST-AMT OF RSP06-OLD =
CCLAUS        RSP06-IBR-TOTAL-GST-AMT OF RSP06-NEW OR   
CCLAUS        RSP06-IBR-GST-PAID-AMT OF RSP06-NEW NOT > ZEROES  
CCLAUS        GO TO 0232-CHECK-IBR-GST-COMM-AMT 
CCLAUS     END-IF.  

CCLAUS     MOVE SPACES           TO WS-HISTORY-AN-PARAMS.   
CCLAUS     MOVE LOW-VALUES       TO WS-HISTORY-N-PARAMS.

CCLAUS     MOVE 'TGC'            TO WS-HIST-ACTIVITY-TYPE.  

CCLAUS     COMPUTE WS-HIST-AMT = RSP06-IBR-TOTAL-GST-AMT OF RSP06-NEW   
CCLAUS                     - RSP06-IBR-TOTAL-GST-AMT OF RSP06-OLD   

CCLAUS     MOVE RSP06-IBR-TOTAL-GST-AMT OF RSP06-OLD
CCLAUS                           TO WS-DSPAMT8-1
CCLAUS     STRING 'GST AMOUNT: ' WS-DSPAMT8-1   
CCLAUS               DELIMITED BY SIZE INTO WS-HIST-COMMENT.
CCLAUS     MOVE 'Y'              TO WS-HIST-TRF-IND.
CCLAUS     MOVE WS-HIST-COMMENT  TO WS-HIST-TRF-COMMENT2.   
CCLAUS     PERFORM 8000-WRITE-HISTORY THRU 8099-EXIT.   

CCLAUS 0232-CHECK-IBR-GST-COMM-AMT. 

CCLAUS     IF RSP06-IBR-COMM-GST-AMT OF RSP06-OLD = 
CCLAUS        RSP06-IBR-COMM-GST-AMT OF RSP06-NEW OR
CCLAUS        RSP06-IBR-COMM-GST-PAID-AMT OF RSP06-NEW NOT > ZEROES 
186084*       GO TO 0235-CHECK-IBR-B-PLUS-HISTORY   
186084        GO TO 0253-CHECK-TRANSFER-COMM
CCLAUS     END-IF.  

CCLAUS     MOVE SPACES           TO WS-HISTORY-AN-PARAMS.   
CCLAUS     MOVE LOW-VALUES       TO WS-HISTORY-N-PARAMS.

CCLAUS     MOVE 'CGU'            TO WS-HIST-ACTIVITY-TYPE.  

CCLAUS     COMPUTE WS-HIST-AMT = RSP06-IBR-COMM-GST-AMT OF RSP06-NEW
CCLAUS                     - RSP06-IBR-COMM-GST-AMT OF RSP06-OLD

CCLAUS     MOVE RSP06-IBR-COMM-GST-AMT OF RSP06-OLD 
CCLAUS                           TO WS-DSPAMT8-1
CCLAUS     STRING 'COM GST AMT: '  WS-DSPAMT8-1 
CCLAUS               DELIMITED BY SIZE INTO WS-HIST-COMMENT.
CCLAUS     MOVE 'Y'              TO WS-HIST-TRF-IND.
CCLAUS     MOVE WS-HIST-COMMENT  TO WS-HIST-TRF-COMMENT2.   
CCLAUS     PERFORM 8000-WRITE-HISTORY THRU 8099-EXIT.   


