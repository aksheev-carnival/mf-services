**********************DIRECT DILUTION METHOD 1**************************

165711     IF RSP90-OVR-INS-CHG-FLG = 1 
165711        ADD 1         TO WS-OVERRIDE-COUNT

165711        MOVE 'OVRINSPENLTY'   
165711                      TO WS-OVERRIDE-CODE      (WS-OVERRIDE-COUNT)

165711        COMPUTE WS-OLD-CRUISE-NCF-AMT (WS-OVERRIDE-COUNT) 
165711                          = RSP06-IBR-PTCHG-AMT  OF RSP06-OLD 
165711                          + RSP06-IBR-CRUISE-AMT OF RSP06-OLD 
165711                          + RSP06-IBR-INS-PREMIUM-AMT OF RSP06-OLD
165711  
165711        COMPUTE WS-NEW-CRUISE-NCF-AMT (WS-OVERRIDE-COUNT) 
165711                          = RSP06-IBR-PTCHG-AMT  OF RSP06-NEW 
165711                          + RSP06-IBR-CRUISE-AMT OF RSP06-NEW 
165711                          + RSP06-IBR-INS-PREMIUM-AMT OF RSP06-NEW
165711  
165711        MOVE 'Y'      TO WS-METHOD1-CALCULATED
165711        MOVE ZEROES   TO WS-OLD-MAR-AMT   (WS-OVERRIDE-COUNT) 
165711                         WS-NEW-MAR-AMT   (WS-OVERRIDE-COUNT) 
165711                         WS-OLD-ADDON-AMT (WS-OVERRIDE-COUNT) 
165711                         WS-NEW-ADDON-AMT (WS-OVERRIDE-COUNT) 
165711     END-IF.  

165711     IF RSP90-ALLOW-RPU-PRC-CHG-FLG = 1   
165711        ADD 1         TO WS-OVERRIDE-COUNT

165711        MOVE 'ALLOWRPUPRC'
