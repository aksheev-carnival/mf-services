                WS-HIST-PAX-SEQ-NUM.
           MOVE RSP06-PAX-COUPON-AMT OF RSP06-NEW (NSUB) TO 
                WS-DSPAMT3-1.   
           MOVE RSP06-PAX-COUPON-AMT OF RSP06-OLD (OSUB) TO 
                WS-DSPAMT3-2.   

           STRING 'CPN AMT' WS-DSPAMT3-1 '-' WS-DSPAMT3-2   
               DELIMITED BY SIZE INTO WS-HIST-COMMENT.  

           MOVE WS-HIST-COMMENT TO WS-HIST-TRF-COMMENT2.
           MOVE 'Y'             TO WS-HIST-TRF-IND. 

           PERFORM 8000-WRITE-HISTORY THRU 8099-EXIT.   

PPC470*-----------------------------------------------------------------

PPC470 3550-CHK-DIAMOND-REMEMPTION. 

           IF RSP06-PAX-DIAMOND-REDEEM-CODE OF RSP06-NEW (NSUB) =   
              RSP06-PAX-DIAMOND-REDEEM-CODE OF RSP06-OLD (OSUB) 
              GO TO 3600-CHECK-PXFR-CHANGE  
           ELSE 
              MOVE SPACES     TO WS-HISTORY-AN-PARAMS   
              MOVE LOW-VALUES TO WS-HISTORY-N-PARAMS
              MOVE 'DRC'      TO WS-HIST-ACTIVITY-TYPE  
              MOVE NSUB       TO WS-HIST-PAX-NUM
              MOVE RSP06-PAX-SEQ-NUM OF RSP06-NEW (NSUB) TO 
                   WS-HIST-PAX-SEQ-NUM  

              STRING 'DRC changed: '
                     RSP06-PAX-DIAMOND-REDEEM-CODE of RSP06-OLD (OSUB)  
                     ' to ' 
                     RSP06-PAX-DIAMOND-REDEEM-CODE OF RSP06-NEW (NSUB)  
                     DELIMITED BY SIZE INTO WS-HIST-COMMENT 

              MOVE WS-HIST-COMMENT TO WS-HIST-TRF-COMMENT1  
              MOVE 'Y'             TO WS-HIST-TRF-IND   

              PERFORM 8000-WRITE-HISTORY THRU 8099-EXIT 
           END-IF.  


PPC470*-----------------------------------------------------------------

PPC470*-----------------------------------------------------------------
PPC470* 
PPC470*3560-CHECK-PAX-OCC-ADJ.  
PPC470*    IF (RSP06-PAX-OCC-ADJUSTMENT-AMT OF RSP06-NEW (NSUB) =   
PPC470*          RSP06-PAX-OCC-ADJUSTMENT-AMT OF RSP06-OLD (OSUB))  
PPC470*       GO TO 3600-CHECK-PXFR-CHANGE. 
PPC470* 
PPC470*    MOVE SPACES     TO WS-HISTORY-AN-PARAMS. 
PPC470*    MOVE LOW-VALUES TO WS-HISTORY-N-PARAMS.  
PPC470*    MOVE 'COA'      TO WS-HIST-ACTIVITY-TYPE.
PPC470*    MOVE NSUB       TO WS-HIST-PAX-NUM.  
PPC470*    MOVE RSP06-PAX-SEQ-NUM OF RSP06-NEW (NSUB) TO
PPC470*         WS-HIST-PAX-SEQ-NUM.
PPC470*    MOVE RSP06-PAX-OCC-ADJUSTMENT-AMT OF RSP06-OLD (NSUB) TO 
PPC470*         WS-DSPAMT3-1.   
PPC470*    MOVE RSP06-PAX-OCC-ADJUSTMENT-AMT OF RSP06-NEW (OSUB) TO 
PPC470*         WS-DSPAMT3-2.   
PPC470* 
PPC470*    STRING 'OCC ADJ' WS-DSPAMT3-1 'to' WS-DSPAMT3-2  
PPC470*        DELIMITED BY SIZE INTO WS-HIST-COMMENT.  
PPC470* 
PPC470*    MOVE WS-HIST-COMMENT TO WS-HIST-TRF-COMMENT2.
PPC470*    MOVE 'Y'             TO WS-HIST-TRF-IND. 
PPC470* 
PPC470*    PERFORM 8000-WRITE-HISTORY THRU 8099-EXIT.   
PPC470* 
      *=================================================================

AK1011 3600-CHECK-PXFR-CHANGE.  
AK1011     IF WS-REACTIVATE-FLAG = 'Y' OR WS-CHG-SAILING-FLAG = 'Y' OR  
AK1011        WS-NEW-BKG-FLAG  = 'Y'
AK1011        GO TO 2020-NEXT-NEW-GUEST.

RE1111     IF RSP06-IBR-CANCEL-DATE OF RSP06-NEW > ZERO OR  
RE1111           RSP06-PAX-CANCEL-DATE OF RSP06-NEW (NSUB) > ZERO   
RE1111        GO TO 2020-NEXT-NEW-GUEST.

PPC470*    IF (RSP06-PAX-PRICE-TYPE OF RSP06-NEW (NSUB) NOT =   
PPC470*          RSP06-PAX-PRICE-TYPE OF RSP06-OLD (OSUB)) OR   
PPC470*          (RSP06-PAX-PRICE-CODE OF RSP06-NEW (NSUB) NOT =
PPC470*          RSP06-PAX-PRICE-CODE OF RSP06-OLD (OSUB))  
PPC470*       GO TO 2020-NEXT-NEW-GUEST.
PPC470     IF (RSP06-PAX-FARE-TYPE OF RSP06-NEW (NSUB) NOT =
PPC470           RSP06-PAX-FARE-TYPE OF RSP06-OLD (OSUB)) OR
PPC470           (RSP06-PAX-OFFER-CODE OF RSP06-NEW (NSUB) NOT =
PPC470           RSP06-PAX-OFFER-CODE OF RSP06-OLD (OSUB))  
PPC470        GO TO 2020-NEXT-NEW-GUEST 
PPC470     END-IF.  
AK1011  
PPC470*    IF (RSP06-PAX-FARE-CODE OF RSP06-NEW (NSUB) NOT =
PPC470*          RSP06-PAX-FARE-CODE OF RSP06-OLD (OSUB))   
PPC470*       GO TO 2020-NEXT-NEW-GUEST.
PPC470     IF (RSP06-PAX-OFFER-CODE OF RSP06-NEW (NSUB) NOT =   
PPC470           RSP06-PAX-OFFER-CODE OF RSP06-OLD (OSUB))  
PPC470        GO TO 2020-NEXT-NEW-GUEST 
PPC470     END-IF.  
AK1011  
AK1011     IF (RSP06-PAX-CITY-CODE OF RSP06-NEW (NSUB) NOT =
AK1011           RSP06-PAX-CITY-CODE OF RSP06-OLD (OSUB))   
AK1011        GO TO 2020-NEXT-NEW-GUEST.
AK1011  
AK1011     IF (RSP06-IBR-REQ-RATE-VERSION OF RSP06-NEW NOT =
AK1011           RSP06-IBR-REQ-RATE-VERSION  OF RSP06-OLD)  
AK1011        GO TO 2020-NEXT-NEW-GUEST.
AK1011  
AK1011     IF (RSP06-PXFR-READ-IND OF RSP06-NEW (NSUB) = 'N') AND   
AK1011           (RSP06-PXFR-READ-IND OF RSP06-OLD (OSUB) = 'N')
AK1011        GO TO 2020-NEXT-NEW-GUEST 
AK1011     ELSE 
AK1011        IF (RSP06-PXFR-READ-IND OF RSP06-NEW (NSUB) NOT = 
AK1011              RSP06-PXFR-READ-IND OF RSP06-OLD (OSUB))
AK1011           MOVE 52 TO DPP42-HOLD-MSG-INDEX
AK1011           GO TO 9200-EDIT-ERROR-MSG. 
AK1011  
AK1011     IF (RSP06-PXFR-EXIST-IND OF RSP06-OLD (OSUB) = 'N')  
AK1011        GO TO 3660-CHECK-NEW-PXFRS.   
AK1011  
AK1011     MOVE ZERO TO OPXFR-SUB.  
AK1011  
      *-----------------------------------------------------------------

AK1011 3620-NEXT-OLD-PXFR.  
AK1011     ADD 1 TO OPXFR-SUB.  
AK1011  
AK1011     IF OPXFR-SUB > RSP06-PXFR-CNT OF RSP06-OLD (OSUB)
AK1011        GO TO 3660-CHECK-NEW-PXFRS.   
AK1011  
AK1011     IF (RSP06-PXFR-EXIST-IND OF RSP06-NEW (NSUB) = 'N')  
AK1011        GO TO 3640-REMOVE-PXFR-HISTORY.   
AK1011  
AK1011     MOVE ZERO TO PXFR-SUB.   
AK1011  
AK1011     PERFORM VARYING SUB FROM 1 BY 1  
AK1011           UNTIL SUB > RSP06-PXFR-CNT OF RSP06-NEW (NSUB) 
AK1011        IF RSP06-PXFR-FEE-CODE OF RSP06-OLD (OSUB OPXFR-SUB) =
AK1011              RSP06-PXFR-FEE-CODE OF RSP06-NEW (NSUB SUB) 
AK1011           MOVE SUB TO PXFR-SUB   
AK1011           MOVE RSP06-PXFR-CNT OF RSP06-NEW (NSUB) TO SUB 
AK1011        END-IF
AK1011     END-PERFORM. 
AK1011  
AK1011     IF PXFR-SUB = ZERO   
AK1011        GO TO 3640-REMOVE-PXFR-HISTORY.   
AK1011  
AK1011     IF (RSP06-PXFR-ENTRY OF RSP06-NEW (NSUB PXFR-SUB) =  
AK1011           RSP06-PXFR-ENTRY OF RSP06-OLD (OSUB OPXFR-SUB))
AK1011        GO TO 3620-NEXT-OLD-PXFR. 
AK1011  
AK1011     MOVE SPACES     TO WS-HISTORY-AN-PARAMS. 
AK1011     MOVE LOW-VALUES TO WS-HISTORY-N-PARAMS.  
AK1011     MOVE NSUB       TO WS-HIST-PAX-NUM.  
AK1011     IF RSP06-PXFR-FEE-GROUP-CODE OF RSP06-OLD (OSUB OPXFR-SUB)   
AK1011                                                            = 'C' 
AK1011        MOVE 'OCF'   TO WS-HIST-ACTIVITY-TYPE 
AK1011     ELSE 
AK1011        MOVE 'OTF'   TO WS-HIST-ACTIVITY-TYPE.
AK1011     MOVE RSP06-PAX-SEQ-NUM OF RSP06-NEW (NSUB) TO
AK1011          WS-HIST-PAX-SEQ-NUM.
AK1011     MOVE RSP06-PAX-CITY-CODE OF RSP06-NEW (NSUB) TO  
AK1011          WS-HIST-CITY-CODE.  
PPC470*    MOVE RSP06-PAX-FARE-CODE OF RSP06-NEW (NSUB) TO  
PPC470*         WS-HIST-FARE-CODE.  
PPC470     MOVE RSP06-PAX-OFFER-CODE OF RSP06-NEW (NSUB) TO 
PPC470          WS-HIST-OFFER-CODE. 
PPC470     MOVE RSP06-PAX-FARE-TYPE OF RSP06-NEW (NSUB) TO  
PPC470          WS-HIST-FARE-TYPE.  

AK1011     MOVE RSP06-PXFR-FEE-AMT OF RSP06-OLD (OSUB OPXFR-SUB) TO 
AK1011          WS-DSPAMT4-1.   
AK1011     MOVE RSP06-PXFR-FEE-AMT OF RSP06-NEW (NSUB PXFR-SUB) TO  
AK1011          WS-DSPAMT4-2.   
AK1011  
AK1011     COMPUTE WS-HIST-AMT =
AK1011                  RSP06-PXFR-FEE-AMT OF RSP06-NEW (NSUB PXFR-SUB) 
AK1011                - RSP06-PXFR-FEE-AMT OF RSP06-NEW (NSUB PXFR-SUB).
AK1011  
AK1011     STRING RSP06-PXFR-FEE-CODE OF RSP06-OLD (OSUB OPXFR-SUB) ' ' 
AK1011            WS-DSPAMT4-1 ' to '   
AK1011            WS-DSPAMT4-2  
AK1011            DELIMITED BY SIZE INTO WS-HIST-COMMENT.   
AK1011  
AK1011     PERFORM 8000-WRITE-HISTORY THRU 8099-EXIT.   
AK1011  
AK1011     GO TO 3620-NEXT-OLD-PXFR.
AK1011  
      *-----------------------------------------------------------------

AK1011 3640-REMOVE-PXFR-HISTORY.
AK1011     MOVE SPACES     TO WS-HISTORY-AN-PARAMS. 
AK1011     MOVE LOW-VALUES TO WS-HISTORY-N-PARAMS.  
AK1011     MOVE NSUB       TO WS-HIST-PAX-NUM.  
AK1011     IF RSP06-PXFR-FEE-GROUP-CODE OF RSP06-OLD (OSUB OPXFR-SUB)   
AK1011                                                            = 'C' 
AK1011        MOVE 'OCF'   TO WS-HIST-ACTIVITY-TYPE 
AK1011     ELSE 
AK1011        MOVE 'OTF'   TO WS-HIST-ACTIVITY-TYPE.
AK1011     MOVE RSP06-PAX-SEQ-NUM OF RSP06-NEW (NSUB) TO
AK1011          WS-HIST-PAX-SEQ-NUM.
AK1011     MOVE RSP06-PAX-CITY-CODE OF RSP06-NEW (NSUB) TO  
AK1011          WS-HIST-CITY-CODE.  
PPC470*    MOVE RSP06-PAX-FARE-CODE OF RSP06-NEW (NSUB) TO  
PPC470*         WS-HIST-FARE-CODE.  
PPC470     MOVE RSP06-PAX-OFFER-CODE OF RSP06-NEW (NSUB) TO 
PPC470          WS-HIST-OFFER-CODE. 
PPC470     MOVE RSP06-PAX-FARE-TYPE OF RSP06-NEW (NSUB) TO  
PPC470          WS-HIST-FARE-TYPE.  

AK1011     MOVE RSP06-PXFR-FEE-AMT OF RSP06-OLD (OSUB OPXFR-SUB) TO 
AK1011          WS-DSPAMT4-1.   
AK1011     MOVE 0 TO WS-DSPAMT4-2.  
AK1011  
AK1011     COMPUTE WS-HIST-AMT =
AK1011            RSP06-PXFR-FEE-AMT OF RSP06-OLD (OSUB OPXFR-SUB) * -1.
AK1011  
AK1011     STRING RSP06-PXFR-FEE-CODE OF RSP06-OLD (OSUB OPXFR-SUB) ' ' 
AK1011            WS-DSPAMT4-1 ' to '   
AK1011            WS-DSPAMT4-2  
AK1011            DELIMITED BY SIZE INTO WS-HIST-COMMENT.   
AK1011  
AK1011     PERFORM 8000-WRITE-HISTORY THRU 8099-EXIT.   
AK1011  
AK1011     GO TO 3620-NEXT-OLD-PXFR.
AK1011  
      *-----------------------------------------------------------------

AK1011 3660-CHECK-NEW-PXFRS.
AK1011     IF (RSP06-PXFR-EXIST-IND OF RSP06-NEW (NSUB) = 'N')  
AK1011        GO TO 2020-NEXT-NEW-GUEST.
AK1011  
AK1011     MOVE ZERO TO PXFR-SUB.   
AK1011  
AK1011 3680-NEXT-NEW-PXFR.  
AK1011     ADD 1 TO PXFR-SUB.   
AK1011  
AK1011     IF PXFR-SUB > RSP06-PXFR-CNT OF RSP06-NEW (NSUB) 
AK1011        GO TO 2020-NEXT-NEW-GUEST.
AK1011  
AK1011     IF (RSP06-PXFR-EXIST-IND OF RSP06-OLD (OSUB) = 'N')  
AK1011        GO TO 3700-ADD-PXFR-HISTORY.  
AK1011  
AK1011     MOVE ZERO TO OPXFR-SUB.  
AK1011  
AK1011     PERFORM VARYING SUB FROM 1 BY 1  
AK1011           UNTIL SUB > RSP06-PXFR-CNT OF RSP06-OLD (OSUB) 
AK1011        IF RSP06-PXFR-FEE-CODE OF RSP06-OLD (OSUB SUB) =  
AK1011              RSP06-PXFR-FEE-CODE OF RSP06-NEW (NSUB PXFR-SUB)
AK1011           MOVE SUB TO OPXFR-SUB  
AK1011           MOVE RSP06-PXFR-CNT OF RSP06-OLD (OSUB) TO SUB 
AK1011        END-IF
AK1011     END-PERFORM. 
AK1011  
AK1011     IF OPXFR-SUB > ZERO  
AK1011        GO TO 3680-NEXT-NEW-PXFR. 
AK1011  
      *-----------------------------------------------------------------

AK1011 3700-ADD-PXFR-HISTORY.   
AK1011     MOVE SPACES     TO WS-HISTORY-AN-PARAMS. 
AK1011     MOVE LOW-VALUES TO WS-HISTORY-N-PARAMS.  
AK1011     MOVE NSUB       TO WS-HIST-PAX-NUM.  
AK1011     IF RSP06-PXFR-FEE-GROUP-CODE OF RSP06-NEW (NSUB PXFR-SUB)
AK1011                                                            = 'C' 
AK1011        MOVE 'OCF'   TO WS-HIST-ACTIVITY-TYPE 
AK1011     ELSE 
AK1011        MOVE 'OTF'   TO WS-HIST-ACTIVITY-TYPE.
AK1011     MOVE RSP06-PAX-SEQ-NUM OF RSP06-NEW (NSUB) TO
AK1011          WS-HIST-PAX-SEQ-NUM.
AK1011     MOVE RSP06-PAX-CITY-CODE OF RSP06-NEW (NSUB) TO  
AK1011          WS-HIST-CITY-CODE.  
PPC470*    MOVE RSP06-PAX-FARE-CODE OF RSP06-NEW (NSUB) TO  
PPC470*         WS-HIST-FARE-CODE.  
PPC470     MOVE RSP06-PAX-OFFER-CODE OF RSP06-NEW (NSUB) TO 
PPC470          WS-HIST-OFFER-CODE. 
PPC470     MOVE RSP06-PAX-FARE-TYPE OF RSP06-NEW (NSUB) TO  
PPC470          WS-HIST-FARE-TYPE.  

AK1011     MOVE 0 TO WS-DSPAMT4-2.  
AK1011     MOVE RSP06-PXFR-FEE-AMT OF RSP06-NEW (NSUB PXFR-SUB) TO  
AK1011          WS-DSPAMT4-2
AK1011          WS-HIST-AMT.
AK1011  
AK1011     STRING RSP06-PXFR-FEE-CODE OF RSP06-NEW (NSUB PXFR-SUB) ' '  
AK1011            WS-DSPAMT4-1 ' to '   
AK1011            WS-DSPAMT4-2  
AK1011            DELIMITED BY SIZE INTO WS-HIST-COMMENT.   
AK1011  
AK1011     PERFORM 8000-WRITE-HISTORY THRU 8099-EXIT.   
AK1011  
AK1011     GO TO 3680-NEXT-NEW-PXFR.

      *=================================================================
      *=================================================================

       5000-TOUR-PACKAGE-HISTORY.   
           MOVE ZERO TO OTPR-SUB.   

       5020-NEXT-OLD-TPR.   
           ADD 1 TO OTPR-SUB.   

           IF OTPR-SUB > RSP06-TPR-CNT OF RSP06-OLD 
              GO TO 5060-CHECK-NEW-TPRS.

           MOVE ZERO TO TPR-SUB.

           PERFORM VARYING SUB FROM 1 BY 1  
                   UNTIL SUB > RSP06-TPR-CNT OF RSP06-NEW   
              IF (RSP06-TPR-PKG-NUM OF RSP06-OLD (OTPR-SUB) =   
                    RSP06-TPR-PKG-NUM OF RSP06-NEW (SUB)) AND   
                    (RSP06-TPR-PKG-TYPE OF RSP06-OLD (OTPR-SUB) =   
                    RSP06-TPR-PKG-TYPE OF RSP06-NEW (SUB)) AND  
                    (RSP06-TPR-PKG-CODE OF RSP06-OLD (OTPR-SUB) =   
                    RSP06-TPR-PKG-CODE OF RSP06-NEW (SUB))  
                 MOVE SUB TO TPR-SUB
                 MOVE RSP06-TPR-CNT OF RSP06-NEW TO SUB 
              END-IF
           END-PERFORM. 

           IF TPR-SUB > ZERO
              GO TO 5040-TPR-MODIFY-HIST.   

           MOVE SPACES     TO WS-HISTORY-AN-PARAMS. 
           MOVE LOW-VALUES TO WS-HISTORY-N-PARAMS.  
           MOVE 'TPD'      TO WS-HIST-ACTIVITY-TYPE.

           STRING RSP06-TPR-PKG-NUM OF RSP06-OLD (OTPR-SUB) '/' 
                  RSP06-TPR-PKG-CODE OF RSP06-OLD (OTPR-SUB) '/'
                  RSP06-TPR-PKG-TYPE OF RSP06-OLD (OTPR-SUB) ' CAR:'
                  RSP06-TPR-NUM-CAR OF RSP06-OLD (OTPR-SUB) ' XFR:' 
                  RSP06-TPR-NUM-XFR OF RSP06-OLD (OTPR-SUB) ' ROOMS:'   
                  RSP06-TPR-NUM-ROOMS OF RSP06-OLD (OTPR-SUB) ' PAX:'   
                  RSP06-TPR-NUM-PAX OF RSP06-OLD (OTPR-SUB) 
                  DELIMITED BY SIZE INTO WS-HIST-COMMENT.   

           PERFORM 8000-WRITE-HISTORY THRU 8099-EXIT.   

           GO TO 5020-NEXT-OLD-TPR. 

      *-----------------------------------------------------------------

       5040-TPR-MODIFY-HIST.
           IF (RSP06-TPR-REC OF RSP06-NEW (TPR-SUB) =   
                 RSP06-TPR-REC OF RSP06-OLD (OTPR-SUB)) 
              GO TO 5020-NEXT-OLD-TPR.  

             MOVE SPACES     TO WS-HISTORY-AN-PARAMS.   
             MOVE LOW-VALUES TO WS-HISTORY-N-PARAMS.
             MOVE 'TPC'      TO WS-HIST-ACTIVITY-TYPE.  

           STRING RSP06-TPR-PKG-NUM OF RSP06-OLD (OTPR-SUB) '/' 
                  RSP06-TPR-PKG-CODE OF RSP06-OLD (OTPR-SUB) '/'
                  RSP06-TPR-PKG-TYPE OF RSP06-OLD (OTPR-SUB) ' CAR:'
                  RSP06-TPR-NUM-CAR OF RSP06-OLD (OTPR-SUB) ' XFR:' 
                  RSP06-TPR-NUM-XFR OF RSP06-OLD (OTPR-SUB) ' ROOMS:'   
                  RSP06-TPR-NUM-ROOMS OF RSP06-OLD (OTPR-SUB) ' PAX:'   
                  RSP06-TPR-NUM-PAX OF RSP06-OLD (OTPR-SUB) 
                  DELIMITED BY SIZE INTO WS-HIST-COMMENT.   

             PERFORM 8000-WRITE-HISTORY THRU 8099-EXIT. 

           GO TO 5020-NEXT-OLD-TPR. 

      *-----------------------------------------------------------------

       5060-CHECK-NEW-TPRS. 
           MOVE ZERO TO TPR-SUB.

       5080-NEXT-NEW-TPR.   
           ADD 1 TO TPR-SUB.

           IF TPR-SUB > RSP06-TPR-CNT OF RSP06-NEW  
              GO TO 6000-WRITE-INPUT-HISTORY.   

           MOVE ZERO TO OTPR-SUB.   

           PERFORM VARYING SUB FROM 1 BY 1  
                   UNTIL SUB > RSP06-TPR-CNT OF RSP06-OLD   
              IF (RSP06-TPR-PKG-NUM OF RSP06-OLD (SUB) =
                    RSP06-TPR-PKG-NUM OF RSP06-NEW (TPR-SUB)) AND   
                    (RSP06-TPR-PKG-TYPE OF RSP06-OLD (SUB) =
                    RSP06-TPR-PKG-TYPE OF RSP06-NEW (TPR-SUB)) AND  
                    (RSP06-TPR-PKG-CODE OF RSP06-OLD (SUB) =
                    RSP06-TPR-PKG-CODE OF RSP06-NEW (TPR-SUB))  
                 MOVE SUB TO OTPR-SUB   
                 MOVE RSP06-TPR-CNT OF RSP06-OLD TO SUB 
              END-IF
           END-PERFORM. 

           IF TPR-SUB > ZERO
              GO TO 5080-NEXT-NEW-TPR.  

           MOVE SPACES     TO WS-HISTORY-AN-PARAMS. 
           MOVE LOW-VALUES TO WS-HISTORY-N-PARAMS.  
           MOVE 'TPA'      TO WS-HIST-ACTIVITY-TYPE.

           STRING RSP06-TPR-PKG-NUM OF RSP06-NEW (TPR-SUB) '/'  
                  RSP06-TPR-PKG-CODE OF RSP06-NEW (TPR-SUB) '/' 
                  RSP06-TPR-PKG-TYPE OF RSP06-NEW (TPR-SUB) ' CAR:' 
                  RSP06-TPR-NUM-CAR OF RSP06-NEW (TPR-SUB) ' XFR:'  
                  RSP06-TPR-NUM-XFR OF RSP06-NEW (TPR-SUB) ' ROOMS:'
                  RSP06-TPR-NUM-ROOMS OF RSP06-NEW (TPR-SUB) ' PAX:'
                  RSP06-TPR-NUM-PAX OF RSP06-NEW (TPR-SUB)  
                  DELIMITED BY SIZE INTO WS-HIST-COMMENT.   

           PERFORM 8000-WRITE-HISTORY THRU 8099-EXIT.   

           GO TO 5080-NEXT-NEW-TPR. 

      *=================================================================
      *=================================================================

       6000-WRITE-INPUT-HISTORY.
           MOVE ZERO TO HST-SUB.

       6020-WRITE-NEXT-INPUT-HIST.  
           ADD 1 TO HST-SUB.

           IF HST-SUB > RSP29-HIST-CNT  
              GO TO 6040-CHECK-CXP-TO-SGL.  

           MOVE RSP29-HIST-COMMENT (HST-SUB)   TO WS-HIST-COMMENT.  
           MOVE RSP29-HIST-TYPE (HST-SUB)      TO WS-HIST-TYPE. 
           MOVE RSP29-HIST-CITY-CODE (HST-SUB) TO WS-HIST-CITY-CODE.
           MOVE RSP29-HIST-CABIN-NUM (HST-SUB) TO WS-HIST-CABIN-NUM.
           MOVE RSP29-HIST-CONTACT (HST-SUB)   TO WS-HIST-CONTACT.  
           MOVE RSP29-HIST-PKG-TYPE (HST-SUB)  TO WS-HIST-PKG-TYPE. 
           MOVE RSP29-HIST-PKG-CODE (HST-SUB)  TO WS-HIST-PKG-CODE. 
PPC470*    MOVE RSP29-HIST-FARE-CODE (HST-SUB) TO WS-HIST-FARE-CODE.
PPC470     MOVE RSP29-HIST-FARE-TYPE (HST-SUB) TO WS-HIST-FARE-TYPE.
PPC470     MOVE RSP29-HIST-OFFER-CODE (HST-SUB) 
PPC470                                         TO WS-HIST-OFFER-CODE.   
           MOVE RSP29-HIST-TRF-IND (HST-SUB)   TO WS-HIST-TRF-IND.  
           MOVE RSP29-HIST-SHIP-CODE (HST-SUB) TO WS-HIST-TRF-SHIP-CODE.
           MOVE RSP29-HIST-AMT (HST-SUB)       TO WS-HIST-AMT.  
           MOVE RSP29-HIST-OLD-AMT (HST-SUB)   TO WS-HIST-OLD-AMT.  
           MOVE RSP29-HIST-TRF-AMT (HST-SUB)   TO WS-HIST-TRF-AMT.  
           MOVE RSP29-HIST-PAX-NUM (HST-SUB)   TO WS-HIST-PAX-NUM.  
           MOVE RSP29-HIST-PAX-SEQ-NUM (HST-SUB) TO 
                WS-HIST-PAX-SEQ-NUM.
           MOVE RSP29-HIST-TRF-OLD-AMT (HST-SUB) TO 
                WS-HIST-TRF-OLD-AMT.
           MOVE RSP29-HIST-ACTIVITY-TYPE (HST-SUB) TO   
                WS-HIST-ACTIVITY-TYPE.  
           MOVE RSP29-HIST-TRF-ACTIVITY-TYPE (HST-SUB) TO   
                WS-HIST-TRF-ACTIVITY-TYPE.  
           MOVE RSP29-HIST-TRF-COMMENT1 (HST-SUB) TO
                WS-HIST-TRF-COMMENT1.   
           MOVE RSP29-HIST-TRF-COMMENT2 (HST-SUB) TO
                WS-HIST-TRF-COMMENT2.   
           MOVE RSP29-HIST-TRF-MAIL-IND (HST-SUB) TO
