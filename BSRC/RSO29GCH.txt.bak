120706     MOVE 'RAJ'      TO WS-HIST-TRF-ACTIVITY-TYPE.
120706*    MOVE 1          TO WS-HIST-PAX-SEQ-NUM.  
           MOVE 'CXP LED TO RATE CHANGE' TO 
                WS-HIST-TRF-COMMENT1.   

           COMPUTE WS-HIST-TRF-AMT =
                   RSP06-IB-PAX-GROSS-FARE-AMT OF RSP06-NEW -   
                   WS-STEPPED-GROSS-AMT.

           IF WS-HIST-TRF-AMT > ZERO
              PERFORM 8100-WRITE-TRF THRU 8199-EXIT.

      *-----------------------------------------------------------------

       6060-CHECK-GROSS-CHANGE. 
           IF WS-REACTIVATE-FLAG = 'Y' OR WS-NEW-BKG-FLAG  = 'Y'
165711*       GO TO 9000-END-OF-JOB.
218337*       GO TO 6070-CHECK-IF-OVERRIDE-USED 
218337        GO TO 6065-CHECK-SPOILAGE-POL-IND 
165711     END-IF.  

105206     MOVE ZEROS          TO WS-FCC-REDEEMED-CNT   
105206                            WS-FCC-REMAINING-AMT  
105206                            WS-FCC-REDEEMED-AMT.  

105206     EXEC SQL SELECT COUNT(*), IFNULL(SUM(FCC_AMT),0) 
105206              INTO :WS-FCC-REDEEMED-CNT,  
105206                   :WS-FCC-REDEEMED-AMT   
105206              FROM FCC_REDEMPTION_TBL 
105206              WHERE BOOK_NUM =
105206                 :RSP06-IBR-BOOK-NUM OF RSP06-OLD AND 
105206                  FCC_AMT IS NOT NULL 
105206     END-EXEC.
105206     IF SQLCODE = 100 
105206        CONTINUE  
105206     END-IF.  
105206     IF SQLCODE < 0   
105206        GO TO 9150-RDMS-ERROR 
105206     END-IF.  

105206     COMPUTE WS-FCC-REMAINING-AMT =   
105206                        RSP06-IBR-CRUISE-AMT     OF RSP06-NEW  +  
105206                        RSP06-IBR-PTCHG-AMT      OF RSP06-NEW  +  
105206                        RSP06-IBR-OBC-CHARGE-AMT OF RSP06-NEW  -  
105206                        WS-FCC-REDEEMED-AMT.  

105206     IF WS-FCC-REDEEMED-CNT > 0   
105206        IF IBR-CANCEL-DATE > 0 AND
105206           RSP06-IB-PAX-GROSS-FARE-AMT OF RSP06-NEW NOT EQUAL 
105206           RSP06-IB-PAX-GROSS-FARE-AMT OF RSP06-OLD   
105206             MOVE 54 TO DPP42-HOLD-MSG-INDEX  
105206             PERFORM 9400-INFO-MSG
105206        ELSE  
105206           IF RSP06-IB-PAX-GROSS-FARE-AMT OF RSP06-NEW >  
105206              RSP06-IB-PAX-GROSS-FARE-AMT OF RSP06-OLD
105206                 MOVE 52 TO DPP42-HOLD-MSG-INDEX  
105206                 PERFORM 9400-INFO-MSG
105206           ELSE   
105206             IF RSP06-IB-PAX-GROSS-FARE-AMT OF RSP06-NEW <
105206                RSP06-IB-PAX-GROSS-FARE-AMT OF RSP06-OLD  
105206                IF WS-FCC-REMAINING-AMT < 0   
105206                   MOVE 56 TO DPP42-HOLD-MSG-INDEX
105206                   GO TO 9200-EDIT-ERROR-MSG  
105206                ELSE  
105206                   IF RSP29-CALL-CENTER-FLAG = 1  
105206                      MOVE 53 TO DPP42-HOLD-MSG-INDEX 
105206                      PERFORM 9400-INFO-MSG   
105206                   ELSE   
105206                      MOVE 55 TO DPP42-HOLD-MSG-INDEX 
105206                      GO TO 9200-EDIT-ERROR-MSG   
105206                   END-IF 
105206                END-IF
105206             END-IF   
105206           END-IF 
105206        END-IF
105206     END-IF.  
           IF (RSP06-IBR-GROSS-FARE-AMT OF RSP06-NEW =  
                 RSP06-IBR-GROSS-FARE-AMT OF RSP06-OLD) OR  
                 WS-SKIP-HISTORY-IND = 'Y'  
165711*       GO TO 9000-END-OF-JOB.
218337*       GO TO 6070-CHECK-IF-OVERRIDE-USED 
218337        GO TO 6065-CHECK-SPOILAGE-POL-IND 
165711     END-IF.  

           MOVE SPACES     TO WS-HISTORY-AN-PARAMS. 
           MOVE LOW-VALUES TO WS-HISTORY-N-PARAMS.  

           IF (RSP29-REPRICE-FLAG = 1)  
              MOVE 'REP'            TO WS-HIST-ACTIVITY-TYPE
           ELSE 
              MOVE 'CG$'            TO WS-HIST-ACTIVITY-TYPE.   

           COMPUTE WS-HIST-AMT = RSP06-IBR-GROSS-FARE-AMT OF RSP06-NEW  
                               - RSP06-IBR-GROSS-FARE-AMT OF RSP06-OLD. 

           MOVE RSP06-IBR-GROSS-FARE-AMT OF RSP06-OLD TO WS-DSPAMT8-1.  
           MOVE 'Y'  TO WS-HIST-TRF-IND.

           STRING 'GROSS: ' WS-DSPAMT8-1
                 DELIMITED BY SIZE INTO WS-HIST-COMMENT.

           PERFORM 8000-WRITE-HISTORY THRU 8099-EXIT.   

