           IF  BKCPO1-ORDER-TYPE NOT > SPACES   
               ADD 1                     TO CCMV-ADV-SUB
               MOVE 0008                 TO MSGHDR-ADVISE-CODE  
                                            (CCMV-ADV-SUB)  
               MOVE 'CCR02CPO'           TO MSGHDR-ADVISE-SOURCE
                                            (CCMV-ADV-SUB)  
               PERFORM CCP75-OUTPUT-CCERRMSG
                  THRU CCP75-OUTPUT-CCERRMSG-EXIT   
               GO TO 9000-END-OF-JOB
           END-IF.  

           IF  BKCPO1-CURRENCY-CODE NOT > SPACES
               ADD 1                     TO CCMV-ADV-SUB
               MOVE 0009                 TO MSGHDR-ADVISE-CODE  
                                            (CCMV-ADV-SUB)  
               MOVE 'CCR02CPO'           TO MSGHDR-ADVISE-SOURCE
                                            (CCMV-ADV-SUB)  
               PERFORM CCP75-OUTPUT-CCERRMSG
                  THRU CCP75-OUTPUT-CCERRMSG-EXIT   
               GO TO 9000-END-OF-JOB
           END-IF.  

      *     IF  BKCPO1-DEPT-CODE NOT > SPACES   
      *         ADD 1                     TO CCMV-ADV-SUB   
      *         MOVE 0019                 TO MSGHDR-ADVISE-CODE 
      *                                      (CCMV-ADV-SUB) 
      *         MOVE 'CCR02CPO'           TO MSGHDR-ADVISE-SOURCE   
      *                                      (CCMV-ADV-SUB) 
      *         PERFORM CCP75-OUTPUT-CCERRMSG   
      *            THRU CCP75-OUTPUT-CCERRMSG-EXIT  
      *         GO TO 9000-END-OF-JOB   
      *     END-IF. 


           IF MSGHDR-USER-ID (1:1) = '@'
               MOVE MSGHDR-USER-ID    TO WS-USER-INFO   
           ELSE 
               MOVE FUNCTION UPPER-CASE (MSGHDR-USER-ID)
                                           TO SSP18-I-NT-UID

               CALL 'SSC18GUD' USING DPP01-COMMON-DATA-FIELDS   
                                            DPP01-COMMON-INFO   
                                            SSP18-INPUT-PARAMS  
                                            SSP18-OUTPUT-PARAMS 

               IF DPP01-SUB-MSG-CTR > 0 AND 
                  DPP01-SUB-MSG-STATUS (1) > 1  
      *                              GO TO 9500-RETURN-SUBROUTINE-ERROR 
                  MOVE '@ER' TO SSP18-O-NTUR-MAPPER-UID 
                  MOVE SPACES TO SSP18-O-NTUR-FIRST-NAME
                                 SSP18-O-NTUR-LAST-NAME 
               END-IF   
               MOVE SSP18-O-NTUR-MAPPER-UID  TO WS-USER-INFO
               MOVE SSP18-O-NTUR-FIRST-NAME  TO WS-USER-FIRST-NAME  
               MOVE SSP18-O-NTUR-LAST-NAME   TO WS-USER-LAST-NAME   
           END-IF.  

CCLCOM     IF WS-USER-FIRST-NAME < SPACES   
CCLCOM        MOVE SPACES      TO WS-USER-FIRST-NAME
CCLCOM     END-IF.  
CCLCOM  
CCLCOM     IF WS-USER-LAST-NAME < SPACES
CCLCOM        MOVE SPACES      TO WS-USER-LAST-NAME 
CCLCOM     END-IF.  

           EVALUATE FUNCTION UPPER-CASE (BKCPO1-DEPT-CODE)  
              WHEN 'ZERO'   
                 MOVE '0' TO BKCPO1-DEPT-CODE   
              WHEN 'ONE'
                 MOVE '1' TO BKCPO1-DEPT-CODE   
              WHEN 'TWO'
                 MOVE '2' TO BKCPO1-DEPT-CODE   
              WHEN 'THREE'  
                 MOVE '3' TO BKCPO1-DEPT-CODE   
              WHEN 'FOUR'   
                 MOVE '4' TO BKCPO1-DEPT-CODE   
              WHEN 'FIVE'   
                 MOVE '5' TO BKCPO1-DEPT-CODE   
              WHEN 'SIX'
                 MOVE '6' TO BKCPO1-DEPT-CODE   
              WHEN 'SEVEN'  
                 MOVE '7' TO BKCPO1-DEPT-CODE   
              WHEN 'EIGHT'  
                 MOVE '8' TO BKCPO1-DEPT-CODE   
              WHEN 'NINE'   
                 MOVE '9' TO BKCPO1-DEPT-CODE   
              WHEN OTHER
                 CONTINUE   
           END-EVALUATE.

       0400-VALIDATE-SAIL.  

           MOVE BKCPO1-SAIL-DATE         TO TDP01-I-SAIL-DATE-YYYYMMDD. 
           MOVE BKCPO1-SHIP-CODE         TO TDP01-I-SHIP-CODE.  
           MOVE BKCPO1-DURATION-DAYS     TO TDP01-I-DUR-DAYS.   

           PERFORM TDP01-RET-SAIL-DETAILS   
              THRU TDP01-RET-SAIL-DETAILS-EXIT. 

           IF TDP01-SAIL-SQLERR 
              GO TO 9150-RDMS-ERROR 
           END-IF.  

           IF TDP01-SAIL-NOTFND OR  
              TDP01-PROC-ERROR > ZEROES 
              ADD  1                     TO CCMV-ADV-SUB
              MOVE 0010                  TO MSGHDR-ADVISE-CODE  
                                            (CCMV-ADV-SUB)  
              MOVE 'CCR02CPO'            TO MSGHDR-ADVISE-SOURCE
                                            (CCMV-ADV-SUB)  
              PERFORM CCP75-OUTPUT-CCERRMSG 
                 THRU CCP75-OUTPUT-CCERRMSG-EXIT
              GO TO 9000-END-OF-JOB 
           END-IF.  

CCLCOM 0405-CHK-ID. 
CCLCOM      MOVE SPACES TO WSA-MF-OID.  
CCLCOM      EXEC SQL SELECT ORDER_NUM,  
CCLCOM                      SHIP_CODE,  
CCLCOM                      SAIL_ID,
CCLCOM                      ORDER_TOTAL_AMT,
CCLCOM                      OBC_AMT,
CCLCOM                      ORDER_TYPE, 
CCLCOM                      CURRENCY_CODE   
CCLCOM                 INTO WSA-MF-OID, 
CCLCOM                      WSA-SHIP-CODE,  
CCLCOM                      WSA-SAIL-ID,
CCLCOM                      WSA-ORDER-TOTAL-AMT,
CCLCOM                      WSA-OBC-AMT,
CCLCOM                      WSA-ORDER-TYPE, 
CCLCOM                      WSA-CURRENCY-CODE   
CCLCOM                 FROM ORDER_MASTER
CCLCOM                WHERE (HYBRIS_ORDER_ID = :BKCPO1-ORDER-NUM) AND   
CCLCOM                      (CORRELATION_ID = :BKCPO1-CORRELATION-ID)   
CCLCOM      END-EXEC.   
CCLCOM  
CCLCOM      IF SQLCODE < 0  
CCLCOM         GO TO 9150-RDMS-ERROR
CCLCOM      END-IF. 
CCLCOM  
CCLCOM*   Same Hybris order already existing in order master,   
CCLCOM*   hence send the same MF order id in response   
CCLCOM      IF SQLCODE = 0  
CCLCOM        IF WSA-MF-OID > SPACES
CCLCOM           MOVE 0 TO WS-OBC-AMT-RECVD 
CCLCOM           PERFORM VARYING SUB1 FROM 1 BY 1   
CCLCOM              UNTIL SUB1 > CPOBK1-SUB 
CCLCOM              PERFORM VARYING SUB2 FROM 1 BY 1
CCLCOM                UNTIL (SUB2 > CPOOB1-CNT (SUB1))  
CCLCOM                ADD CPOOB1-OBC-AMT (SUB1 SUB2) TO WS-OBC-AMT-RECVD
CCLCOM              END-PERFORM 
CCLCOM           END-PERFORM
CCLCOM  
CCLCOM           IF (TDP01-SAIL-ID = WSA-SAIL-ID) AND   
CCLCOM              (BKCPO1-SHIP-CODE = WSA-SHIP-CODE) AND  
CCLCOM              (BKCPO1-ORDER-TOTAL-AMT = WSA-ORDER-TOTAL-AMT) AND  
CCLCOM              (BKCPO1-ORDER-TYPE = WSA-ORDER-TYPE ) AND   
CCLCOM              (BKCPO1-CURRENCY-CODE = WSA-CURRENCY-CODE) AND  
CCLCOM              (WS-OBC-AMT-RECVD = WSA-OBC-AMT)
CCLCOM                MOVE WSA-MF-OID TO WS-MF-ORDER-NUM
CCLCOM                GO TO 5000-SEND-RESPONSE  
CCLCOM           ELSE   
CCLCOM                ADD 1                     TO CCMV-ADV-SUB 
CCLCOM                MOVE 0021                 TO MSGHDR-ADVISE-CODE   
CCLCOM                                             (CCMV-ADV-SUB)   
CCLCOM                MOVE 'CCR02CPO'           TO MSGHDR-ADVISE-SOURCE 
CCLCOM                                             (CCMV-ADV-SUB)   
CCLCOM                PERFORM CCP75-OUTPUT-CCERRMSG 
CCLCOM                   THRU CCP75-OUTPUT-CCERRMSG-EXIT
CCLCOM                GO TO 9000-END-OF-JOB 
CCLCOM           END-IF 
CCLCOM        END-IF
CCLCOM      END-IF. 
CCLCOM  
CCLCOM      IF SQLCODE = 100
CCLCOM         CONTINUE 
CCLCOM      END-IF. 

       0410-VALIDATE-CURR.  

            IF TDP01-BASE-CURRENCY-CODE NOT = BKCPO1-CURRENCY-CODE  
               ADD  1                     TO CCMV-ADV-SUB   
               MOVE 0017                  TO MSGHDR-ADVISE-CODE 
                                             (CCMV-ADV-SUB) 
               MOVE 'CCR02CPO'            TO MSGHDR-ADVISE-SOURCE   
                                             (CCMV-ADV-SUB) 
               PERFORM CCP75-OUTPUT-CCERRMSG
                  THRU CCP75-OUTPUT-CCERRMSG-EXIT   
               GO TO 9000-END-OF-JOB
           END-IF.  

       0420-PROCESS-ORDER.  

           PERFORM VARYING SUB1 FROM 1 BY 1 
              UNTIL SUB1 > CPOBK1-SUB   
              PERFORM VARYING SUB2 FROM 1 BY 1  
                 UNTIL (SUB2 > CPOOB1-CNT (SUB1))   
                 ADD CPOOB1-OBC-AMT (SUB1 SUB2) TO WS-TOT-OBC-AMT   
              END-PERFORM   
           END-PERFORM. 

           IF WS-TOT-OBC-AMT > BKCPO1-ORDER-TOTAL-AMT   
              ADD  1                     TO CCMV-ADV-SUB
              MOVE 0012                  TO MSGHDR-ADVISE-CODE  
                                            (CCMV-ADV-SUB)  
              MOVE 'CCR02CPO'            TO MSGHDR-ADVISE-SOURCE
                                            (CCMV-ADV-SUB)  
              PERFORM CCP75-OUTPUT-CCERRMSG 
                 THRU CCP75-OUTPUT-CCERRMSG-EXIT
              GO TO 9000-END-OF-JOB 
           END-IF.  

           MOVE 7     TO WS-NUMRTN-TYPE.
           MOVE SPACE TO WS-NUMRTN-COMMAND  
           CALL 'NUMRTN' USING WS-NUMRTN-ORDER-NUM  
                               WS-NUMRTN-TYPE   
                               WS-NUMRTN-COMMAND.   
           STRING '00' WS-NUMRTN-ORDER-NUM  
           DELIMITED BY SIZE INTO WS-MF-ORDER-NUM.  

           EXEC SQL 
                 INSERT INTO ORDER_MASTER   
                        (ORDER_NUM  
                        ,HYBRIS_ORDER_ID
                        ,SHIP_CODE  
                        ,SAIL_ID
                        ,ORDER_TOTAL_AMT
                        ,OBC_AMT
                        ,PAYMENT_AMT
                        ,REFUND_AMT 
                        ,ORDER_STATUS   
                        ,CHARGEBACK_IND 
                        ,HOLD_REFUND_IND
                        ,ORDER_TYPE 
                        ,CURRENCY_CODE  
                        ,CREATION_DATETIME  
                        ,DEPT_CODE  
                        ,PARENT_ORDER_ID
CCLCOM                  ,CORRELATION_ID 
CCLCOM                  ,VC_IND)
                 VALUES (:WS-MF-ORDER-NUM   
                        ,:BKCPO1-ORDER-NUM  
                        ,:BKCPO1-SHIP-CODE  
                        ,:TDP01-SAIL-ID 
                        ,:BKCPO1-ORDER-TOTAL-AMT
                        ,:WS-TOT-OBC-AMT
                        ,NULL   
                        ,NULL   
                        ,'A'
                        ,NULL   
                        ,NULL   
                        ,:BKCPO1-ORDER-TYPE 
                        ,:BKCPO1-CURRENCY-CODE  
                        ,GETUTCDATE ()  
                        ,:BKCPO1-DEPT-CODE  
                        ,NULLIF(:BKCPO1-PARENT-ORD-ID, ' ' )
CCLCOM                  ,:BKCPO1-CORRELATION-ID 
CCLCOM                  ,NULL)  
           END-EXEC.

CCLCOM     PERFORM VARYING SUB1 FROM 1 BY 1 
CCLCOM        UNTIL SUB1 > CPOBK1-SUB   
CCLCOM        PERFORM VARYING SUB2 FROM 1 BY 1  
CCLCOM           UNTIL (SUB2 > CPOOB1-CNT (SUB1))   
CCLCOM           PERFORM 2100-INS-PRODUCT-TYPE THRU 2100-INS-TYPE-EXIT  
CCLCOM        END-PERFORM   
CCLCOM     END-PERFORM. 

           MOVE ZEROES                    TO MAP-SUB.   

       0450-GET-MAPPING-DATA.   

           EXEC SQL DECLARE MAPPING_DATA CURSOR 
                SELECT ITEM_TYPE,   
                       OBC_TYPE_1,  
                       OBC_TYPE_2,  
                       OBC_TYPE_3,  
                       TRANSLATED_NAME  
                FROM ITEM_OBC_MAP_TBL   
           END-EXEC.

           EXEC SQL OPEN MAPPING_DATA END-EXEC. 

       0460-READ-NEXT-MAPPING-DATA. 

           EXEC SQL FETCH NEXT FROM MAPPING_DATA
                INTO :MAP-ITEM-TYPE  ,  
                     :MAP-OBC-TYPE-1 ,  
                     :MAP-OBC-TYPE-2            :WS-OBC-TYPE2-NI ,  
                     :MAP-OBC-TYPE-3            :WS-OBC-TYPE3-NI ,  
                     :MAP-TRANSLATED-NAME   
           END-EXEC.

           IF SQLCODE = 100 
              GO TO 0470-CLOSE-MAPPING-CURSOR   
           END-IF.  

           IF SQLCODE < 0   
              GO TO 9150-RDMS-ERROR 
           END-IF.  

           IF  WS-OBC-TYPE2-NI = WS-NULL-IND
               MOVE SPACES   TO MAP-OBC-TYPE-2  
           END-IF.  

           IF  WS-OBC-TYPE3-NI = WS-NULL-IND
               MOVE SPACES   TO MAP-OBC-TYPE-3  
           END-IF.  

           ADD 1 TO MAP-SUB.

           MOVE MAP-ITEM-TYPE          TO WS-ITEM-TYPE        (MAP-SUB).
           MOVE MAP-OBC-TYPE-1         TO WS-OBC-TYPE-1       (MAP-SUB).
           MOVE MAP-OBC-TYPE-2         TO WS-OBC-TYPE-2       (MAP-SUB).
           MOVE MAP-OBC-TYPE-3         TO WS-OBC-TYPE-3       (MAP-SUB).
           MOVE MAP-TRANSLATED-NAME    TO WS-TRANSLATED-NAME  (MAP-SUB).

           GO TO 0460-READ-NEXT-MAPPING-DATA.   

       0470-CLOSE-MAPPING-CURSOR.   

           EXEC SQL 
              CLOSE MAPPING_DATA
           END-EXEC.

           MOVE 0 TO BSUB   
                     WS-SEQ-NUM.

       0500-PROCESS-BOOKING-DETAILS.

           IF CPOBK1-SUB < 1
              ADD  1                      TO CCMV-ADV-SUB   
              MOVE 0011                   TO MSGHDR-ADVISE-CODE 
                                             (CCMV-ADV-SUB) 
              MOVE 'CCR02CPO'             TO MSGHDR-ADVISE-SOURCE   
                                             (CCMV-ADV-SUB) 
              PERFORM CCP75-OUTPUT-CCERRMSG 
                 THRU CCP75-OUTPUT-CCERRMSG-EXIT
              GO TO 9000-END-OF-JOB 
           END-IF.  

           ADD 1 TO BSUB.   
           IF BSUB > CPOBK1-SUB 
CCLCOM*       GO TO 5000-SEND-RESPONSE  
              GO TO 5000-UPDATE-USER-INFO   
           END-IF.  

           IF CPOBK1-BOOK-NUM (BSUB) NOT > SPACES   
              ADD  1                      TO CCMV-ADV-SUB   
              MOVE 0011                   TO MSGHDR-ADVISE-CODE 
                                             (CCMV-ADV-SUB) 
              MOVE 'CCR02CPO'             TO MSGHDR-ADVISE-SOURCE   
                                             (CCMV-ADV-SUB) 
              PERFORM CCP75-OUTPUT-CCERRMSG 
                 THRU CCP75-OUTPUT-CCERRMSG-EXIT
              GO TO 9000-END-OF-JOB 
           END-IF.  

           MOVE CPOBK1-BOOK-NUM (BSUB) TO GBR1-BOOK-NUM 
                                          WS-BOOK-NUM.  
           MOVE 'N'                    TO WS-GRP-BOOK-IND.  
           FETCH GRP1-BOOKING-REC RECORD ON ERROR   
                 GO TO 0550-CHECK-ERROR 
           MOVE 'Y'                    TO WS-GRP-BOOK-IND   
           IF GBR1-SAIL-DATE     = BKCPO1-SAIL-DATE AND 
              GBR1-SHIP-CODE     = BKCPO1-SHIP-CODE AND 
              GBR1-DURATION-DAYS = BKCPO1-DURATION-DAYS 
              CONTINUE  
           ELSE 
              ADD  1                      TO CCMV-ADV-SUB   
              MOVE 0018                   TO MSGHDR-ADVISE-CODE 
                                             (CCMV-ADV-SUB) 
              MOVE 'CCR02CPO'             TO MSGHDR-ADVISE-SOURCE   
                                             (CCMV-ADV-SUB) 
              PERFORM CCP75-OUTPUT-CCERRMSG 
                 THRU CCP75-OUTPUT-CCERRMSG-EXIT
              GO TO 9000-END-OF-JOB 
           END-IF.  

             GO TO 0600-PROCESS-BOOKING.

       0550-CHECK-ERROR.

           IF ERROR-NUM NOT = '0007' AND '0013' 
              MOVE 0006                  TO MSGHDR-ADVISE-CODE (1)  
              PERFORM CCP75-OUTPUT-CCERRMSG 
                 THRU CCP75-OUTPUT-CCERRMSG-EXIT
              GO TO 9000-END-OF-JOB 
           END-IF.  

           PERFORM 3000-CALL-RSO23  
              THRU 3000-CALL-RSO23-EXIT.

           IF RSP06-IBR-SAIL-DATE = BKCPO1-SAIL-DATE AND
              RSP06-IBR-SHIP-CODE = BKCPO1-SHIP-CODE AND
              RSP06-IBR-DURATION-DAYS = BKCPO1-DURATION-DAYS
              CONTINUE  
           ELSE 
              ADD  1                      TO CCMV-ADV-SUB   
              MOVE 0018                   TO MSGHDR-ADVISE-CODE 
                                             (CCMV-ADV-SUB) 
              MOVE 'CCR02CPO'             TO MSGHDR-ADVISE-SOURCE   
                                             (CCMV-ADV-SUB) 
              PERFORM CCP75-OUTPUT-CCERRMSG 
                 THRU CCP75-OUTPUT-CCERRMSG-EXIT
              GO TO 9000-END-OF-JOB 
           END-IF.  

       0600-PROCESS-BOOKING.

           EXEC SQL 
                 INSERT INTO BOOKING_ORDER  
                        (BOOK_NUM   
                        ,ORDER_NUM) 
                 VALUES (:CPOBK1-BOOK-NUM (BSUB)
                        ,:WS-MF-ORDER-NUM)  
           END-EXEC.

           IF (BKCPO1-ORDER-TYPE = 'P')  OR 
              ((BKCPO1-DEPT-CODE = '5') AND 
                               (BKCPO1-ORDER-TYPE = 'C' OR 'A'))
              PERFORM 1500-ADD-COURTESY-ORD-AMT THRU 1500-EXIT  
           END-IF.  

           MOVE ZEROES TO WS-TOT-BKG-OBC-AMT.   
           PERFORM VARYING SUB1 FROM 1 BY 1 
                UNTIL (SUB1 > CPOOB1-CNT (BSUB))
                ADD CPOOB1-OBC-AMT (BSUB SUB1) TO WS-TOT-BKG-OBC-AMT
           END-PERFORM. 

           IF WS-TOT-BKG-OBC-AMT NOT > ZEROES   
              GO TO 0500-PROCESS-BOOKING-DETAILS
           END-IF.  

           IF (RSP06-IBR-OBC-SAILING-AMT NOT > 0)   
              ADD 1                TO CCMV-ADV-SUB  
              MOVE 0015            TO MSGHDR-ADVISE-CODE
                                      (CCMV-ADV-SUB)
              MOVE 'CCR02CPO'      TO MSGHDR-ADVISE-SOURCE  
                                      (CCMV-ADV-SUB)
              PERFORM CCP75-OUTPUT-CCERRMSG 
                 THRU CCP75-OUTPUT-CCERRMSG-EXIT
              GO TO 9000-END-OF-JOB 
           END-IF.  

           MOVE 0 TO WS-O-OBC-ENTRY-CNT 
                     WS-ORDER-ENTRY-CNT 
                     WS-ENTRY-CNT.  
           PERFORM 3200-GET-OFFERED-OBC THRU 3200-EXIT  
             VARYING RSP06-PAX-SUB FROM 1 BY 1  
               UNTIL RSP06-PAX-SUB > RSP06-PAX-CNT. 
           IF (WS-O-OBC-ENTRY-CNT NOT > 0)  
              ADD 1                TO CCMV-ADV-SUB  
              MOVE 0015            TO MSGHDR-ADVISE-CODE
                                      (CCMV-ADV-SUB)
              MOVE 'CCR02CPO'      TO MSGHDR-ADVISE-SOURCE  
                                      (CCMV-ADV-SUB)
              PERFORM CCP75-OUTPUT-CCERRMSG 
                 THRU CCP75-OUTPUT-CCERRMSG-EXIT
              GO TO 9000-END-OF-JOB 
           END-IF.  

           PERFORM 3700-REARRANGE-OUTPUT
              THRU 3700-EXIT.   

           PERFORM 3800-FIND-ORDERS 
              THRU 3800-EXIT.   

           PERFORM 3900-APPLY-OBC   
              THRU 3900-EXIT.   

            MOVE 0 TO OBCSUB.   

       1000-PROCESS-BOOKING-OBC.

           ADD 1 TO OBCSUB. 

           IF OBCSUB > CPOOB1-CNT (BSUB)
              GO TO 0500-PROCESS-BOOKING-DETAILS
           END-IF.  

           IF CPOOB1-OBC-AMT (BSUB OBCSUB) NOT > ZEROES 
              GO TO 1000-PROCESS-BOOKING-OBC
           END-IF.  

           MOVE 'N'         TO WS-OBC-MATCH.
           EXEC SQL 
                SELECT TRANSLATED_NAME  
                FROM ITEM_OBC_MAP_TBL   
                WHERE ITEM_TYPE =   
                      :CPOOB1-ITEM-TYPE (BSUB OBCSUB)   
                INTO WS-TRANS-NAME  
           END-EXEC.

           MOVE CPOOB1-OBC-AMT (BSUB OBCSUB) TO WS-OBC-REQ-AMT. 

           PERFORM VARYING SUB FROM 1 BY 1  
             UNTIL SUB > WS-O-OBC-ENTRY-CNT OR  
                   (WS-OBC-REQ-AMT <= 0)
                IF WS-O-TRANSLATED-NAME (SUB) = 
                                         WS-TRANS-NAME OR   
                   WS-O-TRANSLATED-NAME (SUB) = 'GENERAL'   
                   IF WS-O-REMAINING-OBC-AMT (SUB)  >=  
                      WS-OBC-REQ-AMT
                      COMPUTE WS-O-REMAINING-OBC-AMT (SUB) =
                       WS-O-REMAINING-OBC-AMT (SUB) - WS-OBC-REQ-AMT
                       MOVE ZEROES TO WS-OBC-REQ-AMT
                   ELSE 
                      COMPUTE WS-OBC-REQ-AMT = WS-OBC-REQ-AMT - 
                       WS-O-REMAINING-OBC-AMT (SUB) 
                       MOVE ZEROES TO WS-O-REMAINING-OBC-AMT (SUB)  
                   END-IF   
                END-IF  
           END-PERFORM. 

           IF WS-OBC-REQ-AMT > 0
              ADD 1                TO CCMV-ADV-SUB  
              MOVE 0019            TO MSGHDR-ADVISE-CODE
                                      (CCMV-ADV-SUB)
              MOVE 'CCR02CPO'      TO MSGHDR-ADVISE-SOURCE  
                                      (CCMV-ADV-SUB)
              PERFORM CCP75-OUTPUT-CCERRMSG 
                 THRU CCP75-OUTPUT-CCERRMSG-EXIT
              GO TO 9000-END-OF-JOB 
           END-IF.  

           MOVE 'N'   TO  WS-OBC-TYP-FND.   

           EXEC SQL 
                SELECT SEQ_NUM  
                  INTO :WS-ORD-SEQ  
                  FROM ORDER_OBC_DETAIL 
                 WHERE ORDER_NUM  = :WS-MF-ORDER-NUM AND
                       BOOK_NUM  = :CPOBK1-BOOK-NUM (BSUB) AND  
                     PRESALE_ITEM_TYPE = :CPOOB1-ITEM-TYPE (BSUB OBCSUB)
           END-EXEC.

           IF SQLCODE < 0   
              GO TO 9150-RDMS-ERROR 
           END-IF.  

           IF SQLCODE = 100 
              CONTINUE  
           ELSE 
              MOVE 'Y'         TO WS-OBC-TYP-FND
           END-IF.  

           IF WS-OBC-TYP-FND = 'N'  
              ADD 1 TO WS-SEQ-NUM   
              EXEC SQL  
                   INSERT INTO ORDER_OBC_DETAIL 
                          (ORDER_NUM
                          ,SEQ_NUM  
                          ,BOOK_NUM 
                          ,OBC_AMT  
                          ,PRESALE_ITEM_TYPE)   
                    VALUES (:WS-MF-ORDER-NUM
                          ,:WS-SEQ-NUM  
                          ,:CPOBK1-BOOK-NUM (BSUB)  
                          ,NULLIF(:CPOOB1-OBC-AMT (BSUB OBCSUB),0)  
                          ,NULLIF(:CPOOB1-ITEM-TYPE (BSUB OBCSUB),' ')) 
              END-EXEC  
           ELSE 
              EXEC SQL  
                   UPDATE ORDER_OBC_DETAIL  
                      SET OBC_AMT = IFNULL(OBC_AMT,0) + 
                                      :CPOOB1-OBC-AMT (BSUB OBCSUB) 
                    WHERE ORDER_NUM = :WS-MF-ORDER-NUM AND  
                            SEQ_NUM = :WS-ORD-SEQ   
              END-EXEC  
           END-IF.  

           GO TO  1000-PROCESS-BOOKING-OBC. 

       1500-ADD-COURTESY-ORD-AMT.   

           MOVE ZEROES TO  WS-ORDER-ITEM-AMT WS-ORDER-SRVCH-AMT.

           PERFORM VARYING SUB2 FROM 1 BY 1 
              UNTIL SUB2 >  CPOOB1-CNT (BSUB)   
              ADD CPOOB1-ITEM-TOTAL-AMT (BSUB SUB2) 
                                               TO WS-ORDER-ITEM-AMT 
              ADD CPOOB1-ITEM-SURCHARGE-AMT (BSUB SUB2) 
                                               TO WS-ORDER-SRVCH-AMT
           END-PERFORM. 

           MOVE SPACES                         TO WS-IBR-CABIN-NUM. 
           IF WS-GRP-BOOK-IND NOT = 'Y' 
              IF RSP06-IBR-BOOK-TYPE = 'I'  
                 MOVE RSP06-IBR-BOOK-NUM       TO IBR-BOOK-NUM  
                 PERFORM IRP66-FETCH-IBR THRU IRP66-FETCH-IBR-EXIT  
                 MOVE IBR-SHIP-CODE            TO WS-SHIP-CODE  
                 MOVE IBR-SAIL-DATE            TO WS-SAIL-DATE  
                 MOVE IBR-DURATION-DAYS        TO WS-DUR-DAYS   
                 IF BKCPO1-ORDER-TYPE = 'P' 
                    COMPUTE IBR-COURTESY-ORDER-AMT =
                        IBR-COURTESY-ORDER-AMT + WS-ORDER-ITEM-AMT  
                    COMPUTE WS-CO-AMT ROUNDED   
                        =   WS-ORDER-ITEM-AMT   
                          * IBR-PRC-XCHG-RATE   
                    ADD WS-CO-AMT              TO IBR-NET-FARE-AMT  
                    COMPUTE WS-PAYMENT-AMT = IBR-CABIN-UCC-PMT-AMT    + 
                                             IBR-CABIN-CASH-PMT-AMT   + 
                                             IBR-CABIN-OTHER-PMT-AMT  + 
                                             IBR-ALLOC-UCC-PMT-AMT    + 
                                             IBR-ALLOC-CASH-PMT-AMT   + 
                                             IBR-ALLOC-OTHER-PMT-AMT

                    IF WS-PAYMENT-AMT < IBR-DEPOSIT-AMT 
                       MOVE ZERO TO IBR-DEP-PAID-IND
                    ELSE
                       MOVE 1    TO IBR-DEP-PAID-IND
                    END-IF  
                    IF WS-PAYMENT-AMT < IBR-NET-FARE-AMT
                       MOVE ZERO TO IBR-FP-PAID-IND 
                    ELSE
                       MOVE 1    TO IBR-FP-PAID-IND 
                    END-IF  
                    IF IBR-NET-FARE-AMT NOT = ZEROES
                       MOVE ZERO TO WS-IBR-NET-FARE-AMT-NI  
                    ELSE
                       MOVE -1   TO WS-IBR-NET-FARE-AMT-NI  
                    END-IF  
                    FIND CURRENT INDV-BOOKING-REC RECORD
                    PERFORM IRP66-MODIFY-IBR THRU IRP66-MODIFY-IBR-EXIT 
                    PERFORM DPP16-MODIFY-SAIL-INDIVIDUAL
                       THRU DPP16-EXIT  
                 END-IF 
                 MOVE 'SSA'                 TO DPP04-HIST-ACTIVITY-TYPE 
                 IF BKCPO1-ORDER-TYPE = 'P' 
                    MOVE WS-ORDER-ITEM-AMT  TO DPP04-HIST-AMT   
                    MOVE 'Y'             TO DPP04-OVERRIDE-HIST-AMT-IND 
                    COMPUTE WS-TRF-AMT ROUNDED  
                          = WS-ORDER-ITEM-AMT * IBR-PRC-XCHG-RATE   
                    MOVE WS-TRF-AMT       TO DPP04-TRF-AMT  
                 ELSE   
                    MOVE 0                TO DPP04-HIST-AMT 
                                             DPP04-TRF-AMT  
                    MOVE 'N'              TO DPP04-OVERRIDE-HIST-AMT-IND
                 END-IF 
                 MOVE BKCPO1-ORDER-NUM    TO WS-HYB-ORDER-NUM   
                 MOVE SPACES              TO DPP04-HIST-COMMENT 
                 STRING IBR-CABIN-NUM DELIMITED BY SPACES   
CCLCOM*          ' ORDER: ' WS-MF-ORDER-NUM 
CCLCOM           ' ORDER: ' BKCPO1-ORDER-NUM
                 DELIMITED BY SIZE INTO DPP04-HIST-COMMENT  
                 IF BKCPO1-ORDER-TYPE = 'P' 
                    MOVE IBR-AGENT-CONTACT  TO DPP04-HIST-CONTACT   
                 ELSE   
                    MOVE SPACE TO WS-COMMENT-TXT
                    IF BKCPO1-ORDER-TYPE = 'C'  
                       MOVE 'CMP'           TO WS-COMMENT-TXT   
                    ELSE
                       IF BKCPO1-ORDER-TYPE = 'A'   
                          MOVE 'AME'        TO WS-COMMENT-TXT   
                       END-IF   
                    END-IF  
                    MOVE SPACE TO DPP04-HIST-CONTACT
                    MOVE WS-ORDER-ITEM-AMT  TO WS-DOLAR-AMT 
                    MOVE 0 TO WS-TALLY  
                    INSPECT WS-DOLAR-AMT TALLYING   
                    WS-TALLY FOR LEADING SPACES 
                    COMPUTE WS-LENGTH = 
                        FUNCTION LENGTH (WS-DOLAR-AMT) - WS-TALLY   
                    STRING WS-DOLAR-AMT (WS-TALLY + 1 : WS-LENGTH) ' '  
                    DELIMITED BY SIZE   
                    WS-COMMENT-TXT DELIMITED BY SPACE   
                    INTO DPP04-HIST-CONTACT 
                 END-IF 
                 MOVE WS-USER-INFO          TO DPP04-HIST-OPER-INITIAL  
                 MOVE 0                     TO DPP04-HIST-PAX-SEQ-NUM   
                 MOVE SPACE                 TO DPP04-HIST-TYPE  
                 MOVE DPP04-HIST-COMMENT    TO DPP04-TRF-COMMENT1   
                 MOVE IBR-SAIL-DATE         TO DPP04-TRF-SAIL-DATE  
                 MOVE IBR-SHIP-CODE         TO DPP04-TRF-SHIP-CODE  
                 MOVE IBR-DURATION-DAYS     TO DPP04-TRF-DURATION-DAYS  
                 MOVE IBR-CABIN-NUM         TO DPP04-TRF-CABIN-NUM  
                 MOVE 0                     TO DPP04-TRF-PAX-SEQ-NUM
                 MOVE SSP18-O-NTUR-LOC-CODE TO DPP04-TRF-LOCATION-CODE  
                 MOVE 'IR'                  TO  
                                            DPP04-HIST-AGENCY-CONN-CODE 
                 MOVE 15                    TO DPP42-HOLD-MSG-INDEX 
                 PERFORM IRP15-CREATE-BOOKING-HISTORY   
                    THRU IRP15-TRF-EXIT 
                 MOVE IBR-CABIN-NUM         TO WS-IBR-CABIN-NUM 
                 IF BKCPO1-ORDER-TYPE = 'P' 
                    PERFORM 4000-GET-SAILING-INFO   
                    THRU 4000-SAILING-INFO-EXIT 
                    PERFORM 4000-CREATE-GML-ENTRY   
                    THRU 4000-GML-ENTRY-EXIT
                 END-IF 
              ELSE  
                 MOVE RSP06-IBR-GROUP-BOOK-NUM TO GBR1-BOOK-NUM 
                 FETCH GRP1-BOOKING-REC RECORD  
                 MOVE GBR1-BOOK-NUM TO WS-BOOK-NUM  
                 MOVE RSP06-IBR-CABIN-NUM   TO WS-IBR-CABIN-NUM 
              END-IF
           END-IF.  

           IF RSP06-IBR-BOOK-TYPE = 'G' OR WS-GRP-BOOK-IND = 'Y'
             IF BKCPO1-ORDER-TYPE = 'P' 
              COMPUTE GBR1-COURTESY-ORDER-AMT = 
                    GBR1-COURTESY-ORDER-AMT + WS-ORDER-ITEM-AMT 
              COMPUTE WS-CO-AMT ROUNDED 
                  =   WS-ORDER-ITEM-AMT 
                    * GBR1-PRC-XCHG-RATE
              ADD WS-CO-AMT               TO GBR1-NET-FARE-AMT  
190115        IF GBR1-FINANCIAL-COMPANY-CODE = 'A'  
190115           COMPUTE WS-EFF-INCL-GST-PCT =  
190115                           ((GBR1-12NM-PCT * GBR1-GST-PCT)
190115                           / (1 + (GBR1-12NM-PCT * GBR1-GST-PCT)))
190115           COMPUTE WS-GBR1-COURTESY-GST-AMT = 
190115                   WS-CO-AMT  * WS-EFF-INCL-GST-PCT   
190115           ADD WS-GBR1-COURTESY-GST-AMT TO GBR1-TOTAL-GST-AMT 
190115        END-IF
              MOVE WS-SYS-DATETIME        TO GBR1-UPDATE-DATETIME   
              FIND CURRENT GRP1-BOOKING-REC RECORD  
              MODIFY GRP1-BOOKING-REC RECORD
               MOVE GBR1-SHIP-CODE         TO WS-SHIP-CODE  
               MOVE GBR1-SAIL-DATE         TO WS-SAIL-DATE  
               MOVE GBR1-DURATION-DAYS     TO WS-DUR-DAYS   
               MOVE GBR1-UPDATE-DATETIME   TO WS-SYS-DATETIME   
               MOVE WS-SYS-DATETIME(1:4)   TO WS-UPDATE-YEAR
               MOVE WS-SYS-DATETIME(5:2)   TO WS-UPDATE-MONTH   
               MOVE WS-SYS-DATETIME(7:2)   TO WS-UPDATE-DAY-DATE
               MOVE WS-SYS-DATETIME(9:2)   TO WS-UPDATE-HOUR
               MOVE WS-SYS-DATETIME(11:2)  TO WS-UPDATE-MINUTE  
               MOVE WS-SYS-DATETIME(13:2)  TO WS-UPDATE-SECOND  
               MOVE WS-SYS-DATETIME(15:2)  TO WS-UPDATE-MILISEC 
               EXEC SQL UPDATE GROUP_SUMMARY
               SET GSR_UPDATE_DATETIME = :WS-UPDATE-DATETIME
                   WHERE (GSR_BOOK_NUM = :GBR1-BOOK-NUM AND 
                       GSR_UPDATE_DATETIME <> :WS-UPDATE-DATETIME)  
               END-EXEC 
               IF  SQLCODE < 0  
                   GO TO 9150-RDMS-ERROR
               END-IF   
               IF  SQLCODE = 100
                   CONTINUE 
               END-IF   
             END-IF 
               MOVE 'SSA'                   TO GRP15-ACTIVITY-CODE  
               IF BKCPO1-ORDER-TYPE = 'P'   
                 MOVE WS-ORDER-ITEM-AMT     TO GRP15-AMT
                 MOVE 'Y'                   TO GRP15-OVERRIDE-HIST-AMT  
                 COMPUTE WS-TRF-AMT ROUNDED 
                       = WS-ORDER-ITEM-AMT  * GBR1-PRC-XCHG-RATE
                 MOVE WS-TRF-AMT            TO GRP15-TRF-AMT
               ELSE 
                 MOVE 0                     TO GRP15-AMT
                                               GRP15-TRF-AMT
                 MOVE 'N'                   TO GRP15-OVERRIDE-HIST-AMT  
               END-IF   

               MOVE WS-USER-INFO            TO GRP15-USERID 
               MOVE SPACES                  TO GRP15-COMMENT
               STRING WS-IBR-CABIN-NUM DELIMITED BY SPACES  
CCLCOM*        ' ORDER: ' WS-MF-ORDER-NUM   
CCLCOM         ' ORDER: ' BKCPO1-ORDER-NUM  
               DELIMITED BY SIZE INTO GRP15-COMMENT 

               IF BKCPO1-ORDER-TYPE = 'P'   
                  MOVE GBR1-AGENT-CONTACT      TO GRP15-AGENCY-CONTACT  
               ELSE 
                  MOVE SPACE TO WS-COMMENT-TXT  
                  IF BKCPO1-ORDER-TYPE = 'C'
                     MOVE 'CMP' TO WS-COMMENT-TXT   
                  ELSE  
                     IF BKCPO1-ORDER-TYPE = 'A' 
                        MOVE 'AME' TO WS-COMMENT-TXT
                     END-IF 
                  END-IF
                  MOVE SPACE TO GRP15-AGENCY-CONTACT
                  MOVE WS-ORDER-ITEM-AMT TO WS-DOLAR-AMT
                  MOVE 0 TO WS-TALLY
                  INSPECT WS-DOLAR-AMT TALLYING 
                  WS-TALLY FOR LEADING SPACES   
                  COMPUTE WS-LENGTH =   
                      FUNCTION LENGTH (WS-DOLAR-AMT) - WS-TALLY 
                  STRING WS-DOLAR-AMT (WS-TALLY + 1 : WS-LENGTH) ' '
                  DELIMITED BY SIZE 
                  WS-COMMENT-TXT DELIMITED BY SPACE 
                    INTO GRP15-AGENCY-CONTACT   
               END-IF   

               MOVE 0                       TO GRP15-PAX-SEQ-NUM
               MOVE SPACE                   TO GRP15-TYPE   
               MOVE GRP15-COMMENT           TO GRP15-TRF-COMMENT1   
               MOVE WS-IBR-CABIN-NUM        TO GRP15-CABIN-NUM  
               MOVE SSP18-O-NTUR-LOC-CODE   TO GRP15-LOCATION-CODE  
               MOVE 'ER'                    TO GRP15-AGENCY-CONNECT-CODE
               PERFORM GRP15-CREATE-BOOKING-HISTORY 
                  THRU GRP15-GTRF-EXIT  
               IF BKCPO1-ORDER-TYPE = 'P'   
                  PERFORM 4000-GET-SAILING-INFO 
                     THRU 4000-SAILING-INFO-EXIT
                  PERFORM 4000-CREATE-GML-ENTRY 
                     THRU 4000-GML-ENTRY-EXIT   
               END-IF   
           END-IF.  

       1500-EXIT.   
           EXIT.

CCLCOM 2100-INS-PRODUCT-TYPE.   
CCLCOM     MOVE CPOOB1-ITEM-TYPE (SUB1 SUB2)  TO WS-PRODUCT-TYPE.   
CCLCOM     MOVE SPACES                        TO WS-PRODUCT-SUB-TYPE
CCLCOM                                           WS-PRODUCT-ORDER-NUM.  
CCLCOM  
CCLCOM     IF WS-PRODUCT-TYPE NOT = 'EX' OR 'SP'
CCLCOM        MOVE 'FS'    TO WS-PRODUCT-TYPE   
CCLCOM        MOVE CPOOB1-ITEM-TYPE (SUB1 SUB2) TO WS-PRODUCT-SUB-TYPE  
CCLCOM     END-IF.  
CCLCOM  
CCLCOM     EXEC SQL 
CCLCOM          SELECT ORDER_NUMBER 
CCLCOM            INTO :WS-PRODUCT-ORDER-NUM
CCLCOM            FROM ORDER_PRODUCT_TYPE   
CCLCOM           WHERE ORDER_NUMBER     = :WS-MF-ORDER-NUM  
CCLCOM             AND PRODUCT_TYPE     = :WS-PRODUCT-TYPE  
CCLCOM             AND PRODUCT_SUB_TYPE = :WS-PRODUCT-SUB-TYPE  
CCLCOM           FETCH FIRST 1 ROW ONLY 
CCLCOM     END-EXEC.
CCLCOM  
CCLCOM     IF SQLCODE < 0   
CCLCOM        GO TO 9150-RDMS-ERROR 
CCLCOM     END-IF.  
CCLCOM  
CCLCOM     IF SQLCODE = 100 
CCLCOM        CONTINUE  
CCLCOM     END-IF.  
CCLCOM  
CCLCOM     IF WS-PRODUCT-ORDER-NUM > SPACES 
CCLCOM        GO TO 2100-INS-TYPE-EXIT  
CCLCOM     END-IF.  
CCLCOM  
CCLCOM     EXEC SQL 
CCLCOM          INSERT  
CCLCOM            INTO ORDER_PRODUCT_TYPE   
CCLCOM                (ORDER_NUMBER 
CCLCOM                ,PRODUCT_TYPE 
CCLCOM                ,PRODUCT_SUB_TYPE)
CCLCOM         VALUES (:WS-MF-ORDER-NUM 
CCLCOM                ,:WS-PRODUCT-TYPE 
CCLCOM                ,NULLIF(:WS-PRODUCT-SUB-TYPE, ' '))   
CCLCOM     END-EXEC.
CCLCOM  
CCLCOM 2100-INS-TYPE-EXIT.  
CCLCOM     EXIT.

       3000-CALL-RSO23. 
           COPY RSP23INT.   

           MOVE CPOBK1-BOOK-NUM (BSUB)    TO RSP23-I-INDV-BOOK-NUM. 
           MOVE 'A'                       TO RSP23-I-BOOK-TYPE. 
           MOVE ZERO                      TO DPP01-SUB-MSG-CTR. 

           MOVE 'Y'                    TO RSP23-I-READ-POBC-IND 
                                          RSP23-I-READ-PAX-IND  
                                          RSP23-I-READ-IFR-IND  
                                          RSP23-I-READ-PICF-IND 
                                          RSP23-I-READ-PXFR-IND 
                                          RSP23-I-READ-PTFR-IND 
                                          RSP23-I-READ-PPR-IND  
                                          RSP23-I-READ-TIR-IND  
                                          RSP23-I-READ-CXP-GUEST-IND
                                          RSP23-I-READ-PPIR-IND 
                                          RSP23-I-READ-WAITLIST-IND 
                                          RSP23-I-READ-CIF-IND  
                                          RSP23-I-READ-IBPIR-IND
                                          RSP23-I-READ-I-TOAR-IND   
                                          RSP23-I-READ-PPHOR-IND
                                          RSP23-I-READ-POBC-IND 
                                          RSP23-I-READ-GST-OFR-IND  
                                          RSP23-I-READ-GST-OFR-QUL-IND  
                                          RSP23-I-READ-IBR-IND. 

           CALL 'RSO23RGC' USING DPP01-COMMON-DATA-FIELDS   
                                 DPP01-COMMON-INFO  
                                 RSP23-RGC-INPUT
                                 RSP06-GUEST-CABIN-INFO.

           IF  DPP01-SUB-MSG-CTR > 0 AND
               DPP01-SUB-MSG-STATUS (1) > 1 
               GO TO DPP12-RETURN-SUBROUTINE-ERROR  
           END-IF.  

       3000-CALL-RSO23-EXIT.
           EXIT.

       3200-GET-OFFERED-OBC.

           IF  RSP06-POBC-EXIST-IND (RSP06-PAX-SUB) = 'Y'   
               PERFORM VARYING POBC-SUB FROM 1 BY 1 
                   UNTIL POBC-SUB > RSP06-POBC-ENTRY-CNT
                                       (RSP06-PAX-SUB)  
                   PERFORM 3400-CHECK-VALID-FOR-PRESALES THRU 3400-EXIT 
                   IF WS-VALID-OBC = 'Y'
                      PERFORM 3600-ADD-TO-OFFERED-OBC THRU 3600-EXIT
                   END-IF   
                END-PERFORM 
           END-IF.  

       3200-EXIT.   
           EXIT.

       3400-CHECK-VALID-FOR-PRESALES.   

           MOVE RSP06-POBC-OBC-CODE (RSP06-PAX-SUB POBC-SUB)
                                    TO OBC-CODE.

           FETCH OBC-MASTER-REC RECORD  
                 ON ERROR GO TO 9100-DATABASE-ERROR.

           MOVE 'N'                 TO WS-VALID-OBC 
           MOVE SPACES              TO WS-TNAME.

           IF OBC-DEPT-CODE(1) NOT > SPACES 
              MOVE 'Y'              TO WS-VALID-OBC 
              MOVE 'GENERAL'        TO OBC-DEPT-CODE(1) 
                                       WS-TNAME 
              GO TO 3400-EXIT   
           END-IF.  

           PERFORM VARYING SUB FROM 1 BY 1 UNTIL SUB > MAP-SUB  
              IF (OBC-DEPT-CODE(1) = WS-OBC-TYPE-1 (SUB)) OR
                 (OBC-DEPT-CODE(1) = WS-OBC-TYPE-2 (SUB)) OR
                 (OBC-DEPT-CODE(1) = WS-OBC-TYPE-3 (SUB))   
                 MOVE 'Y'           TO WS-VALID-OBC 
                 MOVE WS-TRANSLATED-NAME (SUB)  
                                    TO WS-TNAME 
                 MOVE MAP-SUB       TO SUB  
              END-IF
           END-PERFORM. 

       3400-EXIT.   
           EXIT.

       3600-ADD-TO-OFFERED-OBC. 

           IF WS-O-OBC-ENTRY-CNT NOT > 0
              MOVE 1                   TO WS-O-OBC-ENTRY-CNT
              MOVE OBC-DEPT-CODE(1) TO WS-O-OBC-DEPT-CODE   
                                          (WS-O-OBC-ENTRY-CNT)  
              MOVE WS-TNAME            TO WS-O-TRANSLATED-NAME  
                                          (WS-O-OBC-ENTRY-CNT)  
              MOVE OBC-REFUND-IND      TO WS-O-OBC-REFUNDABLE-IND   
                                          (WS-O-OBC-ENTRY-CNT)  
              MOVE RSP06-POBC-SAILING-AMT (RSP06-PAX-SUB POBC-SUB)  
                                       TO WS-O-OFFERED-OBC-AMT  
                                          (WS-O-OBC-ENTRY-CNT)  
                                          WS-O-REMAINING-OBC-AMT
                                          (WS-O-OBC-ENTRY-CNT)  
              MOVE ZEROS               TO WS-O-APPLIED-OBC-AMT  
                                          (WS-O-OBC-ENTRY-CNT)  
              GO TO 3600-EXIT   
           ELSE 
              MOVE 'N'                 TO WS-ENTRY-FOUND
              PERFORM VARYING SUB FROM 1 BY 1   
                  UNTIL SUB > WS-O-OBC-ENTRY-CNT
                  IF (OBC-DEPT-CODE(1) = WS-O-OBC-DEPT-CODE (SUB)) AND  
                     (OBC-REFUND-IND = WS-O-OBC-REFUNDABLE-IND (SUB))   
                     MOVE 'Y'          TO WS-ENTRY-FOUND
                     ADD RSP06-POBC-SAILING-AMT (RSP06-PAX-SUB POBC-SUB)
                                       TO WS-O-OFFERED-OBC-AMT  (SUB)   
                                          WS-O-REMAINING-OBC-AMT (SUB)  
                     MOVE WS-O-OBC-ENTRY-CNT
                                       TO SUB   
                  END-IF
               END-PERFORM  

               IF WS-ENTRY-FOUND = 'N'  
                  ADD 1                  TO WS-O-OBC-ENTRY-CNT  
                  MOVE OBC-DEPT-CODE(1)  TO WS-O-OBC-DEPT-CODE  
                                            (WS-O-OBC-ENTRY-CNT)
                  MOVE WS-TNAME          TO WS-O-TRANSLATED-NAME
                                            (WS-O-OBC-ENTRY-CNT)
                  MOVE OBC-REFUND-IND    TO WS-O-OBC-REFUNDABLE-IND 
                                            (WS-O-OBC-ENTRY-CNT)
                  MOVE RSP06-POBC-SAILING-AMT (RSP06-PAX-SUB POBC-SUB)  
                                         TO WS-O-OFFERED-OBC-AMT
                                            (WS-O-OBC-ENTRY-CNT)
                                            WS-O-REMAINING-OBC-AMT  
                                            (WS-O-OBC-ENTRY-CNT)
                  MOVE ZEROS             TO WS-O-APPLIED-OBC-AMT
                                            (WS-O-OBC-ENTRY-CNT)
               ELSE 
                  GO TO 3600-EXIT   
               END-IF   
           END-IF.  

       3600-EXIT.   
           EXIT.

       3700-REARRANGE-OUTPUT.   
           MOVE ZEROS               TO WS-HCNT. 

      *Grouping non-refundable entries first.   

           PERFORM VARYING SUB FROM 1 BY 1  
               UNTIL SUB > WS-O-OBC-ENTRY-CNT   
               IF WS-O-OBC-REFUNDABLE-IND (SUB) = 'N'   
                  ADD 1             TO WS-HCNT  
                  IF WS-HCNT > 1
                     IF WS-O-OBC-DEPT-CODE (SUB) NOT = 'GENERAL' AND
                        WS-HOLD-OBC-DEPT-CODE (WS-HCNT - 1) = 'GENERAL' 
                        MOVE WS-HOLD-ENTRY (WS-HCNT - 1)
                                    TO WS-HOLD-ENTRY (WS-HCNT)  
                        MOVE WS-O-OBC-ENTRY (SUB)   
                                    TO WS-HOLD-ENTRY (WS-HCNT - 1)  
                     ELSE   
                        MOVE WS-O-OBC-ENTRY (SUB)   
                                    TO WS-HOLD-ENTRY (WS-HCNT)  
                     END-IF 
                  ELSE  
                     MOVE WS-O-OBC-ENTRY (SUB)  
                                   TO WS-HOLD-ENTRY (WS-HCNT)   
                  END-IF
               END-IF   
           END-PERFORM. 

      *Grouping refundable entries. 

           PERFORM VARYING SUB FROM 1 BY 1  
               UNTIL SUB > WS-O-OBC-ENTRY-CNT   
               IF WS-O-OBC-REFUNDABLE-IND (SUB) = 'Y'   
                  ADD 1             TO WS-HCNT  
                  IF WS-HCNT > 1
                     IF WS-O-OBC-DEPT-CODE (SUB) NOT = 'GENERAL' AND
                        (WS-HOLD-OBC-DEPT-CODE (WS-HCNT - 1) = 'GENERAL'
                                         AND
                        WS-HOLD-OBC-REFUNDABLE-IND (WS-HCNT - 1) = 'Y') 
                        MOVE WS-HOLD-ENTRY (WS-HCNT - 1)
                                    TO WS-HOLD-ENTRY (WS-HCNT)  
                        MOVE WS-O-OBC-ENTRY (SUB)   
                                    TO WS-HOLD-ENTRY (WS-HCNT - 1)  
                     ELSE   
                        MOVE WS-O-OBC-ENTRY (SUB)   
                                    TO WS-HOLD-ENTRY (WS-HCNT)  
                     END-IF 
                  ELSE  
                     MOVE WS-O-OBC-ENTRY (SUB)  
                                    TO WS-HOLD-ENTRY (WS-HCNT)  
                  END-IF
               END-IF   
           END-PERFORM. 

           IF WS-HCNT NOT = WS-O-OBC-ENTRY-CNT  
              ADD 1                     TO CCMV-ADV-SUB 
              MOVE 0014                 TO MSGHDR-ADVISE-CODE   
                                           (CCMV-ADV-SUB)   
              MOVE 'CCR02CPO'           TO MSGHDR-ADVISE-SOURCE 
                                           (CCMV-ADV-SUB)   
              PERFORM CCP75-OUTPUT-CCERRMSG 
                 THRU CCP75-OUTPUT-CCERRMSG-EXIT
              GO TO 9000-END-OF-JOB 
           END-IF.  

           PERFORM VARYING SUB FROM 1 BY 1  
               UNTIL SUB > WS-HCNT  
               MOVE WS-HOLD-ENTRY (SUB) 
                                    TO WS-O-OBC-ENTRY (SUB) 
           END-PERFORM. 

       3700-EXIT.   
           EXIT.

       3800-FIND-ORDERS.

CCLCOM* *Finding EXC orders first.  
CCLCOM*      MOVE SPACES   TO SXP03-INPUT-DATA  
CCLCOM*                       SXP03-OUTPUT-DATA.
CCLCOM*      MOVE ZEROES   TO SXP03-EXC-EOR-REC-COUNT   
CCLCOM*                       SXP03-EXC-EGOR-REC-COUNT. 
CCLCOM*      MOVE RSP06-IBR-BOOK-NUM
CCLCOM*                     TO SXP03-EOR-IBR-BOOK-NUM.  
CCLCOM*      MOVE RSP06-IBR-SHORE-EXC-SEQ-NUM   
CCLCOM*                                  TO 
CCLCOM*                    SXP03-EOR-IBR-SHORE-EXC-SEQ-NM.  
CCLCOM* 
CCLCOM*      IF  SXP03-EOR-IBR-SHORE-EXC-SEQ-NM > 0 
CCLCOM*          CALL 'SXC03ORD' USING DPP01-COMMON-DATA-FIELDS 
CCLCOM*                                DPP01-COMMON-INFO
CCLCOM*                                SXP03-INPUT-DATA 
CCLCOM*                                SXP03-OUTPUT-DATA
CCLCOM* 
CCLCOM*          IF  SXP03-EXC-EOR-REC-COUNT > 0
CCLCOM*              PERFORM VARYING SUB1 FROM 1 BY 1   
CCLCOM*                UNTIL SUB1 > SXP03-EXC-EOR-REC-COUNT 
CCLCOM*                IF SXP03-EOR-ORDER-STATUS (SUB1) =   
CCLCOM*                                 'A' AND 
CCLCOM*                   SXP03-EOR-OBC-AMOUNT (SUB1) > 0   
CCLCOM*                   ADD 1        TO WS-ENTRY-CNT  
CCLCOM*                   MOVE SPACES  TO   
CCLCOM*                          WS-ORDER-NUM (WS-ENTRY-CNT)
CCLCOM*                          WS-ORDER-ITEM-TYPE   (WS-ENTRY-CNT)
CCLCOM*                   MOVE SXP03-EOR-CALC-KEY (SUB1)
CCLCOM*                         TO WS-ORDER-NUM (WS-ENTRY-CNT)  
CCLCOM*                   MOVE SXP03-EOR-ORDER-DATE (SUB1)   TO 
CCLCOM*                        WS-ORDER-CREATE-DATE (WS-ENTRY-CNT)  
CCLCOM*                   MOVE SXP03-EOR-ORDER-TIME (SUB1) TO   
CCLCOM*                           WS-TIME-HHMM         (WS-ENTRY-CNT)   
CCLCOM*                   MOVE ZEROS    TO  
CCLCOM*                            WS-TIME-SSMM         (WS-ENTRY-CNT)  
CCLCOM*                   MOVE SXP03-EOR-EXC-TYPE (SUB1)    TO  
CCLCOM*                    WS-ORDER-ITEM-TYPE   (WS-ENTRY-CNT)  
CCLCOM*                   MOVE SXP03-EOR-OBC-AMOUNT (SUB1)  TO  
CCLCOM*                      WS-OBC-AMT           (WS-ENTRY-CNT)
CCLCOM*                END-IF   
CCLCOM*              END-PERFORM
CCLCOM*          END-IF 
CCLCOM*      END-IF.

CCLCOM* 3800-FIND-BV-ORDERS.

            EXEC SQL
                DECLARE ORDER_OBC_CUR CURSOR
                FOR RETENTION   
                SELECT OOD.ORDER_NUM,   
                       IFNULL(OOD.OBC_AMT,0),   
                       IFNULL (OOD.PRESALE_ITEM_TYPE,' '),  
                       CONVERT(OMS.CREATION_DATETIME, 112), 
                       CONVERT(OMS.CREATION_DATETIME, 108)  
                  FROM ORDER_OBC_DETAIL OOD 
                  JOIN ORDER_MASTER OMS 
                       ON OOD.ORDER_NUM = OMS.ORDER_NUM 
                  WHERE (OOD.BOOK_NUM = :RSP23-I-INDV-BOOK-NUM) 
                      AND (OMS.ORDER_STATUS <> 'C') 

            END-EXEC.   

            EXEC SQL
                 OPEN ORDER_OBC_CUR 
            END-EXEC.   

            IF SQLCODE < 0  
               GO TO 9150-RDMS-ERROR
            END-IF. 

       3800-PROCESS-BV. 

            EXEC SQL
                 FETCH ORDER_OBC_CUR
                 INTO :WS-ORD-NUM,  
                      :WS-ORD-OBC-AMT,  
                      :WS-ORD-ITEM-TYPE,
                      :WS-ORD-CREATE-DATE,  
                      :WS-TIME  
            END-EXEC.   

            IF SQLCODE < 0 OR SQLCODE = 100 
               GO TO 3800-ORDER-OBC-ERROR   
            END-IF. 
            IF WS-ORD-OBC-AMT > 0   
               ADD 1                       TO WS-ENTRY-CNT  
               MOVE WS-ORD-NUM TO  WS-ORDER-NUM (WS-ENTRY-CNT)  
               MOVE WS-ORD-OBC-AMT TO WS-OBC-AMT(WS-ENTRY-CNT)  
               MOVE WS-ORD-ITEM-TYPE TO WS-ORDER-ITEM-TYPE  
                                              (WS-ENTRY-CNT)
               MOVE WS-ORD-CREATE-DATE TO WS-ORDER-CREATE-DATE  
                                              (WS-ENTRY-CNT)
               STRING WS-TIME-HH WS-TIME-MM 
               DELIMITED BY SIZE INTO WS-TIME-HHMM (WS-ENTRY-CNT)   
               MOVE ZEROS      TO WS-TIME-SSMM (WS-ENTRY-CNT)   
            END-IF. 
            GO TO 3800-PROCESS-BV.  

       3800-ORDER-OBC-ERROR.

            EXEC SQL
               CLOSE ORDER_OBC_CUR  
            END-EXEC.   

       3800-SORT-ORDERS.

            IF WS-ENTRY-CNT NOT > 1 
               GO TO 3800-EXIT  
            END-IF. 

            PERFORM WS-ENTRY-CNT TIMES  
               PERFORM VARYING SUB FROM 1 BY 1  
                   UNTIL SUB > (WS-ENTRY-CNT - 1)   
                   IF WS-ORDER-CREATE-DATETIME (SUB) >  
                      WS-ORDER-CREATE-DATETIME (SUB + 1)
                      MOVE WS-ORDER-ENTRY (SUB) 
                                     TO WS-HOLD-TBL 
                      MOVE WS-ORDER-ENTRY (SUB + 1) 
                              TO WS-ORDER-ENTRY (SUB)   
                      MOVE WS-HOLD-TBL TO   
                       WS-ORDER-ENTRY (SUB + 1) 
                   END-IF   
               END-PERFORM  
            END-PERFORM.

       3800-EXIT.   
            EXIT.   

       3900-APPLY-OBC.  

           IF WS-ENTRY-CNT = ZEROS  
              GO TO 3900-EXIT   
           END-IF.  

           MOVE 0                   TO OSUB.

       3900-PROCESS-ORDER-TBL.  
           ADD 1                    TO OSUB.

           IF OSUB > WS-ENTRY-CNT   
              GO TO 3900-EXIT   
           END-IF.  

           MOVE SPACES              TO WS-QUAL-OBC-TYPE-1   
                                       WS-QUAL-OBC-TYPE-2   
                                       WS-QUAL-OBC-TYPE-3.  

           IF WS-ORDER-ITEM-TYPE (OSUB) = 'TR'  
              MOVE 'GENERAL'        TO WS-QUAL-OBC-TYPE-1   
                                       WS-TNAME 
           ELSE 
              PERFORM VARYING SUB FROM 1 BY 1 UNTIL SUB > MAP-SUB   
                 IF WS-ORDER-ITEM-TYPE (OSUB) = WS-ITEM-TYPE (SUB)  
                    MOVE WS-OBC-TYPE-1 (SUB) TO WS-QUAL-OBC-TYPE-1  
                    MOVE WS-OBC-TYPE-2 (SUB) TO WS-QUAL-OBC-TYPE-2  
                    MOVE WS-OBC-TYPE-3 (SUB) TO WS-QUAL-OBC-TYPE-3  
                    MOVE WS-TRANSLATED-NAME (SUB)   
                                             TO WS-TNAME
                    MOVE MAP-SUB             TO SUB 
                 END-IF 
              END-PERFORM   
           END-IF.  

CCLHP2*    IF WS-QUAL-OBC-TYPE-1 NOT > SPACES   
CCLHP2*       ADD 1                      TO CCMV-ADV-SUB
CCLHP2*       MOVE 0016                  TO MSGHDR-ADVISE-CODE  
CCLHP2*                                     (CCMV-ADV-SUB)  
CCLHP2*       MOVE 'CCR02CPO'            TO MSGHDR-ADVISE-SOURCE
CCLHP2*                                     (CCMV-ADV-SUB)  
CCLHP2*       PERFORM CCP75-OUTPUT-CCERRMSG 
CCLHP2*          THRU CCP75-OUTPUT-CCERRMSG-EXIT
CCLHP2*       GO TO 9000-END-OF-JOB 
CCLHP2*    END-IF.  

           PERFORM VARYING SUB FROM 1 BY 1  
              UNTIL SUB > WS-O-OBC-ENTRY-CNT
              IF ((WS-O-OBC-DEPT-CODE (SUB) = WS-QUAL-OBC-TYPE-1   OR   
                                                 WS-QUAL-OBC-TYPE-2   OR
                                                 WS-QUAL-OBC-TYPE-3   OR
                                                 'GENERAL')          AND
                  (WS-O-REMAINING-OBC-AMT (SUB)  > 0))  
                 IF WS-O-REMAINING-OBC-AMT (SUB) >= WS-OBC-AMT (OSUB)   
                    ADD WS-OBC-AMT (OSUB)   
                                    TO WS-O-APPLIED-OBC-AMT (SUB)   
                    SUBTRACT WS-OBC-AMT (OSUB)  
                        FROM WS-O-REMAINING-OBC-AMT (SUB)   
                    MOVE ZEROS      TO WS-OBC-AMT (OSUB)
                    MOVE WS-O-OBC-ENTRY-CNT TO SUB  
                 ELSE   
                    ADD WS-O-REMAINING-OBC-AMT (SUB)
                                    TO WS-O-APPLIED-OBC-AMT (SUB)   
                    SUBTRACT WS-O-REMAINING-OBC-AMT (SUB)   
                        FROM WS-OBC-AMT (OSUB)  
                    MOVE ZEROS      TO WS-O-REMAINING-OBC-AMT (SUB) 
                 END-IF 
              END-IF
           END-PERFORM. 

           IF (WS-OBC-AMT (OSUB) NOT = 0)   
              ADD 1                           TO WS-ORDER-ENTRY-CNT 
              MOVE WS-ORDER-NUM (OSUB)        TO WS-O-ORDER-NUM 
                                                 (WS-ORDER-ENTRY-CNT)   
              MOVE WS-ORDER-ITEM-TYPE (OSUB)  TO WS-O-ITEM-TYPE 
                                                 (WS-ORDER-ENTRY-CNT)   

              MOVE WS-OBC-AMT (OSUB)          TO WS-O-DEFICIT-OBC-AMT   
                                                 (WS-ORDER-ENTRY-CNT)   
           END-IF.  

           GO TO 3900-PROCESS-ORDER-TBL.

       3900-EXIT.   
           EXIT.

       4000-GET-SAILING-INFO.   
           MOVE WS-SHIP-CODE       TO TDP01-I-SHIP-CODE 
           MOVE WS-SAIL-DATE       TO TDP01-I-SAIL-DATE-YYYYMMDD
           MOVE WS-DUR-DAYS        TO TDP01-I-DUR-DAYS  

           PERFORM TDP01-RET-SAIL-DETAILS   
              THRU TDP01-RET-SAIL-DETAILS-EXIT. 

           IF TDP01-SAIL-SQLERR 
              GO TO 9150-RDMS-ERROR 
           END-IF.  

           IF TDP01-SAIL-NOTFND OR  
              TDP01-PROC-ERROR > ZEROES 
              ADD  1                     TO CCMV-ADV-SUB
              MOVE 0010                  TO MSGHDR-ADVISE-CODE  
                                            (CCMV-ADV-SUB)  
              MOVE 'CCR01UPO'            TO MSGHDR-ADVISE-SOURCE
                                            (CCMV-ADV-SUB)  
              PERFORM CCP75-OUTPUT-CCERRMSG 
                 THRU CCP75-OUTPUT-CCERRMSG-EXIT
              GO TO 9000-END-OF-JOB 
           END-IF.  

       4000-SAILING-INFO-EXIT.  
            EXIT.   

       4000-CREATE-GML-ENTRY.   

           IF TDP01-STATUS-CODE = 'V' OR 'T'
              CONTINUE  
           ELSE 
              GO TO 4000-GML-ENTRY-EXIT 
           END-IF.  

           MOVE SPACES                        TO ARP01-CASH-DETAILS-REC.
           MOVE TDP01-FINANCIAL-COMPANY-CODE  TO ARP01-DB-COMPANY-CODE  
                                                 ARP01-CR-COMPANY-CODE. 
       COPY SSP20INT.   
           MOVE TDP01-SHIP-CODE     TO SSP20-I-SHIP-CODE.   

           CALL 'SSC20GSD' USING DPP01-COMMON-DATA-FIELDS   
                                 DPP01-COMMON-INFO  
                                 SSP20-INPUT-PARAMS 
                                 SSP20-OUTPUT-PARAMS.   

           IF DPP01-SUB-MSG-CTR > 0 AND DPP01-SUB-MSG-STATUS (1) > 1
              GO TO 9500-RETURN-SUBROUTINE-ERROR.   

           MOVE FUNCTION CURRENT-DATE   TO DPP01-SYSTEM-DATE-TIME.  
           MOVE DPP01-SYSTEM-DATE       TO ARP01-DEPOSIT-DATE.  
           MOVE 961                     TO ARP01-BATCH-NUM. 
           MOVE 'SSA'                   TO ARP01-PAYMENT-TYPE.  
           MOVE WS-USER-INFO            TO ARP01-OPER-INITIALS. 
           MOVE 'SPC SERVE ADJSTMT'     TO ARP01-PAYMENT-ID.
           MOVE '0000207'               TO ARP01-CUST-NUM2. 
           MOVE '0000001220007000'      TO ARP01-GLDB-NUM.  

           IF WS-GRP-BOOK-IND = 'Y' OR RSP06-IBR-BOOK-TYPE = 'G'
              MOVE '0000203'            TO ARP01-CUST-NUM2  
              MOVE '0000001130071000'   TO ARP01-GLDB-NUM   
              MOVE GBR1-CUSTOMER-NUM    TO ARP01-CUST-NUM1  
              MOVE 'G'                  TO ARP01-BOOK-TYPE  
           ELSE 
              MOVE IBR-CUSTOMER-NUM     TO ARP01-CUST-NUM1  
              MOVE IBR-BOOK-TYPE        TO ARP01-BOOK-TYPE  
           END-IF.  

           MOVE WS-BOOK-NUM             TO ARP01-INVOICE-NUM
                                           ARP01-BOOK-NUM.  
           MOVE DPP01-SYSTEM-DATE       TO ARP01-ORIG-TRANSACTION-DATE. 
           MOVE DPP01-SYSTEM-TIME-HHMM  TO ARP01-ORIG-TRAN-TIME.

            IF WS-GRP-BOOK-IND NOT = 'Y' AND RSP06-IBR-BOOK-TYPE = 'G'  
              MOVE RSP06-IBR-BOOK-NUM TO ARP01-IBR-BOOK-NUM 
           ELSE 
              MOVE SPACES TO ARP01-IBR-BOOK-NUM 
           END-IF.  

       4000-CONTINUE-AFTER-GROUP.   

           MOVE ZEROS                       TO WS-PRC-XCHG-RATE 
                                               WS-CLSD-XCHG-RATE.   

           IF  WS-BOOK-NUM = GBR1-BOOK-NUM  
               MOVE GBR1-PRC-XCHG-RATE      TO WS-PRC-XCHG-RATE 
               MOVE GBR1-CLSD-XCHG-RATE     TO WS-CLSD-XCHG-RATE
               MOVE GBR1-CURRENCY-CODE      TO ARP01-CURRENCY-CODE  
               GO TO 4000-GET-BOOKING-EXIT  
           ELSE 
               IF  WS-BOOK-NUM = IBR-BOOK-NUM   
                   MOVE IBR-PRC-XCHG-RATE   TO WS-PRC-XCHG-RATE 
                   MOVE IBR-CLSD-XCHG-RATE  TO WS-CLSD-XCHG-RATE
                   MOVE IBR-CURRENCY-CODE   TO ARP01-CURRENCY-CODE  
               END-IF   
               GO TO 4000-GET-BOOKING-EXIT  
           END-IF.  

       4000-GET-INDV-BOOKING.   
           MOVE 'A'                         TO  IBR-BOOK-TYPE.  
           MOVE WS-BOOK-NUM                 TO  IBR-BOOK-NUM.   

           PERFORM IRP66-FETCH-IBR-SUPPRESS THRU
                   IRP66-FETCH-IBR-SUP-EXIT.

           IF IRP66-ERROR-NUM > 0   
               GO TO 4000-GET-GRP-BOOKING   
           END-IF.  

           MOVE IBR-PRC-XCHG-RATE           TO WS-PRC-XCHG-RATE.
           MOVE IBR-CLSD-XCHG-RATE          TO WS-CLSD-XCHG-RATE.   
           MOVE IBR-CURRENCY-CODE           TO ARP01-CURRENCY-CODE. 

           GO TO 4000-GET-BOOKING-EXIT. 

       4000-GET-GRP-BOOKING.
           MOVE WS-BOOK-NUM                 TO  GBR1-BOOK-NUM.  

           FETCH GRP1-BOOKING-REC RECORD
                 SUPPRESS ALL CURRENCY UPDATES  
                 ON ERROR   
                    GO TO 9100-DATABASE-ERROR.  

           MOVE GBR1-PRC-XCHG-RATE          TO WS-PRC-XCHG-RATE.
           MOVE GBR1-CLSD-XCHG-RATE         TO WS-CLSD-XCHG-RATE.   
           MOVE GBR1-CURRENCY-CODE          TO ARP01-CURRENCY-CODE. 

       4000-GET-BOOKING-EXIT.   

           PERFORM VARYING SUB2 FROM 1 BY 1 
              UNTIL SUB2 >  CPOOB1-CNT (BSUB)   
              MOVE CPOOB1-ITEM-TOTAL-AMT (BSUB SUB2)
                                               TO WS-ORDER-ITEM-AMT 
              MOVE CPOOB1-ITEM-SURCHARGE-AMT (BSUB SUB2)
                                               TO WS-ORDER-SRVCH-AMT
              COMPUTE WS-PAID-AMT = (WS-ORDER-ITEM-AMT -
                                  WS-ORDER-SRVCH-AMT)   
              PERFORM 4200-CREATE-GL-ENTRIES THRU 4200-EXIT 
           END-PERFORM. 

           GO TO 4000-GML-ENTRY-EXIT.   

       4200-CREATE-GL-ENTRIES.  

           EXEC SQL 
              SELECT  IFNULL (ITEM_LEGCY_SHIP_NUM, ' '),
                      IFNULL (ITEM_LEGCY_CENTER_NUM, ' '),  
                      IFNULL (ITEM_LEGCY_ACCT_NUM, ' '),
                      IFNULL (ITEM_LEGCY_SUB_ACCT_NUM,' ')  
               INTO  :WS-HYB-SHIP-NUM,  
                     :WS-HYB-CENTER-NUM,
                     :WS-HYB-GL-ACCT-NUM,   
                     :WS-HYB-SUB-ACCT-NUM   
              FROM    BV_ITEM_TYPE_CGFS_ACCTS   
              WHERE   ITEM_TYPE = :CPOOB1-ITEM-TYPE (BSUB SUB2) 
                AND   COMP_IND = 'N'
              FETCH FIRST 1 ROW ONLY
           END-EXEC.

           IF SQLCODE = 100 
              CONTINUE  
           END-IF.  

           MOVE WS-GL-ACCT-NUM      TO ARP01-GLCR-NUM.  
           MOVE SSP20-O-SHIP-NUM    TO ARP01-GLCR-SHIP-NUM. 
           MOVE WS-PAID-AMT         TO ARP01-ORIG-TRANSACTION-AMT.  

           COMPUTE ARP01-PAYMENT-AMT ROUNDED =  
                   WS-PAID-AMT / WS-PRC-XCHG-RATE   
           COMPUTE ARP01-USD-EQUIVALENT-AMT ROUNDED =   
                   ARP01-PAYMENT-AMT / WS-CLSD-XCHG-RATE
           PERFORM ARP10-STORE-CASH-ENTRIES THRU ARP10-EXIT.

           IF WS-ORDER-SRVCH-AMT NOT = 0
              EXEC SQL  
                 SELECT  IFNULL (ITEM_LEGCY_SHIP_NUM, ' '), 
                         IFNULL (ITEM_LEGCY_CENTER_NUM, ' '),   
                         IFNULL (ITEM_LEGCY_ACCT_NUM, ' '), 
                         IFNULL (ITEM_LEGCY_SUB_ACCT_NUM,' ')   
                  INTO  :WS-HYB-SRVCH-SHIP-NUM, 
                        :WS-HYB-SRVCH-CENTER-NUM,   
                        :WS-HYB-SRVCH-GL-ACCT-NUM,  
                        :WS-HYB-SRVCH-SUB-ACCT-NUM  
                 FROM    BV_ITEM_TYPE_CGFS_ACCTS
                 WHERE   ITEM_TYPE =  'SRVCH'   
                   AND   COMP_IND = 'N' 
                 FETCH FIRST 1 ROW ONLY 
              END-EXEC  

              IF SQLCODE = 100  
                 CONTINUE   
              END-IF

              MOVE WS-HYB-SR-GL-ACCT-NUM   TO ARP01-GLCR-NUM
              MOVE SSP20-O-SHIP-NUM        TO ARP01-GLCR-SHIP-NUM   
              MOVE WS-ORDER-SRVCH-AMT      TO ARP01-ORIG-TRANSACTION-AMT
              COMPUTE ARP01-PAYMENT-AMT ROUNDED =   
                      WS-ORDER-SRVCH-AMT / WS-PRC-XCHG-RATE 
              COMPUTE ARP01-USD-EQUIVALENT-AMT ROUNDED =
                      ARP01-PAYMENT-AMT / WS-CLSD-XCHG-RATE 
              PERFORM ARP10-STORE-CASH-ENTRIES THRU ARP10-EXIT  
           END-IF.  

       4200-EXIT.   
           EXIT.

       4000-GML-ENTRY-EXIT. 
            EXIT.   

CCLCOM 5000-UPDATE-USER-INFO.   
CCLCOM  
CCLCOM     IF BKCPO1-ORDER-TYPE = 'C' OR 'A'
CCLCOM          MOVE WS-USER-INFO         TO WS-APPR-ID 
CCLCOM     ELSE 
CCLCOM          MOVE SPACES               TO WS-APPR-ID 
CCLCOM     END-IF.  
CCLCOM  
CCLCOM     MOVE BKCPO1-SAIL-DATE       TO WS-ORD-SAIL-DATE. 
CCLCOM  
CCLCOM     EXEC SQL 
CCLCOM          INSERT INTO ORDER_PAYMENT_DETAIL
CCLCOM             (MF_ORDER_NUM,   
CCLCOM             HYBRIS_ORDER_ID, 
CCLCOM             SHIP_CODE,   
CCLCOM             SAIL_DATE,   
CCLCOM             DURATION_DAYS,   
CCLCOM             ORDER_PAYMENT_AMT,   
CCLCOM             ORDER_REFUND_AMT,
CCLCOM             CC_PAYMENT_TYPE, 
CCLCOM             CC_NUM_LAST4,
CCLCOM             CC_EXP_MMYY, 
CCLCOM             APPR_ID, 
CCLCOM             USER_FIRST_NAME, 
CCLCOM             USER_LAST_NAME,  
CCLCOM             USER_ID) 
CCLCOM           VALUES 
CCLCOM           (:WS-MF-ORDER-NUM, 
CCLCOM            :BKCPO1-ORDER-NUM,
CCLCOM            :BKCPO1-SHIP-CODE,
CCLCOM            DATE(STRPTIME(:WS-ORD-SAIL-DATE-X,'%Y%m%d')), 
CCLCOM            :BKCPO1-DURATION-DAYS,
CCLCOM            NULL, 
CCLCOM            NULL, 
CCLCOM            NULL, 
CCLCOM            NULL, 
CCLCOM            NULL, 
CCLCOM            NULLIF(:WS-APPR-ID,' '),  
CCLCOM            NULLIF(:WS-USER-FIRST-NAME, ' '), 
CCLCOM            NULLIF(:WS-USER-LAST-NAME, ' '),  
CCLCOM            NULLIF(:WS-USER-INFO,' '))
CCLCOM     END-EXEC.
CCLCOM  
CCLCOM     IF SQLCODE < 0   
CCLCOM        GO TO 9150-RDMS-ERROR 
CCLCOM     END-IF.  

       5000-SEND-RESPONSE.  

           MOVE BKCPO1-ORDER-NUM  TO BKCPO2-ORDER-NUM.  
           MOVE WS-MF-ORDER-NUM   TO BKCPO2-NAV-ORDER-NUM.  
           PERFORM CCP02-OUTPUT-CCBKCPO2
              THRU CCP02-OUTPUT-CCBKCPO2-EXIT.  

       9000-END-OF-JOB. 
           GO TO DPP12-END-OF-JOB.  

       9100-DATABASE-ERROR. 
           GO TO DPP12-DATABASE-ERROR.  

       9150-RDMS-ERROR. 

           ADD 1                      TO CCMV-ADV-SUB.  
           MOVE 0013                  TO MSGHDR-ADVISE-CODE 
                                         (CCMV-ADV-SUB).
           MOVE 'CCR02CPO'            TO MSGHDR-ADVISE-SOURCE   
                                         (CCMV-ADV-SUB).
           PERFORM CCP75-OUTPUT-CCERRMSG
              THRU CCP75-OUTPUT-CCERRMSG-EXIT.  

           GO TO DPP12-RDMS-ERROR.  

       9200-EDIT-ERROR-MSG. 
           PERFORM DPP12-EDIT-ERROR-MSG 
              THRU DPP12-EDIT-ERROR-MSG-EXIT.   

           GO TO 9000-END-OF-JOB.   

       9210-EDIT-CONTINUE-MSG.  
           PERFORM DPP12-EDIT-ERROR-MSG 
              THRU DPP12-EDIT-ERROR-MSG-EXIT.   

       9300-SEVERE-ERROR-MSG.   
           GO TO DPP12-SEVERE-ERROR-MSG.

       9400-INFO-MSG.   
           PERFORM DPP12-INFO-MSG   
              THRU DPP12-INFO-MSG-EXIT. 

       9500-RETURN-SUBROUTINE-ERROR.
           GO TO DPP12-RETURN-SUBROUTINE-ERROR. 

       9600-SAVE-SUBROUTINE-ERRORS. 
           PERFORM DPP12-SAVE-SUBROUTINE-MSGS   
              THRU DPP12-SAVE-SUBROUTINE-MSGS-X.

       COPY CCP10CCS.   
       COPY CCP50P02.   
       COPY CCP02CPU.   
       COPY CCP75P02.   
       COPY CCP02CPS.   
       COPY DPP12API.   
       COPY DPP12AMI.   
       COPY DPP12ERR.   
       COPY DPP12WDB.   
       COPY RSP50INT.   
       COPY RSP49INT.   
       COPY IRP66RIB.   
       COPY IRP66OIB.   
       COPY DPP04PIR.   
       COPY DPP10Y2K.   
       COPY DPP11POP.   
       COPY DPP45AOP.   
       COPY IRP66UIB.   
       COPY GRP15BHP.   
       COPY IRP15BHS.   
       COPY DPP15OAS.   
       COPY IRP48CNP.   
       COPY DPP16SBR.   
       COPY DPP17PFR.   
       COPY DPP20Y2K.   
       COPY TDP01SAP.   
       COPY ARP06ACH.   
       COPY IRP14OHS.   
       COPY ARP10CDS.   
203526*COPY ARP79SIP.   
203526 COPY ARP79SIP-SI.
       COPY ARP90SPR.   
       COPY ARP15ATP.   
